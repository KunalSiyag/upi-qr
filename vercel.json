{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "proupiqr.in" }],
      "destination": "https://www.proupiqr.in/:path*",
      "permanent": true
    },
    { "source": "/old-blog/:slug", "destination": "/blog/:slug/", "permanent": true },
    { "source": "/upi-qr-code-generator-no-signup/:path*", "destination": "/free-qr-generator-without-watermark/", "permanent": true },
    { "source": "/hi/upi-qr-code-generator-no-signup/:path*", "destination": "/hi/free-qr-generator-without-watermark/", "permanent": true },
    { "source": "/ta/upi-qr-code-generator-no-signup/:path*", "destination": "/ta/free-qr-generator-without-watermark/", "permanent": true },
    { "source": "/te/upi-qr-code-generator-no-signup/:path*", "destination": "/te/free-qr-generator-without-watermark/", "permanent": true },
    { "source": "/mr/upi-qr-code-generator-no-signup/:path*", "destination": "/mr/free-qr-generator-without-watermark/", "permanent": true },
    { "source": "/hi/sbi-business-qr-code-generator", "destination": "/hi/sbi-business-qr-code-generator/", "permanent": true },
    { "source": "/hi/hdfc-business-qr-code-generator", "destination": "/hi/hdfc-business-qr-code-generator/", "permanent": true },
    { "source": "/hi/icici-business-qr-code-generator", "destination": "/hi/icici-business-qr-code-generator/", "permanent": true },
    { "source": "/universal-upi-qr-code-generator-for-bank-account/:path*", "destination": "/universal-qr-generator/", "permanent": true },
    { "source": "/hi/universal-upi-qr-code-generator-for-bank-account/:path*", "destination": "/hi/universal-qr-generator/", "permanent": true },
    { "source": "/hi/doctor-clinic-upi-qr-generator", "destination": "/hi/doctor-clinic-upi-qr-generator/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        }
      ]
    },
    {
      "source": "/embed/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/sign-in/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/sign-up/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/c/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/r/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "base-uri 'none'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/hi/rss.xml",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/ta/rss.xml",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/te/rss.xml",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/mr/rss.xml",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
