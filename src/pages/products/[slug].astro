---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  PRODUCTS,
  getProduct,
  relatedProducts,
  type HardwareProduct,
} from "../../data/products";
import { siteImage } from "../../data/siteImages";

export async function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: HardwareProduct;
}

const { product } = Astro.props;
const pageUrl = `https://www.proupiqr.in/products/${product.slug}/`;
const og = siteImage(product.ogImageId);
const siblings = relatedProducts(product);
const imageUrl = `https://www.proupiqr.in${product.imgSrc}`;
const lastReviewed = "3 September 2026";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `${pageUrl}#product`,
      name: product.name,
      description: product.seoDescription,
      image: [imageUrl, `https://www.proupiqr.in${og.src}`],
      brand: { "@type": "Brand", name: "Shop counter hardware" },
      category: "Point of Sale Display",
      url: pageUrl,
      offers: {
        "@type": "AggregateOffer",
        url: product.affiliateUrl,
        priceCurrency: "INR",
        lowPrice: product.lowPrice,
        highPrice: product.highPrice,
        offerCount: 5,
        availability: "https://schema.org/InStock",
        seller: { "@type": "Organization", name: "Amazon.in" },
      },
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      name: `How to use a ${product.shortName} with a UPI QR`,
      description: product.intro,
      totalTime: "PT5M",
      step: product.steps.map((step, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: step.name,
        text: step.text,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: product.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "Print UPI QR", item: "https://www.proupiqr.in/print-upi-qr/" },
        { "@type": "ListItem", position: 3, name: "Hardware", item: "https://www.proupiqr.in/products/" },
        { "@type": "ListItem", position: 4, name: product.shortName, item: pageUrl },
      ],
    },
  ],
};

const alternates = [
  { lang: "en", url: pageUrl },
  { lang: "x-default", url: pageUrl },
];
---

<BaseLayout
  title={product.seoTitle}
  description={product.seoDescription}
  schema={schema}
  image={og.src}
  alternates={alternates}
>
  <main class="px-4 py-10 md:px-6 lg:px-8">
    <article class="mx-auto max-w-5xl rounded-[2rem] border border-white/75 bg-white/86 p-5 shadow-[0_18px_48px_rgba(17,59,44,0.08)] sm:p-8 md:p-10">
      <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
        <a href="/" class="hover:text-leaf">Home</a>
        <span>/</span>
        <a href="/print-upi-qr/" class="hover:text-leaf">Print UPI QR</a>
        <span>/</span>
        <a href="/products/" class="hover:text-leaf">Hardware</a>
        <span>/</span>
        <span class="text-forest" aria-current="page">{product.shortName}</span>
      </nav>

      <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">
        {product.tag}
      </p>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-forest md:text-5xl">{product.h1}</h1>
      <p class="mt-4 max-w-3xl text-base leading-7 text-forest/75">{product.intro}</p>
      <p class="mt-2 text-xs font-semibold text-forest/50">Last reviewed {lastReviewed} · Amazon Associate link labelled below</p>

      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <div class="relative flex min-h-[18rem] items-center justify-center overflow-hidden rounded-[1.75rem] border border-forest/5 bg-cream p-6">
          <picture>
            <source type="image/avif" srcset={product.imgSrc.replace(".png", ".avif")} />
            <source type="image/webp" srcset={product.imgSrc.replace(".png", ".webp")} />
            <img
              src={product.imgSrc}
              alt={product.imgAlt}
              width={product.imgWidth}
              height={product.imgHeight}
              loading="eager"
              decoding="async"
              class="max-h-[22rem] w-full object-contain"
            />
          </picture>
        </div>
        <div class="flex flex-col justify-between rounded-[1.75rem] border border-forest/10 bg-[#fffdf6] p-6">
          <div>
            <p class="text-sm font-black uppercase tracking-[0.18em] text-leaf">Typical street price</p>
            <p class="mt-2 text-3xl font-black text-forest">{product.priceEst}</p>
            <p class="mt-2 text-sm leading-6 text-forest/70">{product.bestFor}</p>
            <p class="mt-3 text-sm leading-6 text-forest/70">
              Print insert: {product.printInsert}
            </p>
          </div>
          <div class="mt-6 space-y-3">
            <a
              href={product.affiliateUrl}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="inline-flex w-full items-center justify-center rounded-full bg-forest px-5 py-3 text-sm font-black text-white transition hover:bg-leaf focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf focus-visible:ring-offset-2"
            >
              Check price on Amazon →
            </a>
            <a
              href={product.generatorHref}
              class="inline-flex w-full items-center justify-center rounded-full border border-forest/15 bg-white px-5 py-3 text-sm font-black text-forest transition hover:border-leaf hover:text-leaf focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf"
            >
              {product.generatorLabel} →
            </a>
            <p class="text-[11px] leading-5 text-forest/55">
              Amazon Associate link — Pro UPI QR may earn from qualifying purchases. Prices change. This does not affect QR generation. See the
              <a href="/editorial-policy/" class="text-leaf hover:underline">editorial policy</a>.
            </p>
          </div>
        </div>
      </div>
      <p class="mt-3 text-xs leading-5 text-forest/55">{product.imgCaption}</p>

      <div class="mt-10 space-y-5 text-base leading-8 text-forest/85">
        {product.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <h2 class="mt-12 text-2xl font-black text-forest">Specs that actually matter</h2>
      <dl class="mt-5 grid gap-3 sm:grid-cols-2">
        {product.specs.map((spec) => (
          <div class="rounded-2xl border border-forest/10 bg-mint/30 p-4">
            <dt class="text-[11px] font-black uppercase tracking-wider text-forest/60">{spec.label}</dt>
            <dd class="mt-1 text-sm font-semibold text-forest">{spec.value}</dd>
          </div>
        ))}
      </dl>

      <h2 class="mt-12 text-2xl font-black text-forest">How to set it up</h2>
      <ol class="mt-5 grid gap-4 md:grid-cols-3">
        {product.steps.map((step, index) => (
          <li class="rounded-2xl border border-forest/10 bg-white p-5">
            <p class="text-[11px] font-black uppercase tracking-wider text-leaf">Step {index + 1}</p>
            <h3 class="mt-1 text-base font-black text-forest">{step.name}</h3>
            <p class="mt-2 text-sm leading-6 text-forest/75">{step.text}</p>
          </li>
        ))}
      </ol>

      <p class="mt-8 text-sm leading-7 text-forest/75">
        Related print notes:
        <a class="font-semibold text-leaf hover:underline" href={product.guideHref}>{product.guideLabel}</a>
        {" "}·
        <a class="font-semibold text-leaf hover:underline" href="/print-templates/">template gallery</a>
        {" "}·
        <a class="font-semibold text-leaf hover:underline" href="/print-upi-qr/">print hub</a>
      </p>

      <h2 class="mt-12 text-2xl font-black text-forest">FAQ</h2>
      <dl class="mt-5 grid gap-4 md:grid-cols-2">
        {product.faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-[#fffdf6] p-5">
            <dt class="font-black text-forest">{faq.question}</dt>
            <dd class="mt-2 text-sm leading-7 text-forest/75">{faq.answer}</dd>
          </div>
        ))}
      </dl>

      <h2 class="mt-12 text-2xl font-black text-forest">Related hardware</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        {siblings.map((item) => (
          <a
            href={`/products/${item.slug}/`}
            class="group rounded-2xl border border-forest/10 bg-white p-4 transition hover:border-leaf/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf"
          >
            <p class="text-sm font-black text-forest group-hover:text-leaf">{item.name}</p>
            <p class="mt-1 text-xs leading-5 text-forest/65">{item.priceEst} · {item.tag}</p>
          </a>
        ))}
      </div>
    </article>
  </main>
</BaseLayout>
