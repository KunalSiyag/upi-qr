const { title, headline, intro, presetType } = Astro.props;
const combinedDescription = `${headline}. ${intro}`;
const description =
  combinedDescription.length <= 160
    ? combinedDescription
    : intro.length <= 160
      ? intro
      : `${intro.slice(0, 157).replace(/\s+\S*$/, "")}...`;
const generatorSlug = Astro.params.slug as GeneratorSlug;
const resolvedPreset = getPresetFromSlug(generatorSlug);

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

