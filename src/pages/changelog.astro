---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CHANGELOG } from "../data/changelog";
import { BUSINESS } from "../data/business";

const title = "What's New at Pro UPI QR — Product Changelog";
const description =
  "Everything we've shipped, month by month: the payment tracker, Pro, pay links, MSME tools, and free UPI QR and billing tools for Indian businesses.";
const url = "https://www.proupiqr.in/changelog/";
const link = "font-bold text-leaf underline";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", name: "Pro UPI QR changelog", url, description, inLanguage: "en-IN", about: { "@id": "https://www.proupiqr.in/#organization" } },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "About", item: "https://www.proupiqr.in/about/" },
        { "@type": "ListItem", position: 3, name: "What's new", item: url },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-8 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-4xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="transition-colors hover:text-leaf">Home</a>
          <span>/</span>
          <a href="/about/" class="transition-colors hover:text-leaf">About</a>
          <span>/</span>
          <span class="font-bold text-forest" aria-current="page">What's new</span>
        </nav>
        <p class="text-sm font-semibold text-leaf">Changelog</p>
        <h1 class="mt-3 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">What we've shipped</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-forest/75">
          We ship every month. Here's what changed, newest first. Want something built? Email <a href={`mailto:${BUSINESS.emails.feedback}`} class={link}>{BUSINESS.emails.feedback}</a>.
        </p>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8" aria-label="Releases">
      <ol class="mx-auto max-w-4xl space-y-6 border-l-2 border-leaf/20 pl-6">
        {CHANGELOG.map((entry, index) => (
          <li class="relative">
            <span class={`absolute -left-[2.15rem] top-6 h-4 w-4 rounded-full border-4 border-cream ${index === 0 ? "bg-sun" : "bg-leaf"}`} aria-hidden="true"></span>
            <article class="rounded-[2rem] border border-white/75 bg-white/90 p-6 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
              <p class="text-sm font-semibold text-leaf"><time datetime={entry.date}>{entry.month}</time>{index === 0 && <span class="ml-2 rounded-full bg-sun px-2 py-0.5 text-forest">Latest</span>}</p>
              <h2 class="mt-2 text-2xl font-black tracking-tight text-forest">{entry.title}</h2>
              <ul class="mt-4 space-y-2 text-sm leading-6 text-forest/75">
                {entry.items.map((item) => (
                  <li class="flex gap-2"><span aria-hidden="true" class="text-leaf">✓</span><a href={item.href} class="hover:text-leaf hover:underline">{item.text}</a></li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ol>
      <p class="mx-auto mt-10 max-w-4xl text-sm text-forest/70">
        Next up: automatic WhatsApp reminders, with early access for Pro. Read <a href="/about/" class={link}>about us</a>, see <a href="/pricing/" class={link}>pricing</a>, or follow along on <a href="https://x.com/proupiqr" rel="noopener noreferrer" class={link}>X</a>.
      </p>
    </section>
  </main>
</BaseLayout>
