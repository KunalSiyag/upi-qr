---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalLinkHub from "../components/InternalLinkHub.astro";
import { FreelanceRateCalculator } from "../components/FreelanceRateCalculator";

const title = "Freelance Rate Calculator: Hourly and Day Rate | Pro UPI QR";
const description = "Work out the hourly and day rate you need from your take-home goal, costs, tax, holidays and billable time. Works in rupees, dollars, pounds and more. Free.";

const faqs = [
  {
    "question": "How is a freelance hourly rate calculated?",
    "answer": "Start from what you want to take home plus any personal costs you fund yourself. Gross that up for tax to get the profit you need, add business costs and a safety margin to get the revenue you need, then divide by the hours you can bill. With ₹12 lakh take-home, ₹1 lakh of personal costs, ₹1 lakh of business costs, 20% tax and a 10% margin, you need about ₹18,97,500 a year."
  },
  {
    "question": "Why can't I just divide a salary by the hours in a year?",
    "answer": "Because you cannot bill every hour. Holidays, sick days, admin and finding new work all take time. In the example, 225 working days of 8 hours are 1,800 hours, but at 65% billable only about 1,170 hours earn money, so the rate is about ₹1,622 an hour, not ₹1,054."
  },
  {
    "question": "What share of my time can I bill?",
    "answer": "Only you know, and it moves the rate a lot. In the same example the hourly rate is about ₹2,108 if you bill 50% of your time and about ₹1,318 if you bill 80%. The sensitivity table shows your own range. Track a few weeks of real hours before you trust a figure."
  },
  {
    "question": "What is the difference between the hourly, day and monthly figures?",
    "answer": "They all bring in the same yearly revenue. The day rate divides it by your billable days (about ₹12,974 in the example) and the monthly figure divides it by 12 (about ₹1,58,125). Use the one your clients expect, or a retainer for steady work."
  },
  {
    "question": "What should I enter for tax?",
    "answer": "Your own estimate of the share of profit that goes in income tax and any social charges. It depends on your country and how you work, and the calculator does not model tax rules, so check with an accountant."
  },
  {
    "question": "Does it work in other currencies and countries?",
    "answer": "Yes. Pick rupees, dollars, pounds, euros, Australian or Canadian dollars and enter your figures in that currency. There is no conversion. Public holidays and sick days are your own inputs because they differ by country."
  },
  {
    "question": "Does the rate include GST or VAT?",
    "answer": "No. The rate is what you keep before any sales tax. If you must charge GST or VAT, add it on the invoice according to the rules where you work."
  },
  {
    "question": "Is my data stored anywhere?",
    "answer": "No. The calculation runs in your browser and your inputs stay on your device. A draft is kept in your browser's local storage so you can come back to it; clear your site data to remove it."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Freelance Rate Calculator by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/freelance-rate-calculator/",
      description,
      featureList: ["Hourly, day and monthly rate from your take-home goal", "Tax, business costs and a safety margin built in", "Holidays, sick days and billable share of your time", "Rate at different billable shares", "Rupees, US dollars, pounds, euros, Australian and Canadian dollars", "Plan PDF and PNG export", "Browser-only, no signup"],
            offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to work out a freelance rate",
      step: [
        { "@type": "HowToStep", "name": "Enter the take-home you want and your yearly costs" },
        { "@type": "HowToStep", "name": "Add your tax estimate and a safety margin" },
        { "@type": "HowToStep", "name": "Enter your working days, holidays and the share of time you can bill" },
        { "@type": "HowToStep", "name": "Read your hourly, day and monthly figures, then download the plan" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/65">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">Freelance Rate Calculator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex text-sm font-semibold text-leaf">Money tools</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Freelance rate calculator: what to charge per hour and per day</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Work backwards from the income you want: tax, costs, holidays and the time you can actually bill, and get the hourly and day rate you need to charge.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#rate-tool" class="rounded-[10px] bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-graphite">Work out my rate</a>
            <a href="/invoice-generator/" class="rounded-[10px] border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Ready to bill? Invoice generator →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="rate-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <FreelanceRateCalculator client:visible />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">How it works</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-4xl">What the numbers assume</h2>
        <ul class="mt-6 grid gap-3 text-base leading-7 text-forest/75">
          <li class="rounded-[10px] bg-fog px-5 py-4">Money is worked in whole minor units (paise, cents) and every rate is rounded up, so a quote is never short.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">You want to take home an amount after tax, and you also fund some personal costs yourself. The profit you need before tax is that total divided by (1 − your tax rate).</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">Business costs and a safety margin are added on top of that profit to get the revenue you need.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">Working days are the weeks you work times the days a week, minus public holidays and sick days. Billable hours are those days times your hours a day times the share of time you can bill.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">Tax, billable share and margin are your assumptions, not forecasts, and tax rules are not modelled.</li>
        </ul>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Freelance rate questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="rounded-[10px] bg-fog px-5 py-4">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <InternalLinkHub currentPath="/freelance-rate-calculator/" />
      </div>
    </section>
  </main>
</BaseLayout>
