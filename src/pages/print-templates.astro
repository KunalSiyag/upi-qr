---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { PRINT_TEMPLATES, siteImage } from "../data/siteImages";

const title = "Printable UPI QR Templates A4 A5 5x7 | Pro UPI QR";
const description =
  "Browse A4 standees, A5 cards, 5×7 inserts, table tents, and A4 sticker sheets. Size charts, 300 DPI notes, and generator links for each layout.";

const pageUrl = "https://www.proupiqr.in/print-templates/";
const overview = siteImage("print-formats-overview");
const sizeChart = siteImage("print-size-chart");
const stickers = siteImage("sticker-sheet-layouts");
const og = siteImage("print-formats-overview");

const faqs = [
  {
    question: "What size should a counter UPI QR be?",
    answer:
      "For a typical checkout distance, keep the QR module itself at least 2.5–3 cm on the short side. Table tents can be smaller (about 1.5–2 in). Outdoor boards and donation walls need 5 cm or more. NPCI does not mandate one global print size.",
  },
  {
    question: "Should I download PNG or PDF?",
    answer:
      "PDF is the safer print-shop master because it keeps A4/A5 page size. PNG is fine for home inkjet and WhatsApp. Export at the physical size you will print; do not stretch a small screenshot. This site does not claim SVG or WebAssembly print engines.",
  },
  {
    question: "How many stickers fit on an A4 sheet?",
    answer:
      "The sticker-sheet tool prints 4, 6, or 12 labels per A4 page. Leave a white quiet zone inside each sticker and prefer matte vinyl on glass.",
  },
  {
    question: "Can I change the UPI ID after printing?",
    answer:
      "Not on a static print. Reprint, or use a dynamic QR whose destination you can edit without changing the sticker. Always test-scan after a VPA change.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#page`,
      name: "Printable UPI QR templates",
      description,
      url: pageUrl,
      inLanguage: "en-IN",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: `https://www.proupiqr.in${overview.src}`,
        width: overview.width,
        height: overview.height,
        caption: overview.caption,
      },
      hasPart: PRINT_TEMPLATES.map((item) => {
        const image = siteImage(item.imageId);
        return {
          "@type": "ImageObject",
          name: item.name,
          caption: image.caption,
          contentUrl: `https://www.proupiqr.in${image.src}`,
          width: image.width,
          height: image.height,
          encodingFormat: image.mime,
        };
      }),
    },
    {
      "@type": "ItemList",
      name: "Printable UPI QR formats",
      numberOfItems: PRINT_TEMPLATES.length,
      itemListElement: PRINT_TEMPLATES.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        url: `${pageUrl}#${item.id}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "Print UPI QR", item: "https://www.proupiqr.in/print-upi-qr/" },
        { "@type": "ListItem", position: 3, name: "Printable templates", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema} image={og.src}>
  <main class="mx-auto max-w-6xl px-4 py-12 md:px-6 lg:px-8">
    <article class="rounded-[2rem] border border-white/75 bg-white/86 p-6 shadow-[0_18px_48px_rgba(17,59,44,0.08)] md:p-10">
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
        <a href="/" class="hover:text-leaf">Home</a>
        <span>/</span>
        <a href="/print-upi-qr/" class="hover:text-leaf">Print UPI QR</a>
        <span>/</span>
        <span class="text-forest">Templates</span>
      </nav>
      <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">
        Print gallery
      </p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-forest md:text-5xl">
        Printable UPI QR templates
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-7 text-forest/75">
        A4, A5, 5×7, table tents, counter cards, and sticker sheets all encode the same
        <code class="rounded bg-mint px-1.5 py-0.5 text-sm">upi://pay</code> payload.
        Pick the physical size for the scan distance, download PNG or PDF from the generator, and print at 300 DPI on matte stock.
      </p>
      <p class="mt-2 text-xs text-forest/50">Last updated 28 August 2026 · sizes from the print guide, not an NPCI mandate</p>

      <ResponsiveImage src={overview.src} loading="eager" />

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {PRINT_TEMPLATES.map((item) => {
          const image = siteImage(item.imageId);
          return (
            <article id={item.id} class="scroll-mt-28 rounded-[1.5rem] border border-forest/10 bg-[#fffdf6] p-4">
              <ResponsiveImage src={image.src} loading="lazy" class="h-auto w-full rounded-2xl border border-forest/10 object-cover" />
              <h2 class="mt-4 text-2xl font-black text-forest">{item.name}</h2>
              <p class="mt-1 text-sm font-semibold text-forest/70">
                {item.size} · {item.qr} · {item.dpi}
              </p>
              <p class="mt-2 text-sm leading-6 text-forest/75">{item.bestFor}</p>
              <a href={item.href} class="mt-4 inline-flex text-sm font-bold text-leaf hover:underline">
                {item.cta} →
              </a>
            </article>
          );
        })}
      </div>

      <h2 class="mt-12 text-2xl font-black text-forest">Size chart and sticker layouts</h2>
      <p class="mt-3 text-sm leading-7 text-forest/75">
        Rule of thumb: scan distance ÷ 10 ≈ minimum QR width in inches. A 5-foot counter needs about a 2-inch (5 cm) QR.
        Full write-up: <a class="font-semibold text-leaf hover:underline" href="/blog/upi-qr-code-size-dimensions-printing-guide/">print size guide</a>.
      </p>
      <ResponsiveImage src={sizeChart.src} />
      <ResponsiveImage src={stickers.src} />

      <div class="mt-8 rounded-2xl border border-forest/10 bg-mint/40 p-5 text-sm leading-7 text-forest/80">
        <p>
          Need waterproof stock, an acrylic T-stand, or a reprint after a VPA change?
          See <a class="font-semibold text-leaf hover:underline" href="/products/">hardware buying guides</a>,
          {" "}<a class="font-semibold text-leaf hover:underline" href="/blog/how-to-print-durable-waterproof-qr-stickers/">waterproof stickers</a>
          {" "}and <a class="font-semibold text-leaf hover:underline" href="/blog/how-to-change-upi-id-on-printed-qr-standee/">changing a printed UPI ID</a>.
        </p>
      </div>

      <section class="mt-12">
        <h2 class="text-2xl font-black text-forest">FAQ</h2>
        <dl class="mt-6 space-y-5">
          {faqs.map((faq) => (
            <div class="rounded-2xl border border-forest/10 bg-[#fffdf6] p-5">
              <dt class="font-black text-forest">{faq.question}</dt>
              <dd class="mt-2 text-sm leading-7 text-forest/75">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    </article>
  </main>
</BaseLayout>
