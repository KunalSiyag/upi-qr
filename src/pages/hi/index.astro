---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GeneratorForm } from "../../components/GeneratorForm";
import TemplateThumb from "../../components/TemplateThumb.astro";
import SponsorSlot from "../../components/SponsorSlot.astro";
import SponsorStrip from "../../components/SponsorStrip.astro";

const title = "मुफ्त UPI QR कोड जनरेटर — यूनिवर्सल QR";
const description =
  "दुकान या बैंक खाते के लिए मुफ्त यूनिवर्सल UPI QR कोड जनरेटर। PhonePe, Google Pay, Paytm और BHIM पर चलता है। बिना साइनअप।";

const faqs = [
  {
    question: "UPI QR कोड कैसे जनरेट करें?",
    answer:
      "UPI QR कोड जनरेट करने के लिए, बस हमारे मुफ्त UPI QR कोड जनरेटर में अपना प्राप्तकर्ता का नाम और UPI आईडी दर्ज करें। आप भुगतान QR को तुरंत उच्च-रिज़ॉल्यूशन छवि के रूप में डाउनलोड कर सकते हैं।"
  },
  {
    question: "क्या यह एक यूनिवर्सल UPI QR कोड जनरेटर है?",
    answer:
      "हां, यह एक यूनिवर्सल UPI QR कोड जनरेटर है। बनाए गए QR कोड PhonePe, Google Pay (GPay), Paytm, BHIM और सभी प्रमुख बैंकिंग ऐप्स सहित सभी प्रमुख भुगतान ऐप्स पर काम करेंगे।"
  },
  {
    question: "राशि के साथ UPI QR कोड कैसे बनाएं?",
    answer:
      "आप हमारे टूल का उपयोग करके आसानी से राशि के साथ UPI QR कोड बना सकते हैं। बस 'राशि' फ़ील्ड में अपनी निश्चित राशि दर्ज करें, और जनरेट किया गया UPI QR कोड स्वचालित रूप से ग्राहक से उस सटीक भुगतान का अनुरोध करेगा।"
  },
  {
    question: "UPI QR कोड क्या है?",
    answer:
      "एक UPI QR कोड एक स्कैन करने योग्य बारकोड है जिसमें आपकी वर्चुअल भुगतान पता (VPA) और बैंकिंग विवरण सुरक्षित रूप से शामिल होते हैं। जब किसी भी UPI भुगतान ऐप द्वारा स्कैन किया जाता है, तो यह ग्राहक को सीधे आपके बैंक खाते में पैसे स्थानांतरित करने की अनुमति देता है।"
  },
  {
    question: "दुकान के लिए UPI QR कोड कैसे प्राप्त करें?",
    answer:
      "अपनी दुकान के लिए UPI QR कोड प्राप्त करने के लिए, हमारे जनरेटर में अपना मर्चेंट UPI आईडी दर्ज करें। एक पेशेवर पोस्टर टेम्पलेट चुनें, जनरेट पर क्लिक करें, और अपने बिलिंग काउंटर के लिए परिणामी स्टैंडी प्रिंट करें।"
  },
  {
    question: "QR कोड से UPI आईडी कैसे प्राप्त करें?",
    answer:
      "किसी मौजूदा QR कोड से UPI आईडी प्राप्त करने के लिए, बस अपने फोन पर किसी भी मानक QR कोड रीडर ऐप का उपयोग करके इसे स्कैन करें। परिणामी पाठ एक 'upi://pay' लिंक होगा। आपकी UPI आईडी उस लिंक में 'pa=' के ठीक बाद वाला हिस्सा है।"
  },
  {
    question: "दुकान के लिए PhonePe QR स्टीकर कैसे बनाएं?",
    answer:
      "आधिकारिक PhonePe किट ऑर्डर करने की ज़रूरत नहीं। PhonePe QR स्टीकर जनरेटर में UPI आईडी डालें, A4 पर 4, 6 या 12 स्टीकर चुनें और प्रिंट करें। यह सामान्य upi://pay कोड है, इसलिए Google Pay, Paytm और BHIM भी स्कैन करेंगे।"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Pro UPI QR",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/hi/",
      description,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "INR"
      }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer
        }
      }))
    }
  ]
};

const useCases = [
  "दुकानें और किराना स्टोर",
  "फ्रीलांसर और सलाहकार",
  "रेस्तरां और कैफे",
  "मंदिर दान काउंटर",
  "स्कूल और ट्यूशन फीस",
  "इवेंट और पंजीकरण"
];

const features = [
  {
    title: "तुरंत ब्राउज़र जनरेशन",
    copy: "बिना लॉगिन, साइनअप या किसी डैशबोर्ड की प्रतीक्षा किए सीधे अपने ब्राउज़र में QR बनाएं।"
  },
  {
    title: "भुगतान-तैयार UPI प्रारूप",
    copy: "प्राप्तकर्ता का नाम, UPI आईडी, निश्चित राशि और नोट जोड़ें ताकि स्कैनर सही भुगतान ऐप पर पहुंचे।"
  },
  {
    title: "पोस्टर-फर्स्ट डिज़ाइन",
    copy: "आज ही एक QR से शुरुआत करें, फिर इसे स्टैंडी, दान पोस्टर, टेबल कार्ड और फीस संग्रह सामग्री में बदलें।"
  }
];

const templates = [
  {
    name: "दुकान भुगतान स्टैंडी",
    image: "/images/template/abc-shop-standee.png",
    value: "खुदरा स्टोर, किराना काउंटर और स्थानीय दुकानों के लिए काउंटर-रेडी डिस्प्ले।",
    bestFor: "सर्वोत्तम: खुदरा कैशियर काउंटर, किराना दुकान और फार्मेसियों के लिए।",
    status: "अभी उपलब्ध है"
  },
  {
    name: "मंदिर दान पोस्टर",
    image: "/images/template/abc-temple-donation.png",
    value: "विश्वास और पारदर्शिता के लिए बड़े फोंट और दान-प्रथम संदेशों के साथ भक्तिमय लेआउट।",
    bestFor: "सर्वोत्तम: सामुदायिक दान बक्से, धार्मिक केंद्र और धर्मार्थ डेस्क के लिए।",
    status: "अभी उपलब्ध है"
  },
  {
    name: "रेस्तरां टेबल QR",
    image: "/images/template/abc-restaurant-table.png",
    value: "टेबल नंबर और डायरेक्ट डाइन-इन स्कैन-टू-पे निर्देशों को प्रदर्शित करने वाला कॉम्पैक्ट डिज़ाइन।",
    bestFor: "सर्वोत्तम: डाइन-इन टेबल, कैफे काउंटर और फूड ट्रक डिस्प्ले के लिए।",
    status: "अभी उपलब्ध है"
  },
  {
    name: "फ्रीलांसर भुगतान कार्ड",
    image: "/images/template/abc-freelancer-card.png",
    value: "क्लाइंट बिलिंग, बार-बार दी जाने वाली सेवाओं और त्वरित चालान लिंक के लिए आधुनिक कार्ड लेआउट।",
    bestFor: "सर्वोत्तम: इनवॉइस, डिजिटल रिज्यूमे, पोर्टफोलियो साइट और व्हाट्सएप शेयरिंग के लिए।",
    status: "अभी उपलब्ध है"
  },
  {
    name: "इवेंट पास टिकट",
    image: "/images/template/abc-event-ticket.png",
    value: "इवेंट की तारीख, स्थान विवरण और स्कैन-टू-रजिस्टर फ्लो की विशेषता वाला जीवंत टिकट डिज़ाइन।",
    bestFor: "सर्वोत्तम: टिकटिंग बूथ, कार्यशालाओं, पंजीकरणों और सेमिनार पास के लिए।",
    status: "अभी उपलब्ध है"
  },
  {
    name: "ट्यूशन फीस कार्ड",
    image: "/images/template/abc-custom-minimal.png",
    value: "क्लासरूम डिस्प्ले, बैच और कोचिंग फीस संग्रह के लिए डिज़ाइन किया गया स्कूल नोटबुक प्रेरित थीम।",
    bestFor: "सर्वोत्तम: स्कूलों, कोचिंग बैचों, क्लास नोटिस बोर्ड और ट्यूटर्स के लिए।",
    status: "अभी उपलब्ध है"
  },
  {
    name: "कैब / टैक्सी डैशबोर्ड कार्ड",
    image: "/images/template/abc-taxi-cab.png",
    value: "बड़े पठनीय टैक्सी/कैब क्रेडेंशियल के साथ उच्च-कंट्रास्ट ड्राइवर-अनुकूल डैशबोर्ड कार्ड।",
    bestFor: "सर्वोत्तम: कैब डैशबोर्ड, ऑटो-रिक्शा स्क्रीन और डिलीवरी राइडर्स के लिए।",
    status: "अभी उपलब्ध है"
  },
  {
    name: "कस्टम मिनिमलिस्ट कार्ड",
    image: "/images/template/abc-custom-minimal.png",
    value: "सीधे फंड ट्रांसफर और औपचारिक व्यावसायिक आवश्यकताओं के लिए साफ, पेशेवर कार्यकारी कार्ड संरचना।",
    bestFor: "सर्वोत्तम: कॉर्पोरेट चालान, बिजनेस कार्ड और प्रत्यक्ष फंड ट्रांसफर के लिए।",
    status: "अभी उपलब्ध है"
  }
];

const landingLinks = [
  { href: "/hi/phonepe-qr-generator/", label: "PhonePe QR जनरेटर" },
  { href: "/hi/google-pay-qr-generator/", label: "Google Pay QR जनरेटर" },
  { href: "/hi/paytm-qr-generator/", label: "Paytm QR जनरेटर" },
  { href: "/hi/bhim-qr-generator/", label: "BHIM QR जनरेटर" },
  { href: "/hi/whatsapp-pay-qr-generator/", label: "WhatsApp Pay QR जनरेटर" },
  { href: "/hi/amazon-pay-qr-generator/", label: "Amazon Pay QR जनरेटर" },
  { href: "/hi/sbi-qr-generator/", label: "SBI QR जनरेटर" },
  { href: "/hi/hdfc-qr-generator/", label: "HDFC QR जनरेटर" },
  { href: "/hi/icici-qr-generator/", label: "ICICI QR जनरेटर" },
  { href: "/hi/donation-qr-generator/", label: "Donation QR जनरेटर" },
  { href: "/universal-qr-generator/", label: "Universal QR जनरेटर" }
];
/** Quick presets under the generator: app and bank pages people search for, plus stickers. */
const presets = [
  { href: "/hi/phonepe-qr-generator/", label: "PhonePe QR", icon: "/phonepe.png" },
  { href: "/hi/qr-sticker-generator/?app=phonepe#tool", label: "PhonePe स्टीकर", icon: "/phonepe.png" },
  { href: "/hi/google-pay-qr-generator/", label: "Google Pay QR", icon: "/googlepay.png" },
  { href: "/hi/qr-sticker-generator/?app=gpay#tool", label: "GPay स्टीकर", icon: "/googlepay.png" },
  { href: "/hi/paytm-qr-generator/", label: "Paytm QR", icon: "/paytm.ico" },
  { href: "/hi/bhim-qr-generator/", label: "BHIM QR", icon: "/bhim.ico" },
  { href: "/hi/whatsapp-pay-qr-generator/", label: "WhatsApp QR", icon: "/whatsapp.png" },
  { href: "/hi/amazon-pay-qr-generator/", label: "Amazon Pay QR", icon: "/amazonpay.png" },
  { href: "/hi/sbi-qr-generator/", label: "SBI QR", icon: "/sbi.ico" },
  { href: "/hi/hdfc-qr-generator/", label: "HDFC QR", icon: "/hdfc.ico" },
  { href: "/hi/icici-qr-generator/", label: "ICICI QR", icon: "/icici.ico" },
  { href: "/hi/donation-qr-generator/", label: "दान QR", icon: null },
  { href: "/universal-qr-generator/", label: "Universal QR", icon: null },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  image="/images/og-image.jpg"
>
  <main>
    <section class="px-4 pb-14 pt-8 md:px-6 md:pt-14 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-x-12">
          <div class="max-w-4xl">
            <h1 class="text-[2.75rem] font-black leading-[1.05] tracking-[-0.02em] text-obsidian sm:text-6xl lg:text-7xl">
              मुफ्त UPI QR कोड जनरेटर
            </h1>
            <p class="mt-4 max-w-2xl text-lg leading-8 md:text-xl">
              अपनी UPI आईडी डालें और PhonePe, Google Pay, Paytm व BHIM पर चलने वाला भुगतान QR डाउनलोड करें। साइनअप नहीं। राशि वैकल्पिक। काउंटर स्टैंडी या स्टीकर जब चाहिए तब प्रिंट करें।
            </p>
            <ul class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-[15px] font-medium">
              <li class="flex items-center gap-2"><svg class="h-[18px] w-[18px] text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" /></svg>मुफ्त · बिना साइनअप</li>
              <li class="flex items-center gap-2"><svg class="h-[18px] w-[18px] text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" /></svg>QR आपके ब्राउज़र में बनता है</li>
              <li class="flex items-center gap-2"><svg class="h-[18px] w-[18px] text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" /></svg>हर UPI ऐप पर स्कैन</li>
              <li><a href="/reviews/" class="font-semibold text-forest underline underline-offset-4 hover:text-leaf">समीक्षाएं पढ़ें</a></li>
            </ul>
          </div>

          <SponsorSlot lang="hi" class="order-3 mt-8 lg:order-none lg:mt-1" />

          <div id="generator" class="mt-8 scroll-mt-20 lg:col-span-2">
            <GeneratorForm client:load lang="hi" />
          </div>

          <SponsorStrip lang="hi" class="order-4 mt-8 lg:order-none lg:col-span-2" />
        </div>

        <div class="mt-12 grid gap-10 border-t border-forest/10 pt-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-obsidian sm:text-3xl">
              30 सेकंड से कम समय में राशि के साथ UPI QR कोड जनरेट करें।
            </h2>
            <p class="mt-3 text-base leading-7">
              PhonePe, Google Pay, Paytm, BHIM और अन्य UPI ऐप्स के लिए काम करता है जो मानक{" "}
              <code class="font-mono text-sm">upi://pay</code> लिंक्स का समर्थन करते हैं।
            </p>
            <p class="mt-4 flex items-start gap-2 text-[15px] leading-6">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              <span>100% गोपनीयता: आपके ब्राउज़र में स्थानीय रूप से जनरेट। हम कभी भी आपके भुगतान विवरण एकत्र या संग्रहीत नहीं करते हैं।</span>
            </p>
            <p class="mt-3 text-[15px] leading-6">
              Product Hunt पर सार्वजनिक रेटिंग दें, या{" "}<a href="/reviews/" class="font-semibold text-forest underline underline-offset-4 hover:text-leaf">समीक्षा पृष्ठ</a>{" "}पर दुकान का अनुभव भेजें। हम नकली स्टार स्कोर नहीं दिखाते।
            </p>
            <p class="mt-6 text-sm leading-6 text-muted">इनके लिए बना: {useCases.join(" · ")}।</p>
          </div>
          <div>
            <p class="text-sm font-bold text-muted">क्विक प्रीसेट जनरेटर्स</p>
            <ul class="mt-2 grid grid-cols-2 gap-x-6">
              {presets.map((preset) => (
                <li>
                  <a href={preset.href} class="flex min-h-12 items-center gap-3 border-b border-forest/10 py-2.5 text-[15px] font-semibold text-forest hover:text-leaf">
                    {preset.icon ? (
                      <img src={preset.icon} alt="" width="24" height="24" loading="lazy" class="h-6 w-6 rounded-full bg-white object-contain ring-1 ring-forest/10" />
                    ) : (
                      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-mint" aria-hidden="true"><span class="h-2 w-2 rounded-full bg-leaf"></span></span>
                    )}
                    {preset.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 md:px-6 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 border-t border-forest/10 pt-12 md:grid-cols-3">
        {features.map((feature) => (
          <div>
            <h3 class="text-xl font-bold text-obsidian">{feature.title}</h3>
            <p class="mt-2 text-base leading-7">{feature.copy}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="templates" class="scroll-mt-20 px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-black tracking-tight text-obsidian md:text-5xl">
            आठ तैयार पेमेंट पोस्टर टेम्पलेट्स के साथ शुरुआत करें।
          </h2>
          <p class="mt-4 text-lg leading-8">
            एक बार जनरेट करें, तुरंत शैलियों को बदलें, और अपने काउंटर, टेबल, दान डेस्क या क्लाइंट शेयर फ्लो के लिए एक प्रिंट करने योग्य भुगतान छवि डाउनलोड करें।
          </p>
          <p class="mt-3 text-base leading-7">
            चेकआउट काउंटर पर प्रिंट, फ्रेम और उच्च-रिज़ॉल्यूशन वाले भुगतान स्टैंडी रखें। आपके ग्राहकों के साथ तत्काल विश्वास बनाने के लिए साफ और पेशेवर दिखने के लिए डिज़ाइन किया गया।
          </p>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-x-5 gap-y-8 md:grid-cols-4">
          {templates.map((template) => (
            <li>
              <div class="overflow-hidden rounded-[10px] bg-fog">
                <TemplateThumb
                  src={template.image}
                  alt={template.name}
                  width={340}
                  height={255}
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover object-top"
                />
              </div>
              <h3 class="mt-3 text-base font-bold text-obsidian">{template.name}</h3>
              <p class="mt-1 text-sm leading-6">{template.value}</p>
              <p class="mt-1 text-xs leading-5 text-muted">{template.bestFor}</p>
            </li>
          ))}
        </ul>
        <a href="#generator" class="mt-8 inline-block text-[15px] font-semibold text-forest underline underline-offset-4 hover:text-leaf">जनरेटर में अपना पोस्टर बनाएं &uarr;</a>
      </div>
    </section>

    <section class="bg-forest px-4 py-16 text-[#c8dccf] md:px-6 lg:px-8">
      <div class="mx-auto flex max-w-7xl flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-black tracking-tight text-mint md:text-5xl">
            विशिष्ट पेमेंट ऐप्स के लिए अनुकूलित जनरेटर
          </h2>
          <p class="mt-4 text-lg leading-8">
            यदि आप विशेष रूप से PhonePe, Google Pay, या Paytm के लिए QR कोड पोस्टर डिज़ाइन करना चाहते हैं, तो हमारे विशेष रूप से तैयार जनरेटर का उपयोग करें।
          </p>
        </div>
        <ul class="grid grid-cols-1 gap-x-8 gap-y-3 text-[15px] font-semibold text-white sm:grid-cols-2 lg:min-w-[30rem]">
          {landingLinks.map((link) => (
            <li><a href={link.href} class="hover:underline">{link.label} &rarr;</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="scroll-mt-20 px-4 py-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-leaf">अक्सर पूछे जाने वाले प्रश्न (FAQ)</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-obsidian md:text-5xl">
          भुगतान QR पर भरोसा करने से पहले लोग अक्सर जो प्रश्न पूछते हैं।
        </h2>
        <div class="mt-8 grid gap-3">
          {faqs.map((faq) => (
            <details class="group rounded-[10px] bg-fog px-5 py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-bold text-obsidian">
                <span>{faq.question}</span>
                <span class="mt-0.5 text-2xl leading-none text-forest transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 max-w-3xl text-base leading-7">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
