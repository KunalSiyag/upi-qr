---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const posts = (await getCollection("blogHi")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = "बिज़नेस गाइड्स हिंदी में — UPI, बिलिंग, टैक्स | Pro UPI QR";
const description = "हिंदी में पढ़ें UPI QR, बिलिंग, किराया रसीद, HRA, GST और payment collection की आसान गाइड्स। मुफ्त टूल्स के साथ सीधे apply करें।";
const hiUrl = new URL("/hi/blog/", Astro.site).toString();
const enUrl = new URL("/blog/", Astro.site).toString();

const alternates = [
  { lang: "hi", url: hiUrl },
  { lang: "en", url: enUrl },
  { lang: "x-default", url: enUrl }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      name: "Pro UPI QR बिज़नेस गाइड्स (हिंदी)",
      url: hiUrl,
      inLanguage: "hi-IN",
      description
    }
  ]
};

const formatDate = (d: Date) => new Intl.DateTimeFormat("hi-IN", { day: "numeric", month: "long", year: "numeric" }).format(d);
---

<BaseLayout title={title} description={description} canonical={hiUrl} alternates={alternates} schema={schema}>
  <main class="px-4 py-12 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
        <a href="/hi/" class="hover:text-leaf transition-colors">होम</a>
        <span>/</span>
        <span class="text-forest font-bold" aria-current="page">ब्लॉग</span>
      </nav>

      <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">हिंदी गाइड्स</p>
      <h1 class="mt-4 text-3xl font-black leading-tight tracking-tight text-forest md:text-5xl">बिज़नेस और payments गाइड्स — हिंदी में</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-forest/75">UPI QR से लेकर invoice, किराया रसीद, HRA और payment recovery तक — वो सब गाइड्स जो आपके business का पैसा और paperwork, दोनों संभालते हैं। English में <a href="/blog/" class="font-bold text-leaf hover:underline">और भी guides</a> उपलब्ध हैं।</p>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {posts.map((post) => (
          <a href={`/hi/blog/${post.id.replace(/\.mdx?$/, "")}/`} class="group flex flex-col rounded-[1.5rem] border border-white/75 bg-white/88 p-6 shadow-[0_10px_30px_rgba(17,59,44,0.06)] transition hover:border-leaf/40 hover:-translate-y-0.5 hover:shadow-[0_18px_44px_rgba(17,59,44,0.12)]">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="rounded-full bg-mint px-2.5 py-1 text-[10px] font-bold text-forest/70">{tag}</span>
              ))}
            </div>
            <h2 class="mt-3 text-lg font-black leading-snug text-forest group-hover:text-leaf transition-colors">{post.data.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-forest/70">{post.data.description}</p>
            <span class="mt-3 text-[11px] font-semibold text-forest/50"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></span>
          </a>
        ))}
      </div>

      <section class="mt-12 rounded-[2rem] border border-white/75 bg-white/86 p-6 text-sm leading-7 text-forest/72">
        बाकी guides (अंग्रेज़ी में) <a href="/blog/" class="font-bold text-leaf hover:underline">यहाँ पढ़ें →</a>। हर guide के साथ एक मुफ्त browser tool मिलता है — <a href="/tools/" class="font-bold text-leaf hover:underline">सभी tools यहाँ</a>।
      </section>
    </div>
  </main>
</BaseLayout>
