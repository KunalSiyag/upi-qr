---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CashMemoGenerator } from "../components/CashMemoGenerator";

const title = "Cash Memo Generator - Free Retail Billing Slips | Pro UPI QR";
const description = "Create retail cash memo billing slips for kirana shops, restaurants, and small stores. Simple print-friendly format. Browser-only, PDF export.";

const faqs = [
  { question: "What is a cash memo?", answer: "A cash memo is a simplified retail billing slip used by small shops, kiranas, restaurants, and service counters. It records what was sold, the total amount, and the date — similar to a thermal-printed till receipt. Unlike a tax invoice, it does not show GSTINs, HSN codes, or tax breakdowns. It is used for small-value retail sales where detailed GST invoicing is not required or when the buyer does not need an input credit." },
  { question: "Is a cash memo valid for GST?", answer: "For B2C retail sales below ₹200 and for shops not registered under GST, cash memos are acceptable. GST-registered businesses selling to other GST-registered entities should issue a proper tax invoice. For most kirana and retail shops selling to walk-in customers, a cash memo is the practical everyday document." },
  { question: "Can I print this as a thermal roll receipt?", answer: "Download as PDF and print to any thermal or inkjet printer. For thermal roll printers (80mm), use your printer's receipt mode or reduce the PDF page size. The layout is simple enough to work on most receipt printers." },
  { question: "Is my data uploaded to a server?", answer: "No. All data stays in localStorage on your browser. Nothing is uploaded." }
];

const schema = { "@context": "https://schema.org", "@graph": [{ "@type": "WebApplication", name: "Cash Memo Generator by Pro UPI QR", applicationCategory: "BusinessApplication", operatingSystem: "Any", url: "https://www.proupiqr.in/cash-memo-generator/", description, featureList: ["Retail cash memo billing slips", "Counter and staff tracking", "Simple item list with quantity and rate", "Thermal-friendly layout"], offers: { "@type": "Offer", price: "0", priceCurrency: "INR" } }, { "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })) }, { "@type": "HowTo", name: "How to create a cash memo", step: [{ "@type": "HowToStep", name: "Enter your shop name and address" }, { "@type": "HowToStep", name: "Add items sold with quantity and rate" }, { "@type": "HowToStep", name: "Enter customer name (optional) and counter" }, { "@type": "HowToStep", name: "Download as PDF or print" }] }] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60"><a href="/" class="hover:text-leaf transition-colors">Home</a><span>/</span><a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a><span>/</span><span class="text-forest font-bold" aria-current="page">Cash Memo</span></nav>
        <div class="max-w-4xl"><p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Merchant documents</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Cash memo generator for retail shops</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Generate simple cash memo billing slips for your kirana, restaurant, salon, or service counter. Free, private, exports as PDF — print on any receipt or A4 printer.</p>
          <div class="mt-7 flex flex-wrap gap-3"><a href="#cm-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Create cash memo</a><a href="/invoice-generator/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Need GST invoice? →</a></div>
        </div>
      </div>
    </section>
    <section id="cm-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><CashMemoGenerator client:visible /></div></section>
    <section class="px-4 py-14 md:px-6 lg:px-8"><div class="mx-auto max-w-5xl"><p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p><h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Cash memo questions</h2><div class="mt-8 grid gap-4">{faqs.map((faq) => (<details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5"><summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary><p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p></details>))}</div></div></section>
    <section class="px-4 pb-16 md:px-6 lg:px-8"><div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10"><h2 class="text-2xl font-black tracking-tight md:text-3xl">Run your shop counter with paper and digital.</h2><p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/72">Cash memos for the counter, invoices for B2B, and UPI QR standees for payment.</p><div class="mt-6 flex flex-wrap justify-center gap-3"><a href="/invoice-generator/" class="rounded-full bg-sun px-5 py-2.5 text-sm font-black text-forest hover:bg-white transition">Invoice PDF →</a><a href="/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">UPI QR generator</a></div></div></section>
  </main>
</BaseLayout>