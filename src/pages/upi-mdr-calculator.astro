---
import BaseLayout from "../layouts/BaseLayout.astro";
import { UpiMdrCalculator } from "../components/UpiMdrCalculator";
import InternalLinkHub from "../components/InternalLinkHub.astro";

const title = "UPI MDR Calculator — 0.4% Fee from 15 Oct 2026";
const description = "See if the 0.4% UPI MDR from 15 October 2026 hits your shop. Payments to ₹2,000 stay free. Small QR merchants under ₹1 lakh/month stay free. GST on MDR and ITC included.";

const faqs = [
  {
    question: "Is the new UPI charge a tax?",
    answer: "No. The Finance Ministry said MDR is neither a tax nor a charge collected by the government or NPCI. From 15 October 2026 it is a merchant discount rate paid to banks and app providers on some person-to-merchant UPI payments above ₹2,000. 18% GST may apply on that MDR; registered merchants can usually claim ITC."
  },
  {
    question: "Who still pays nothing?",
    answer: "Person-to-person transfers stay free at any amount. Merchant payments of ₹2,000 or less stay free. Small merchants collecting up to ₹1 lakh a month on UPI QR (P2PM) stay on zero MDR. The government says about 96% of P2M transactions remain unaffected."
  },
  {
    question: "Can I add 0.4% on the customer's bill?",
    answer: "No. Banks have been told not to let merchants pass MDR to customers, and UPI apps cannot add a platform fee. Price your goods as you like; do not show a UPI surcharge on the bill."
  },
  {
    question: "How is this different from a payment gateway?",
    answer: "A typical gateway still takes about 2% + 18% GST (2.36%) on cards. UPI MDR is 0.4% and only on P2M above ₹2,000, capped at ₹300. Direct UPI remains far cheaper. Compare both in this calculator."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "UPI MDR Calculator by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/upi-mdr-calculator/",
      description,
      featureList: [
        "0.4% P2M MDR with ₹300 cap",
        "₹2,000 threshold and small-merchant exemption",
        "Essential-sector flat ₹5 and capital-markets 0.02%",
        "GST on MDR with optional ITC",
        "Monthly estimate vs payment-gateway MDR"
      ],
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to estimate UPI MDR from 15 October 2026",
      step: [
        { "@type": "HowToStep", name: "Type the bill amount — or monthly UPI plus a typical bill" },
        { "@type": "HowToStep", name: "Pick shop, fuel/rail/utilities, mutual funds, or paying a person" },
        { "@type": "HowToStep", name: "Tick small QR merchant only if the bank tagged this VPA as P2PM under ₹1 lakh/month" },
        { "@type": "HowToStep", name: "Read MDR (matches the official examples), GST, and the gateway comparison" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">UPI MDR Calculator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">From 15 Oct 2026 · not a tax</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">UPI MDR calculator for merchant payments</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">
            Type a bill. ₹3,000 is ₹12. ₹2,000 is ₹0. Customer pays nothing. Monthly view uses your typical bill — not a “share of value” guess.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#mdr-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Estimate my MDR</a>
            <a href="/blog/upi-mdr-charges-october-2026/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Read the explainer →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="mdr-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <UpiMdrCalculator client:visible />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">UPI MDR questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <InternalLinkHub currentPath="/upi-mdr-calculator/" />
      </div>
    </section>
  </main>
</BaseLayout>
