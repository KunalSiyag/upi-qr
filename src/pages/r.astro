---
import BaseLayout from "../layouts/BaseLayout.astro";

const requestedUrl = Astro.url.searchParams.get("url") || Astro.url.searchParams.get("u") || "/";
const initialUrl = /^(https?:\/\/|upi:\/\/)/i.test(requestedUrl) ? requestedUrl : "/";
const qrId = Astro.url.searchParams.get("id") || "";
---

<BaseLayout title="Redirecting..." description="Dynamic QR Link Redirect Manager" noindex={true}>
  <div class="min-h-[65vh] flex items-center justify-center p-6 text-center">
    <div class="max-w-md w-full rounded-3xl border border-forest/10 bg-white p-8 shadow-xl space-y-5">
      <div class="mx-auto w-16 h-16 rounded-2xl bg-mint border border-leaf/20 flex items-center justify-center text-leaf font-black animate-pulse shadow-sm">
        <svg class="h-8 w-8 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </div>
      <div>
        <h1 class="text-xl font-black text-forest">Connecting to Destination</h1>
        <p class="text-xs text-forest/60 mt-1">Dynamic QR Router • Secure Cloud Sync</p>
      </div>

      <div id="target-display" class="text-xs font-mono text-forest/80 break-all bg-cream p-3.5 rounded-2xl border border-forest/10 shadow-inner">
        {initialUrl}
      </div>

      <a id="direct-link" href={initialUrl} class="inline-flex items-center justify-center w-full rounded-2xl bg-forest px-6 py-3 text-xs font-black text-mint hover:bg-leaf transition-all shadow-md">
        Click here if not redirected automatically →
      </a>
    </div>
  </div>

  <script is:inline>
    (function() {
      var KVDB_BASE = 'https://kvdb.io/UTBhVqvgHGvEDSqYe3s8Th';
      var REGISTRY_KEY = 'pro_upi_cloud_synced_ids';
      var params = new URLSearchParams(window.location.search);
      var id = params.get('id');
      var target = params.get('url') || params.get('u') || '/';

      function isSafeDestination(value) {
        return /^(https?:\/\/|upi:\/\/)/i.test(value || '');
      }

      function isCloudSynced(qrId) {
        try {
          var raw = localStorage.getItem(REGISTRY_KEY);
          return raw ? JSON.parse(raw).indexOf(qrId) !== -1 : false;
        } catch (e) { return false; }
      }

      if (!isSafeDestination(target)) target = '/';

      var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      var deviceType = isMobile ? 'mobile' : 'desktop';

      async function processRedirect() {
        if (id && isCloudSynced(id)) {
          // Only fetch from cloud if this ID was previously confirmed synced.
          // This prevents browser-level 404 console errors entirely.
          try {
            var kvRes = await fetch(KVDB_BASE + '/' + encodeURIComponent(id));
            if (kvRes.status === 200) {
              var kvText = await kvRes.text();
              if (kvText && kvText.trim().startsWith('{')) {
                var meta = JSON.parse(kvText.trim());

                if (isSafeDestination(meta.destinationUrl)) target = meta.destinationUrl;

                meta.scans = (meta.scans || 0) + 1;
                meta.mobileScans = (meta.mobileScans || 0) + (isMobile ? 1 : 0);
                meta.desktopScans = (meta.desktopScans || 0) + (isMobile ? 0 : 1);
                meta.lastScanned = new Date().toISOString();

                fetch(KVDB_BASE + '/' + encodeURIComponent(id), {
                  method: 'PUT',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(meta)
                }).catch(function() {});

                if (meta.whatsappPhone && meta.whatsappApiKey) {
                  var alertMsg = encodeURIComponent('\u26A1 Pro UPI QR Alert: Your QR Code "' + (meta.title || id) + '" was just scanned via ' + deviceType.toUpperCase() + '!');
                  fetch('https://api.callmebot.com/whatsapp.php?phone=' + meta.whatsappPhone + '&text=' + alertMsg + '&apikey=' + meta.whatsappApiKey, { mode: 'no-cors' }).catch(function() {});
                }
              }
            }
          } catch (e) {
            // Network failure — silently use the fallback URL from the query string
          }
        }

        // Update local storage scan counts (works regardless of cloud sync)
        if (id) {
          try {
            var saved = localStorage.getItem('pro_upi_dynamic_links');
            if (saved) {
              var links = JSON.parse(saved);
              var now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
              var dateStr = new Date().toLocaleDateString();
              var updated = links.map(function(l) {
                if (l.id === id) {
                  var currentScans = (l.scans || 0) + 1;
                  var deviceStats = l.scansByDevice || { mobile: 0, desktop: 0 };
                  if (isMobile) deviceStats.mobile = (deviceStats.mobile || 0) + 1;
                  else deviceStats.desktop = (deviceStats.desktop || 0) + 1;

                  var recentScans = l.recentScans || [];
                  recentScans.unshift({ id: 's-' + Date.now(), timestamp: dateStr + ' at ' + now, device: deviceType, status: 'Success' });
                  if (recentScans.length > 20) recentScans.pop();

                  return Object.assign({}, l, {
                    scans: currentScans,
                    lastScanned: dateStr + ' at ' + now,
                    scansByDevice: deviceStats,
                    recentScans: recentScans
                  });
                }
                return l;
              });
              localStorage.setItem('pro_upi_dynamic_links', JSON.stringify(updated));
            }
          } catch (e) {}
        }

        // Perform instant redirection
        if (target) {
          var displayEl = document.getElementById('target-display');
          var linkEl = document.getElementById('direct-link');
          if (displayEl) displayEl.textContent = target;
          if (linkEl) linkEl.href = target;

          window.location.replace(target);
        }
      }

      processRedirect();
    })();
  </script>
</BaseLayout>
