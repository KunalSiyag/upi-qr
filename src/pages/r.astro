---
import BaseLayout from "../layouts/BaseLayout.astro";

const initialUrl = Astro.url.searchParams.get("url") || Astro.url.searchParams.get("u") || "/";
const qrId = Astro.url.searchParams.get("id") || "";
---

<BaseLayout title="Redirecting..." description="Dynamic QR Link Redirect Manager" noindex={true}>
  <div class="min-h-[65vh] flex items-center justify-center p-6 text-center">
    <div class="max-w-md w-full rounded-3xl border border-forest/10 bg-white p-8 shadow-xl space-y-5">
      <div class="mx-auto w-16 h-16 rounded-2xl bg-mint border border-leaf/20 flex items-center justify-center text-leaf font-black animate-pulse shadow-sm">
        <svg class="h-8 w-8 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </div>
      <div>
        <h1 class="text-xl font-black text-forest">Connecting to Destination</h1>
        <p class="text-xs text-forest/60 mt-1">Dynamic QR Router • Secure Cloud Sync</p>
      </div>

      <div id="target-display" class="text-xs font-mono text-forest/80 break-all bg-cream p-3.5 rounded-2xl border border-forest/10 shadow-inner">
        {initialUrl}
      </div>

      <a id="direct-link" href={initialUrl} class="inline-flex items-center justify-center w-full rounded-2xl bg-forest px-6 py-3 text-xs font-black text-mint hover:bg-leaf transition-all shadow-md">
        Click here if not redirected automatically →
      </a>
    </div>
  </div>

  <script is:inline>
    (function() {
      const params = new URLSearchParams(window.location.search);
      const id = params.get('id');
      let target = params.get('url') || params.get('u') || '/';

      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      const deviceType = isMobile ? 'mobile' : 'desktop';

      async function processRedirect() {
        if (id) {
          // 1. Primary KVDB Cloud Scan Increment
          try {
            fetch(`https://kvdb.io/8xN4mK7pQ9zX2yW1/cnt_${id}`)
              .then(res => res.text())
              .then(text => {
                const current = parseInt(text) || 0;
                fetch(`https://kvdb.io/8xN4mK7pQ9zX2yW1/cnt_${id}`, {
                  method: 'POST',
                  body: (current + 1).toString()
                }).catch(() => {});
              }).catch(() => {});

            fetch(`https://kvdb.io/8xN4mK7pQ9zX2yW1/cnt_${id}_${deviceType}`)
              .then(res => res.text())
              .then(text => {
                const currentDev = parseInt(text) || 0;
                fetch(`https://kvdb.io/8xN4mK7pQ9zX2yW1/cnt_${id}_${deviceType}`, {
                  method: 'POST',
                  body: (currentDev + 1).toString()
                }).catch(() => {});
              }).catch(() => {});
          } catch (e) {}

          // 2. Backup Counter API
          try {
            fetch(`https://api.counterapi.dev/v1/proupiqr_${id}/up`, { method: 'GET' }).catch(() => {});
            fetch(`https://api.counterapi.dev/v1/proupiqr_${id}_${deviceType}/up`, { method: 'GET' }).catch(() => {});
          } catch (e) {}

          // 3. Fetch latest destination URL and metadata from Cloud KV store
          try {
            const cloudRes = await fetch(`https://kvdb.io/8xN4mK7pQ9zX2yW1/${id}`, { method: 'GET' });
            if (cloudRes.ok) {
              const text = await cloudRes.text();
              if (text && text.trim()) {
                const trimmed = text.trim();
                if (trimmed.startsWith('{')) {
                  const meta = JSON.parse(trimmed);
                  if (meta.destinationUrl) target = meta.destinationUrl;

                  // 4. Trigger Free WhatsApp Alert Webhook if configured
                  if (meta.whatsappPhone && meta.whatsappApiKey) {
                    const alertMsg = encodeURIComponent(`⚡ Pro UPI QR Alert: Your QR Code "${meta.title || id}" was just scanned via ${deviceType.toUpperCase()}!`);
                    fetch(`https://api.callmebot.com/whatsapp.php?phone=${meta.whatsappPhone}&text=${alertMsg}&apikey=${meta.whatsappApiKey}`, { mode: 'no-cors' }).catch(() => {});
                  }
                } else if (trimmed.startsWith('http') || trimmed.startsWith('upi://')) {
                  target = trimmed;
                }
              }
            }
          } catch (e) {
            console.warn("Cloud destination fetch fallback:", e);
          }

          // 5. Update local storage if scanned on dashboard browser
          try {
            const saved = localStorage.getItem('pro_upi_dynamic_links');
            if (saved) {
              const links = JSON.parse(saved);
              const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
              const dateStr = new Date().toLocaleDateString();
              const updated = links.map(l => {
                if (l.id === id) {
                  const currentScans = (l.scans || 0) + 1;
                  const deviceStats = l.scansByDevice || { mobile: 0, desktop: 0 };
                  if (isMobile) deviceStats.mobile = (deviceStats.mobile || 0) + 1;
                  else deviceStats.desktop = (deviceStats.desktop || 0) + 1;

                  const recentScans = l.recentScans || [];
                  recentScans.unshift({ id: 's-' + Date.now(), timestamp: `${dateStr} at ${now}`, device: deviceType, status: 'Success' });
                  if (recentScans.length > 20) recentScans.pop();

                  return {
                    ...l,
                    scans: currentScans,
                    lastScanned: `${dateStr} at ${now}`,
                    scansByDevice: deviceStats,
                    recentScans: recentScans
                  };
                }
                return l;
              });
              localStorage.setItem('pro_upi_dynamic_links', JSON.stringify(updated));
            }
          } catch (e) {}
        }

        // Perform instant redirection
        if (target) {
          const displayEl = document.getElementById('target-display');
          const linkEl = document.getElementById('direct-link');
          if (displayEl) displayEl.textContent = target;
          if (linkEl) linkEl.href = target;

          window.location.replace(target);
        }
      }

      processRedirect();
    })();
  </script>
</BaseLayout>
