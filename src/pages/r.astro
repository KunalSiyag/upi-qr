---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { isExpired, readRecord, recordScan, safeDestination, validId } from "../lib/dynamicQrStore";
import { requestFingerprint } from "../lib/apiSecurity";
import { consumeRateLimit } from "../lib/rateLimit";

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Content-Security-Policy", "base-uri 'none'; frame-ancestors 'none'");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const id = Astro.url.searchParams.get("id");
let message = "This dynamic QR link is invalid or no longer available.";
let status = 404;
let resolvedDestination: string | null = null;
let destinationHost = "";

if (validId(id)) {
  try {
    const resolverLimit = await consumeRateLimit("dynamic-resolve", requestFingerprint(Astro.request), 600, 60);
    if (!resolverLimit.allowed) {
      message = "The redirect service is receiving too many requests. Please try again shortly.";
      status = 429;
    }

    const campaign = status === 429 ? null : await readRecord(id);
    if (campaign?.isPaused) {
      message = "This dynamic QR campaign is paused by its owner.";
      status = 410;
    } else if (campaign && isExpired(campaign)) {
      message = "This dynamic QR campaign has expired.";
      status = 410;
    } else if (campaign) {
      const destinationUrl = safeDestination(campaign.destinationUrl);
      if (destinationUrl) {
        const rateLimit = await consumeRateLimit("dynamic-scan", `${id}:${requestFingerprint(Astro.request)}`, 300, 60);
        if (!rateLimit.allowed) {
          message = "This QR is receiving too many requests. Please try again shortly.";
          status = 429;
        } else {
          const userAgent = Astro.request.headers.get("user-agent") || "";
          const device = /Android|iPhone|iPad|iPod|IEMobile/i.test(userAgent) ? "mobile" : "desktop";
          await recordScan(id, device);
          if (destinationUrl.startsWith("upi:")) {
            return new Response(null, {
              status: 302,
              headers: {
                "Cache-Control": "no-store",
                "Location": destinationUrl,
                "Referrer-Policy": "no-referrer",
                "X-Robots-Tag": "noindex, nofollow",
              },
            });
          }

          const destination = new URL(destinationUrl);
          const isFirstParty = destination.hostname === "proupiqr.in" || destination.hostname.endsWith(".proupiqr.in");
          if (isFirstParty) {
            return new Response(null, {
              status: 302,
              headers: {
                "Cache-Control": "no-store",
                "Location": destinationUrl,
                "Referrer-Policy": "no-referrer",
                "X-Robots-Tag": "noindex, nofollow",
              },
            });
          }

          resolvedDestination = destinationUrl;
          destinationHost = destination.hostname;
          message = "This QR points to an external website. Check the hostname before continuing.";
          status = 200;
        }
      } else {
        message = "This campaign has an invalid destination and was blocked.";
        status = 410;
      }
    }
  } catch {
    message = "The dynamic QR service is temporarily unavailable.";
    status = 503;
  }
}

Astro.response.status = status;
Astro.response.statusText = status === 200
  ? "OK"
  : status === 410
  ? "Gone"
  : status === 429
    ? "Too Many Requests"
    : status === 503
      ? "Service Unavailable"
      : "Not Found";
---

<BaseLayout title={resolvedDestination ? "Confirm External QR Destination | Pro UPI QR" : "Dynamic QR Link Unavailable | Pro UPI QR"} description="Review or troubleshoot a protected Pro UPI QR dynamic destination." noindex={true}>
  <main class="flex min-h-[65vh] items-center justify-center p-6 text-center">
    <div class="w-full max-w-md space-y-5 rounded-3xl border border-forest/10 bg-white p-8 shadow-xl">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-amber-200 bg-amber-50 text-2xl font-black text-amber-800">!</div>
      <div>
        <h1 class="text-xl font-black text-forest">{resolvedDestination ? "You Are Leaving Pro UPI QR" : "Dynamic Link Unavailable"}</h1>
        <p class="mt-2 text-sm leading-6 text-forest/65">{message}</p>
      </div>
      {resolvedDestination ? (
        <>
          <div class="break-all rounded-2xl border border-forest/10 bg-cream p-4 text-sm font-black text-forest">{destinationHost}</div>
          <a href={resolvedDestination} rel="nofollow noopener noreferrer" referrerpolicy="no-referrer" class="inline-flex w-full items-center justify-center rounded-2xl bg-forest px-6 py-3 text-xs font-black text-white transition hover:bg-leaf">
            Continue to {destinationHost}
          </a>
          <a href="/" class="block text-xs font-bold text-leaf hover:underline">Cancel and return to Pro UPI QR</a>
        </>
      ) : (
        <a href="/" class="inline-flex w-full items-center justify-center rounded-2xl bg-forest px-6 py-3 text-xs font-black text-white transition hover:bg-leaf">
          Open Pro UPI QR
        </a>
      )}
    </div>
  </main>
</BaseLayout>
