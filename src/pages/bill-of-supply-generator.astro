---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BillOfSupplyGenerator } from "../components/BillOfSupplyGenerator";

const title = "Bill of Supply Generator - GST for Composition Dealers | Pro UPI QR";
const description = "Create a GST-compliant bill of supply for composition dealers and exempt suppliers. No GST charged. Browser-only, PDF export.";

const faqs = [
  { question: "Who must issue a bill of supply?", answer: "Composition scheme taxpayers and registered dealers supplying exempt goods must issue a bill of supply instead of a tax invoice. The bill tells the buyer the value of the supply but shows zero GST — because the supplier is not permitted to collect tax from the buyer." },
  { question: "Can I include GST on a bill of supply?", answer: "No. A bill of supply must not show any GST amount, CGST/SGST split, or tax rate. It states the total value of the supply only. If you need to charge GST, issue a tax invoice instead." },
  { question: "Is the buyer's GSTIN required?", answer: "If the buyer is registered and the supply value is above ₹50,000, recording their GSTIN is recommended for your records. It is not mandatory on the bill of supply itself in the same way it is on a tax invoice." },
  { question: "Is my data uploaded to a server?", answer: "No. All data stays in your browser's localStorage. Nothing is uploaded." }
];

const schema = { "@context": "https://schema.org", "@graph": [{ "@type": "WebApplication", name: "Bill of Supply Generator by Pro UPI QR", applicationCategory: "BusinessApplication", operatingSystem: "Any", url: "https://www.proupiqr.in/bill-of-supply-generator/", description, featureList: ["Bill of supply for composition dealers", "Exempt supply documentation", "Zero-GST compliant format", "PDF export"], offers: { "@type": "Offer", price: "0", priceCurrency: "INR" } }, { "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })) }, { "@type": "HowTo", name: "How to create a bill of supply", step: [{ "@type": "HowToStep", name: "Choose composition or exempt supply type" }, { "@type": "HowToStep", name: "Enter supplier and buyer details" }, { "@type": "HowToStep", name: "Add items with quantity and rate" }, { "@type": "HowToStep", name: "Download as PDF — no tax column shown" }] }] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60"><a href="/" class="hover:text-leaf transition-colors">Home</a><span>/</span><a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a><span>/</span><span class="text-forest font-bold" aria-current="page">Bill of Supply</span></nav>
        <div class="max-w-4xl"><p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Merchant documents</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Bill of supply generator</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Issue a GST-compliant bill of supply when you cannot charge tax — for composition dealers and exempt goods suppliers. Free, private, browser-only.</p>
          <div class="mt-7 flex flex-wrap gap-3"><a href="#bos-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Create bill of supply</a><a href="/invoice-generator/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Need a tax invoice? →</a></div>
        </div>
      </div>
    </section>
    <section id="bos-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><BillOfSupplyGenerator client:visible /></div></section>
    <section class="px-4 py-14 md:px-6 lg:px-8"><div class="mx-auto max-w-5xl"><p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p><h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Bill of supply questions</h2><div class="mt-8 grid gap-4">{faqs.map((faq) => (<details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5"><summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary><p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p></details>))}</div></div></section>
    <section class="px-4 pb-16 md:px-6 lg:px-8"><div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10"><h2 class="text-2xl font-black tracking-tight md:text-3xl">Not collecting GST? Your billing stack still needs paperwork.</h2><p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/72">Bills of supply, cash memos, and simplified invoices for composition dealers and exempt suppliers.</p><div class="mt-6 flex flex-wrap justify-center gap-3"><a href="/invoice-generator/" class="rounded-full bg-sun px-5 py-2.5 text-sm font-black text-forest hover:bg-white transition">Tax invoice →</a><a href="/cash-memo-generator/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Cash memo</a></div></div></section>
  </main>
</BaseLayout>