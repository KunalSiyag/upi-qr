---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GeneratorForm } from "../components/GeneratorForm";
import AffiliateProducts from "../components/AffiliateProducts.astro";
import TemplateThumb from "../components/TemplateThumb.astro";
import Testimonials from "../components/Testimonials.astro";
import ReviewInvite from "../components/ReviewInvite.astro";
import { getCollection } from "astro:content";
import { guidePath } from "../data/internalLinks";
import { TOPIC_HUBS, pickFeaturedPosts } from "../data/topicHubs";
import { ogImageForPath } from "../data/siteImages";
import { softwareApplicationSchema } from "../data/reviews";

const title = "Free UPI QR Code Generator — Universal QR";
const description =
  "Create a free universal UPI QR code for your shop or bank account. Works on PhonePe, Google Pay, Paytm, and BHIM. Print a standee or sticker. No signup.";

const faqs = [
  {
    question: "How to generate UPI QR code?",
    answer:
      "To generate a UPI QR code, simply enter your payee name and UPI ID in our free UPI QR code generator. You can instantly download the payment QR as a high-resolution image."
  },
  {
    question: "Is this a universal UPI QR code generator?",
    answer:
      "Yes, this is a universal UPI QR code generator. The QR codes created will work seamlessly across all major payment apps including PhonePe, Google Pay (GPay), Paytm, and BHIM."
  },
  {
    question: "How to create UPI QR code with amount?",
    answer:
      "You can easily create a UPI QR code with amount using our tool. Simply enter your fixed price in the 'Amount' field, and the generated UPI QR code will automatically request that exact payment from the customer. Read our guide on generating UPI QR with a fixed amount for billing workflows.",
    answerLink: { href: "/blog/how-to-generate-upi-qr-with-amount/", label: "generating UPI QR with a fixed amount" }
  },
  {
    question: "What is UPI QR code?",
    answer:
      "A UPI QR code is a scannable barcode that contains your Virtual Payment Address (VPA) and banking details securely. When scanned by any UPI payment app, it allows the customer to transfer money directly to your bank account."
  },
  {
    question: "How to get UPI QR code for shop?",
    answer:
      "To get a UPI QR code for your shop, enter your merchant UPI ID into our generator. Select a professional poster template, click generate, and print the resulting standee for your billing counter. Our standee printing guide covers sizing, DPI, and laminate choices.",
    answerLink: { href: "/blog/how-to-create-print-upi-qr-code-standee/", label: "standee printing guide" }
  },
  {
    question: "How to get UPI ID from QR code?",
    answer:
      "Upload the image to the UPI QR decoder. It reads the pa= VPA, payee name, and amount in your browser. See how to extract UPI ID from a QR code for the full checklist.",
    answerLink: { href: "/blog/extract-upi-id-from-qr-code/", label: "extract UPI ID from a QR code" }
  },
  {
    question: "Is there an official NPCI QR code generator?",
    answer:
      "No official one exists: NPCI writes the upi://pay rules and does not host a public shop form. Use the NPCI QR generator here to print a BHIM standee from your VPA. Bharat QR is a separate bank-issued code.",
    answerLink: { href: "/bhim-qr-generator/", label: "NPCI QR generator" }
  },
  {
    question: "Can I generate a UPI QR from a bank account number?",
    answer:
      "No. A UPI QR encodes your VPA, not IFSC plus account number. Copy the UPI ID from the bank app, then generate. Full steps: QR from bank account number.",
    answerLink: { href: "/blog/generate-qr-from-bank-account-number/", label: "QR from bank account number" }
  },
  {
    question: "Is this UPI QR generator free and without signup?",
    answer:
      "Yes. Pro UPI QR generates the code in your browser. There is no account, watermark, or monthly fee. Download PNG or print a standee immediately."
  },
  {
    question: "Can I create a UPI QR code for my SBI, HDFC or ICICI bank account?",
    answer:
      "Yes. Enter the UPI ID from your bank app (for example name@sbi or mobile@okhdfcbank). The same poster works in PhonePe, Google Pay, Paytm and BHIM."
  },
  {
    question: "Where can I read Pro UPI QR reviews and ratings?",
    answer:
      "Public ratings live on Product Hunt. Named merchant quotes, when we have them, are on the Pro UPI QR reviews page. We do not invent star scores for search snippets.",
    answerLink: { href: "/reviews/", label: "Pro UPI QR reviews page" }
  },
  {
    question: "What is the difference between this and the universal QR generator?",
    answer:
      "This page prints a UPI payment standee for shops. The universal QR generator is the one ranking for “universal qr code generator” — UPI for a bank account, plus URL, WiFi, vCard, and PDF.",
    answerLink: { href: "/universal-qr-generator/", label: "universal QR generator" }
  },
  {
    question: "How do I get a PhonePe QR code sticker for my shop?",
    answer:
      "You do not need to order an official PhonePe kit. Paste your UPI ID into the PhonePe QR sticker generator, pick 4, 6, or 12 stickers per A4, and print. It is a standard upi://pay code, so Google Pay, Paytm, and BHIM scan it too.",
    answerLink: { href: "/qr-sticker-generator/?app=phonepe#tool", label: "PhonePe QR sticker generator" }
  },
  {
    question: "How do I print a Google Pay QR sticker for my counter?",
    answer:
      "Open the GPay sticker generator, paste your UPI ID, pick 4, 6, or 12 stickers per A4, and print on matte vinyl. It is a standard upi://pay code, so PhonePe, Paytm, and BHIM scan it too. It is not an official Google Pay Business kit.",
    answerLink: { href: "/qr-sticker-generator/?app=gpay#tool", label: "GPay QR sticker generator" }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    softwareApplicationSchema({ url: "https://www.proupiqr.in/", description }),
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer
        }
      }))
    }
  ]
};

const useCases = [
  "Shops and kirana stores",
  "Freelancers and consultants",
  "Restaurants and cafes",
  "Temple donation counters",
  "Schools and tuition fees",
  "Events and registrations"
];

const features = [
  {
    title: "Instant browser generation",
    copy: "Build the QR in the browser without login, signup, or waiting for a dashboard."
  },
  {
    title: "Payment-ready UPI format",
    copy: "Add payee name, UPI ID, fixed amount, and note so scanners land on the right payment intent."
  },
  {
    title: "Poster-first design",
    copy: "Start with a QR today, then turn it into standees, donation posters, table cards, and fee collection materials."
  }
];

const templates = [
  {
    name: "Shop Payment Standee",
    image: "/images/template/abc-shop-standee.png",
    value: "Counter-ready display for retail stores, grocery counters, and local shops.",
    bestFor: "Best for: retail cashier counters, grocery shops, and pharmacies.",
    status: "Available now"
  },
  {
    name: "Temple Donation Poster",
    image: "/images/template/abc-temple-donation.png",
    value: "Devotional layout with larger type and donation-first messaging for trust and transparency.",
    bestFor: "Best for: community donation boxes, religious centers, and charity desks.",
    status: "Available now"
  },
  {
    name: "Restaurant Table QR",
    image: "/images/template/abc-restaurant-table.png",
    value: "Compact table tent design displaying table numbers and direct dine-in scan-to-pay instructions.",
    bestFor: "Best for: dine-in tables, cafe counters, and food truck displays.",
    status: "Available now"
  },
  {
    name: "Freelancer Payment Card",
    image: "/images/template/abc-freelancer-card.png",
    value: "Modern card layout for client billing, repeat services, and instant invoice links.",
    bestFor: "Best for: invoices, digital resumes, portfolio sites, and WhatsApp sharing.",
    status: "Available now"
  },
  {
    name: "Event Pass Ticket",
    image: "/images/template/abc-event-ticket.png",
    value: "Vibrant ticket-stub design featuring event date, venue details, and scan-to-register flow.",
    bestFor: "Best for: ticketing booths, workshops, registrations, and seminar passes.",
    status: "Available now"
  },
  {
    name: "Tuition Fees Card",
    image: "/images/template/abc-custom-minimal.png",
    value: "School notebook inspired theme designed for classroom displays, batches, and coaching fee collections.",
    bestFor: "Best for: schools, coaching batches, class notice boards, and tutors.",
    status: "Available now"
  },
  {
    name: "Cab / Taxi Dashboard Card",
    image: "/images/template/abc-taxi-cab.png",
    value: "High-contrast driver-friendly dashboard card with large readable taxi/cab credentials.",
    bestFor: "Best for: cab dashboards, auto-rickshaw screens, and delivery riders.",
    status: "Available now"
  },
  {
    name: "Custom Minimalist Card",
    image: "/images/template/abc-custom-minimal.png",
    value: "Clean, professional executive card structure for direct fund transfers and formal business needs.",
    bestFor: "Best for: corporate invoices, business cards, and direct fund transfers.",
    status: "Available now"
  }
];

const landingLinks = [
  { href: "/phonepe-qr-generator/", label: "PhonePe QR Generator" },
  { href: "/google-pay-qr-generator/", label: "Google Pay QR Generator" },
  { href: "/paytm-qr-generator/", label: "Paytm QR Generator" },
  { href: "/bhim-qr-generator/", label: "BHIM QR Generator" },
  { href: "/whatsapp-pay-qr-generator/", label: "WhatsApp Pay QR Generator" },
  { href: "/amazon-pay-qr-generator/", label: "Amazon Pay QR Generator" },
  { href: "/sbi-qr-generator/", label: "SBI QR Generator" },
  { href: "/hdfc-qr-generator/", label: "HDFC QR Generator" },
  { href: "/icici-qr-generator/", label: "ICICI QR Generator" },
  { href: "/donation-qr-generator/", label: "Donation QR Generator" },
  { href: "/universal-qr-generator/", label: "Universal QR Generator" },
  { href: "/qr-sticker-generator/?app=phonepe#tool", label: "PhonePe QR Sticker" },
  { href: "/qr-sticker-generator/?app=gpay#tool", label: "GPay QR Sticker" },
  { href: "/invoice-generator/", label: "Invoice QR Generator" },
  { href: "/receipt-generator/", label: "Payment Receipt Generator" },
  { href: "/paid-stamp-generator/", label: "Paid Stamp Generator" },
  { href: "/rent-receipt-generator/", label: "Rent Receipt Generator" },
  { href: "/quotation-generator/", label: "Quotation Generator" },
  { href: "/payment-reminder-generator/", label: "Payment Reminder Generator" }
];

const merchantTools = [
  { title: "Invoice PDF Generator", href: "/invoice-generator/", copy: "Create GST-ready invoices with an embedded UPI QR and save as PDF for WhatsApp or email.", status: "Live now" },
  { title: "Payment Receipt Generator", href: "/receipt-generator/", copy: "Acknowledge payments with a PAID-stamped receipt PDF that records mode, UTR, and a UPI QR.", status: "Live now" },
  { title: "Rent Receipt Generator", href: "/rent-receipt-generator/", copy: "HRA-ready monthly rent receipts with amount in words and a revenue stamp box.", status: "Live now" },
  { title: "Quotation Generator", href: "/quotation-generator/", copy: "Send estimates with validity dates, terms, and an optional advance-payment QR.", status: "Live now" },
  { title: "Payment Reminder Generator", href: "/payment-reminder-generator/", copy: "Polite overdue invoice reminders for WhatsApp and SMS in three tones.", status: "Live now" },
  { title: "Split Bill Calculator", href: "/split-bill-calculator/", copy: "Split by dish, not just equally. Per-person WhatsApp and UPI QR.", status: "Live now" },
  { title: "Night-close till", href: "/cash-denomination-calculator/", copy: "Count notes, add UPI and card, petty cash and bank deposit, download variance.", status: "Live now" },
  { title: "UPI MDR Calculator", href: "/upi-mdr-calculator/", copy: "0.4% from 15 Oct 2026 on some P2M above ₹2,000. Not a tax. Small shops stay free.", status: "New" },
  { title: "GST Credit Note Generator", href: "/credit-note-generator/", copy: "Section 34 compliant credit notes for returns, discounts, and corrections.", status: "Live now" },
  { title: "Paid Stamp Generator", href: "/paid-stamp-generator/", copy: "Upload any bill photo and stamp PAID with date and signature, right inside your browser.", status: "Live now" },
  { title: "All Merchant Tools", href: "/tools/", copy: "Browse every QR generator, billing tool, calculator, and guide in one hub.", status: "20+ tools" },
  { title: "Purchase Order Generator", href: "/purchase-order-generator/", copy: "Formal POs with buyer/supplier GSTINs, delivery terms, and line items.", status: "New" },
  { title: "Cash Memo Generator", href: "/cash-memo-generator/", copy: "Simple retail billing slips for kirana shops and walk-in counter sales.", status: "New" },
  { title: "Influencer Contract Generator", href: "/influencer-contract-generator/", copy: "Brand collaboration agreements with deliverables, ASCI rules, and advance UPI QR.", status: "New" },
  { title: "Freelance Contract Generator", href: "/freelance-contract-generator/", copy: "Service agreements with milestone deliverables, IP ownership, and revision limits.", status: "New" },
  { title: "Payment Tracker", href: "/payment-tracker/", copy: "Who owes you, what is overdue, one-tap WhatsApp reminders, and part payments. No signup.", status: "New" },
  { title: "MSME Receivables Tracker", href: "/msme-receivables/", copy: "Invoice aging buckets, 45-day due alerts, and Section 16 demand letters with interest.", status: "New" },
  { title: "Developer API", href: "/developer/", copy: "Embed UPI QR widgets, payment links, and authenticated checkout sessions.", status: "Live now" }
];

const posts = await getCollection("blog");
const featuredGuides = pickFeaturedPosts(posts, 6);

/** Quick presets under the generator: app and bank pages people search for, plus stickers. */
const presets = [
  { href: "/phonepe-qr-generator/", label: "PhonePe QR", icon: "/phonepe.png" },
  { href: "/qr-sticker-generator/?app=phonepe#tool", label: "PhonePe sticker", icon: "/phonepe.png" },
  { href: "/google-pay-qr-generator/", label: "Google Pay QR", icon: "/googlepay.png" },
  { href: "/qr-sticker-generator/?app=gpay#tool", label: "GPay sticker", icon: "/googlepay.png" },
  { href: "/paytm-qr-generator/", label: "Paytm QR", icon: "/paytm.ico" },
  { href: "/bhim-qr-generator/", label: "BHIM QR", icon: "/bhim.ico" },
  { href: "/whatsapp-pay-qr-generator/", label: "WhatsApp QR", icon: "/whatsapp.png" },
  { href: "/amazon-pay-qr-generator/", label: "Amazon Pay QR", icon: "/amazonpay.png" },
  { href: "/sbi-qr-generator/", label: "SBI QR", icon: "/sbi.ico" },
  { href: "/hdfc-qr-generator/", label: "HDFC QR", icon: "/hdfc.ico" },
  { href: "/icici-qr-generator/", label: "ICICI QR", icon: "/icici.ico" },
  { href: "/donation-qr-generator/", label: "Donation QR", icon: null },
  { href: "/universal-qr-generator/", label: "Universal QR", icon: null },
  { href: "/invoice-generator/", label: "Invoice QR PDF", icon: null },
];

---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  image={ogImageForPath("/").src}
>
  <main>
    <section class="px-4 pb-14 pt-8 md:px-6 md:pt-14 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-4xl">
          <h1 class="text-[2.75rem] font-black leading-[0.95] tracking-[-0.03em] text-obsidian sm:text-6xl lg:text-7xl">
            Free UPI QR Code Generator
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-8 md:text-xl">
            Enter your UPI ID and download a universal payment QR that works on PhonePe, Google Pay, Paytm, and BHIM. No signup. Optional amount. Print a counter standee when you need one.
          </p>
          <ul class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-[15px] font-medium">
            <li class="flex items-center gap-2"><svg class="h-[18px] w-[18px] text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" /></svg>Free · no signup</li>
            <li class="flex items-center gap-2"><svg class="h-[18px] w-[18px] text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" /></svg>Local in-browser QR</li>
            <li class="flex items-center gap-2"><svg class="h-[18px] w-[18px] text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" /></svg>20+ merchant tools</li>
            <li><a href="/reviews/" class="font-semibold text-forest underline underline-offset-4 hover:text-leaf">Read reviews</a></li>
          </ul>
        </div>

        <div id="generator" class="mt-8 scroll-mt-20">
          <GeneratorForm client:load />
        </div>

        <div class="mt-12 grid gap-10 border-t border-forest/10 pt-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-obsidian sm:text-3xl">
              Generate UPI QR code with amount in under 30 seconds.
            </h2>
            <p class="mt-3 text-base leading-7">
              Works on PhonePe, Google Pay, Paytm, BHIM, and other UPI apps that support standard{" "}
              <code class="font-mono text-sm">upi://pay</code> links. Need a peel-off counter sticker?
              Use the{" "}<a href="/qr-sticker-generator/?app=phonepe#tool" class="font-semibold text-forest underline underline-offset-4 hover:text-leaf">PhonePe / GPay sticker sheet</a>.
              Need URL, WiFi, or vCard? Open the{" "}<a href="/universal-qr-generator/" class="font-semibold text-forest underline underline-offset-4 hover:text-leaf">universal QR generator</a>.
            </p>
            <p class="mt-4 flex items-start gap-2 text-[15px] leading-6">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              <span>100% Privacy: Generated locally in your browser. We never collect, transmit, or store your payment details.</span>
            </p>
            <p class="mt-3 text-[15px] leading-6">
              <span class="font-bold text-forest">Dynamic QR:</span> Need to update payment links later or track daily customer scans?{" "}
              <a href="/dynamic-qr-generator/" class="font-semibold text-forest underline underline-offset-4 hover:text-leaf">Create Dynamic QR &rarr;</a>
            </p>
            <p class="mt-6 text-sm leading-6 text-muted">Made for {useCases.join(" · ")}.</p>
          </div>
          <div>
            <p class="text-sm font-bold text-muted">Quick preset generators</p>
            <ul class="mt-2 grid grid-cols-2 gap-x-6">
              {presets.map((preset) => (
                <li>
                  <a href={preset.href} class="flex min-h-12 items-center gap-3 border-b border-forest/10 py-2.5 text-[15px] font-semibold text-forest hover:text-leaf">
                    {preset.icon ? (
                      <img src={preset.icon} alt="" width="24" height="24" loading="lazy" class="h-6 w-6 rounded-full bg-white object-contain ring-1 ring-forest/10" />
                    ) : (
                      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-mint" aria-hidden="true"><span class="h-2 w-2 rounded-full bg-leaf"></span></span>
                    )}
                    {preset.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-mint px-4 py-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <h2 class="text-3xl font-black tracking-tight text-obsidian md:text-5xl">Turn Pro UPI QR into a complete payment workflow.</h2>
            <p class="mt-4 text-lg leading-8">Beyond standalone QR codes, use Pro UPI QR for invoices, hosted payment links, developer integrations, and bulk merchant assets.</p>
          </div>
          <a href="/invoice-generator/" class="inline-flex h-12 shrink-0 items-center self-start rounded-full bg-sun px-6 text-[15px] font-bold text-forest transition hover:brightness-95 md:self-auto">Open invoice generator &rarr;</a>
        </div>
        <ul class="mt-10 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
          {merchantTools.map((tool) => (
            <li class="border-t border-forest/15 py-5">
              <a href={tool.href} class="group block">
                <h3 class="flex flex-wrap items-center gap-2 text-lg font-bold text-obsidian group-hover:text-leaf">
                  {tool.title}
                  {tool.status === "New" && <span class="rounded-full bg-white px-2 py-0.5 text-xs font-semibold text-leaf">New</span>}
                </h3>
                <p class="mt-1.5 text-[15px] leading-6">{tool.copy}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="px-4 pt-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="max-w-3xl text-3xl font-black tracking-tight text-obsidian md:text-5xl">Find the right tool without scanning a hundred footer links.</h2>
        <ul class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
          {TOPIC_HUBS.map((hub) => (
            <li class="border-t border-forest/10 py-5">
              <a href={hub.path} class="group block">
                <h3 class="text-lg font-bold text-obsidian group-hover:text-leaf">{hub.shortName}</h3>
                <p class="mt-1.5 text-[15px] leading-6">{hub.blurb}</p>
                <span class="mt-2 inline-block text-sm font-semibold text-forest underline underline-offset-4">Open hub &rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="px-4 py-16 md:px-6 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 border-t border-forest/10 pt-12 md:grid-cols-3">
        {features.map((feature) => (
          <div>
            <h3 class="text-xl font-bold text-obsidian">{feature.title}</h3>
            <p class="mt-2 text-base leading-7">{feature.copy}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="templates" class="scroll-mt-20 px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-black tracking-tight text-obsidian md:text-5xl">
            Start with eight ready-to-use payment poster templates.
          </h2>
          <p class="mt-4 text-lg leading-8">
            Generate once, switch styles instantly, and download a printable payment image for your
            counter, table, donation desk, or client share flow.
            See paper sizes in the{" "}
            <a href="/print-templates/" class="font-semibold text-forest underline underline-offset-4 hover:text-leaf">A4, A5, 5×7, and sticker gallery</a>.
          </p>
          <p class="mt-3 text-base leading-7">
            Print, frame, and place high-resolution payment standees at checkout. Designed to look clean and professional, creating instant trust with your customers.
          </p>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-x-5 gap-y-8 md:grid-cols-4">
          {templates.map((template) => (
            <li>
              <div class="overflow-hidden rounded-[10px] bg-fog">
                <TemplateThumb
                  src={template.image}
                  alt={`${template.name} printable UPI QR template`}
                  width={340}
                  height={255}
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover object-top"
                />
              </div>
              <h3 class="mt-3 text-base font-bold text-obsidian">{template.name}</h3>
              <p class="mt-1 text-sm leading-6">{template.value}</p>
              <p class="mt-1 text-xs leading-5 text-muted">{template.bestFor}</p>
            </li>
          ))}
        </ul>
        <a href="#generator" class="mt-8 inline-block text-[15px] font-semibold text-forest underline underline-offset-4 hover:text-leaf">Make your poster with the generator &uarr;</a>
        <div class="mt-12"><AffiliateProducts /></div>
      </div>
    </section>

    <section class="bg-forest px-4 py-16 text-[#c8dccf] md:px-6 lg:px-8">
      <div class="mx-auto flex max-w-7xl flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-black tracking-tight text-mint md:text-5xl">
            Scan instantly using any UPI payment application.
          </h2>
          <p class="mt-4 text-lg leading-8">
            Our generated QR codes strictly adhere to standard UPI guidelines. Customers can scan and make secure payments instantly using PhonePe, Google Pay, Paytm, BHIM, or any banking app.
          </p>
        </div>
        <ul class="grid grid-cols-1 gap-x-8 gap-y-3 text-[15px] font-semibold text-white sm:grid-cols-2 lg:min-w-[30rem]">
          {landingLinks.map((link) => (
            <li><a href={link.href} class="hover:underline">{link.label} &rarr;</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="px-4 py-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-black tracking-tight text-obsidian md:text-5xl">
            Learn how to print, set up, and secure your payment QR.
          </h2>
          <p class="mt-4 text-lg leading-8">
            Practical tutorials for shop owners, NGOs, and freelancers — from standee printing to Google Pay activation.
          </p>
        </div>
        <ul class="mt-8 grid gap-x-10 md:grid-cols-2 lg:grid-cols-3">
          {featuredGuides.map((guide) => (
            <li class="border-t border-forest/10 py-5">
              <a href={guidePath(guide.id.replace(/\.mdx?$/, ""))} class="group block">
                <h3 class="line-clamp-2 text-lg font-bold text-obsidian group-hover:text-leaf">{guide.data.title}</h3>
                <p class="mt-1.5 line-clamp-3 text-[15px] leading-6">{guide.data.description}</p>
                <span class="mt-2 inline-block text-sm font-semibold text-forest underline underline-offset-4">Read guide &rarr;</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/blog/" class="mt-6 inline-block text-[15px] font-semibold text-forest underline underline-offset-4 hover:text-leaf">
          Browse all blog guides &rarr;
        </a>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl border-t border-forest/10 pt-12">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold text-leaf">Also available</p>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-obsidian md:text-4xl">Universal QR Code Generator</h2>
            <p class="mt-3 text-lg leading-8">Free QR codes for websites, WiFi, vCard, WhatsApp, PDF, and UPI. 13 templates. No signup, no watermark.</p>
          </div>
          <a href="/universal-qr-generator/" class="inline-flex h-12 shrink-0 items-center self-start rounded-full border border-forest px-6 text-[15px] font-semibold text-forest transition hover:bg-forest hover:text-white md:self-auto">Open universal QR editor &rarr;</a>
        </div>
        <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[15px] font-semibold">
          {["UPI Pay", "Website / URL", "WhatsApp", "WiFi", "Contact (vCard)", "PDF Files", "SMS", "Email", "Phone", "Plain Text"].map((item) => (
            <a href="/universal-qr-generator/" class="text-forest hover:text-leaf hover:underline">{item}</a>
          ))}
        </p>
        <ul class="mt-8 grid gap-x-10 border-t border-forest/10 sm:grid-cols-2 lg:grid-cols-4">
          <li><a href="/upi-qr-decoder/" class="flex items-center gap-2 py-4 text-[15px] font-semibold text-forest hover:text-leaf"><svg class="h-4 w-4 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>Decode &amp; Scan UPI QR Code Image</a></li>
          <li><a href="/upi-link-generator/" class="flex items-center gap-2 py-4 text-[15px] font-semibold text-forest hover:text-leaf"><svg class="h-4 w-4 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>UPI Payment Link Builder</a></li>
          <li><a href="/survey-qr-generator/" class="flex items-center gap-2 py-4 text-[15px] font-semibold text-forest hover:text-leaf"><svg class="h-4 w-4 text-leaf" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>Survey &amp; Google Review QR</a></li>
          <li><a href="/sbi-business-qr-code-generator/" class="flex items-center gap-2 py-4 text-[15px] font-semibold text-forest hover:text-leaf"><svg class="h-4 w-4 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/></svg>SBI Business QR Generator</a></li>
        </ul>
      </div>
    </section>

    <Testimonials heading="Merchant reviews of Pro UPI QR" />
    <ReviewInvite />

    <section id="faq" class="scroll-mt-20 px-4 py-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-3xl font-black tracking-tight text-obsidian md:text-5xl">
          Questions about UPI &amp; Universal QR Codes
        </h2>
        <div class="mt-8 grid gap-3">
          {faqs.map((faq) => (
            <details class="group rounded-[10px] bg-fog px-5 py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-bold text-obsidian">
                <span>{faq.question}</span>
                <span class="mt-0.5 text-2xl leading-none text-forest transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 max-w-3xl text-base leading-7">
                {faq.answerLink ? (
                  <>
                    {faq.answer.split(faq.answerLink.label)[0]}
                    <a href={faq.answerLink.href} class="font-semibold text-forest underline underline-offset-4 hover:text-leaf">
                      {faq.answerLink.label}
                    </a>
                    {faq.answer.split(faq.answerLink.label)[1]}
                  </>
                ) : (
                  faq.answer
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
