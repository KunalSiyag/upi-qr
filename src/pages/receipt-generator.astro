---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ReceiptGenerator } from "../components/ReceiptGenerator";

const title = "Free Payment Receipt Generator with UPI QR & Paid Stamp | Pro UPI QR";
const description = "Create a professional payment receipt PDF with PAID stamp and UPI QR in seconds. Ideal for shops, freelancers, tutors, and landlords. Browser-only, no signup.";

const faqs = [
  {
    question: "What is the difference between an invoice and a receipt?",
    answer: "An invoice is a request for payment issued before money moves. A receipt is proof of payment issued after the customer has paid. Use the invoice generator to bill, and this receipt generator to acknowledge the payment with a PAID stamp."
  },
  {
    question: "Can I add a UPI transaction reference to the receipt?",
    answer: "Yes. Enter the UPI transaction ID, UTR, cheque number, or any reference in the reference field and it is printed on the receipt so both sides have a record of the transaction."
  },
  {
    question: "Is the receipt data uploaded to a server?",
    answer: "No. The receipt and its QR code are generated entirely in your browser. Drafts are saved locally on your device so your numbering continues even after closing the tab. No account is needed."
  },
  {
    question: "Can I send the receipt on WhatsApp?",
    answer: "Yes. Tap the WhatsApp share button and your phone's share sheet opens with the actual receipt image attached, ready to send to any chat along with a pre-filled summary of number, amount, mode, and reference. On desktops without native sharing, the receipt PNG is downloaded so you can attach it manually."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Payment Receipt Generator by Pro UPI QR",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/receipt-generator/",
      "description": description,
      "featureList": [
        "Payment receipt PDF generator",
        "PAID stamp and status badge",
        "UPI QR for repeat payments",
        "UTR and payment mode recording",
        "WhatsApp share and PNG export"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      "name": "How to create a paid receipt with UPI details",
      "description": "Generate a printable payment receipt with a PAID stamp in your browser.",
      "step": [
        { "@type": "HowToStep", "name": "Enter business name, customer, and receipt number" },
        { "@type": "HowToStep", "name": "Choose payment mode and add UTR or reference" },
        { "@type": "HowToStep", "name": "Review the auto-generated UPI QR and PAID stamp" },
        { "@type": "HowToStep", "name": "Share on WhatsApp or download the receipt as PDF" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/#tools" class="hover:text-leaf transition-colors">Merchant Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">Payment Receipt Generator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Merchant toolkit</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Free payment receipt generator with PAID stamp &amp; UPI QR</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Acknowledge payments instantly. Record UPI, cash, card, or bank transfers with reference numbers, add a professional PAID stamp, then share on WhatsApp or download the receipt as PDF.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#receipt-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Create receipt PDF</a>
            <a href="/paid-stamp-generator/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Stamp an existing invoice →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="receipt-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <ReceiptGenerator client:visible />
      </div>
    </section>

    <section id="related-tools" class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-white md:p-10">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-sun">Complete the billing loop</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight md:text-5xl">Invoice → Payment → Paid receipt.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {[
            ["UPI Invoice Generator", "Bill first. Create GST-ready invoice PDFs with an embedded payment QR.", "/invoice-generator/", "Open invoice tool"],
            ["Paid Stamp Generator", "Already have a printed or photographed bill? Upload it and stamp it PAID.", "/paid-stamp-generator/", "Open stamp tool"],
            ["UPI QR Generator", "Print a permanent counter QR standee for walk-in customers.", "/", "Create counter QR"]
          ].map(([heading, copy, href, cta]) => (
            <article class="flex flex-col rounded-[1.5rem] border border-white/10 bg-white/8 p-5">
              <h3 class="text-xl font-black">{heading}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-white/72">{copy}</p>
              <a href={href} class="mt-4 inline-block text-sm font-black text-sun hover:text-white">{cta} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Receipt questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
