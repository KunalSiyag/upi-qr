---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  CATEGORY_LABEL,
  DEBIT_LABEL,
  ERROR_CODE_PAGES,
  ERROR_CODE_REVIEWED_ON,
  ERROR_CODE_SOURCES,
  ORIGIN_LABEL,
  errorCodePath,
  errorCodeSlug,
  relatedErrorCodes,
  type UpiErrorCode,
} from "../../data/upiErrorCodes";

export async function getStaticPaths() {
  return ERROR_CODE_PAGES.map((item, index) => ({
    params: { code: errorCodeSlug(item.code) },
    props: { item, index },
  }));
}

interface Props {
  item: UpiErrorCode;
  index: number;
}

const { item, index } = Astro.props;
const prev = ERROR_CODE_PAGES[index - 1];
const next = ERROR_CODE_PAGES[index + 1];
const related = relatedErrorCodes(item);

const firstFitting = (limit: number, ...candidates: string[]) =>
  candidates.find((candidate) => candidate.length <= limit) ?? candidates[candidates.length - 1];

const title = firstFitting(
  70,
  `UPI Error ${item.code}: ${item.title} — Meaning & Fix`,
  `UPI Error ${item.code}: ${item.title}`,
  `UPI Error Code ${item.code} — Meaning, Refund & Fix`,
);
const debitPhrase =
  item.debitStatus === "none"
    ? "Usually no money is debited"
    : item.debitStatus === "possible"
      ? "Money may be debited, so check the UTR first"
      : "If money was debited, it reverses automatically";
const description = firstFitting(
  170,
  `UPI error ${item.code} on Google Pay, PhonePe, Paytm or BHIM means: ${item.title.toLowerCase()}. ${debitPhrase}. What to do next.`,
  `UPI error ${item.code} means: ${item.title.toLowerCase()}. ${debitPhrase}. What to do next.`,
  `What UPI error ${item.code} means, whether money was debited, and what to do next.`,
);

// Aliases repeat the code itself and short search words; show only the phrases apps actually print.
const shownAs = item.aliases.filter((alias) => alias.toLowerCase() !== item.code.toLowerCase() && alias.length > 3);

const reviewedLabel = new Date(`${ERROR_CODE_REVIEWED_ON}T00:00:00+05:30`).toLocaleDateString("en-IN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const faqs = [
  {
    question: `What does UPI error ${item.code} mean?`,
    answer: `${item.title}. ${item.cause}`,
  },
  {
    question: `Is money deducted on UPI error ${item.code}?`,
    answer:
      item.debitStatus === "none"
        ? `Usually not: ${item.code} is normally declined before the debit. Confirm with your bank SMS or passbook rather than the app tile.`
        : `${DEBIT_LABEL[item.debitStatus]}. ${item.refundTime}. Copy the 12-digit UTR and do not pay the same bill again while it is pending.`,
  },
  {
    question: `How to fix UPI error ${item.code}`,
    answer: item.actionStep,
  },
  {
    question: `Shopkeepers: is ${item.code} a problem with my QR?`,
    answer: item.merchantNote,
  },
];

const pageUrl = new URL(`/upi-error-codes/${errorCodeSlug(item.code)}/`, Astro.site).toString();
const hubUrl = new URL("/upi-error-codes/", Astro.site).toString();

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      url: pageUrl,
      name: title,
      description,
      dateModified: ERROR_CODE_REVIEWED_ON,
      isPartOf: { "@id": hubUrl + "#webapp" },
    },
    {
      "@type": "FAQPage",
      "@id": pageUrl + "#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "UPI error codes", item: hubUrl },
        { "@type": "ListItem", position: 3, name: `Error ${item.code}`, item: pageUrl },
      ],
    },
  ],
};

const facts = [
  { label: "Who declined it", value: ORIGIN_LABEL[item.origin] },
  { label: "Type", value: CATEGORY_LABEL[item.category] },
  { label: "Money debited?", value: DEBIT_LABEL[item.debitStatus] },
  { label: "Refund", value: item.refundTime },
];
const link = "font-semibold text-leaf underline underline-offset-2";
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="px-4 pb-16 pt-8 md:px-6 md:pt-12 lg:px-8">
    <article class="mx-auto max-w-3xl">
      <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
        <a href="/" class="transition-colors hover:text-leaf">Home</a>
        <span>/</span>
        <a href="/upi-error-codes/" class="transition-colors hover:text-leaf">UPI error codes</a>
        <span>/</span>
        <span class="font-bold text-forest" aria-current="page" translate="no">{item.code}</span>
      </nav>

      <p class="text-sm font-semibold text-leaf">UPI error code · {CATEGORY_LABEL[item.category]}</p>
      <h1 class="mt-2 text-4xl font-black leading-[1.05] tracking-[-0.02em] text-obsidian md:text-5xl">
        UPI error <span translate="no">{item.code}</span>: {item.title}
      </h1>
      <p class="mt-5 text-lg leading-8">{item.cause}</p>
      {shownAs.length > 0 && (
        <p class="mt-3 text-[15px] leading-6 text-muted">
          Apps may show it as: {shownAs.map((alias, i) => <>{i > 0 && ", "}<span class="text-charcoal">“{alias}”</span></>)}
        </p>
      )}

      <dl class="mt-8 grid gap-px overflow-hidden rounded-[12px] bg-hairline ring-1 ring-hairline sm:grid-cols-2">
        {facts.map((fact) => (
          <div class="bg-white p-4">
            <dt class="text-sm font-semibold text-muted">{fact.label}</dt>
            <dd class="mt-1 text-[15px] font-semibold leading-6 text-obsidian">{fact.value}</dd>
          </div>
        ))}
      </dl>

      <section class="mt-10">
        <h2 class="text-2xl font-black tracking-tight text-obsidian">{faqs[1].question}</h2>
        <p class="mt-3 text-[15px] leading-7">{faqs[1].answer}</p>
        {item.debitStatus !== "none" && (
          <p class="mt-3 text-[15px] leading-7">
            If the bank SMS shows a debit but the payee was not paid, RBI requires auto-reversal by T+1 working day for
            transfers and T+5 for merchant payments, with ₹100 a day compensation after that.{" "}
            <a href="/upi-error-codes/#refund-timelines" class={link}>See the refund timelines</a>.
          </p>
        )}
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-black tracking-tight text-obsidian">{faqs[2].question}</h2>
        <p class="mt-3 text-[15px] leading-7">{faqs[2].answer}</p>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-black tracking-tight text-obsidian">{faqs[3].question}</h2>
        <p class="mt-3 text-[15px] leading-7">{faqs[3].answer}</p>
        <p class="mt-3 text-[15px] leading-7">
          Never release goods on a green screenshot alone. Match the UTR in your bank SMS, ledger or soundbox.
        </p>
      </section>

      <section class="mt-10 rounded-[14px] bg-fog p-5 md:p-7">
        <h2 class="text-xl font-bold text-obsidian">If it keeps failing</h2>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-[15px] leading-6">
          <li>Open the failed payment in the app and copy the 12-digit UTR.</li>
          <li>Use Raise issue or Check status in the app first.</li>
          <li>Then call your bank with the UTR, amount and time. NPCI's UPI helpdesk is 1800-120-1740.</li>
          <li>After 30 days without a fix, complain on the RBI ombudsman portal, <a href="https://cms.rbi.org.in" class={link}>cms.rbi.org.in</a>.</li>
        </ol>
      </section>

      {related.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-black tracking-tight text-obsidian">Related error codes</h2>
          <ul class="mt-4">
            {related.map((other) => (
              <li class="border-t border-hairline">
                <a href={errorCodePath(other.code)} class="flex items-baseline gap-4 py-3 text-[15px] transition-colors hover:text-leaf">
                  <span class="w-10 shrink-0 font-mono font-semibold text-obsidian" translate="no">{other.code}</span>
                  <span>{other.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-10 border-t border-hairline pt-6 text-sm leading-6 text-muted">
        <p>
          Last reviewed {reviewedLabel}. Meaning based on: {item.sources.join("; ")}. Apps word codes differently, so if
          your bank describes {item.code} another way, trust the bank and keep the UTR.
        </p>
        <p class="mt-2">
          Sources:{" "}
          {ERROR_CODE_SOURCES.map((source, i) => <>{i > 0 && " · "}<a href={source.href} class={link}>{source.label}</a></>)}
        </p>
      </section>

      <nav aria-label="Other error codes" class="mt-10 flex items-center justify-between gap-3">
        {prev ? (
          <a href={errorCodePath(prev.code)} class="inline-flex h-10 items-center rounded-[10px] bg-white px-4 text-sm font-semibold text-forest ring-1 ring-inset ring-forest/15 hover:bg-fog">← {prev.code}</a>
        ) : <span />}
        <a href="/upi-error-codes/#resolver" class="inline-flex h-10 items-center rounded-[10px] bg-forest px-4 text-sm font-semibold text-white hover:bg-graphite">All UPI error codes</a>
        {next ? (
          <a href={errorCodePath(next.code)} class="inline-flex h-10 items-center rounded-[10px] bg-white px-4 text-sm font-semibold text-forest ring-1 ring-inset ring-forest/15 hover:bg-fog">{next.code} →</a>
        ) : <span />}
      </nav>
    </article>
  </main>
</BaseLayout>
