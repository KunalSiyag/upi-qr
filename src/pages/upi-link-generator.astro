---
import BaseLayout from "../layouts/BaseLayout.astro";
import { UpiLinkGenerator } from "../components/UpiLinkGenerator";
import InternalLinkHub from "../components/InternalLinkHub.astro";

const title = "Free Online UPI Payment Link Generator – Create upi://pay Links";
const description =
  "Generate free UPI payment links, WhatsApp shareable payment links, and HTML website payment buttons for any UPI ID (VPA). Instant, 100% free & private.";

const faqs = [
  {
    question: "What is a UPI payment link?",
    answer:
      "A UPI payment link is a standardized URI scheme starting with upi://pay. When clicked on a mobile device or scanned via a QR code, it opens installed UPI apps (PhonePe, GPay, Paytm, BHIM) and auto-fills payee name, UPI ID, and payment amount."
  },
  {
    question: "How do I embed a UPI payment button on my website?",
    answer:
      "Use our free generator above to enter your UPI ID and optional amount. Copy the generated HTML Payment Button snippet and paste it into your website's HTML code."
  },
  {
    question: "How do I send a UPI payment link on WhatsApp?",
    answer:
      "Enter your UPI ID and payee name in the generator above, then click 'Share via WhatsApp'. It creates a pre-formatted message with a direct link that recipients can tap to pay."
  },
  {
    question: "Are there any transaction fees for using UPI payment links?",
    answer:
      "No. UPI transfers between bank accounts are 100% free for standard peer-to-peer and merchant transactions. Pro UPI QR does not charge any processing fees."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://www.proupiqr.in/upi-link-generator/#webapp",
      "name": "Free Online UPI Payment Link Generator | Pro UPI QR",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/upi-link-generator/",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "HowTo",
      "@id": "https://www.proupiqr.in/upi-link-generator/#howto",
      "name": "How to Generate a UPI Payment Link",
      "description": "Create a free UPI payment link for websites, WhatsApp, and SMS in three simple steps.",
      "totalTime": "PT30S",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Enter UPI ID and Payee Name",
          "text": "Type your Virtual Payment Address (e.g. name@okicici) and your merchant name."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Add Fixed Amount & Note",
          "text": "Optionally enter a fixed rupee amount and transaction reference note."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Copy Link or Share on WhatsApp",
          "text": "Copy the generated upi://pay URI, HTML button code, or send via WhatsApp with 1-click."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.proupiqr.in/upi-link-generator/#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": " " + faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="py-8">
    <section class="px-5 pb-6 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mint border border-leaf/20 text-xs font-black text-forest uppercase tracking-wider mb-3">
        ⚡ 100% Free Payment URI Tool
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-forest">
        Free Online UPI Payment Link Generator
      </h1>
      <p class="mt-3 text-base text-forest/75 leading-relaxed">
        Convert any <strong>UPI ID (VPA)</strong> into clickable deep links (`upi://pay`), WhatsApp payment messages, and HTML web checkout buttons.
      </p>
    </section>

    <!-- Interactive Link Generator Tool -->
    <section class="px-4 pb-12">
      <UpiLinkGenerator client:load />
    </section>

    <!-- FAQ Section -->
    <section class="max-w-4xl mx-auto px-5 pb-12">
      <h2 class="text-2xl font-black text-forest text-center mb-6">Frequently Asked Questions</h2>
      <div class="grid gap-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm">
            <h3 class="text-base font-black text-forest">{faq.question}</h3>
            <p class="mt-2 text-sm text-forest/75 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal Link Hub -->
    <InternalLinkHub />
  </main>
</BaseLayout>
