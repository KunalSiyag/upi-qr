---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GeneratorForm } from "../../components/GeneratorForm";
import AffiliateProducts from "../../components/AffiliateProducts.astro";

const title = "இலவச UPI QR குறியீடு ஜெனரேட்டர் | கடைகளுக்கான UPI QR உருவாக்குங்கள்";
const description =
  "இலவசமாக தொகையுடன் கூடிய UPI QR குறியீடு ஜெனரேட்டர். Paytm, PhonePe, Google Pay (GPay) போன்ற அனைத்து UPI செயலிகளுக்கும் வேலை செய்யும் universal UPI QR உருவாக்கம்.";

const faqs = [
  {
    question: "UPI QR குறியீட்டை எப்படி உருவாக்குவது?",
    answer: "உங்கள் UPI ID மற்றும் பெயரை உள்ளிட்டு இலவசமாக UPI QR குறியீட்டை பதிவிறக்கம் செய்யலாம்."
  },
  {
    question: "இது அனைத்து UPI செயலிகளுக்கும் வேலை செய்யுமா?",
    answer: "ஆம், இது Google Pay, PhonePe, Paytm, BHIM மற்றும் அனைத்து இந்திய வங்கி பயன்பாடுகளுடனும் 100% வேலை செய்கிறது."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Pro UPI QR (Tamil)",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/ta/"
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-[2rem] border border-white/75 bg-white/86 p-4 sm:p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
      <div class="text-center">
        <span class="inline-block rounded-full bg-leaf/10 px-4 py-1.5 text-xs font-black uppercase tracking-wider text-forest">
          இலவச UPI QR ஜெனரேட்டர் (தமிழ்)
        </span>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-forest md:text-5xl">
          உங்கள் கடைக்கான இலவச UPI QR குறியீடு உருவாக்குங்கள்
        </h1>
        <p class="mt-3 text-sm text-forest/75 md:text-base max-w-2xl mx-auto">
          கட்டணம் இல்லாமல் Google Pay, PhonePe, Paytm செயலிகளுக்கு உடனடி QR தயாரிப்பு.
        </p>
      </div>

      <div class="mt-8">
        <GeneratorForm client:load />
      </div>

      <div class="mt-12 border-t border-forest/10 pt-10">
        <h2 class="text-2xl font-black text-forest">அடிக்கடி கேட்கப்படும் கேள்விகள்</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {faqs.map((faq) => (
            <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm space-y-2">
              <h3 class="text-sm font-black text-forest flex items-start gap-2">
                <span class="text-leaf shrink-0">கே.</span>
                <span>{faq.question}</span>
              </h3>
              <p class="text-xs text-forest/75 leading-relaxed pl-5">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>

      <AffiliateProducts />
    </div>
  </main>
</BaseLayout>
