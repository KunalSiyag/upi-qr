---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GeneratorForm } from "../../components/GeneratorForm";
import AffiliateProducts from "../../components/AffiliateProducts.astro";
import InternalLinkHub from "../../components/InternalLinkHub.astro";
import { getPresetFromSlug, type GeneratorSlug } from "../../data/internalLinks";
import LocalizedToolPage from "../../components/LocalizedToolPage.astro";
import { LOCALIZED_TOOLS } from "../../data/localizedTools";

export async function getStaticPaths() {
  return [
    {
      params: { slug: "phonepe-qr-generator" },
      props: {
        title: "PhonePe QR ஜெனரேட்டர்",
        headline: "PhonePe ஆதரவுடைய இலவச UPI QR குறியீடு உருவாக்குங்கள்",
        presetType: "phonepe",
        intro: "பதிவு இல்லாமல் PhonePe மற்றும் பிற UPI செயலிகளுடன் வேலை செய்யும் QR குறியீட்டை உருவாக்குங்கள்."
      }
    },
    {
      params: { slug: "google-pay-qr-generator" },
      props: {
        title: "Google Pay QR ஜெனரேட்டர்",
        headline: "Google Pay ஆதரவுடைய இலவச UPI QR குறியீடு உருவாக்குங்கள்",
        presetType: "gpay",
        intro: "Google Pay பயன்பாட்டிற்கான உடனடி கட்டண UPI QR குறியீட்டை உருவாக்குங்கள்."
      }
    },
    {
      params: { slug: "paytm-qr-generator" },
      props: {
        title: "Paytm QR ஜெனரேட்டர்",
        headline: "Paytm ஆதரவுடைய இலவச UPI QR குறியீடு உருவாக்குங்கள்",
        presetType: "paytm",
        intro: "கடைகள் மற்றும் சிறு வணிகங்களுக்கான Paytm ஆதரவுடைய UPI QR குறியீட்டை உருவாக்குங்கள்."
      }
    },
    {
      params: { slug: "sbi-qr-generator" },
      props: {
        title: "SBI UPI QR ஜெனரேட்டர்",
        headline: "SBI வங்கி கணக்கிற்கான UPI QR உருவாக்குங்கள்",
        presetType: "sbi",
        intro: "State Bank of India கணக்குகளுக்கான UPI QR குறியீட்டை உடனடியாக பெறுங்கள்."
      }
    },
    ...LOCALIZED_TOOLS.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }))
  ];
}

const { slug } = Astro.params;
const { title, headline, presetType, intro, tool } = Astro.props;

const generatorSlug = slug as GeneratorSlug;
const resolvedPreset = tool ? undefined : (presetType ?? getPresetFromSlug(generatorSlug));

const description = tool ? `${tool.name}: தமிழில் கிடைக்கும் இலவச, மொபைலுக்கு ஏற்ற வணிகக் கருவி. வேகமான முடிவுகள் மற்றும் உலாவியில் பாதுகாப்பான செயலாக்கம்.` : `${intro} 100% இலவசம் மற்றும் உடனடி பதிவிறக்கம்.`;
const pageTitle = tool ? `${tool.name} — தமிழில் பயன்படுத்துங்கள் | Pro UPI QR` : `${title} | Pro UPI QR (Tamil)`;
---

<BaseLayout title={pageTitle} description={description}>
  {tool ? (
    <LocalizedToolPage lang="ta" tool={tool} />
  ) : (
  <main class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-[2rem] border border-white/75 bg-white/86 p-4 sm:p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
      <a href="/ta/" class="inline-block mb-4 text-xs font-bold text-leaf hover:underline">&larr; முதன்மை பக்கத்திற்கு திரும்பு</a>
      
      <p class="text-xs font-black uppercase tracking-[0.2em] text-leaf">உடனடி கட்டண QR</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-forest md:text-5xl">{headline}</h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-forest/72 md:text-base">{intro}</p>

      <div class="mt-8">
        <GeneratorForm client:load presetType={resolvedPreset} />
      </div>

      <AffiliateProducts />
      <InternalLinkHub variant="both" currentGenerator={generatorSlug} presetType={resolvedPreset} />
    </div>
  </main>
  )}
</BaseLayout>
