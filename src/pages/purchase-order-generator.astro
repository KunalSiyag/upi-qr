---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PurchaseOrderGenerator } from "../components/PurchaseOrderGenerator";

const title = "Free Purchase Order Generator for Indian Businesses | Pro UPI QR";
const description = "Create GST-ready purchase order PDFs with buyer/supplier GSTINs, item lists, delivery terms, and digital sign-off. Browser-only, no login.";

const faqs = [
  {
    question: "What is a purchase order and when do I need one?",
    answer: "A purchase order (PO) is a formal document a buyer sends to a supplier to order goods or services at agreed rates. It protects both sides — the supplier gets a written commitment before stocking or manufacturing, and the buyer gets locked-in prices and delivery terms. Indian businesses use POs before receiving goods so the invoice can reference the PO number."
  },
  {
    question: "Is a purchase order mandatory under GST?",
    answer: "GST does not mandate a PO — only a tax invoice and e-way bill are statutory. However, most medium and large businesses require a numbered PO from you before they release payment or process your invoice. This tool lets you generate a properly formatted PO with your supplier GSTIN and delivery terms so your buyer can process it in their ERP without delays."
  },
  {
    question: "Can I add my company logo and terms to the PO?",
    answer: "Yes. Fill in your supplier name, GSTIN, address, and terms. The PDF reflects everything. The PO can also include delivery date expectations and a signatory block. No upload — type it once, export as PDF."
  },
  {
    question: "Does this upload my PO data to a server?",
    answer: "No. The draft is saved in localStorage on your browser. Nothing is uploaded. Export as PDF from your device — no account, no cloud storage."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Purchase Order Generator by Pro UPI QR",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/purchase-order-generator/",
      description,
      featureList: ["Purchase order with buyer and supplier GSTINs", "Line items with quantity, rate, GST", "Delivery date and terms", "PDF export"],
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } }))
    },
    {
      "@type": "HowTo",
      name: "How to create a purchase order",
      step: [
        { "@type": "HowToStep", name: "Enter buyer and supplier details with GSTINs" },
        { "@type": "HowToStep", name: "Add items with quantity, rate, and GST" },
        { "@type": "HowToStep", name: "Set delivery date and terms" },
        { "@type": "HowToStep", name: "Download as PDF" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a><span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a><span>/</span>
          <span class="text-forest font-bold" aria-current="page">Purchase Order</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Merchant documents</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Purchase order generator for Indian businesses</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Create a formal purchase order with buyer and supplier GSTINs, itemised rates, delivery terms, and digital sign-off. Free, no signup, everything stays in your browser.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#po-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Create PO now</a>
            <a href="#faqs" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">How it works ↓</a>
          </div>
        </div>
      </div>
    </section>
    <section id="po-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl"><PurchaseOrderGenerator client:visible /></div>
    </section>
    <section class="px-4 py-14 md:px-6 lg:px-8"><div class="mx-auto max-w-5xl">
      <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Purchase order questions</h2>
      <div class="mt-8 grid gap-4">
        {faqs.map((faq) => (<details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5"><summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary><p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p></details>))}
      </div>
    </div></section>
    <section class="px-4 pb-16 md:px-6 lg:px-8"><div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10">
      <h2 class="text-2xl font-black tracking-tight md:text-3xl">Complete your document stack.</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/72">Purchase orders, invoices, challans, and bills of supply — create the full billing lifecycle in one place.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/invoice-generator/" class="rounded-full bg-sun px-5 py-2.5 text-sm font-black text-forest hover:bg-white transition">Invoice PDF →</a>
        <a href="/tools/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">All tools</a>
      </div>
    </div></section>
  </main>
</BaseLayout>