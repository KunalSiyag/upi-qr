---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GeneratorForm } from "../../components/GeneratorForm";
import AffiliateProducts from "../../components/AffiliateProducts.astro";
import InternalLinkHub from "../../components/InternalLinkHub.astro";
import { getPresetFromSlug, type GeneratorSlug } from "../../data/internalLinks";
import LocalizedToolPage from "../../components/LocalizedToolPage.astro";
import { LOCALIZED_TOOLS, getLocalizedToolCopy } from "../../data/localizedTools";

export async function getStaticPaths() {
  return [
    {
      params: { slug: "phonepe-qr-generator" },
      props: {
        title: "PhonePe QR జనరేటర్",
        headline: "PhonePe అనుకూల ఉచిత UPI QR కోడ్ సృష్టించండి",
        presetType: "phonepe",
        intro: "ఎలాంటి సైన్అప్ లేకుండా PhonePe మరియు ఇతర UPI యాప్‌లతో పనిచేసే QR కోడ్‌ను సృష్టించండి."
      }
    },
    {
      params: { slug: "google-pay-qr-generator" },
      props: {
        title: "Google Pay QR జనరేటర్",
        headline: "Google Pay అనుకూల ఉచిత UPI QR కోడ్ సృష్టించండి",
        presetType: "gpay",
        intro: "Google Pay యాప్ కోసం తక్షణ చెల్లింపు UPI QR కోడ్‌ను సృష్టించండి."
      }
    },
    {
      params: { slug: "paytm-qr-generator" },
      props: {
        title: "Paytm QR జనరేటర్",
        headline: "Paytm అనుకూల ఉచిత UPI QR కోడ్ సృష్టించండి",
        presetType: "paytm",
        intro: "షాపులు మరియు వ్యాపారాల కోసం Paytm అనుకూల UPI QR కోడ్‌ను రూపొందించండి."
      }
    },
    {
      params: { slug: "sbi-qr-generator" },
      props: {
        title: "SBI UPI QR జనరేటర్",
        headline: "SBI బ్యాంక్ ఖాతా కోసం UPI QR సృష్టించండి",
        presetType: "sbi",
        intro: "State Bank of India ఖాతాల కోసం తక్షణమే UPI QR కోడ్‌ను పొందండి."
      }
    },
    ...LOCALIZED_TOOLS.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }))
  ];
}

const { slug } = Astro.params;
const { title, headline, presetType, intro, tool } = Astro.props;

const generatorSlug = slug as GeneratorSlug;
const resolvedPreset = tool ? undefined : (presetType ?? getPresetFromSlug(generatorSlug));

const localeCopy = tool ? getLocalizedToolCopy(tool, "te") : null;
const description = localeCopy
  ? localeCopy.description
  : `${intro} 100% ఉచితం; తక్షణ డౌన్‌లోడ్.`;
const pageTitle = localeCopy ? localeCopy.title : `${title} | Pro UPI QR`;
const pageUrl = new URL(Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site).toString();
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: localeCopy?.name ?? title,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url: pageUrl,
      description,
      inLanguage: "te-IN",
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
    },
  ],
};
---

<BaseLayout title={pageTitle} description={description} schema={schema}>
  {tool ? (
    <LocalizedToolPage lang="te" tool={tool} />
  ) : (
  <main class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-[2rem] border border-white/75 bg-white/86 p-4 sm:p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
      <a href="/te/" class="inline-block mb-4 text-xs font-bold text-leaf hover:underline">&larr; ప్రధాన పేజీకి తిరిగి వెళ్లండి</a>
      
      <p class="text-xs font-black uppercase tracking-[0.2em] text-leaf">తక్షణ చెల్లింపు QR</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-forest md:text-5xl">{headline}</h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-forest/72 md:text-base">{intro}</p>

      <div class="mt-8">
        <GeneratorForm client:visible presetType={resolvedPreset} lang="te" />
      </div>

      <AffiliateProducts />
      <InternalLinkHub variant="both" currentGenerator={generatorSlug} presetType={resolvedPreset} lang="te" />
    </div>
  </main>
  )}
</BaseLayout>
