---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GeneratorForm } from "../../components/GeneratorForm";
import AffiliateProducts from "../../components/AffiliateProducts.astro";

const title = "ఉచిత UPI QR కోడ్ జనరేటర్ | దుకాణాల కోసం UPI QR సృష్టించండి";
const description =
  "ఉచితంగా మొత్తం నమోదు చేసి UPI QR కోడ్ సృష్టించండి. Paytm, PhonePe, Google Pay (GPay) వంటి అన్ని UPI యాప్‌లకు పనిచేసే universal UPI QR.";

const faqs = [
  {
    question: "UPI QR కోడ్‌ని ఎలా తయారు చేయాలి?",
    answer: "మీ UPI ID మరియు పేరును నమోదు చేసి తక్షణమే ఉచితంగా UPI QR కోడ్‌ను డౌన్‌లోడ్ చేసుకోండి."
  },
  {
    question: "ఇది అన్ని UPI యాప్‌లలో పనిచేస్తుందా?",
    answer: "అవును, ఇది Google Pay, PhonePe, Paytm, BHIM మరియు అన్ని బ్యాంకింగ్ యాప్‌లతో 100% పనిచేస్తుంది."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Pro UPI QR (Telugu)",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/te/"
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-[2rem] border border-white/75 bg-white/86 p-4 sm:p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
      <div class="text-center">
        <span class="inline-block rounded-full bg-leaf/10 px-4 py-1.5 text-xs font-black uppercase tracking-wider text-forest">
          ఉచిత UPI QR జనరేటర్ (తెలుగు)
        </span>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-forest md:text-5xl">
          మీ షాప్ కోసం ఉచిత UPI QR కోడ్ సృష్టించండి
        </h1>
        <p class="mt-3 text-sm text-forest/75 md:text-base max-w-2xl mx-auto">
          Google Pay, PhonePe, Paytm యాప్‌లకు తక్షణమే రూపకల్పన చేయండి.
        </p>
      </div>

      <div class="mt-8">
        <GeneratorForm client:load />
      </div>

      <div class="mt-12 border-t border-forest/10 pt-10">
        <h2 class="text-2xl font-black text-forest">తరచుగా అడిగే ప్రశ్నలు</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {faqs.map((faq) => (
            <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm space-y-2">
              <h3 class="text-sm font-black text-forest flex items-start gap-2">
                <span class="text-leaf shrink-0">ప్ర.</span>
                <span>{faq.question}</span>
              </h3>
              <p class="text-xs text-forest/75 leading-relaxed pl-5">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>

      <AffiliateProducts />
    </div>
  </main>
</BaseLayout>
