---
import BaseLayout from "../layouts/BaseLayout.astro";
import { StickerSheetGenerator } from "../components/StickerSheetGenerator";
import InternalLinkHub from "../components/InternalLinkHub.astro";
import { ogImageForPath } from "../data/siteImages";

const title = "Free PhonePe QR Sticker Generator — Print for Shop";
const description =
  "Print a PhonePe, Google Pay, or Paytm UPI QR sticker for your shop. A4 sheet of 4, 6, or 12 stickers. Not official PhonePe — works on every UPI app.";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "PhonePe & GPay QR Sticker Generator",
  "alternateName": [
    "PhonePe QR sticker generator",
    "Google Pay QR sticker generator",
    "UPI QR sticker sheet"
  ],
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "url": "https://www.proupiqr.in/qr-sticker-generator/",
  "description": description,
  "featureList": [
    "PhonePe, Google Pay, Paytm, and BHIM sticker looks",
    "Shop name and UPI ID on every sticker",
    "A4 sheets of 4, 6, or 12 stickers",
    "Standard upi://pay QR — any UPI app can scan",
    "PNG and PDF download, no signup"
  ],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "@id": "https://www.proupiqr.in/qr-sticker-generator/#howto",
  "name": "How to print a PhonePe QR sticker for your shop",
  "description": "Create a free UPI payment sticker that looks like a PhonePe or GPay counter sticker and print it on A4 paper.",
  "totalTime": "PT2M",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Choose PhonePe, GPay, or Paytm look",
      "text": "Pick a sticker style. This only changes the header colour and logo. The QR is a standard upi://pay code, not an official PhonePe or Google Pay merchant kit."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Enter shop name and UPI ID",
      "text": "Type the name customers should see and your VPA, for example shop@ybl or name@oksbi. Amount is optional."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Print 4, 6, or 12 stickers on A4",
      "text": "Download the PNG or A4 PDF, print on matte sticker paper, cut, and paste at the counter. Test-scan with PhonePe and Google Pay before laminating."
    }
  ]
};

const faqs = [
  {
    q: "How do I get a PhonePe QR code sticker for my shop?",
    a: "Paste your UPI ID, pick the PhonePe look, and print an A4 sheet. You do not need to order from PhonePe. The sticker encodes your VPA so any UPI app can pay you."
  },
  {
    q: "Is this the official PhonePe QR sticker?",
    a: "No. PhonePe Business kits, KYC, and soundboxes still come from the PhonePe app. This generator prints a compatible upi://pay sticker with a PhonePe-style header. Customers can scan it from PhonePe, Google Pay, Paytm, or BHIM."
  },
  {
    q: "Can I print a Google Pay QR sticker?",
    a: "Yes. Choose the Google Pay look. Same UPI ID, GPay-coloured header. It is not a Google Pay for Business merchant QR; it is a printable sticker for the VPA you already own."
  },
  {
    q: "Can I order a PhonePe QR sticker online for free?",
    a: "You can print one free here. Official PhonePe sticker orders go through PhonePe Business and may take days. Print today on sticker paper, or compare print-vs-order in our PhonePe sticker guide."
  },
  {
    q: "How many UPI QR stickers fit on one A4 sheet?",
    a: "4 large desk stickers, 6 standard counter stickers, or 12 compact labels for parcels and boxes."
  },
  {
    q: "What paper should I use?",
    a: "Self-adhesive matte vinyl or 120–180 GSM sticker paper. Glossy lamination can glare and fail scans. Test one sticker at the counter distance before printing a full batch."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  schema={[schema, howToSchema, faqSchema]}
  image={ogImageForPath("/qr-sticker-generator/").src}
>
  <main class="px-3 sm:px-4 py-8 sm:py-12 md:py-16 w-full min-w-0">
    <div class="mx-auto max-w-6xl rounded-[2rem] sm:rounded-[2.5rem] border border-white/75 bg-white/86 p-4 sm:p-8 md:p-12 shadow-[0_24px_64px_rgba(17,59,44,0.06)] backdrop-blur-md w-full min-w-0">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-bold text-leaf/80 mb-6">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <a href="/print-upi-qr/" class="hover:underline">Print</a>
        <span>/</span>
        <span class="text-forest">PhonePe QR sticker</span>
      </nav>

      <div class="max-w-3xl">
        <p class="inline-flex rounded-full border border-[#5f259f]/20 bg-[#5f259f]/5 px-3.5 py-1.5 sm:px-4 sm:py-2 text-[10px] sm:text-xs font-black uppercase tracking-[0.2em] sm:tracking-[0.26em] text-[#5f259f]">
          PhonePe · GPay · Paytm sticker studio
        </p>
        <h1 class="mt-4 sm:mt-5 text-3xl font-black leading-[1.08] tracking-tight text-forest sm:text-5xl md:text-6xl">
          Free PhonePe &amp; GPay QR Sticker Generator
        </h1>
        <p class="mt-4 sm:mt-6 text-base sm:text-lg leading-relaxed text-forest/75">
          Print a shop QR sticker that looks like a PhonePe or Google Pay counter sticker. Shop name and UPI ID on every label. Not an official merchant kit — any UPI app can scan it.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-forest/65">
          Need a full-page standee instead? Use the
          <a href="/#generator" class="font-bold text-leaf hover:underline">UPI QR code generator</a>.
          Compare print vs order in the
          <a href="/blog/phonepe-qr-sticker-print-free-vs-order/" class="font-bold text-leaf hover:underline">PhonePe sticker guide</a>.
        </p>
      </div>

      <div id="tool" class="mt-8 sm:mt-10 w-full min-w-0 scroll-mt-28">
        <StickerSheetGenerator client:load />
      </div>

      <section class="mt-16 sm:mt-24 border-t border-forest/10 pt-12 sm:pt-16 max-w-4xl">
        <h2 class="text-2xl sm:text-3xl font-black text-forest tracking-tight">
          Print a PhonePe QR sticker today — do not wait for a kit
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-forest/80">
          Search results for “PhonePe QR code sticker order online free” and “how to get PhonePe QR code sticker for shop” usually mean one thing: a peel-off label for the glass, till, or parcel. Official PhonePe Business kits need KYC and shipping. This page prints a compatible sticker from the UPI ID you already have.
        </p>

        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          <div class="rounded-2xl border border-[#5f259f]/15 bg-[#5f259f]/5 p-5">
            <h3 class="text-base font-black text-[#5f259f]">PhonePe look</h3>
            <p class="mt-2 text-xs leading-relaxed text-forest/70">
              Purple header, PhonePe mark in the QR. Same VPA — customers still pay from GPay or Paytm.
            </p>
          </div>
          <div class="rounded-2xl border border-[#1a73e8]/15 bg-[#1a73e8]/5 p-5">
            <h3 class="text-base font-black text-[#1a73e8]">Google Pay look</h3>
            <p class="mt-2 text-xs leading-relaxed text-forest/70">
              Blue GPay header for shops that already display Google Pay branding. Still a universal UPI QR.
            </p>
          </div>
          <div class="rounded-2xl border border-[#00baf2]/15 bg-[#00baf2]/5 p-5">
            <h3 class="text-base font-black text-[#00baf2]">Paytm / BHIM look</h3>
            <p class="mt-2 text-xs leading-relaxed text-forest/70">
              Cyan Paytm or saffron BHIM headers for bank-led counters that never used PhonePe.
            </p>
          </div>
        </div>

        <h2 class="mt-14 text-2xl sm:text-3xl font-black text-forest tracking-tight">
          Sticker sizes, paper, and where to paste
        </h2>
        <div class="mt-6 overflow-x-auto rounded-2xl border border-forest/10 bg-white shadow-sm">
          <table class="w-full text-left border-collapse text-xs min-w-[500px]">
            <caption class="sr-only">A4 UPI QR sticker grid sizes, uses, and paper stock</caption>
            <thead>
              <tr class="border-b border-forest/10 bg-cream/30 text-forest font-bold">
                <th scope="col" class="p-4">Sticker grid</th>
                <th scope="col" class="p-4">Size</th>
                <th scope="col" class="p-4">Best for</th>
                <th scope="col" class="p-4">Paper</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-forest/5 text-forest/80">
              <tr>
                <td class="p-4 font-bold text-leaf">6 per A4</td>
                <td class="p-4 font-mono">85 mm × 85 mm</td>
                <td class="p-4">Kirana counters, billing desks, PhonePe-style till stickers</td>
                <td class="p-4">Self-adhesive matte vinyl, 135 GSM</td>
              </tr>
              <tr>
                <td class="p-4 font-bold text-leaf">4 per A4</td>
                <td class="p-4 font-mono">95 mm × 95 mm</td>
                <td class="p-4">Acrylic standee inserts, glass doors</td>
                <td class="p-4">Heavy matte sticker paper, 180 GSM</td>
              </tr>
              <tr>
                <td class="p-4 font-bold text-leaf">12 per A4</td>
                <td class="p-4 font-mono">60 mm × 60 mm</td>
                <td class="p-4">Parcels, tiffin lids, extra tills</td>
                <td class="p-4">Standard matte label sheet</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 class="mt-16 text-2xl sm:text-3xl font-black text-forest tracking-tight">
          Frequently asked questions
        </h2>
        <div class="mt-6 space-y-4">
          {faqs.map((faq) => (
            <details class="group rounded-2xl border border-forest/10 bg-white p-5 text-forest [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between font-bold text-sm sm:text-base">
                <span>{faq.q}</span>
                <span class="ml-1.5 shrink-0 rounded-full bg-mint p-1 text-leaf group-open:-rotate-180 transition-transform duration-300">▼</span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm leading-relaxed text-forest/75">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <div class="mt-16">
        <InternalLinkHub currentPath="/qr-sticker-generator/" />
      </div>
    </div>
  </main>
</BaseLayout>
