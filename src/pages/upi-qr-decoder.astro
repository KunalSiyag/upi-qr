---
import BaseLayout from "../layouts/BaseLayout.astro";
import { UpiQrDecoder } from "../components/UpiQrDecoder";
import InternalLinkHub from "../components/InternalLinkHub.astro";

const title = "Free UPI QR Validator & Decoder – Extract & Verify UPI ID Online";
const description =
  "Upload a UPI QR image to extract VPA, payee name, and amount — then check for missing fields, tamper clues, and invalid syntax. 100% private in-browser safety report.";

const faqs = [
  {
    question: "What does the UPI QR safety validator check?",
    answer:
      "It decodes the hidden upi://pay URI, then runs syntax and safety checks: missing mandatory VPA, invalid amount, unusual bank handles, payee name mismatches, and non-standard UPI intents. Each check returns a colour-coded warning so you can spot issues before printing or scanning."
  },
  {
    question: "Is scanning/decoding QR codes on this site secure?",
    answer:
      "Yes, 100% secure. The decoding and validation happen directly inside your web browser using HTML5 JavaScript. Your image is never uploaded to any external server or saved anywhere."
  },
  {
    question: "Can I extract the UPI ID from PhonePe, GPay, or Paytm QR codes?",
    answer:
      "Yes. All standard Indian UPI QR codes — including PhonePe, Google Pay, Paytm, BHIM, SBI, HDFC, and ICICI — use a standardised upi://pay format that this decoder parses instantly."
  },
  {
    question: "What should I do if the validator reports a suspicious QR?",
    answer:
      "Do not print or display a QR flagged as suspicious. Double-check the UPI ID with the payer, test with a ₹1 scan from another device, and regenerate a fresh QR using the 'Create Standee' link so you control all the fields."
  },
  {
    question: "What details can I get from a decoded UPI QR code?",
    answer:
      "You can extract the Virtual Payment Address (VPA / UPI ID), Payee Name, Fixed Transaction Amount, Payment Note, Merchant Category Code (MCC), and the full raw upi://pay URI string."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://www.proupiqr.in/upi-qr-decoder/#webapp",
      "name": "Free Online UPI QR Validator & Safety Decoder | Pro UPI QR",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/upi-qr-decoder/",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "HowTo",
      "@id": "https://www.proupiqr.in/upi-qr-decoder/#howto",
      "name": "How to Validate a UPI QR Code Before Printing",
      "description": "Upload, decode, and safety-check any UPI QR image in three steps before displaying it at a shop counter.",
      "totalTime": "PT30S",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Upload or Paste QR Code Image",
          "text": "Select your QR code image from your phone/PC gallery or press Ctrl+V to paste a screenshot."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Review the Safety Report",
          "text": "Check the colour-coded verdict. Green = looks safe. Amber = minor concern. Red = do not use without verification."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Copy, Recreate, or Print",
          "text": "Copy the extracted VPA for your records, or click 'Create Standee' to regenerate a fresh, verified print-ready poster."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.proupiqr.in/upi-qr-decoder/#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": " " + faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="py-8">
    <section class="px-5 pb-6 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-mint border border-leaf/20 text-xs font-black text-forest uppercase tracking-wider mb-3">
        <svg class="h-3.5 w-3.5 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span>100% Private Browser Tool</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-forest">
        UPI QR Validator & Safety Decoder
      </h1>
      <p class="mt-3 text-base text-forest/75 leading-relaxed">
        Upload any UPI QR code image to <strong>extract and safety-check</strong> every hidden field — VPA, payee name, amount, and more. Get a colour-coded verdict before you print, display, or scan.
      </p>
    </section>

    <section class="px-4 pb-12">
      <UpiQrDecoder client:visible />
    </section>

    <section class="max-w-4xl mx-auto px-5 pb-12">
      <div class="rounded-3xl border border-forest/10 bg-white p-6 md:p-8 shadow-sm">
        <h2 class="text-2xl font-black text-forest">What the Validator Checks</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl bg-cream p-5 border border-forest/10">
            <div class="rounded-xl bg-forest/10 p-2.5 w-fit mb-3 text-forest">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="font-black text-forest text-base">Syntax Completeness</h3>
            <p class="mt-1.5 text-xs text-forest/70 leading-relaxed">
              Verifies the mandatory VPA (pa=) field, the upi://pay scheme, and parameter format. Flags missing or malformed fields immediately.
            </p>
          </div>
          <div class="rounded-2xl bg-cream p-5 border border-forest/10">
            <div class="rounded-xl bg-forest/10 p-2.5 w-fit mb-3 text-forest">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
            </div>
            <h3 class="font-black text-forest text-base">Tamper Clues</h3>
            <p class="mt-1.5 text-xs text-forest/70 leading-relaxed">
              Detects unusually short bank handles, missing payee names, amounts exceeding UPI limits, and non-standard merchant category codes.
            </p>
          </div>
          <div class="rounded-2xl bg-cream p-5 border border-forest/10">
            <div class="rounded-xl bg-forest/10 p-2.5 w-fit mb-3 text-forest">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="font-black text-forest text-base">One-Click Recreate</h3>
            <p class="mt-1.5 text-xs text-forest/70 leading-relaxed">
              If the decoded QR looks safe, click one button to pre-fill the standee generator with the same UPI ID and print a fresh verified poster.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-5 pb-12">
      <h2 class="text-2xl font-black text-forest text-center mb-6">Frequently Asked Questions</h2>
      <div class="grid gap-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm">
            <h3 class="text-base font-black text-forest">{faq.question}</h3>
            <p class="mt-2 text-sm text-forest/75 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <InternalLinkHub />
  </main>
</BaseLayout>