---
import BaseLayout from "../layouts/BaseLayout.astro";
import { UpiQrDecoder } from "../components/UpiQrDecoder";
import InternalLinkHub from "../components/InternalLinkHub.astro";

const title = "Free Online UPI QR Code Scanner & Decoder – Extract UPI ID from Image";
const description =
  "Scan or upload any UPI QR code image online to extract the UPI ID (VPA), payee name, amount & raw payment link. 100% free, browser-side & private.";

const faqs = [
  {
    question: "How do I extract a UPI ID from a QR code image?",
    answer:
      "Simply upload or drag & drop your QR code image (PNG, JPG, WebP) into our decoder above. You can also paste an image screenshot using Ctrl+V. Our tool decodes the QR data locally and displays the exact Virtual Payment Address (VPA) and payee details."
  },
  {
    question: "Is scanning/decoding QR codes on this site secure?",
    answer:
      "Yes, 100% secure. The decoding happens directly inside your web browser using HTML5 JavaScript. Your image is never uploaded to any external server or saved anywhere."
  },
  {
    question: "Can I extract the UPI ID from PhonePe, GPay, or Paytm QR codes?",
    answer:
      "Yes. All standard Indian UPI QR codes — including PhonePe, Google Pay, Paytm, BHIM, SBI, HDFC, and ICICI — use a standardized upi://pay format that this decoder parses instantly."
  },
  {
    question: "What details can I get from a decoded UPI QR code?",
    answer:
      "You can extract the Virtual Payment Address (VPA / UPI ID), Payee Name, Fixed Transaction Amount (if specified), Transaction Note / Remarks, and the raw payment URI string."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://www.proupiqr.in/upi-qr-decoder/#webapp",
      "name": "Free Online UPI QR Code Decoder & Scanner | Pro UPI QR",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/upi-qr-decoder/",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "HowTo",
      "@id": "https://www.proupiqr.in/upi-qr-decoder/#howto",
      "name": "How to Extract UPI ID from QR Code Image Online",
      "description": "Extract the UPI Virtual Payment Address (VPA) and payment details from any QR code image in three simple steps.",
      "totalTime": "PT30S",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Upload or Paste QR Code Image",
          "text": "Select your QR code image from your phone/PC gallery or press Ctrl+V to paste a screenshot."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Automatic Local Decoding",
          "text": "Our browser-based decoder instantly parses the hidden upi://pay URI data within milliseconds."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Copy UPI ID or Print Standee",
          "text": "Click 'Copy VPA' to copy the extracted UPI handle, or click 'Create Standee' to generate a print-ready poster."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.proupiqr.in/upi-qr-decoder/#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": " " + faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="py-8">
    <section class="px-5 pb-6 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mint border border-leaf/20 text-xs font-black text-forest uppercase tracking-wider mb-3">
        🔍 100% Free & Browser-Based Utility
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-forest">
        Online UPI QR Code Decoder & Scanner
      </h1>
      <p class="mt-3 text-base text-forest/75 leading-relaxed">
        Upload or paste any UPI QR code screenshot to extract the <strong>UPI ID (VPA)</strong>, Payee Name, Amount, and transaction links. Decoded locally on your device for absolute privacy.
      </p>
    </section>

    <!-- Interactive Decoder Tool -->
    <section class="px-4 pb-12">
      <UpiQrDecoder client:load />
    </section>

    <!-- Step-by-Step Info Guide -->
    <section class="max-w-4xl mx-auto px-5 pb-12">
      <div class="rounded-3xl border border-forest/10 bg-white p-6 md:p-8 shadow-sm">
        <h2 class="text-2xl font-black text-forest">Why Use Our Free Online UPI QR Decoder?</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl bg-cream p-5 border border-forest/10">
            <div class="text-2xl mb-2">⚡</div>
            <h3 class="font-black text-forest text-base">Instant Extraction</h3>
            <p class="mt-1.5 text-xs text-forest/70 leading-relaxed">
              No need to type manual payment handles. Extract hidden VPAs from gallery screenshots in seconds.
            </p>
          </div>
          <div class="rounded-2xl bg-cream p-5 border border-forest/10">
            <div class="text-2xl mb-2">🔒</div>
            <h3 class="font-black text-forest text-base">Privacy Guaranteed</h3>
            <p class="mt-1.5 text-xs text-forest/70 leading-relaxed">
              Decoding runs 100% locally inside your web browser. No image data is sent to external servers.
            </p>
          </div>
          <div class="rounded-2xl bg-cream p-5 border border-forest/10">
            <div class="text-2xl mb-2">🖼️</div>
            <h3 class="font-black text-forest text-base">Re-Create Counter Posters</h3>
            <p class="mt-1.5 text-xs text-forest/70 leading-relaxed">
              Extract details from damaged or old QR stickers and print crisp new standee posters instantly.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-4xl mx-auto px-5 pb-12">
      <h2 class="text-2xl font-black text-forest text-center mb-6">Frequently Asked Questions</h2>
      <div class="grid gap-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm">
            <h3 class="text-base font-black text-forest">{faq.question}</h3>
            <p class="mt-2 text-sm text-forest/75 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal Link Hub -->
    <InternalLinkHub />
  </main>
</BaseLayout>
