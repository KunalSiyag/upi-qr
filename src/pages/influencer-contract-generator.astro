---
import BaseLayout from "../layouts/BaseLayout.astro";
import { InfluencerContractGenerator } from "../components/InfluencerContractGenerator";

const title = "Influencer Contract Generator - Brand & Creator Agreement";
const description = "Create a legally sound influencer contract PDF with deliverables, exclusivity, ASCI disclosure, and advance UPI QR. 100% private in-browser generator.";

const faqs = [
  {
    question: "What is an influencer collaboration agreement?",
    answer: "An influencer collaboration agreement is a legally binding contract between a brand (or marketing agency) and a content creator. It defines campaign deliverables, posting timelines, exclusivity periods, usage and whitelisting rights, compensation, and mandatory advertising disclosures."
  },
  {
    question: "Why are ASCI disclosures mandatory in Indian creator contracts?",
    answer: "Under ASCI (Advertising Standards Council of India) guidelines and the Consumer Protection Act 2019, influencers must explicitly disclose material connections with brands. Contracts should mandate clear labels like #ad, #collab, or platform 'Paid Partnership' tags to protect both the creator and the brand from regulatory penalties."
  },
  {
    question: "What is the difference between organic usage and paid ad whitelisting?",
    answer: "Organic usage allows the content to stay on the creator's profile feed. Paid ad whitelisting (or Meta Partnership Ads / Spark Ads) grants the brand permission to run targeted advertising spend through the creator's handle. Contracts should specify whitelisting duration (e.g. 30 or 60 days) and compensation."
  },
  {
    question: "How should payment and advance retainers be structured?",
    answer: "Standard industry practice is a 50% advance retainer upon signing before filming starts, with the remaining 50% balance paid within 7 to 15 days of the content going live and verified link submission. The embedded advance UPI QR allows instant, direct bank settlements without third-party commission."
  },
  {
    question: "Is my contract data saved or sent to any server?",
    answer: "No. Pro UPI QR tools run entirely client-side. Your campaign details, creator handles, commercial rates, and PAN numbers are saved only in your local browser storage and never uploaded to our servers."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Influencer Contract Generator by Pro UPI QR",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/influencer-contract-generator/",
      description,
      featureList: [
        "Creator and brand collaboration agreement",
        "Deliverable table with format, due dates, and pricing",
        "Exclusivity and paid ad whitelisting clauses",
        "ASCI regulatory disclosure compliance",
        "Advance payment UPI QR integration",
        "Instant PDF and PNG legal contract export"
      ],
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to create an influencer contract",
      description: "Generate a legally binding influencer marketing agreement with clear deliverables and advance UPI payment in under two minutes.",
      step: [
        { "@type": "HowToStep", name: "Enter brand and creator details with handles and PAN" },
        { "@type": "HowToStep", name: "Add campaign deliverables, formats, and due dates" },
        { "@type": "HowToStep", name: "Configure advance deposit, exclusivity, and whitelisting terms" },
        { "@type": "HowToStep", name: "Export as high-resolution PDF or copy agreement text" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a><span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a><span>/</span>
          <span class="text-forest font-bold" aria-current="page">Influencer Contract</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">
            Creator Economy Legal Stack
          </p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">
            Free Influencer Contract Generator
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">
            Build clear, legally sound brand collaboration agreements with itemised deliverables, ASCI disclosure rules, exclusivity windows, and advance UPI payment QR codes. 100% private in-browser tool.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#contract-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">
              Create Agreement Now
            </a>
            <a href="#faqs" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">
              Legal FAQ & Terms &darr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="contract-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <InfluencerContractGenerator client:visible />
      </div>
    </section>

    <section id="faqs" class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Influencer contract questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10">
        <h2 class="text-2xl font-black tracking-tight md:text-3xl">Complete your creator & freelancer workflow.</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/72">
          From collaboration agreements and GST quotations to advance payment QRs and payment receipts — run your creative business professionally.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/freelance-contract-generator/" class="rounded-full bg-sun px-5 py-2.5 text-sm font-black text-forest hover:bg-white transition">
            Freelance Contract &rarr;
          </a>
          <a href="/quotation-generator/" class="rounded-full bg-white/15 px-5 py-2.5 text-sm font-bold hover:bg-white/25 transition">
            Quotation Generator
          </a>
          <a href="/receipt-generator/" class="rounded-full bg-white/15 px-5 py-2.5 text-sm font-bold hover:bg-white/25 transition">
            Receipt Generator
          </a>
          <a href="/tools/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">
            All tools
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
