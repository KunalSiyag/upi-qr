---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RentReceiptGenerator } from "../components/RentReceiptGenerator";

const title = "Free Rent Receipt Generator with Revenue Stamp Format | Pro UPI QR";
const description = "Create monthly rent receipt PDFs with amount in words, revenue stamp box, and landlord PAN for HRA tax claims. Free, browser-only, no signup required.";

const faqs = [
  {
    question: "Why do tenants need rent receipts for HRA exemption?",
    answer: "Indian employers and the income tax department ask for signed monthly rent receipts as proof of payment when you claim House Rent Allowance (HRA) deductions. This tool creates one receipt per month in the standard format with amount in words, revenue stamp box, and optional landlord PAN."
  },
  {
    question: "Does a rent receipt need a revenue stamp?",
    answer: "For cash payments of ₹5,000 or more per month, Indian stamp law expects a revenue stamp signed by the landlord. The receipt includes a dedicated revenue stamp box; for UPI or bank transfers it is usually not required, which is why we also print the payment mode on every receipt."
  },
  {
    question: "Can I generate receipts for all 12 months at once?",
    answer: "Generate one month, then tap 'Next month + new number' — it advances the period and increments the receipt number automatically so you can produce and download each month's receipt in seconds."
  },
  {
    question: "Is my rent data uploaded anywhere?",
    answer: "No. Receipts are generated entirely inside your browser and drafts stay on your device. Nothing is transmitted or stored on our servers."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Rent Receipt Generator by Pro UPI QR",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/rent-receipt-generator/",
      "description": description,
      "featureList": [
        "Monthly rent receipt PDF generator",
        "Amount in words for HRA claims",
        "Revenue stamp box format",
        "Landlord PAN field",
        "UPI QR for next month's rent"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      "name": "How to create a rent receipt for HRA",
      "description": "Generate a printable monthly rent receipt in your browser.",
      "step": [
        { "@type": "HowToStep", "name": "Enter landlord, tenant, address, and monthly rent" },
        { "@type": "HowToStep", "name": "Pick the rent month and payment mode" },
        { "@type": "HowToStep", "name": "Review amount in words and revenue stamp box" },
        { "@type": "HowToStep", "name": "Download the PDF and get the landlord's signature" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">Rent Receipt Generator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Merchant toolkit</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Free rent receipt generator with HRA-ready format</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Create signed-ready monthly rent receipts with amount in words, revenue stamp box, landlord PAN, and an optional UPI QR for next month's rent. Download as PDF or share straight to WhatsApp.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#rent-receipt-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Create rent receipt</a>
            <a href="/receipt-generator/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Business payment receipts →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="rent-receipt-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <RentReceiptGenerator client:load />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-white md:p-10">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-sun">More billing tools</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">One toolkit for every money document.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {[
            ["Payment Receipt Generator", "Acknowledge business payments with PAID-stamped receipt PDFs.", "/receipt-generator/"],
            ["UPI Invoice Generator", "Bill customers with GST-ready invoices and an embedded payment QR.", "/invoice-generator/"],
            ["Paid Stamp Generator", "Stamp existing bill photos as PAID with date and signature.", "/paid-stamp-generator/"]
          ].map(([heading, copy, href]) => (
            <article class="flex flex-col rounded-[1.5rem] border border-white/10 bg-white/8 p-5">
              <h3 class="text-xl font-black">{heading}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-white/72">{copy}</p>
              <a href={href} class="mt-4 inline-block text-sm font-black text-sun hover:text-white">Open tool →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Rent receipt questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
