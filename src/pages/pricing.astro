---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductShot from "../components/ProductShot.astro";
import { PRO_PRICES, PRO_TRIAL_DAYS, REFUND_WINDOW_DAYS, YEARLY_SAVING_RUPEES } from "../data/pricing";
import { FREE_ACTIVE_PAYLINKS } from "../lib/workspace/paylinks";
import { PLANS } from "../lib/workspace/entitlements";
import { billingProviders } from "../lib/billing/config";
import { checkoutProvider } from "../lib/billing/provider";

// Built per deployment: Pro checkout is open once the payment provider's keys are set (then redeploy).
const checkout = checkoutProvider(billingProviders());
const trialDays = checkout?.id === "dodo" ? PRO_TRIAL_DAYS : 0;

const title = "Pricing — Free UPI Tools, Payment Tracker & Pro | Pro UPI QR";
const description = `Every UPI QR, invoice and calculator stays free. A free account adds sync and ${FREE_ACTIVE_PAYLINKS} pay links. Pro is ${PRO_PRICES.monthly.label}/month for unlimited pay links. We take 0% of your payments.`;
const url = "https://www.proupiqr.in/pricing/";
const signUp = "/sign-up/?redirect_url=" + encodeURIComponent("/app/?tab=settings");

const tiers = [
  {
    name: "Free",
    tag: "No account",
    price: "₹0",
    per: "forever",
    blurb: "Everything you need to get paid on UPI, saved in your browser.",
    features: [
      "All UPI QR generators, posters and stickers",
      "Invoices, receipts, quotations and business calculators",
      "Payment tracker: who owes you, overdue first",
      `${PLANS.free.businesses} business in the payment tracker`,
      "Monthly fees: invoices that repeat every month",
      "WhatsApp and SMS reminders in one tap (English or Hindi)",
      "Match bank statement credits to invoices",
      "Backup file and CSV export",
    ],
    cta: { label: "Open the tracker", href: "/app/" },
    featured: false,
  },
  {
    name: "Free account",
    tag: "Free sign-up",
    price: "₹0",
    per: "forever",
    blurb: "Your tracker on phone and laptop, plus links clients can pay from.",
    features: [
      "Everything in Free",
      "Sync between your devices",
      `${PLANS.free.businesses} business in the payment tracker`,
      `${FREE_ACTIVE_PAYLINKS} active pay links with live amount, UPI button and QR`,
      "Clients send their UTR back; you confirm with one tap",
      "Delete your cloud copy anytime",
    ],
    cta: { label: "Create free account", href: signUp },
    featured: false,
  },
  {
    name: "Pro",
    tag: !checkout
      ? `Opening soon · or ${PRO_PRICES.yearly.label}/year — save ₹${YEARLY_SAVING_RUPEES}`
      : trialDays > 0
        ? `${trialDays} days free · then ${PRO_PRICES.monthly.label}/month or ${PRO_PRICES.yearly.label}/year`
        : `or ${PRO_PRICES.yearly.label}/year — save ₹${YEARLY_SAVING_RUPEES}`,
    price: PRO_PRICES.monthly.label,
    per: "per month",
    blurb: "For businesses sending lots of invoices every month.",
    features: [
      "Everything in Free account",
      "Unlimited active pay links",
      `Up to ${PLANS.pro.businesses} businesses in one account after your first payment, each with its own UPI ID, invoice numbers and pay links`,
      "Client statement links: all dues on one page with one UPI button",
      "Pay pages without our “send your own pay links” line",
      "MSME mode: 45-day MSMED deadlines, Section 16 interest, and your rights in reminders",
      "Early access to automatic WhatsApp reminders (in development)",
    ],
    cta: { label: !checkout ? "Get early access" : trialDays > 0 ? `Start ${trialDays}-day free trial` : "Upgrade to Pro", href: "/app/?tab=settings&upgrade=monthly" },
    featured: true,
  },
];

const faqs = [
  {
    question: "Do you take a cut of my payments?",
    answer: "No. Pro UPI QR takes 0% of your payments. Your client pays from their UPI app straight to your UPI ID. We never hold, route, or settle money, so there is no MDR or gateway fee from us.",
  },
  {
    question: "Is Pro UPI QR really free?",
    answer: "Yes. Every QR generator, document tool, calculator, and the payment tracker work without an account and without paying. A free account adds sync and pay links. Pro is for businesses that need more pay links, client statement links, MSME mode, or more than one business.",
  },
  {
    question: "How do I pay for Pro?",
    answer: "Upgrade from Settings in the payment tracker. Checkout opens on Dodo Payments' secure page, where you can pay with UPI or a card. Dodo is our merchant of record: it handles GST and emails your invoice. GST-registered? Buy as a business and add your GSTIN at checkout. Pro UPI QR never sees your card details or UPI PIN.",
  },
  ...(PRO_TRIAL_DAYS > 0 ? [{
    question: "Is there a free trial?",
    answer: `Yes. Your first Pro subscription starts with ${PRO_TRIAL_DAYS} days free. You add a payment method at checkout and pay ₹0 that day; the first payment is taken when the trial ends. Cancel from Settings before then and you pay nothing. One trial per account. During the trial your account keeps ${PLANS.free.businesses} business; up to ${PLANS.pro.businesses} unlock with the first payment.${checkout ? "" : " Pro checkout opens soon; join early access in Settings to hear when."}`,
  }] : []),
  {
    question: "Can I cancel anytime?",
    answer: "Yes. Cancel from Settings. Renewals stop, and Pro stays on until the end of the period you already paid for. Your invoices, clients, and payments stay in your account.",
  },
  {
    question: "Can I get a refund?",
    answer: REFUND_WINDOW_DAYS > 0
      ? `Yes. Ask within ${REFUND_WINDOW_DAYS} days of your first Pro payment, or of a yearly renewal, and we refund it in full. Duplicate charges and charges after you cancelled are always refunded. The cancellation and refund policy has the details.`
      : "Duplicate charges and charges after you cancelled are always refunded in full. You can cancel before any renewal and keep Pro until the period ends. The cancellation and refund policy has the details.",
  },
  {
    question: "What happens to my pay links if I go back to Free?",
    answer: `Pay links you already shared keep working. You can't create new ones while more than ${FREE_ACTIVE_PAYLINKS} are active, so turn off links for paid invoices to make room.`,
  },
  {
    question: "What happens to my extra businesses if I go back to Free?",
    answer: "Nothing is deleted. Every business stays in your tracker, where you can open it, export it and back it up, and its pay links keep working. On Free only your first business can be edited; the others are read-only, and you can't add another business, until you upgrade again.",
  },
  {
    question: "Where is my data stored?",
    answer: "Without an account, only in your browser. With an account, a synced copy is kept so your devices match; you can delete it from Settings at any time. See the privacy policy for exactly what is stored.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", name: "Pro UPI QR pricing", url, description },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "Pricing", item: url },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="bg-gradient-to-b from-mint/70 via-mint/30 to-white px-4 pb-10 pt-10 md:px-6 md:pt-14 lg:px-8">
      <div class="mx-auto max-w-6xl text-center">
        <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center justify-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="transition-colors hover:text-leaf">Home</a>
          <span>/</span>
          <span class="font-bold text-forest" aria-current="page">Pricing</span>
        </nav>
        <h1 class="mx-auto max-w-3xl text-4xl font-black leading-[1.05] tracking-[-0.02em] text-obsidian md:text-6xl">Free for every shop. Pro when you send a lot of invoices.</h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8">No signup for the tools. No commission on payments — money goes straight from your client's UPI app to your bank.</p>
        <p class="mx-auto mt-6 inline-flex items-center gap-2 rounded-[10px] bg-forest px-5 py-2 text-sm font-black text-sun shadow-[0_8px_24px_-8px_rgba(17,59,44,0.5)]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          0% of your payments. Always.
        </p>
        <ul class="mx-auto mt-6 flex max-w-3xl flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold text-forest/80">
          {[["Pay by UPI or card", "M3 10h18M7 15h2m-4 4h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"], ["GST invoice by email", "M9 12h6m-6 4h6M7 3h7l5 5v11a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"], ["Cancel anytime", "M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"], ...(REFUND_WINDOW_DAYS > 0 ? [[`${REFUND_WINDOW_DAYS}-day refund`, "M4 4v6h6M20 20v-6h-6M5.5 15A7 7 0 0018.6 16M18.5 9A7 7 0 005.4 8"]] : [])].map(([label, d]) => (
            <li class="flex items-center gap-2"><svg class="h-4 w-4 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={d} /></svg>{label}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="px-4 pb-10 md:px-6 lg:px-8" aria-label="Plans">
      <div class="mx-auto grid max-w-6xl items-stretch gap-5 md:grid-cols-3">
        {tiers.map((tier) => (
          <article class={`relative flex flex-col rounded-[14px] p-7 ${tier.featured ? "bg-forest text-white shadow-[0_24px_60px_-20px_rgba(17,59,44,0.55)] md:-my-3 md:py-10" : "bg-white text-forest ring-1 ring-forest/10 shadow-[0_1px_2px_rgba(13,31,23,0.04),0_16px_40px_-24px_rgba(13,31,23,0.25)]"}`}>
            {tier.featured && <span class="absolute -top-3 left-7 rounded-[7px] bg-forest px-3 py-1 text-xs font-black text-white shadow-sm">{trialDays > 0 ? `${trialDays} days free` : "For growing businesses"}</span>}
            <h2 class={`text-xl font-black ${tier.featured ? "text-white" : "text-obsidian"}`}>{tier.name}</h2>
            <p class={`mt-1 text-xs font-bold ${tier.featured ? "text-sun" : "text-leaf"}`}>{tier.tag}</p>
            <p class="mt-6"><span class="text-5xl font-black tracking-tight tabular-nums">{tier.price}</span> <span class={`text-sm ${tier.featured ? "text-white/70" : "text-muted"}`}>{tier.per}</span></p>
            <p class={`mt-3 text-sm leading-6 ${tier.featured ? "text-white/80" : ""}`}>{tier.blurb}</p>
            <a href={tier.cta.href} class={`mt-6 flex h-12 items-center justify-center rounded-[10px] px-5 text-center text-sm font-black transition ${tier.featured ? "bg-forest text-white hover:bg-graphite" : "bg-white text-forest ring-1 ring-forest/25 hover:bg-mint"}`}>{tier.cta.label}</a>
            <ul class={`mt-6 flex-1 space-y-3 border-t pt-6 text-sm ${tier.featured ? "border-white/15" : "border-forest/10"}`}>
              {tier.features.map((feature) => (
                <li class="flex gap-3">
                  <span class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${tier.featured ? "bg-sun/20 text-sun" : "bg-mint text-leaf"}`} aria-hidden="true">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-6xl text-center text-sm text-muted">
        Prices in Indian rupees, GST included. Billed by Dodo Payments, our merchant of record, with UPI or card. Cancel anytime{REFUND_WINDOW_DAYS > 0 ? ` · ${REFUND_WINDOW_DAYS}-day refund on your first payment` : ""}{" · "}
        <a href="/refund-policy/" class="font-bold text-leaf underline">Cancellation &amp; refunds</a>{" · "}
        <a href="/contact/" class="font-bold text-leaf underline">Contact</a>
      </p>
    </section>

    <section class="bg-fog px-4 py-16 md:px-6 lg:px-8">
      <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <h2 class="text-3xl font-black tracking-tight text-obsidian md:text-4xl">See who owes you, at a glance</h2>
          <p class="mt-4 text-lg leading-8">Every plan runs the same payment tracker: what's due, what's late, and one-tap WhatsApp reminders. An account keeps your phone and laptop in step; Pro removes the pay-link limit.</p>
          <a href="/app/" class="mt-6 inline-flex h-12 items-center rounded-[10px] bg-forest px-6 text-sm font-black text-white transition hover:bg-graphite">Try it with sample data &rarr;</a>
        </div>
        <ProductShot />
      </div>
    </section>

    <section class="px-4 py-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-semibold text-leaf">FAQ</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-obsidian md:text-5xl">Pricing questions</h2>
        <div class="mt-8 grid items-start gap-3 md:grid-cols-2">
          {faqs.map((faq) => (
            <details class="group rounded-[14px] bg-white px-5 py-4 ring-1 ring-forest/10 open:bg-fog open:ring-0">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-base font-bold text-obsidian">
                <span>{faq.question}</span>
                <span class="mt-0.5 text-xl leading-none text-forest transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-[15px] leading-7">{faq.answer}</p>
            </details>
          ))}
        </div>
        <p class="mt-8 text-sm text-muted">
          See what's stored in the <a href="/privacy/" class="font-bold text-leaf underline">privacy policy</a>, the plan terms in the <a href="/terms/" class="font-bold text-leaf underline">terms of service</a>, and how cancelling and refunds work in the <a href="/refund-policy/" class="font-bold text-leaf underline">cancellation &amp; refund policy</a>. Start with the <a href="/payment-tracker/" class="font-bold text-leaf underline">free payment tracker</a>.
        </p>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 rounded-[14px] bg-forest px-8 py-10 text-white md:flex-row md:items-center md:px-12">
        <div>
          <p class="text-2xl font-black md:text-3xl">Start free. Upgrade when your invoices grow.</p>
          <p class="mt-2 text-[#c8dccf]">No card needed for the free plans. 0% of your payments, always.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/app/" class="inline-flex h-12 items-center rounded-[10px] bg-forest px-6 text-sm font-black text-white transition hover:bg-graphite">Open the tracker</a>
          <a href={signUp} class="inline-flex h-12 items-center rounded-[10px] px-6 text-sm font-black text-white ring-1 ring-white/40 transition hover:bg-white/10">Create free account</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
