---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { UniversalQrForm } from "../../components/UniversalQrForm";
import AffiliateProducts from "../../components/AffiliateProducts.astro";

const title = "Générateur de QR Code Universel Gratuit | Pro UPI QR";
const description =
  "Générateur de QR code universel gratuit et sans filigrane. Créez des QR codes pour liens web, textes, réseaux Wi-Fi et cartes vCard.";
---

<BaseLayout title={title} description={description}>
  <main class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-[2rem] border border-white/75 bg-white/86 p-4 sm:p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
      <div class="text-center">
        <span class="inline-block rounded-full bg-leaf/10 px-4 py-1.5 text-xs font-black uppercase tracking-wider text-forest">
          Outil QR Code Universel (Français)
        </span>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-forest md:text-5xl">
          Générateur de QR Code Universel Gratuit
        </h1>
        <p class="mt-3 text-sm text-forest/75 md:text-base max-w-2xl mx-auto">
          Générez des QR codes nets et professionnels pour vos liens internet, connexions Wi-Fi, réseaux sociaux et cartes de contact vCard.
        </p>
      </div>

      <div class="mt-8">
        <UniversalQrForm client:load />
      </div>

      <AffiliateProducts />
    </div>
  </main>
</BaseLayout>
