---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SurveyQrGenerator } from "../components/SurveyQrGenerator";
import InternalLinkHub from "../components/InternalLinkHub.astro";

const title = "Free Google Review QR Code & Feedback Card Generator";
const description =
  "Create a printable Google Review QR code and feedback prompt card for restaurants, shops, hotels, and clinics. Direct HTTPS link, no tracking redirect.";

const faqs = [
  {
    question: "How do I create a Google Review QR code for my shop?",
    answer:
      "Enter your business name and paste your Google Business review URL into our generator above. Click generate to create a print-ready QR standee poster."
  },
  {
    question: "Does the QR use a tracking redirect?",
    answer:
      "No. The QR contains the HTTPS Google Business review URL you enter, so customers open that destination directly without a Pro UPI QR tracking redirect."
  },
  {
    question: "Is this Google Review QR generator free?",
    answer:
      "Yes. You can design and download the printable review QR card without a monthly subscription or response tracking."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://www.proupiqr.in/survey-qr-generator/#webapp",
      "name": "Customer Survey & Google Review QR Code Generator",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/survey-qr-generator/",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.proupiqr.in/survey-qr-generator/#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": " " + faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="py-8">
    <section class="px-5 pb-6 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-mint border border-leaf/20 text-xs font-black text-forest uppercase tracking-wider mb-3">
        <svg class="h-3.5 w-3.5 text-leaf" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <span>Google Review QR Card Builder</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-forest">
        Free Google Review QR Code & Feedback Card Generator
      </h1>
      <p class="mt-3 text-base text-forest/75 leading-relaxed">
        Build a printable counter card that opens your <strong>Google Business review page</strong> directly. Invite every customer to leave honest feedback without review gating or a tracking redirect.
      </p>
    </section>

    <!-- Survey Generator Tool -->
    <section class="px-4 pb-12">
      <SurveyQrGenerator client:visible />
    </section>

    <!-- FAQs -->
    <section class="max-w-4xl mx-auto px-5 pb-12">
      <h2 class="text-2xl font-black text-forest text-center mb-6">Frequently Asked Questions</h2>
      <div class="grid gap-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm">
            <h3 class="text-base font-black text-forest">{faq.question}</h3>
            <p class="mt-2 text-sm text-forest/75 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <InternalLinkHub />
  </main>
</BaseLayout>
