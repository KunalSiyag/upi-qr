---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SurveyQrGenerator } from "../components/SurveyQrGenerator";
import InternalLinkHub from "../components/InternalLinkHub.astro";

const title = "Free Customer Survey & Google Review QR Code Generator";
const description =
  "Create free customer feedback surveys and Google Review QR code standees for restaurants, shops, hotels & clinics. Collect 5-star ratings instantly.";

const faqs = [
  {
    question: "How do I create a Google Review QR code for my shop?",
    answer:
      "Enter your business name and paste your Google Business review URL into our generator above. Click generate to create a print-ready QR standee poster."
  },
  {
    question: "How does the survey redirect to Google Reviews work?",
    answer:
      "When customers scan your QR standee and leave 5-star feedback, our smart survey automatically prompts them with a direct link to post their review on Google Maps!"
  },
  {
    question: "Is this feedback survey QR generator free?",
    answer:
      "Yes, 100% free with unlimited responses. No monthly subscription or response limits."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://www.proupiqr.in/survey-qr-generator/#webapp",
      "name": "Customer Survey & Google Review QR Code Generator",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/survey-qr-generator/",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.proupiqr.in/survey-qr-generator/#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": " " + faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="py-8">
    <section class="px-5 pb-6 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mint border border-leaf/20 text-xs font-black text-forest uppercase tracking-wider mb-3">
        ⭐ Google Review & Feedback Builder
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-forest">
        Free Survey & Google Review QR Code Generator
      </h1>
      <p class="mt-3 text-base text-forest/75 leading-relaxed">
        Build instant customer feedback forms and counter standees. Collect 5-star ratings and boost your <strong>Google Maps Business Reviews</strong> automatically.
      </p>
    </section>

    <!-- Survey Generator Tool -->
    <section class="px-4 pb-12">
      <SurveyQrGenerator client:load />
    </section>

    <!-- FAQs -->
    <section class="max-w-4xl mx-auto px-5 pb-12">
      <h2 class="text-2xl font-black text-forest text-center mb-6">Frequently Asked Questions</h2>
      <div class="grid gap-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm">
            <h3 class="text-base font-black text-forest">{faq.question}</h3>
            <p class="mt-2 text-sm text-forest/75 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <InternalLinkHub />
  </main>
</BaseLayout>
