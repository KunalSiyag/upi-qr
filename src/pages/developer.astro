---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DeveloperConsole } from "../components/DeveloperConsole";
import EmbedWidgetModal from "../components/EmbedWidgetModal.astro";

const title = "Free UPI QR Embed & Developer API Portal | Pro UPI QR";
const description =
  "Integrate free UPI payment widgets, buttons, and redirection APIs into your HTML website, React, Vue or mobile app. 100% free, commission-free gateway.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "DeveloperApplication",
      "@id": "https://www.proupiqr.in/developer/#developer-app",
      "name": "Pro UPI QR Developer API & Embed Portal",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/developer/",
      "description": description,
      "softwareVersion": "2.0.0",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "TechArticle",
      "@id": "https://www.proupiqr.in/developer/#article",
      "headline": "Integrating NPCI Native upi://pay URI Protocol in Client-Side Web Apps",
      "description": "Technical specification for constructing zero-fee NPCI compliant UPI links and QR widgets using URL parameters.",
      "url": "https://www.proupiqr.in/developer/",
      "proficientLevel": "Beginner"
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="px-3 sm:px-4 py-8 sm:py-12 md:py-16 w-full min-w-0">
    <div class="mx-auto max-w-6xl rounded-[2rem] sm:rounded-[2.5rem] border border-white/75 bg-white/86 p-4 sm:p-8 md:p-12 shadow-[0_24px_64px_rgba(17,59,44,0.06)] backdrop-blur-md w-full min-w-0">
      {/* Breadcrumb Nav */}
      <nav class="flex items-center gap-2 text-xs font-bold text-leaf/80 mb-6">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <span class="text-forest">Developers</span>
      </nav>

      {/* Hero Header */}
      <div class="max-w-3xl">
        <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-3.5 py-1.5 sm:px-4 sm:py-2 text-[10px] sm:text-xs font-black uppercase tracking-[0.2em] sm:tracking-[0.26em] text-leaf">
          Developer Toolkit
        </p>
        <h1 class="mt-4 sm:mt-5 text-3xl font-black leading-[1.08] tracking-tight text-forest sm:text-5xl md:text-6xl">
          Integrate Free UPI Payments On Your Website
        </h1>
        <p class="mt-4 sm:mt-6 text-base sm:text-lg leading-relaxed text-forest/75">
          Generate interactive client-side UPI QR widgets, payment buttons, and deep links instantly. For a real checkout flow, your app sends customers to a checkout screen or QR, then your backend records the verified payment result after the gateway confirms it.
        </p>
      </div>

      {/* Main interactive Sandbox Console */}
      <div class="mt-8 sm:mt-12 w-full min-w-0">
        <DeveloperConsole client:load />
      </div>

      {/* API Documentation Section */}
      <section class="mt-12 sm:mt-20 border-t border-forest/10 pt-10 sm:pt-16 w-full min-w-0">
        <h2 class="text-2xl sm:text-3xl font-black text-forest tracking-tight">Redirection API & Query Parameters</h2>
        <p class="mt-3 sm:mt-4 text-sm sm:text-base text-forest/70 max-w-3xl">
          If you want to generate payment QR codes dynamically inside your custom CRM, billing software, or ecommerce site, you can directly invoke our rendering endpoints by passing standard URL query parameters.
        </p>

        <div class="mt-6 sm:mt-10 overflow-x-auto rounded-2xl sm:rounded-3xl border border-forest/10 bg-white shadow-sm w-full min-w-0">
          <table class="w-full text-left border-collapse text-xs min-w-[500px]">
            <thead>
              <tr class="border-b border-forest/10 bg-cream/30 text-forest font-bold">
                <th class="p-3 sm:p-5">Parameter</th>
                <th class="p-3 sm:p-5">Type</th>
                <th class="p-3 sm:p-5">Description</th>
                <th class="p-3 sm:p-5">Example</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-forest/5 text-forest/80">
              <tr>
                <td class="p-3 sm:p-5 font-mono font-bold text-leaf">pa</td>
                <td class="p-3 sm:p-5 font-semibold text-neutral-500">String (Required)</td>
                <td class="p-3 sm:p-5">Your registered merchant/personal UPI Virtual Payment Address (VPA)</td>
                <td class="p-3 sm:p-5 font-mono text-neutral-500">payee@bank</td>
              </tr>
              <tr>
                <td class="p-3 sm:p-5 font-mono font-bold text-leaf">pn</td>
                <td class="p-3 sm:p-5 font-semibold text-neutral-500">String (Required)</td>
                <td class="p-3 sm:p-5">The display name of the payee/business</td>
                <td class="p-3 sm:p-5 font-mono text-neutral-500">Merchant Store</td>
              </tr>
              <tr>
                <td class="p-3 sm:p-5 font-mono font-bold text-leaf">am</td>
                <td class="p-3 sm:p-5 font-semibold text-neutral-500">Number (Optional)</td>
                <td class="p-3 sm:p-5">Requested transaction amount. (Locks the amount field on scanning apps)</td>
                <td class="p-3 sm:p-5 font-mono text-neutral-500">250.50</td>
              </tr>
              <tr>
                <td class="p-3 sm:p-5 font-mono font-bold text-leaf">tn</td>
                <td class="p-3 sm:p-5 font-semibold text-neutral-500">String (Optional)</td>
                <td class="p-3 sm:p-5">Transaction note or reference ID (shows up on the customer's payment statement)</td>
                <td class="p-3 sm:p-5 font-mono text-neutral-500">Order-8390</td>
              </tr>
              <tr>
                <td class="p-3 sm:p-5 font-mono font-bold text-leaf">theme</td>
                <td class="p-3 sm:p-5 font-semibold text-neutral-500">String (Optional)</td>
                <td class="p-3 sm:p-5">Custom hex color (without # prefix) to theme the payment widget button</td>
                <td class="p-3 sm:p-5 font-mono text-neutral-500">ef4444</td>
              </tr>
              <tr>
                <td class="p-3 sm:p-5 font-mono font-bold text-leaf">logo</td>
                <td class="p-3 sm:p-5 font-semibold text-neutral-500">String (Optional)</td>
                <td class="p-3 sm:p-5">Brand overlay logo. Options: <code>phonepe</code>, <code>gpay</code>, <code>paytm</code>, <code>bhim</code></td>
                <td class="p-3 sm:p-5 font-mono text-neutral-500">phonepe</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-12 sm:mt-20 border-t border-forest/10 pt-10 sm:pt-16 w-full min-w-0">
        <p class="inline-flex rounded-full bg-amber-50 px-3 py-1 text-[10px] font-black uppercase tracking-[0.16em] text-amber-800">Backend-only verification</p>
        <h2 class="mt-3 text-2xl sm:text-3xl font-black text-forest tracking-tight">Payment Response API</h2>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-forest/70 max-w-3xl">
          This API is for your server, not for the customer&apos;s browser. The browser can open a checkout screen or UPI link, but only your backend can receive and trust the final payment result from a verified gateway webhook or secure relay.
        </p>

        <div class="mt-5 rounded-2xl border border-forest/10 bg-white/80 p-4 sm:p-5 text-sm leading-relaxed text-forest/75">
          <p class="font-black text-forest">Simple client flow</p>
          <ol class="mt-3 grid gap-2 sm:grid-cols-3">
            <li class="rounded-xl bg-mint/20 px-3 py-3">1. Your app creates a payment request or shows a checkout screen.</li>
            <li class="rounded-xl bg-cream/40 px-3 py-3">2. The customer pays in their UPI app.</li>
            <li class="rounded-xl bg-mint/20 px-3 py-3">3. Your backend stores the verified result and your UI polls for status.</li>
          </ol>
        </div>

        <div class="mt-6 grid gap-5 md:grid-cols-2">
          <div class="rounded-2xl border border-forest/10 bg-mint/20 p-5 sm:p-6">
            <h3 class="text-sm font-black text-forest">1. Receive the verified gateway result</h3>
            <p class="mt-2 text-xs leading-relaxed text-forest/70">Configure your gateway webhook to reach your server first. Your backend verifies the signature, normalizes the result, and then calls this endpoint server-to-server.</p>
            <div class="mt-4 overflow-x-auto rounded-xl bg-forest p-3 font-mono text-[11px] leading-relaxed text-white"><code>POST /api/payment-response<br />Content-Type: application/json<br /><br />&#123; "orderId": "order_8390", "status": "SUCCESS", "transactionId": "UTR…", "amount": "250.00", "provider": "your-gateway" &#125;</code></div>
          </div>
          <div class="rounded-2xl border border-forest/10 bg-cream/50 p-5 sm:p-6">
            <h3 class="text-sm font-black text-forest">2. Read the saved response</h3>
            <p class="mt-2 text-xs leading-relaxed text-forest/70">Your frontend can show a payment pending screen while your backend polls this endpoint or updates your order database. The result is retained for 90 days in Vercel KV.</p>
            <div class="mt-4 overflow-x-auto rounded-xl bg-forest p-3 font-mono text-[11px] leading-relaxed text-white"><code>GET /api/payment-response?orderId=order_8390<br /><br />&#123; "payment": &#123; "status": "SUCCESS", "transactionId": "UTR…", "receivedAt": "…" &#125; &#125;</code></div>
          </div>
        </div>

        <div class="mt-5 rounded-2xl border border-amber-700/15 bg-amber-50/70 p-4 text-xs leading-relaxed text-amber-950">
          <strong>Backend requirement:</strong> set <code>PAYMENT_WEBHOOK_SECRET</code>, <code>KV_REST_API_URL</code>, and <code>KV_REST_API_TOKEN</code> in Vercel. The secret is only for server-to-server calls. Keep it out of browser JavaScript and out of any embedded widget.
        </div>
      </section>

      {/* Integration Guides and Code Snippets */}
      <section class="mt-12 sm:mt-20 border-t border-forest/10 pt-10 sm:pt-16 grid gap-6 sm:gap-8 md:grid-cols-2 w-full min-w-0">
        <div class="rounded-2xl sm:rounded-3xl bg-mint/30 p-4 sm:p-6 md:p-8 border border-leaf/10 w-full min-w-0">
          <h3 class="text-base sm:text-lg font-black text-forest">Redirection API Endpoint</h3>
          <p class="mt-3 text-xs leading-relaxed text-forest/70">
            Redirecting customers directly to their default payment app is ideal for mobile checkout screens. Use the base URL structure below:
          </p>
          <div class="mt-4 rounded-xl bg-forest p-3 font-mono text-[11px] text-[#fff] overflow-x-auto shadow-inner w-full min-w-0">
            <code>https://www.proupiqr.in/r/?url=upi%3A%2F%2Fpay%3Fpa%3Dmerchant%40upi%26pn%3DPro%2520UPI%2520QR%26am%3D250</code>
          </div>
          <p class="mt-3 text-[10px] text-forest/50 leading-relaxed">
            Note: All spaces and special characters must be properly URL-encoded.
          </p>
        </div>

        <div class="rounded-2xl sm:rounded-3xl bg-[#fcf9f2] p-4 sm:p-6 md:p-8 border border-yellow-700/10 w-full min-w-0">
          <h3 class="text-base sm:text-lg font-black text-forest">Zero commission explained</h3>
          <p class="mt-3 text-xs leading-relaxed text-forest/70">
            Unlike payment gateways that charge 2% to 3% transaction fees, our widget uses native UPI link protocols. Payments flow directly from the customer's bank app to your bank account over the NPCI network, entirely bypassing any third-party gateway processor.
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1 rounded-full bg-forest/5 border border-forest/10 px-3 py-1 text-[10px] font-bold text-forest">
              ✓ No API Keys Required
            </span>
            <span class="inline-flex items-center gap-1 rounded-full bg-forest/5 border border-forest/10 px-3 py-1 text-[10px] font-bold text-forest">
              ✓ No SDKs to Install
            </span>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
