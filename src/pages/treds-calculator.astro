---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TredsCalculator } from "../components/TredsCalculator";

const title = "TReDS Discounting Calculator - Net Proceeds on Invoices | Pro UPI QR";
const description = "Calculate exact net proceeds when discounting MSME invoices on TReDS (RXIL, Invoicemart, M1xchange) — discount cost, platform charges, and effective annualised rate.";

const faqs = [
  {
    question: "How is the TReDS discount amount calculated?",
    answer: "Discount = invoice value × discount rate × (days to maturity ÷ 365). A ₹10 lakh invoice discounted at 11% for 90 days costs about ₹36,986, so roughly ₹9.63 lakh reaches your account."
  },
  {
    question: "What is 'effective annualised cost' and why is it higher than my bid rate?",
    answer: "You receive the net proceeds, not the full invoice, so the same rupee discount is charged against a smaller usable amount over a shorter window. Annualising that gives the true borrowing-cost equivalent — the number to compare against overdrafts or other finance."
  },
  {
    question: "Who can use TReDS?",
    answer: "Micro and small enterprises with Udyam registration can sell accepted invoices from registered buyers — large corporates, PSUs, and government departments mandated to join at least one TReDS platform (RXIL, Invoicemart, M1xchange)."
  },
  {
    question: "Does my buyer know I discounted their invoice?",
    answer: "Buyers only participate in the acceptance step and pay the financier at maturity as normal. The financing decision between you and the financier stays invisible to them."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "TReDS Discounting Calculator by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/treds-calculator/",
      description,
      featureList: [
        "Net proceeds calculation for TReDS bids",
        "Discount cost over custom tenors",
        "Platform charge adjustment",
        "Effective annualised cost comparison",
        "Projection PDF/PNG export"
      ],
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to calculate TReDS net proceeds",
      step: [
        { "@type": "HowToStep", name: "Enter the invoice value" },
        { "@type": "HowToStep", name: "Add the financier's quoted discount rate" },
        { "@type": "HowToStep", name: "Set days until the buyer pays" },
        { "@type": "HowToStep", name: "Review net proceeds and effective annualised cost" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">TReDS Calculator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">B2B money tools</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">TReDS discounting calculator for MSME invoices</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Before accepting a financier's bid on RXIL, Invoicemart, or M1xchange — know exactly how much cash lands today, what the discount truly costs, and whether it beats your overdraft.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#treds-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Calculate net proceeds</a>
            <a href="/blog/treds-invoice-discounting-msme-guide/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">How TReDS works →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="treds-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <TredsCalculator client:load />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">TReDS questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10">
        <h2 class="text-2xl font-black tracking-tight md:text-3xl">Waiting on late buyers? The law owes you interest too.</h2>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/msmed-interest-calculator/" class="rounded-full bg-sun px-5 py-2.5 text-sm font-black text-forest hover:bg-white transition">MSMED Interest Calculator →</a>
          <a href="/tools/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Browse all tools</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
