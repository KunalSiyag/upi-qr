---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductShot from "../components/ProductShot.astro";
import { MSMED_INTEREST_PCT } from "../data/rbiRates";
import { PLANS } from "../lib/workspace/entitlements";
import InternalLinkHub from "../components/InternalLinkHub.astro";

const title = "Free Invoice Payment Tracker with WhatsApp Reminders | Pro UPI QR";
const description = "Track who owes you money, record UPI and cash payments, and send WhatsApp payment reminders in one tap. Free, no signup, and your data stays in your browser.";
const url = "https://www.proupiqr.in/payment-tracker/";

const steps = [
  { name: "Add an invoice", text: "Enter the client, amount, and due date — or tap Track payment after creating an invoice PDF." },
  { name: "See who to chase", text: "The overview lists overdue invoices first, with totals for what is due, overdue, and collected this month." },
  { name: "Remind on WhatsApp", text: "Pick a friendly, due-today, overdue, or firm message. It includes the amount, days late, and your UPI ID." },
  { name: "Mark it paid", text: "Record full or part payments with mode and UTR. The invoice moves to Paid and the totals update." },
];

const features = [
  ["Overdue first", "A daily “chase today” list sorted by how late and how large each unpaid invoice is."],
  ["Monthly fees on autopilot", "Tick “Repeat every month” for tuition, rent, gym or maintenance fees and a new invoice appears on the same day each month."],
  ["Bank statement matching", "Import your bank's CSV statement and the tracker spots which UPI credits pay which invoices. Confirm in one tap; the file never leaves your browser."],
  ["Part payments", "Record advances and instalments with UPI UTR, cash, bank, card, or cheque. Totals are exact to the paisa."],
  ["WhatsApp & SMS reminders", "Four ready messages with your UPI ID as plain text — no broken payment links in chat."],
  ["Aging by bucket", "Not due, 1–15, 16–30, 31–45, and 45+ days late. The 45-day line matters for MSMED Act interest."],
  ["Client balances", "See every client's open amount and overdue amount, then drill into their invoices."],
  ["Receipts that settle dues", "Save a receipt from the free receipt generator and it marks that client's oldest unpaid invoices as paid — no double entry."],
  ["MSME mode", "Registered on Udyam? Overdue invoices show when the 45-day MSMED deadline passed. Pro adds the Section 16 interest due and your payment rights to reminders."],
  ["Morning reminders", "With a free account, a 9 am notification lists who to chase that day — overdue first, with the top client and amount."],
  ["Pay links", "With a free account, share a link that shows the live amount due, a UPI button, and a QR. Clients can send their UTR back."],
  ["Several businesses", `A Pro account keeps up to ${PLANS.pro.businesses} businesses after the first payment, each with its own UPI ID, invoice numbers and pay links. Free keeps ${PLANS.free.businesses}.`],
  ["Sync & backup", "Optional free account syncs phone and laptop. Or stay offline and download a backup or CSV for your accountant."],
];

const faqs = [
  {
    question: "Do I need to sign up to use the payment tracker?",
    answer: "No. The tracker works without an account. Invoices, clients, and payments are saved in your browser's local storage on this device and are not uploaded to Pro UPI QR.",
  },
  {
    question: "What happens if I clear my browser or change phones?",
    answer: "Without an account, data lives in this browser and is removed if you clear site data — use Settings → Download backup. With a free account, the tracker syncs automatically between your phone and laptop, and you can delete the cloud copy at any time.",
  },
  {
    question: "Does the tracker know automatically when a UPI payment arrives?",
    answer: "Pro UPI QR never sits between your customer and your bank, so it can't see your account. Instead, download your bank statement as CSV and import it: the tracker matches UPI credits to open invoices by amount, invoice number, and name, and you confirm them in one tap. The file is read in your browser and never uploaded.",
  },
  {
    question: "How are WhatsApp reminders sent?",
    answer: "Tapping WhatsApp opens the chat with the message filled in; you press send yourself. If you saved the client's number, the right chat opens directly. Nothing is sent without your tap.",
  },
  {
    question: "Can I track invoices made elsewhere, like in Tally, Vyapar, or Excel?",
    answer: "Yes. Add the invoice number, amount, and due date by hand. The tracker only needs what is owed and when — not the full invoice.",
  },
  {
    question: "Is a 45-day overdue invoice special?",
    answer: `For Udyam-registered micro and small enterprises, the MSMED Act, 2006 caps agreed credit at 45 days for business buyers and makes late payments carry compound interest at three times the RBI Bank Rate (${MSMED_INTEREST_PCT}% a year now). Under the Income-tax Act's 43B(h) rule (carried into the Income-tax Act, 2025 from 1 April 2026), a business buyer can deduct a late payment only in the year it is paid. Add your Udyam number in Settings and overdue invoices show when the deadline passed; Pro adds the interest due and can put these rights in your reminders.`,
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Invoice Payment Tracker by Pro UPI QR",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url,
      description,
      featureList: features.map(([name]) => name),
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
    },
    {
      "@type": "HowTo",
      name: "How to track invoice payments and send WhatsApp reminders",
      description: "Track unpaid invoices, chase overdue clients on WhatsApp, and record UPI payments in your browser.",
      step: steps.map((step) => ({ "@type": "HowToStep", name: step.name, text: step.text })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "Tools", item: "https://www.proupiqr.in/tools/" },
        { "@type": "ListItem", position: 3, name: "Payment tracker", item: url },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="bg-gradient-to-b from-mint/70 via-mint/25 to-white px-4 pb-14 pt-8 md:px-6 md:pt-12 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="transition-colors hover:text-leaf">Home</a>
          <span>/</span>
          <a href="/tools/" class="transition-colors hover:text-leaf">Tools</a>
          <span>/</span>
          <span class="font-bold text-forest" aria-current="page">Payment tracker</span>
        </nav>
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold text-leaf">Free · no signup</p>
            <h1 class="mt-3 text-4xl font-black leading-[1.05] tracking-[-0.02em] text-obsidian md:text-6xl">Know who owes you — and get paid faster</h1>
            <p class="mt-5 max-w-2xl text-lg leading-8">A free invoice payment tracker for freelancers, tutors, and small businesses. See every unpaid invoice, send a WhatsApp reminder in one tap, and mark UPI payments received — all on your phone, with no account.</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href="/app/" class="inline-flex h-12 items-center rounded-[10px] bg-forest px-6 text-sm font-black text-white transition hover:bg-graphite">Open payment tracker</a>
              <a href="/app/?new=1" class="inline-flex h-12 items-center rounded-[10px] bg-white px-6 text-sm font-bold text-forest ring-1 ring-forest/20 transition hover:bg-mint">Add first invoice</a>
            </div>
            <p class="mt-4 text-sm text-muted">Saved only in this browser. Back up anytime from Settings. <a href="/pricing/" class="font-bold text-leaf underline">Free account & Pro plans</a></p>
          </div>
          <ProductShot eager />
        </div>
      </div>
    </section>

    <section class="px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-3xl font-black tracking-tight text-forest md:text-4xl">How it works</h2>
        <ol class="mt-6 grid gap-4 md:grid-cols-4">
          {steps.map((step, index) => (
            <li class="rounded-[14px] border border-white/75 bg-white/86 p-5">
              <span class="text-xs font-black text-leaf">Step {index + 1}</span>
              <h3 class="mt-1 text-lg font-black text-forest">{step.name}</h3>
              <p class="mt-2 text-sm leading-6 text-forest/72">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl rounded-[14px] bg-forest p-6 text-white md:p-10">
        <h2 class="text-3xl font-black tracking-tight md:text-4xl">Built for how India actually gets paid</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {features.map(([name, copy]) => (
            <article class="rounded-[14px] border border-white/10 bg-white/8 p-5">
              <h3 class="text-lg font-black">{name}</h3>
              <p class="mt-2 text-sm leading-6 text-white/75">{copy}</p>
            </article>
          ))}
        </div>
        <a href="/app/" class="mt-8 inline-block rounded-[10px] bg-white px-6 py-3 text-sm font-black text-forest transition hover:bg-white/90">Start tracking — free</a>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Payment tracker questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="rounded-[10px] bg-fog px-5 py-4">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <InternalLinkHub currentPath="/payment-tracker/" lang="en" />
      </div>
    </section>
  </main>
</BaseLayout>
