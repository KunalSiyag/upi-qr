---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SplitBillCalculator } from "../components/SplitBillCalculator";

const title = "Split Bill Calculator — Itemised UPI Pay Links";
const description = "Split a restaurant bill by dish, not just equally. Tap who ate what, add service and tip, then send each friend a WhatsApp note or UPI QR for their exact share.";

const faqs = [
  {
    question: "How do I split a restaurant bill fairly among friends?",
    answer: "Use By items: add each dish and tap who ate it. Shared platters stay on everyone; a solo dessert stays on one person. Service charge and tip are then split equally. Equal and custom ₹ modes are still there for simpler tables."
  },
  {
    question: "Can some people pay more than others?",
    answer: "Yes — switch to Custom amounts mode and type what each person owes. A live indicator warns until the custom shares add up to the full bill, so nobody underpays by accident."
  },
  {
    question: "How do friends actually pay me back?",
    answer: "Each person gets a one-tap WhatsApp message containing their name, exact amount, and your UPI ID as plain text they can copy into GPay, PhonePe, Paytm, or any UPI app. No payment gateway, no fees, money lands in your account directly."
  },
  {
    question: "Does anyone see the bill details except my friends?",
    answer: "No. Everything is calculated inside your browser and drafts stay on your device. Sharing happens through your own WhatsApp — we never transmit or store any of it."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Split Bill Calculator with UPI by Pro UPI QR",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/split-bill-calculator/",
      "description": description,
      "featureList": [
        "Itemised split by dish and diner",
        "Equal and custom bill splitting",
        "Service charge and tip",
        "Per-person WhatsApp messages and UPI QR",
        "Paise-perfect rounding that always totals exactly"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      "name": "How to split a bill and collect via UPI",
      "description": "Divide a group bill into fair shares and collect them instantly.",
      "step": [
        { "@type": "HowToStep", "name": "Add dishes and tap who ate each one" },
        { "@type": "HowToStep", "name": "Add service charge and tip" },
        { "@type": "HowToStep", "name": "Enter your UPI ID to get paid back" },
        { "@type": "HowToStep", "name": "Send WhatsApp or show a per-person QR" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">Split Bill Calculator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Money tools</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Split the bill by who actually ordered</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Equal splits are fine until someone skipped the drinks. Add dishes, tap names, add service and tip, then send each friend a WhatsApp note or a scan-to-pay UPI QR.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#split-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Split my bill</a>
            <a href="/tools/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">More money tools →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="split-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <SplitBillCalculator client:visible />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Bill splitting questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10">
        <h2 class="text-2xl font-black tracking-tight md:text-3xl">Run a business? There's a toolkit for that too.</h2>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/invoice-generator/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Invoice Generator</a>
          <a href="/receipt-generator/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Receipt Generator</a>
          <a href="/tools/" class="rounded-full bg-sun px-5 py-2.5 text-sm font-black text-forest hover:bg-white transition">Browse all tools →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
