---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TOPIC_HUBS } from "../data/topicHubs";

const title = "All Free Merchant Tools - QR, Billing, Invoices | Pro UPI QR";
const description = "Browse every free tool: invoice and receipt generators, rent receipts, quotations, reminders, paid stamps, QR generators, GST calculators, and UPI guides.";

const categories = [
  {
    name: "Billing & Money Documents",
    blurb: "The complete billing loop: quote, bill, remind, prove payment.",
    tools: [
      { name: "UPI Invoice Generator", href: "/invoice-generator/", desc: "GST-ready invoices with country templates (India, US, UK, EU, UAE, Australia) and embedded payment QR." },
      { name: "Payment Receipt Generator", href: "/receipt-generator/", desc: "PAID-stamped receipts with payment mode, UTR reference, and UPI QR." },
      { name: "Rent Receipt Generator", href: "/rent-receipt-generator/", desc: "Monthly HRA-ready rent receipts with amount in words and revenue stamp box." },
      { name: "Quotation / Estimate Generator", href: "/quotation-generator/", desc: "Price quotes with validity dates, terms, and optional UPI advance QR." },
      { name: "Paid Stamp Generator", href: "/paid-stamp-generator/", desc: "Stamp PAID with date and signature on any bill photo, fully offline." },
      { name: "Payment Reminder Generator", href: "/payment-reminder-generator/", desc: "Friendly, professional, or firm overdue reminders for WhatsApp, SMS, email." },
      { name: "GST Credit Note Generator", href: "/credit-note-generator/", desc: "Section 34 compliant credit notes for returns, discounts, and billing corrections." },
      { name: "EMI Calculator", href: "/emi-calculator/", desc: "Loan EMI with a year-by-year amortization schedule you can download as PDF." },
      { name: "Gratuity Calculator", href: "/gratuity-calculator/", desc: "Exit payout via the statutory 15/26 formula — eligibility, rounding, and ₹20L cap included." },
      { name: "SIP Calculator", href: "/sip-calculator/", desc: "Monthly SIP maturity projection with yearly growth table and inflation-adjusted value." },
      { name: "Salary Slip Generator", href: "/salary-slip-generator/", desc: "Monthly payslips with PF/PT/TDS breakdowns and amount in words." },
      { name: "MSMED Interest Calculator", href: "/msmed-interest-calculator/", desc: "19.5% statutory interest on late B2B payments under Section 16 of the MSMED Act." },
      { name: "Proforma Invoice Generator", href: "/proforma-invoice-generator/", desc: "Advance-payment documents with buyer PO reference and optional UPI QR." },
      { name: "Break-Even Calculator", href: "/break-even-calculator/", desc: "Survival-unit count, target-profit units, and margin of safety for any business." },
      { name: "TReDS Discounting Calculator", href: "/treds-calculator/", desc: "Net proceeds and effective cost when discounting large-buyer invoices." },
      { name: "MSME Receivables Tracker", href: "/msme-receivables/", desc: "Invoice aging, 45-day due tracker, and Section 16 demand letters." },
      { name: "WhatsApp Order Creator", href: "/whatsapp-order-generator/", desc: "Pre-filled order messages with pay links for chat-based selling." },
      { name: "Purchase Order Generator", href: "/purchase-order-generator/", desc: "Formal POs with buyer/supplier GSTINs, delivery terms, and line items." },
      { name: "Delivery Challan Generator", href: "/delivery-challan-generator/", desc: "Goods dispatch document with vehicle, transporter, e-way bill, and receiver sign-off." },
      { name: "GST Debit Note Generator", href: "/debit-note-generator/", desc: "Section 34 debit notes to increase tax on understated invoices." },
      { name: "Bill of Supply Generator", href: "/bill-of-supply-generator/", desc: "Zero-GST bills for composition dealers and exempt supply." },
      { name: "Cash Memo Generator", href: "/cash-memo-generator/", desc: "Simple retail billing slips for kirana shops, counters, and walk-in sales." }
    ]
  },
  {
    name: "QR Code Generators",
    blurb: "Every kind of payment and info QR you can print or share.",
    tools: [
      { name: "UPI QR Generator", href: "/", desc: "The classic scan-and-pay standee generator with poster templates." },
      { name: "Universal QR Generator", href: "/universal-qr-generator/", desc: "URL, text, WiFi, and vCard QR codes." },
      { name: "Dynamic QR & Link Shortener", href: "/dynamic-qr-generator/", desc: "Editable destinations with scan analytics." },
      { name: "Bulk CSV QR Generator", href: "/bulk-qr/", desc: "Hundreds of labelled QRs from a spreadsheet as ZIP or PDF." },
      { name: "A4 QR Sticker Sheets", href: "/qr-sticker-generator/", desc: "Print 4, 6, or 12 counter stickers per sheet." },
      { name: "Menu QR Generator", href: "/menu-qr-generator/", desc: "Printable price-list cards for restaurants and salons." },
      { name: "Survey QR Generator", href: "/survey-qr-generator/", desc: "Feedback collection QRs with prefilled responses." }
    ]
  },
  {
    name: "Business Cards & Posters",
    blurb: "Branded printables that make payments effortless.",
    tools: [
      { name: "Digital Visiting Card", href: "/digital-visiting-card/", desc: "vCard plus UPI business cards you can share via link or NFC." },
      { name: "Shop Sale Poster Builder", href: "/offer-poster-generator/", desc: "Discount banners and offer posters with your QR baked in." },
      { name: "Printable template gallery", href: "/print-templates/", desc: "A4, A5, 5×7, table tents, counter cards, and A4 sticker sheets with size notes." },
      { name: "UPI QR hardware shop", href: "/products/", desc: "Acrylic standees, waterproof stickers, table tents, thermal printers, and outdoor boards." }
    ]
  },
  {
    name: "Counter hardware",
    blurb: "Physical displays that sit next to a printed UPI QR. Generators stay free.",
    tools: [
      { name: "All hardware guides", href: "/products/", desc: "Twelve buying guides: sizes, scan distance, and Amazon Associate links labelled as shopping." },
      { name: "A6 acrylic standee", href: "/products/acrylic-qr-standee/", desc: "Default checkout T-stand. Print a matte A6 insert." },
      { name: "Waterproof QR stickers", href: "/products/waterproof-qr-stickers/", desc: "Matte vinyl for glass, tiffins, parcels, and wet counters." },
      { name: "Restaurant table tent", href: "/products/table-tent-qr-holder/", desc: "Two-sided cafe tents with a 1.5–2 inch QR." },
      { name: "80 mm thermal printer", href: "/products/bluetooth-thermal-printer/", desc: "Bluetooth receipts for riders — not a counter standee." },
      { name: "A5 acrylic T-stand", href: "/products/a5-acrylic-t-stand/", desc: "Larger display for donation desks and 5-foot scan distance." }
    ]
  },
  {
    name: "Calculators & Checkers",
    blurb: "Know your numbers before you price, print, or promise.",
    tools: [
      { name: "Split Bill Calculator", href: "/split-bill-calculator/", desc: "Fair group splits with per-person WhatsApp messages carrying your UPI ID." },
      { name: "Cash Denomination Calculator", href: "/cash-denomination-calculator/", desc: "Count the drawer by note and coin, check variance, download shift summaries." },
      { name: "GST Tax Calculator", href: "/gst-calculator/", desc: "Tax breakdowns with a payable QR attached." },
      { name: "Profit Margin Calculator", href: "/margin-calculator/", desc: "Cost, margin, and markup maths for retailers." },
      { name: "UPI MDR Savings Calculator", href: "/upi-calculator/", desc: "See what direct UPI saves versus gateway fees." },
      { name: "Indian Bank UPI Limits", href: "/upi-limits/", desc: "Daily transfer caps for 30+ banks at a glance." }
    ]
  },
  {
    name: "Learn, Fix & Build",
    blurb: "Understand UPI deeper and plug it into your own stack.",
    tools: [
      { name: "NPCI UPI Error Resolver", href: "/upi-error-codes/", desc: "NPCI returned error? Decode U16, Z9, ZM and 30+ codes plus RBI refund TAT." },
      { name: "UPI QR Decoder", href: "/upi-qr-decoder/", desc: "Inspect any UPI QR before you trust or print it." },
      { name: "Developer API & Widgets", href: "/developer/", desc: "Embeddable QR widgets and endpoint roadmap." },
      { name: "Payments Glossary", href: "/glossary/", desc: "Every UPI and billing term explained in plain language." },
      { name: "Invoice vs Receipt vs Credit Note", href: "/invoice-vs-receipt/", desc: "Which document when — with a worked example and free generators." },
      { name: "PhonePe vs Paytm vs GPay", href: "/phonepe-vs-paytm-vs-gpay/", desc: "Honest merchant comparison: interoperability, soundboxes, dashboards." },
      { name: "Blog & Guides", href: "/blog/", desc: "Printing, security, and setup guides for Indian merchants." },
      { name: "About & editorial policies", href: "/about/", desc: "Who writes the guides, how facts are checked, and the public corrections log." }
    ]
  }
];
---

<BaseLayout title={title} description={description}>
  <main>
    <section class="relative overflow-hidden px-4 pb-10 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">All Tools</span>
        </nav>
        <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Everything is free</p>
        <h1 class="mt-5 max-w-4xl text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Every Pro UPI QR merchant tool in one place</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Twenty-plus tools covering the full money workflow — create QR codes, bill customers, chase payments, stamp proof, and learn the rules. Local tools need no signup or upload; only cloud-backed dynamic redirects require an account.</p>
      </div>
    </section>

    <section class="px-4 py-8 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="text-2xl font-black tracking-tight text-forest md:text-3xl">Browse by topic</h2>
        <p class="mt-1 text-sm font-semibold text-forest/65">Full inventories live on these hubs. This page remains the complete tool list.</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {TOPIC_HUBS.map((hub) => (
            <a href={hub.path} class="group flex flex-col rounded-[1.5rem] border border-white/75 bg-white/88 p-5 shadow-[0_10px_30px_rgba(17,59,44,0.06)] transition hover:border-leaf/40 hover:-translate-y-0.5">
              <h3 class="text-base font-black text-forest group-hover:text-leaf transition-colors">{hub.shortName}</h3>
              <p class="mt-2 flex-1 text-xs leading-6 text-forest/70">{hub.blurb}</p>
              <span class="mt-3 text-[11px] font-black uppercase tracking-wider text-leaf">Open hub →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {categories.map((category) => (
      <section class="px-4 py-8 md:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="max-w-3xl">
            <h2 class="text-2xl font-black tracking-tight text-forest md:text-3xl">{category.name}</h2>
            <p class="mt-1 text-sm font-semibold text-forest/65">{category.blurb}</p>
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {category.tools.map((tool) => (
              <a href={tool.href} class="group flex flex-col rounded-[1.5rem] border border-white/75 bg-white/88 p-5 shadow-[0_10px_30px_rgba(17,59,44,0.06)] transition hover:border-leaf/40 hover:-translate-y-0.5 hover:shadow-[0_18px_44px_rgba(17,59,44,0.12)]">
                <h3 class="text-base font-black text-forest group-hover:text-leaf transition-colors">{tool.name}</h3>
                <p class="mt-2 flex-1 text-xs leading-6 text-forest/70">{tool.desc}</p>
                <span class="mt-3 text-[11px] font-black uppercase tracking-wider text-leaf opacity-80 group-hover:opacity-100">Open tool →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="px-4 py-12 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10">
        <h2 class="text-2xl font-black tracking-tight md:text-4xl">Missing a tool you need?</h2>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/72">Tell us what would save you time — most requests ship within weeks. Write to feedback@proupiqr.in.</p>
        <a href="/invoice-generator/" class="mt-6 inline-block rounded-full bg-sun px-6 py-3 text-sm font-black text-forest transition hover:bg-white">Start with the invoice generator →</a>
      </div>
    </section>
  </main>
</BaseLayout>
