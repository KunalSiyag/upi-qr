---
import BaseLayout from "../layouts/BaseLayout.astro";
import { InvoiceGenerator } from "../components/InvoiceGenerator";
import { WaitlistCard } from "../components/WaitlistCard";

const title = "Free UPI Invoice Generator with QR Code PDF | Pro UPI QR";
const description = "Create a professional invoice PDF with an embedded UPI QR code for freelancers, shops, tuition teachers, and small businesses. Browser-only, no login required.";

const faqs = [
  {
    question: "Can I add an automatic UPI QR code to a PDF invoice?",
    answer: "Yes. Enter your invoice details, UPI ID, amount, GST, discount, and notes. Pro UPI QR generates the payment QR and places it inside a print-ready invoice that you can save as PDF."
  },
  {
    question: "Does it support currencies and tax systems outside India?",
    answer: "Yes. Pick your country (50 of them, including the UK, every EU country, the US, Canada, Australia, the UAE, Singapore and Japan) and the invoice follows its rules: the right tax name and rates, your tax ID label, the correct title such as Tax invoice or VAT invoice, and the legal notes for small businesses and clients abroad. You can bill in 37 currencies and print the invoice in 14 languages. Rupee invoices carry a UPI QR; other currencies show your bank details and an optional PayPal, Wise or Stripe payment link with its own QR."
  },
  {
    question: "Does it work out CGST, SGST and IGST automatically?",
    answer: "Yes. Pick the client's state as the place of supply. If it matches your state (read from your GSTIN), the invoice splits GST into CGST and SGST; if it differs, it charges IGST. Each line can have its own rate and HSN/SAC code, and the invoice shows the taxable value, tax for each rate, the amount in words and the reverse-charge line that Rule 46 asks for."
  },
  {
    question: "Can I make an export invoice for a foreign client from India?",
    answer: "Yes. Set the client to another country and the currency to USD, EUR, GBP or any other. Add your LUT ARN to export without IGST: the invoice prints the Rule 46 endorsement and 0% IGST. Without an LUT it charges IGST and says so. An optional exchange rate prints the rupee value you report in your GST return."
  },
  {
    question: "How does it handle VAT reverse charge and small-business exemptions?",
    answer: "For an EU seller billing a business in another EU country, choose Another EU country: VAT drops to 0% and the invoice prints the reverse-charge note (Art. 196 of the VAT Directive) in your language, with the client's VAT ID. If you are not VAT-registered, the invoice adds the note your country expects, such as § 19 UStG in Germany or art. 293 B du CGI in France. Rates are suggestions, so check them against your own situation."
  },
  {
    question: "Is the invoice data uploaded to a server?",
    answer: "No. The invoice draft, your logo, signature and saved clients stay in your browser's local storage, and the QR codes are made on your device. Use Next invoice to continue numbering without creating an account."
  },
  {
    question: "Who should use this UPI invoice generator?",
    answer: "It is useful for freelancers, consultants, home bakers, tuition teachers, clinics, photographers, plumbers, electricians, exporters, and shop owners who want customers to scan and pay directly from the invoice."
  },
  {
    question: "Can developers integrate Pro UPI QR into their own apps?",
    answer: "The public API and JavaScript embed are on the roadmap. This invoice tool is the first merchant-workflow module before hosted payment links, bulk QR generation, and API documentation."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "UPI Invoice Generator by Pro UPI QR",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/invoice-generator/",
      "description": description,
      "featureList": [
        "Invoice PDF generator",
        "Embedded UPI QR code",
        "Tax rules for 50 countries: GST, VAT, sales tax, HST",
        "CGST/SGST or IGST from the place of supply, HSN/SAC per line",
        "Export invoices under LUT, EU reverse charge, small-business notes",
        "37 currencies and 14 invoice languages",
        "Logo, signature, saved clients and invoice numbering",
        "Payment links with QR codes for clients abroad",
        "Local browser draft saving",
        "Print and save as PDF"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      "name": "How to create an invoice PDF with UPI QR code",
      "description": "Generate a printable invoice with a UPI payment QR in your browser.",
      "step": [
        { "@type": "HowToStep", "name": "Enter business and customer details" },
        { "@type": "HowToStep", "name": "Pick your country, currency and where the client is" },
        { "@type": "HowToStep", "name": "Add items, tax rates, discount, and payment terms" },
        { "@type": "HowToStep", "name": "Review the auto-generated UPI QR" },
        { "@type": "HowToStep", "name": "Print or save the invoice as PDF" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/#tools" class="hover:text-leaf transition-colors">Merchant Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">UPI Invoice Generator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex text-sm font-semibold text-leaf">Merchant toolkit</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Free UPI invoice generator with QR code PDF</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Make a professional invoice for any country: GST with CGST/SGST or IGST, export invoices under LUT, VAT with reverse charge, sales tax, and HST. Bill in 37 currencies, add your logo and a UPI QR or payment link, and save as PDF for WhatsApp, email or client billing.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#invoice-tool" class="rounded-[10px] bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-graphite">Create invoice PDF</a>
            <a href="#roadmap" class="rounded-[10px] border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">See API roadmap</a>
          </div>
        </div>
      </div>
    </section>

    <section id="invoice-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <InvoiceGenerator client:visible lang="en" />
        <WaitlistCard client:idle tool="invoice" lang="en" />
      </div>
    </section>

    <section id="roadmap" class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[14px] border border-white/75 bg-forest p-6 text-white md:p-10">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-sun">Next integrations</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight md:text-5xl">From QR generator to UPI merchant toolkit.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {[
            ["Public API", "Generate PNG, SVG, base64 QR, UPI URI, and invoice PDFs from billing systems and POS apps.", ""],
            ["Payment links", "Create hosted pay pages like /pay/invoice-102 with logo, amount, UPI button, and QR.", ""],
            ["Bulk CSV invoices", "Upload customer or room lists and export hundreds of payment-ready invoices or QR posters.", ""],
            ["JavaScript embed", "Drop a script into any website to render a Pay via UPI widget without backend code.", ""],
            ["Receipt generator — Live now", "Mark payments as received with a PAID-stamped receipt PDF that records mode, UTR, and a UPI QR.", "/receipt-generator/"],
            ["Paid stamp generator — Live now", "Upload an existing bill photo and stamp it PAID with date and signature, fully in your browser.", "/paid-stamp-generator/"],
          ].map(([heading, copy, href]) => (
            <article class="rounded-[14px] border border-white/10 bg-white/8 p-5">
              <h3 class="text-xl font-black">{heading}</h3>
              <p class="mt-3 text-sm leading-7 text-white/72">{copy}</p>
              {href && <a href={href} class="mt-4 inline-block text-sm font-black text-sun hover:text-white">Open tool →</a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Invoice QR questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="rounded-[10px] bg-fog px-5 py-4">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
