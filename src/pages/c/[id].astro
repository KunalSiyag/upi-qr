---
export const prerender = false;
import "../../styles/global.css";
import { getCheckoutSession, submitCheckoutUtr } from '../../lib/kv';
import { formatPaise, isTrustedMutation, readLimitedText, requestFingerprint, safePublicHttpsUrl, validCheckoutSessionId, validUtr, validVpa } from '../../lib/apiSecurity';
import { consumeRateLimit } from '../../lib/rateLimit';
import QRCode from 'qrcode';

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Content-Security-Policy", "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Frame-Options", "DENY");

const { id } = Astro.params;

if (!validCheckoutSessionId(id)) {
  return new Response("Invalid checkout session.", {
    status: 404,
    headers: { "Cache-Control": "no-store", "Referrer-Policy": "no-referrer", "X-Robots-Tag": "noindex, nofollow" }
  });
}

let session: Awaited<ReturnType<typeof getCheckoutSession>>;
try {
  session = await getCheckoutSession(id);
} catch {
  return new Response("Checkout service is temporarily unavailable.", {
    status: 503,
    headers: { "Cache-Control": "no-store", "Referrer-Policy": "no-referrer", "X-Robots-Tag": "noindex, nofollow" }
  });
}

if (!session) {
  return new Response("Checkout session not found or expired.", {
    status: 404,
    headers: { "X-Robots-Tag": "noindex, nofollow" }
  });
}

const amountPaise = session.amountPaise ?? (typeof session.amount === "number" ? Math.round(session.amount * 100) : 0);
const storedMerchantVpa = session.merchantVpa || "";
const merchantVpa = validVpa(storedMerchantVpa) ? storedMerchantVpa : null;
const merchantName = session.merchantName?.trim().slice(0, 80) || "Merchant";
if (!merchantVpa || amountPaise <= 0) {
  return new Response("This legacy checkout session is unavailable. Ask the merchant to create a new session.", {
    status: 410,
    headers: { "Cache-Control": "no-store", "Referrer-Policy": "no-referrer", "X-Robots-Tag": "noindex, nofollow" }
  });
}

const upiParams = new URLSearchParams({
  pa: merchantVpa,
  pn: merchantName,
  tr: session.orderId,
  am: formatPaise(amountPaise),
  cu: "INR",
});
const upiIntent = `upi://pay?${upiParams.toString()}`;

// Generate QR Code data URL
let qrDataUrl = "";
try {
  qrDataUrl = await QRCode.toDataURL(upiIntent, { width: 300, margin: 2, color: { dark: '#000000', light: '#ffffff' } });
} catch (err) {
  console.error("QR Gen Error", err);
}

let submissionError = "";
if (Astro.request.method === 'POST') {
  try {
    if (!isTrustedMutation(Astro.request)) {
      submissionError = "Cross-site submission rejected. Reload this checkout page and try again.";
    } else {
      const rateLimit = await consumeRateLimit(
        "checkout-utr-claim",
        `${session.id}:${requestFingerprint(Astro.request)}`,
        5,
        900,
      );
      if (!rateLimit.allowed) {
        submissionError = "Too many reference submissions. Try again in 15 minutes.";
      }
    }

    if (!submissionError) {
    const rawBody = await readLimitedText(Astro.request, 1024);
    const utr = new URLSearchParams(rawBody).get('utr')?.trim();

    if (utr && validUtr(utr)) {
      const updated = await submitCheckoutUtr(session.id, utr);
      if (updated) return Astro.redirect(`/c/${session.id}/`, 303);
      submissionError = "This checkout can no longer accept a payment reference.";
    } else {
      submissionError = "Enter the 10-35 character transaction reference shown by your UPI app.";
    }
    }
  } catch {
    submissionError = "The reference could not be submitted. Please try again.";
  }
}

const showSuccess = session.status === 'paid';
const showPending = session.status === 'verification_pending';
const showFailed = session.status === 'failed';
const redirectUrl = safePublicHttpsUrl(session.redirectUrl);
const redirectHost = redirectUrl ? new URL(redirectUrl).hostname : "";

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Checkout | Pro UPI QR</title>
  </head>
  <body data-checkout-session-id={session.id} data-checkout-status={session.status} class="bg-slate-50 min-h-screen flex items-center justify-center p-4 font-sans">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-100">
      
      <div class="bg-indigo-600 p-6 text-center">
        <h1 class="text-white text-xl font-bold opacity-90">{merchantName}</h1>
        <div class="mt-2 text-indigo-100 text-sm">Order: {session.orderId}</div>
        <div class="text-4xl font-extrabold text-white mt-3">₹{formatPaise(amountPaise)}</div>
      </div>

      <div class="p-6">
        {showSuccess ? (
          <div class="text-center py-8">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-4">
              <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-slate-800">Payment Confirmed</h2>
            <p class="text-slate-500 mt-2">The merchant marked this checkout as paid.</p>
            {redirectUrl && (
              <div class="mt-6 space-y-2">
                <p class="text-xs text-slate-500">Check the destination before leaving: <strong>{redirectHost}</strong></p>
                <a href={redirectUrl} rel="nofollow noopener noreferrer" referrerpolicy="no-referrer" class="inline-block text-indigo-600 font-medium hover:underline">Continue to {redirectHost}</a>
              </div>
            )}
          </div>
        ) : showPending ? (
          <div class="text-center py-8">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-amber-100 mb-4 text-2xl">...</div>
            <h2 class="text-2xl font-bold text-slate-800">Reference Submitted</h2>
            <p class="text-slate-500 mt-2">The merchant must check their bank statement before marking this payment as paid.</p>
            <p class="mt-4 rounded-xl bg-amber-50 p-3 text-xs font-semibold text-amber-900">A submitted UTR is not proof that money was received.</p>
          </div>
        ) : showFailed ? (
          <div class="text-center py-8">
            <h2 class="text-2xl font-bold text-slate-800">Payment Not Confirmed</h2>
            <p class="text-slate-500 mt-2">Contact the merchant if you believe this status is incorrect.</p>
          </div>
        ) : (
          <div class="space-y-6">
            <div class="text-center">
              <p class="text-slate-600 mb-4">Scan with any UPI app to pay</p>
              <div class="inline-block p-2 rounded-xl border-2 border-slate-100 bg-white shadow-sm">
                <img src={qrDataUrl} alt="UPI QR Code" class="w-48 h-48 mx-auto" />
              </div>
              <p class="mt-3 text-xs text-slate-500">Payee UPI ID: <strong class="font-mono text-slate-700">{merchantVpa}</strong></p>
              <p class="mt-1 text-xs text-slate-500">Confirm the payee name and amount in your UPI app before entering your PIN.</p>
            </div>

            <!-- Mobile Intent Links -->
            <div class="block sm:hidden">
               <div class="relative flex py-2 items-center">
                  <div class="flex-grow border-t border-slate-200"></div>
                  <span class="flex-shrink-0 mx-4 text-slate-400 text-sm">OR</span>
                  <div class="flex-grow border-t border-slate-200"></div>
              </div>
              <a href={upiIntent} class="w-full flex items-center justify-center gap-2 bg-indigo-50 text-indigo-700 font-semibold py-3 px-4 rounded-xl hover:bg-indigo-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                Pay via UPI App
              </a>
            </div>

            <!-- A UTR submission is an unverified customer claim. -->
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 mt-6">
              <h3 class="font-semibold text-slate-800 text-sm mb-2">Already paid?</h3>
              <p class="text-xs text-slate-500 mb-3">Submit the UTR or reference from your UPI app. The merchant will verify it against their bank statement.</p>
              
              {submissionError && <div class="text-red-500 text-xs mb-2 font-medium">{submissionError}</div>}
              
              <form method="POST" class="flex gap-2">
                <input 
                  type="text" 
                  name="utr" 
                  placeholder="e.g. 312345678901" 
                  class="flex-1 text-sm rounded-lg border-slate-300 border px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
                  required
                  minlength="10"
                  maxlength="35"
                  pattern="[A-Za-z0-9]{10,35}"
                  autocomplete="off"
                />
                <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors whitespace-nowrap">
                  Submit Reference
                </button>
              </form>
            </div>
          </div>
        )}
      </div>
      
      <div class="bg-slate-50 p-4 text-center border-t border-slate-100">
        <div class="text-xs text-slate-400 font-medium flex items-center justify-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          Payment status is confirmed only by the merchant
        </div>
      </div>

    </div>
    <script src="/checkout-status.js" defer></script>
  </body>
</html>
