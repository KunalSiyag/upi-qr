---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GeneratorForm } from "../../components/GeneratorForm";
import AffiliateProducts from "../../components/AffiliateProducts.astro";
import InternalLinkHub from "../../components/InternalLinkHub.astro";
import { getPresetFromSlug, type GeneratorSlug } from "../../data/internalLinks";

export async function getStaticPaths() {
  return [
    {
      params: { slug: "phonepe-qr-generator" },
      props: {
        title: "PhonePe QR जनरेटर",
        headline: "PhonePe सुसंगत मोफत UPI QR कोड बनवा",
        presetType: "phonepe",
        intro: "साइनअपशिवाय PhonePe आणि इतर UPI अॅप्सवर काम करणारा QR कोड तयार करा."
      }
    },
    {
      params: { slug: "google-pay-qr-generator" },
      props: {
        title: "Google Pay QR जनरेटर",
        headline: "Google Pay सुसंगत मोफत UPI QR कोड बनवा",
        presetType: "gpay",
        intro: "Google Pay द्वारे जलद पेमेंट स्वीकारण्यासाठी UPI QR कोड बनवा."
      }
    },
    {
      params: { slug: "paytm-qr-generator" },
      props: {
        title: "Paytm QR जनरेटर",
        headline: "Paytm सुसंगत मोफत UPI QR कोड बनवा",
        presetType: "paytm",
        intro: "दुकानांसाठी Paytm सुसंगत मोफत UPI QR कोड तयार करा."
      }
    },
    {
      params: { slug: "sbi-qr-generator" },
      props: {
        title: "SBI UPI QR जनरेटर",
        headline: "SBI बँक खात्यासाठी UPI QR कोड बनवा",
        presetType: "sbi",
        intro: "State Bank of India खात्यांसाठी त्वरित पेमेंट स्वीकारणारा QR तयार करा."
      }
    }
  ];
}

const { slug } = Astro.params;
const { title, headline, presetType, intro } = Astro.props;

const generatorSlug = slug as GeneratorSlug;
const resolvedPreset = presetType ?? getPresetFromSlug(generatorSlug);

const description = `${intro} १००% मोफत आणि त्वरित डाउनलोड.`;
---

<BaseLayout title={`${title} | Pro UPI QR (Marathi)`} description={description}>
  <main class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-[2rem] border border-white/75 bg-white/86 p-4 sm:p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
      <a href="/mr/" class="inline-block mb-4 text-xs font-bold text-leaf hover:underline">&larr; मुख्य पृष्ठावर परत जा</a>
      
      <p class="text-xs font-black uppercase tracking-[0.2em] text-leaf">त्वरित पेमेंट QR</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-forest md:text-5xl">{headline}</h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-forest/72 md:text-base">{intro}</p>

      <div class="mt-8">
        <GeneratorForm client:load presetType={resolvedPreset} />
      </div>

      <AffiliateProducts />
      <InternalLinkHub variant="both" currentGenerator={generatorSlug} presetType={resolvedPreset} />
    </div>
  </main>
</BaseLayout>
