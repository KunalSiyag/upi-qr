---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GeneratorForm } from "../../components/GeneratorForm";
import AffiliateProducts from "../../components/AffiliateProducts.astro";

const title = "मोफत UPI QR कोड जनरेटर | दुकानासाठी UPI QR कोड बनवा";
const description =
  "रक्कमेसह मोफत UPI QR कोड बनवा. Paytm, PhonePe आणि Google Pay (GPay) साठी काम करणारा युनिव्हर्सल UPI QR कोड जनरेटर.";

const faqs = [
  {
    question: "UPI QR कोड कसा तयार करायचा?",
    answer: "तुमचा UPI ID आणि नाव टाकून मोफत उच्च-गुणवत्तेचा QR कोड त्वरित डाउनलोड करा."
  },
  {
    question: "हा सर्व पेमेंट अॅप्सवर चालेल का?",
    answer: "होय, हा QR कोड Google Pay, PhonePe, Paytm आणि सर्व भारतीय बँकिंग अॅप्सवर काम करतो."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Pro UPI QR (Marathi)",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/mr/"
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-[2rem] border border-white/75 bg-white/86 p-4 sm:p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
      <div class="text-center">
        <span class="inline-block rounded-full bg-leaf/10 px-4 py-1.5 text-xs font-black uppercase tracking-wider text-forest">
          मोफत UPI QR जनरेटर (मराठी)
        </span>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-forest md:text-5xl">
          तुमच्या दुकानासाठी मोफत UPI QR कोड बनवा
        </h1>
        <p class="mt-3 text-sm text-forest/75 md:text-base max-w-2xl mx-auto">
          Google Pay, PhonePe, Paytm वर त्वरित पेमेंट स्वीकारा.
        </p>
      </div>

      <div class="mt-8">
        <GeneratorForm client:load />
      </div>

      <div class="mt-12 border-t border-forest/10 pt-10">
        <h2 class="text-2xl font-black text-forest">सतत विचारले जाणारे प्रश्न</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {faqs.map((faq) => (
            <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm space-y-2">
              <h3 class="text-sm font-black text-forest flex items-start gap-2">
                <span class="text-leaf shrink-0">प्रश्न.</span>
                <span>{faq.question}</span>
              </h3>
              <p class="text-xs text-forest/75 leading-relaxed pl-5">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>

      <AffiliateProducts />
    </div>
  </main>
</BaseLayout>
