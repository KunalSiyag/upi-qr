---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalLinkHub from "../components/InternalLinkHub.astro";
import { HraCalculator } from "../components/HraCalculator";
import { SECTION_MAP, TAX_RULES_REVIEWED_ON, TAX_SOURCES } from "../lib/incomeTax";

const title = "HRA Calculator 2026-27: Tax-Free House Rent Allowance | Pro UPI QR";
const description = "Work out how much of your HRA is tax-free: the least of three amounts, with 50% of salary in eight cities from FY 2026-27. Free, runs in your browser.";

const faqs = [
  {
    "question": "How is the tax-free part of HRA worked out?",
    "answer": "It is the smallest of three amounts: the HRA you actually receive, the rent you pay less 10% of your salary, and 50% of your salary in the listed cities (40% elsewhere). On a ₹50,000 monthly salary with ₹20,000 of HRA and ₹22,000 of rent in a listed city, the rent test is the smallest, so ₹17,000 a month (₹2,04,000 a year) is tax-free and ₹36,000 a year is taxable."
  },
  {
    "question": "Which cities get the 50% limit?",
    "answer": "Under rule 279 of the Income-tax Rules, 2026, Mumbai, Delhi, Kolkata, Chennai, Bengaluru, Hyderabad, Pune and Ahmedabad. It was four cities before; the rule was notified on 20 March 2026 and applies from 1 April 2026, so it covers tax year 2026-27 and not earlier years."
  },
  {
    "question": "How much does the city matter?",
    "answer": "It can matter a lot. With a ₹60,000 monthly salary, ₹30,000 of HRA and ₹40,000 of rent, the exemption is ₹3,60,000 a year in a listed city but ₹2,88,000 elsewhere, because 40% of salary becomes the smallest amount: ₹72,000 less exempt."
  },
  {
    "question": "What counts as salary here?",
    "answer": "Basic salary plus dearness allowance if it is part of your terms of employment. Other allowances and perquisites are left out. The rule text does not say whether a commission on turnover counts, so this calculator does not include it."
  },
  {
    "question": "Is HRA exempt in the new tax regime?",
    "answer": "No. The new regime does not allow the HRA exemption, so this only matters in the old regime. Use the income tax calculator to compare both."
  },
  {
    "question": "What conditions apply?",
    "answer": "You must actually pay the rent, and the home must not be one you own. Keep rent receipts and your landlord's details, and check the current rules before you claim."
  },
  {
    "question": "What if I paid rent for only part of the year?",
    "answer": "Enter the number of months. The three amounts are worked out for those months only: on the same figures as the first example with 6 months of rent at ₹25,000, the exemption is ₹1,20,000."
  },
  {
    "question": "Is my data stored anywhere?",
    "answer": "No. The calculation runs in your browser and your inputs stay on your device. A draft is kept in your browser's local storage so you can come back to it; clear your site data to remove it."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "HRA Calculator by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/hra-calculator/",
      description,
      featureList: ["Tax-free HRA as the least of three amounts", "50% of salary in the eight listed cities, 40% elsewhere", "Part-year rent", "Taxable HRA", "Plan PDF and PNG export", "Browser-only, no signup"],
            offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to work out the tax-free part of your HRA",
      step: [
        { "@type": "HowToStep", "name": "Enter your monthly basic salary and the HRA you receive" },
        { "@type": "HowToStep", "name": "Enter the rent you pay and the months you paid it" },
        { "@type": "HowToStep", "name": "Choose whether you live in one of the eight listed cities" },
        { "@type": "HowToStep", "name": "Read the three amounts and the tax-free HRA, then download the result" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/65">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">HRA Calculator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex text-sm font-semibold text-leaf">Money tools</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">HRA calculator: how much of your house rent allowance is tax-free</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Enter your salary, HRA and rent to see the tax-free amount under the old regime: the smallest of three figures, with the 50% limit now covering eight cities.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#hra-tool" class="rounded-[10px] bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-graphite">Work out my HRA</a>
            <a href="/income-tax-calculator/" class="rounded-[10px] border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Compare tax regimes →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="hra-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <HraCalculator client:visible />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">How it works</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-4xl">What the numbers assume</h2>
        <ul class="mt-6 grid gap-3 text-base leading-7 text-forest/75">
          <li class="rounded-[10px] bg-fog px-5 py-4">The exemption is the least of: the HRA you receive, the rent you pay less one tenth of your salary, and 50% (listed cities) or 40% (elsewhere) of your salary, all for the months you paid rent.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">Salary is basic plus dearness allowance if it is part of your terms of employment. Other allowances and perquisites are not counted, and commission is left out.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">HRA is exempt only in the old tax regime, and only if you pay the rent and do not own the home.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">The rule is read from Schedule III item 11 of the Income-tax Act, 2025 and rule 279 of the Income-tax Rules, 2026, and the checking date is shown below.</li>
        </ul>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">Sources</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-4xl">Where the rules come from</h2>
        <p class="mt-4 text-base leading-7 text-forest/75">Rules last checked on {TAX_RULES_REVIEWED_ON}. If a notification changes the rule or the city list, this page and the calculator are updated together.</p>
        <ul class="mt-4 grid gap-2 text-base leading-7 text-forest/75">
          {TAX_SOURCES.map((s) => <li class="rounded-[10px] bg-fog px-5 py-3"><a class="font-semibold text-leaf underline" href={s.url} rel="noopener">{s.label}</a></li>)}
        </ul>
        <div class="mt-6 overflow-x-auto rounded-[10px] border border-hairline">
          <table class="w-full text-left text-sm">
            <thead><tr class="border-b border-pebble text-xs text-muted"><th class="px-4 py-2 font-semibold">Rule</th><th class="px-4 py-2 font-semibold">1961 Act section</th><th class="px-4 py-2 font-semibold">Income-tax Act, 2025 section</th></tr></thead>
            <tbody>
              {SECTION_MAP.map(([rule, old, now]) => <tr class="border-b border-hairline"><td class="px-4 py-2 font-semibold text-forest">{rule}</td><td class="px-4 py-2 tabular-nums">{old}</td><td class="px-4 py-2 tabular-nums">{now}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">HRA questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="rounded-[10px] bg-fog px-5 py-4">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <InternalLinkHub currentPath="/hra-calculator/" />
      </div>
    </section>
  </main>
</BaseLayout>
