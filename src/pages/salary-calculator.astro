---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalLinkHub from "../components/InternalLinkHub.astro";
import { SalaryCalculator } from "../components/SalaryCalculator";
import { SECTION_MAP, TAX_RULES_REVIEWED_ON, TAX_SOURCES } from "../lib/incomeTax";

const title = "Salary Calculator: CTC to In-Hand Salary 2026-27 | Pro UPI QR";
const description = "Turn your CTC into a monthly in-hand salary: PF, gratuity, professional tax and income tax under the new or old regime. Free, runs in your browser.";

const faqs = [
  {
    "question": "How do I get from CTC to in-hand salary?",
    "answer": "Split the CTC into basic, HRA, a special allowance, and the employer's PF (and gratuity if your CTC includes it). The gross salary is basic plus HRA plus the special allowance. From it, the employee's PF, professional tax and income tax are taken, and what is left is the in-hand salary. With a ₹12 lakh CTC, a 40% basic, HRA at 50% of basic and PF on the full basic, the gross is ₹11,42,400, the new regime leaves no tax after the rebate, and the in-hand salary is ₹90,200 a month."
  },
  {
    "question": "Why is my in-hand salary lower than my CTC?",
    "answer": "Part of the CTC never reaches your account each month: the employer's PF and any gratuity. Then your own PF, professional tax and income tax are deducted. In the example, ₹57,600 of employer PF stays in the PF account, and ₹57,600 of employee PF and ₹2,400 of professional tax come off, so ₹10,82,400 of the ₹12,00,000 is paid out over the year."
  },
  {
    "question": "What is the PF wage ceiling?",
    "answer": "The statutory wage ceiling for provident fund was raised from ₹15,000 to ₹25,000 a month on 17 September 2026. Some employers contribute on the full basic and others on the ceiling, so choose the option your offer letter uses. On a ₹30 lakh CTC with PF on the ceiling, each side puts in ₹36,000 a year."
  },
  {
    "question": "How is the gratuity in CTC worked out?",
    "answer": "Gratuity builds up at 15/26 of a month's basic for each year of service, which is about 4.81% of annual basic. On a ₹30 lakh CTC with a 50% basic that is ₹72,115 a year, and the in-hand salary comes to about ₹2,00,951 a month in the new regime."
  },
  {
    "question": "Is the new or the old regime better for my salary?",
    "answer": "It depends on your deductions, so the calculator shows your in-hand salary under the other regime too. On a ₹15 lakh CTC with ₹25,000 rent, ₹50,000 of other 80C investments, ₹25,000 of health insurance and ₹1 lakh of home loan interest, the old regime leaves about ₹1,02,345 a month and the new regime about ₹1,02,845."
  },
  {
    "question": "What is professional tax?",
    "answer": "A state tax on salary, deducted by your employer. The amount depends on your state and salary, so enter your own figure; it is usually up to about ₹2,500 a year."
  },
  {
    "question": "What does it leave out?",
    "answer": "Bonuses, arrears, ESIC, employer contributions above ₹7.5 lakh a year (which can be taxable), reimbursements and special-rate income. It is an estimate from the rules checked on the date shown, not tax advice."
  },
  {
    "question": "Is my data stored anywhere?",
    "answer": "No. The calculation runs in your browser and your inputs stay on your device. A draft is kept in your browser's local storage so you can come back to it; clear your site data to remove it."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Salary Calculator by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/salary-calculator/",
      description,
      featureList: ["CTC to monthly in-hand salary", "Basic, HRA and special allowance split", "Employee and employer PF on the full basic or the wage ceiling", "Gratuity inside CTC", "New and old regime income tax side by side", "Plan PDF and PNG export", "Browser-only, no signup"],
            offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to work out your in-hand salary from your CTC",
      step: [
        { "@type": "HowToStep", "name": "Enter your yearly CTC and how it splits into basic and HRA" },
        { "@type": "HowToStep", "name": "Choose what PF is worked out on and enter professional tax" },
        { "@type": "HowToStep", "name": "Pick the new or old tax regime and add old-regime deductions" },
        { "@type": "HowToStep", "name": "Read your monthly in-hand salary and the breakdown, then download it" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/65">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">Salary Calculator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex text-sm font-semibold text-leaf">Money tools</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Salary calculator: from CTC to the money in your account</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Enter your CTC and how it splits, and see your monthly in-hand salary after PF, professional tax and income tax, with the other tax regime for comparison.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#salary-tool" class="rounded-[10px] bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-graphite">Calculate my salary</a>
            <a href="/hra-calculator/" class="rounded-[10px] border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Work out your HRA →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="salary-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <SalaryCalculator client:visible />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">How it works</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-4xl">What the numbers assume</h2>
        <ul class="mt-6 grid gap-3 text-base leading-7 text-forest/75">
          <li class="rounded-[10px] bg-fog px-5 py-4">CTC is split into basic (a share of CTC), HRA (a share of basic), the employer's PF and an optional gratuity accrual; the special allowance is what remains.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">PF is 12% from you and 12% from your employer on the full basic or on basic up to the ₹25,000 a month wage ceiling. Gratuity is 15/26 of a month's basic per year of service.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">Gross salary is basic plus HRA plus the special allowance. Income tax comes from the same engine as the income tax calculator, for the regime you choose, and in the old regime the HRA exemption uses the rent you enter.</li>
          <li class="rounded-[10px] bg-fog px-5 py-4">In-hand salary is gross salary less your PF, professional tax and income tax. Tax rules were checked on the date shown on the calculator.</li>
        </ul>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">Sources</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-4xl">Where the rules come from</h2>
        <p class="mt-4 text-base leading-7 text-forest/75">Rules last checked on {TAX_RULES_REVIEWED_ON}. If a notification changes a rate or limit, this page and the calculator are updated together.</p>
        <ul class="mt-4 grid gap-2 text-base leading-7 text-forest/75">
          {TAX_SOURCES.map((s) => <li class="rounded-[10px] bg-fog px-5 py-3"><a class="font-semibold text-leaf underline" href={s.url} rel="noopener">{s.label}</a></li>)}
        </ul>
        <div class="mt-6 overflow-x-auto rounded-[10px] border border-hairline">
          <table class="w-full text-left text-sm">
            <thead><tr class="border-b border-pebble text-xs text-muted"><th class="px-4 py-2 font-semibold">Rule</th><th class="px-4 py-2 font-semibold">1961 Act section</th><th class="px-4 py-2 font-semibold">Income-tax Act, 2025 section</th></tr></thead>
            <tbody>
              {SECTION_MAP.map(([rule, old, now]) => <tr class="border-b border-hairline"><td class="px-4 py-2 font-semibold text-forest">{rule}</td><td class="px-4 py-2 tabular-nums">{old}</td><td class="px-4 py-2 tabular-nums">{now}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-semibold text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Salary questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="rounded-[10px] bg-fog px-5 py-4">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <InternalLinkHub currentPath="/salary-calculator/" />
      </div>
    </section>
  </main>
</BaseLayout>
