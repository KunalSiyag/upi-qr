---
import BaseLayout from "../layouts/BaseLayout.astro";
import { UniversalQrForm } from "../components/UniversalQrForm";
import InternalLinkHub from "../components/InternalLinkHub.astro";
import EmbedWidgetModal from "../components/EmbedWidgetModal.astro";

const title = "Free QR Code Generator Without Watermark (Instant SVG & PNG Export)";
const description =
  "Generate 100% free QR codes with zero watermarks, no signups, and unlimited downloads. Export print-ready vector SVG, PNG, and PDF QR codes for commercial use.";

const faqs = [
  {
    question: "Is this QR code generator truly 100% free without watermarks?",
    answer:
      "Yes, completely free. Unlike other commercial QR generators that place hidden logos or force subscriptions after a trial period, Pro UPI QR generates clean, unwatermarked vector QR codes with zero ads or expiry."
  },
  {
    question: "Do these free unwatermarked QR codes ever expire?",
    answer:
      "No! Standard static QR codes encode your data or UPI VPA directly into the matrix code points. They work permanently and never expire."
  },
  {
    question: "Can I download vector SVG and print-ready PDF files for commercial printing?",
    answer:
      "Yes. You can export ultra high-resolution PNG, vector SVG, and A4 sticker PDF files directly to your device without creating an account."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://www.proupiqr.in/free-qr-generator-without-watermark/#webapp",
      "name": "Free QR Code Generator Without Watermark",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/free-qr-generator-without-watermark/",
      "description": description,
      "featureList": [
        "0% Watermark",
        "No Account Signup Required",
        "Unlimited Commercial Use",
        "Instant SVG Vector Export"
      ],
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.proupiqr.in/free-qr-generator-without-watermark/#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": " " + faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="py-8">
    <section class="px-5 pb-6 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-mint border border-leaf/20 text-xs font-black text-forest uppercase tracking-wider mb-3">
        <svg class="h-3.5 w-3.5 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>100% Free • Zero Watermark • Permanent Expiry</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-forest">
        Free QR Code Generator Without Watermark
      </h1>
      <p class="mt-3 text-base text-forest/75 leading-relaxed">
        Generate clean, high-resolution QR codes for payments, URLs, WiFi, and vCards. Download crisp vector SVG and PNG files with <strong>zero watermarks, zero fees, and no account registration</strong>.
      </p>
    </section>

    <!-- Interactive Generator -->
    <section class="px-4 pb-12">
      <UniversalQrForm client:load />
    </section>

    <div class="max-w-4xl mx-auto px-5">
      <EmbedWidgetModal generatorTitle="Unwatermarked QR Generator" />
    </div>

    <!-- FAQs -->
    <section class="max-w-4xl mx-auto px-5 py-12">
      <h2 class="text-2xl font-black text-forest text-center mb-6">Frequently Asked Questions</h2>
      <div class="grid gap-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm">
            <h3 class="text-base font-black text-forest">{faq.question}</h3>
            <p class="mt-2 text-sm text-forest/75 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <InternalLinkHub />
  </main>
</BaseLayout>
