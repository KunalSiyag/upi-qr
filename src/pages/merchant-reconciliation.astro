---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MerchantReconciliation } from "../components/MerchantReconciliation";

const title = "Merchant UPI Reconciliation Tool — Match Invoices to UTRs Free";
const description =
  "Upload your sales CSV, enter received UPI amounts, and match invoices to UTRs. Settlement difference tracker with PDF export. 100% in-browser, no data upload.";

const faqs = [
  {
    question: "How does the UPI reconciliation tool work?",
    answer:
      "Upload a CSV of your sales register (Date, Invoice, Amount), then enter the UPI amount you actually received for each row. The tool calculates the difference, flags unmatched rows, and generates a settlement summary you can export as PDF or CSV."
  },
  {
    question: "Is my sales data uploaded to a server?",
    answer:
      "No. All data stays inside your browser in localStorage. The tool never sends invoice numbers, UTRs, amounts, or customer names to any server. The PDF is rendered client-side and downloaded directly."
  },
  {
    question: "Can I match partial payments?",
    answer:
      "Yes. Enter any received amount — the tool calculates the exact difference in paise. A row is marked as settled only when the received amount exactly matches the expected amount."
  },
  {
    question: "What CSV format do I need?",
    answer:
      "Your CSV must have at least three columns: Date, Invoice, and Amount. An optional Customer column makes the report clearer. The column headers can be capitalised or lowercase — the parser is case-insensitive."
  },
  {
    question: "Can I use this for monthly bank statement reconciliation?",
    answer:
      "The tool is designed for invoice-to-UTR matching. For a full bank-statement import, export your bank statement as CSV and use the Invoice column to tag each UPI credit to a specific invoice row."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Merchant UPI Reconciliation Tool by Pro UPI QR",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/merchant-reconciliation/",
      "description": description,
      "featureList": [
        "CSV sales register upload",
        "Invoice-to-UTR amount matching",
        "Settlement difference calculated in paise",
        "Monthly PDF and CSV export",
        "100% in-browser — no server upload"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
    },
    {
      "@type": "HowTo",
      "name": "How to Reconcile UPI Payments Against Sales Invoices",
      "description": "Match received UPI amounts to your sales register, spot short-payments, and export a settlement report.",
      "totalTime": "PT10M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Upload your sales register CSV",
          "text": "Export your invoice list from Excel or Tally as CSV. Required columns: Date, Invoice, Amount."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Enter received amounts and UTRs",
          "text": "For each invoice row, type the UPI amount you actually received and the UTR reference number from your bank or app."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Review and export the settlement report",
          "text": "The tool highlights settled, mismatched, and pending rows. Export the complete report as PDF for your accountant or CSV for further processing."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": " " + faq.answer }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/">Home</a> <span>/</span> <a href="/tools/">All Tools</a> <span>/</span>
          <span class="text-forest font-bold" aria-current="page">UPI Reconciliation</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Money tools</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">UPI reconciliation — match invoices to UTRs</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Upload your monthly sales register, enter received amounts, and spot short-payments instantly. All data stays in your browser.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#recon-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Start reconciling</a>
            <a href="/tools/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">More money tools →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="recon-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <MerchantReconciliation client:visible />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Reconciliation questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10">
        <h2 class="text-2xl font-black tracking-tight md:text-3xl">Need more billing tools? Print invoices and receipts with QR codes.</h2>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/invoice-generator/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Invoice Generator</a>
          <a href="/receipt-generator/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Receipt Generator</a>
          <a href="/credit-note-generator/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Credit Note</a>
          <a href="/break-even-calculator/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Break-Even Calc</a>
          <a href="/tools/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">All Tools</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>