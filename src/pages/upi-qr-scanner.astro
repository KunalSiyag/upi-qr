---
import BaseLayout from "../layouts/BaseLayout.astro";
import { UpiQrScanner } from "../components/UpiQrScanner";
import { personSchema } from "../data/authors";
import { UPI_QR_REVIEWED_ON, UPI_QR_SOURCES } from "../lib/upi-qr-read";

const title = "UPI QR Code Scanner: Scan, Read & Check a Payment QR Free";
const description =
  "Scan a UPI QR with your camera, or read one from a photo or pasted text. See the UPI ID, payee name and amount before you pay. Free; nothing you scan is uploaded.";
const pageUrl = "https://www.proupiqr.in/upi-qr-scanner/";

const reviewedLabel = new Date(`${UPI_QR_REVIEWED_ON}T00:00:00+05:30`).toLocaleDateString("en-IN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const steps = [
  {
    name: "Choose how to read the QR",
    text: "Tap Start camera and point it at the code, take or choose a photo of it, or paste the text of a QR you were sent.",
  },
  {
    name: "Read what it says",
    text: "The page lists the UPI ID, the payee name written in the QR and the amount, then notes about anything unusual. Type the UPI ID you were given, and the page says whether the QR carries the same one.",
  },
  {
    name: "Pay only in your own UPI app",
    text: "Before you enter your PIN, check that the payee name your UPI app shows is the person or shop you mean to pay.",
  },
];

const parameters = [
  { name: "pa", text: "The payee's UPI ID. The NPCI draft lists it as required." },
  { name: "pn", text: "The payee name, typed by whoever made the QR. The draft lists it as required, and nobody checks it." },
  { name: "am", text: "The amount in rupees. If it is missing, you type the amount in your app." },
  { name: "mam", text: "A minimum amount. mam=null, or an empty mam, means the amount in am cannot be changed." },
  { name: "cu", text: "The currency. The draft says only INR is supported." },
  { name: "tn", text: "A short note shown with the payment." },
  { name: "tr", text: "A reference such as an order or bill number. The draft makes it mandatory for merchant and dynamic codes." },
  { name: "tid", text: "A transaction ID generated by a payment service provider, when present." },
  { name: "mc", text: "The merchant category code." },
  { name: "url", text: "A web address with bill or order details. It should start with http or https." },
  { name: "mode", text: "How the code was made, for example 00 default, 01 QR code, 02 secure QR code, 04 intent or 05 secure intent." },
  { name: "sign", text: "A digital signature. The draft says an app should warn when it is missing. This page cannot check one." },
  { name: "orgid", text: "A 6-digit organisation ID. 000000 stands for a code created by a merchant." },
  { name: "mid, msid, mtid", text: "Merchant, store and terminal IDs of up to 20 digits, which the merchant or its acquiring bank use for reconciliation." },
];

const faqs = [
  {
    question: "Is it safe to scan a UPI QR code?",
    answer:
      "Reading a QR only reveals the text inside it. What matters is what you do next. Scan to pay only when you mean to pay, check the payee name your UPI app shows before you enter your PIN, and never scan a code or enter a PIN to receive money: the Reserve Bank of India says receiving money does not need either. This page shows what a QR says, but it cannot tell you the QR is the one the shop meant to display.",
  },
  {
    question: "What does a UPI QR code contain?",
    answer:
      "A text link such as upi://pay?pa=shop@bank&pn=Shop&am=100&cu=INR. The pa part is the payee's UPI ID, pn is a name written by whoever made the code, am is an optional amount and cu is the currency. A static shop QR often has no amount, so you type it. The table above lists the other parameters.",
  },
  {
    question: "Why does my phone camera only show a link or text?",
    answer:
      "A camera app only decodes the QR into text, and for a UPI QR that text is a upi:// link. Depending on the phone it may offer to open a UPI app or just show the link. This page takes the same text and splits it into the UPI ID, the name, the amount and notes, so you can read it before anything is opened.",
  },
  {
    question: "What are mode, sign and orgid in a UPI QR?",
    answer:
      "In the NPCI draft, mode says how the link or QR was made, sign carries a digital signature and orgid is a 6-digit organisation ID, with 000000 for a merchant-created code. This page cannot check a signature. A simple QR may leave all three out, and the page shows that as a note, not as a problem.",
  },
  {
    question: "Can someone stick a different QR over a shop's QR?",
    answer:
      "Yes. A sticker can be placed over a printed code, and a swapped code pays someone else; the FBI has warned that physical QR codes are replaced this way, for example with a sticker over the original. A scan, here or in your UPI app, reads whatever is on top, so the check that matters is the payee name your app shows: if it is not the shop's name, stop and ask the shop. Shop owners can read our guide on preventing QR tampering.",
  },
  {
    question: "Why can the payee name in my UPI app differ from the name in the QR?",
    answer:
      "The name inside a QR is text chosen by whoever made it, and nobody checks it. Your UPI app can show a different name for the same UPI ID. Treat the name your app shows as the one to compare with the person or shop you mean to pay. If neither name matches who you expect, do not pay.",
  },
  {
    question: "Does this page upload my camera feed or photo?",
    answer:
      "No. The camera starts only when you tap Start camera, each frame is checked inside your browser and dropped, and the camera stops when you press Stop, when a code is read or when you leave the page. Photos and pasted text are read in the browser too. Nothing you scan, photograph or paste is sent to us or saved, and there is no scan history. Like every page here, the page itself is counted in cookie-free page-view statistics; see the privacy policy.",
  },
  {
    question: "Why is my camera blocked or not starting?",
    answer:
      "The browser needs a secure (https) page and your permission, and the site must be allowed to use the camera. If you tapped Block, allow the camera for this site in the browser settings. A camera may also be missing or in use by another app. A browser built into another app may not pass camera access to the page: open the page in your main browser. You can always use Take a photo or paste the QR text instead.",
  },
  {
    question: "What if the QR is a UPI AutoPay (mandate) code?",
    answer:
      "A upi://mandate code sets up a recurring debit, not a one-time payment. If you approve it, the payee can take money from your account again later. This page marks such a code with a warning. Approve one only for a subscription you set up yourself.",
  },
  {
    question: "What is a Bharat QR or EMV payment code?",
    answer:
      "Some payment QR codes use the EMV merchant QR layout, which starts with 000201, instead of a upi:// link. This page reads the merchant name, city and amount from it and checks its built-in checksum (CRC), which only shows the text was not damaged. It cannot pay such a code: use the payment app or bank app you use for it. Our glossary explains Bharat QR.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${pageUrl}#webapp`,
      name: "UPI QR Code Scanner and Reader by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: pageUrl,
      description,
      inLanguage: "en-IN",
      featureList: [
        "Scan a UPI QR with the phone camera, started only by a tap",
        "Read a QR from a photo or from pasted text",
        "Shows the UPI ID, payee name, amount and notes",
        "Compares the UPI ID with the one you expect",
        "Reads Bharat QR and EMV payment codes and checks their checksum",
        "Runs in the browser, nothing is uploaded",
      ],
      dateModified: UPI_QR_REVIEWED_ON,
      author: personSchema(),
      publisher: { "@id": "https://www.proupiqr.in/#organization" },
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      name: "How to read a UPI QR code before you pay",
      step: steps.map((step, index) => ({ "@type": "HowToStep", position: index + 1, name: step.name, text: step.text })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "All Tools", item: "https://www.proupiqr.in/tools/" },
        { "@type": "ListItem", position: 3, name: "UPI QR Scanner", item: pageUrl },
      ],
    },
  ],
};

const related = [
  { href: "/upi-qr-decoder/", name: "UPI QR decoder", note: "Read a QR from a saved image and see its fields." },
  { href: "/upi-errors-and-limits/", name: "UPI errors, limits and safety", note: "Error codes, bank limits and refund timelines in one place." },
  { href: "/blog/is-it-safe-to-scan-upi-qr-code/", name: "Is it safe to scan UPI QR codes?", note: "How QR payment scams work and how to avoid them." },
  { href: "/blog/prevent-upi-qr-code-tampering-frauds/", name: "Prevent UPI QR tampering", note: "For shop owners: keep a stranger's sticker off your counter QR." },
  { href: "/blog/upi-autopay-mandate-qr-recurring-payments/", name: "UPI AutoPay mandate QR codes", note: "What a recurring-payment QR does and how to read one." },
  { href: "/glossary/static-upi-qr/", name: "Static UPI QR in the glossary", note: "Why a printed shop QR usually has no amount." },
  { href: "/glossary/bharat-qr/", name: "Bharat QR in the glossary", note: "How it differs from the upi://pay QR on most counters." },
  { href: "/upi-id-generator/", name: "UPI ID name ideas and format check", note: "See how a UPI ID is written and which app a handle belongs to." },
  { href: "/upi-id-to-qr-code-generator/", name: "UPI ID to QR code generator", note: "Start from a UPI ID and make a QR you can print or share." },
  { href: "/payment-qr-code-generator/", name: "Payment QR code generator", note: "Which kind of payment QR suits a counter, a table or an invoice." },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="px-4 pb-4 pt-8 md:px-6 md:pb-6 md:pt-12 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/70">
          <a href="/" class="transition-colors hover:text-leaf">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/tools/" class="transition-colors hover:text-leaf">All Tools</a>
          <span aria-hidden="true">/</span>
          <span class="font-bold text-forest" aria-current="page">UPI QR Scanner</span>
        </nav>
        <p class="text-sm font-semibold text-leaf">UPI tools</p>
        <h1 class="mt-2 text-3xl font-black leading-tight tracking-tight text-forest md:mt-3 md:text-5xl">UPI QR Code Scanner &amp; Reader</h1>
        <p class="mt-3 max-w-3xl text-base leading-7 text-forest/75 md:mt-4 md:text-lg md:leading-8">
          Scan a UPI QR with your phone camera, or read one from a photo or pasted text. See the UPI ID, the payee name written in the QR, the amount and any notes, and compare the ID with the one you were given. It cannot show who owns a UPI ID, so you still check the payee name in your own UPI app before you pay.
        </p>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-forest/75 md:mt-3 md:text-base md:leading-7">
          Need a QR for your shop? <a href="/" class="font-semibold text-leaf underline">Make one free</a> with the UPI QR generator, or try the <a href="/universal-qr-generator/" class="font-semibold text-leaf underline">universal QR generator</a>.
        </p>
      </div>
    </section>

    <section id="scanner" class="scroll-mt-28 px-4 pb-6 pt-2 md:px-6 lg:px-8">
      <UpiQrScanner client:load />
    </section>

    <section class="px-4 py-12 md:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-leaf">How it works</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight text-forest md:text-3xl">Read a UPI QR in three steps</h2>
        <ol class="mt-6 grid gap-4 md:grid-cols-3">
          {steps.map((step, index) => (
            <li class="rounded-[12px] border border-forest/10 bg-white p-5">
              <p class="text-sm font-semibold text-leaf">Step {index + 1}</p>
              <h3 class="mt-1 text-lg font-semibold text-forest">{step.name}</h3>
              <p class="mt-2 text-sm leading-6 text-forest/75">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="px-4 py-12 md:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-leaf">Scope</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight text-forest md:text-3xl">What this page does and does not do</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div class="rounded-[12px] border border-forest/10 bg-white p-5">
            <h3 class="text-lg font-semibold text-forest">It does</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-forest/75">
              <li>Read the text inside a UPI QR (upi://pay), an AutoPay QR (upi://mandate), a web-address QR or a Bharat QR / EMV payment code.</li>
              <li>Split a UPI link into its fields and flag a missing UPI ID, repeated fields, a currency other than INR and hidden characters.</li>
              <li>Recompute the built-in checksum of an EMV code, which shows whether its text was damaged.</li>
              <li>Run in your browser, with no upload, no account and no scan history.</li>
            </ul>
          </div>
          <div class="rounded-[12px] border border-forest/10 bg-white p-5">
            <h3 class="text-lg font-semibold text-forest">It does not</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-forest/75">
              <li>Pay anything, open your UPI app or open any link it finds in a QR.</li>
              <li>Show that a UPI ID exists, who owns it, or that a QR was made by the shop it stands in.</li>
              <li>Check a digital signature, which needs keys this page does not have.</li>
              <li>Replace your UPI app, or give legal or financial advice.</li>
            </ul>
          </div>
        </div>
        <p class="mt-5 text-sm leading-6 text-forest/75">
          Pro UPI QR is an independent tool and is not affiliated with NPCI, any bank or any UPI app. Read the <a href="/disclaimer/" class="font-semibold text-leaf underline">disclaimer</a>.
        </p>
      </div>
    </section>

    <section class="px-4 py-12 md:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-leaf">Reference</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight text-forest md:text-3xl">What is inside a UPI QR code</h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-forest/75">
          A UPI QR code is a picture of a text link such as <code class="break-all rounded-[7px] bg-fog px-1.5 py-0.5 font-mono text-sm text-forest">upi://pay?pa=shop@bank&amp;pn=Shop&amp;am=100&amp;cu=INR</code>. NPCI's UPI Linking Specifications define the parameters below; version 1.6 is a draft from November 2017, so apps in use today may differ. A printed shop QR may carry only a few of them.
        </p>
        <dl class="mt-6">
          {parameters.map((parameter) => (
            <div class="grid gap-1 border-t border-forest/10 py-3 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
              <dt class="font-mono text-sm font-semibold text-forest">{parameter.name}</dt>
              <dd class="text-sm leading-6 text-forest/75">{parameter.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="px-4 py-12 md:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-leaf">FAQ</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight text-forest md:text-3xl">UPI QR scanner questions</h2>
        <div class="mt-6 grid gap-4">
          {faqs.map((faq) => (
            <details class="rounded-[10px] bg-fog px-5 py-4">
              <summary class="cursor-pointer list-none text-lg font-semibold text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/75">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-12 md:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-leaf">Sources and method</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight text-forest md:text-3xl">Where the rules come from</h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-forest/75">
          The page splits a upi:// link at &amp; and =, turns %20 and + into spaces, reads each parameter against the NPCI draft and applies a few plain checks: an ID written like name@handle, an amount with at most two decimals, the currency INR, repeated parameters and hidden characters. Amounts are read as text and kept as whole paise, never converted with floating-point maths. For a web address it shows the site name a browser would connect to. For an EMV code it walks the tag-length-value text, counting each length in characters, and recomputes the CRC-16/CCITT-FALSE checksum (polynomial 0x1021, start value 0xFFFF) over the text's UTF-8 bytes; our tests reproduce the checksum of a payload published by Banco Central do Brasil. Because the NPCI document is an old draft, a missing or extra parameter is shown as a note, never as an error.
        </p>
        <ul class="mt-5">
          {UPI_QR_SOURCES.map((source) => (
            <li class="border-t border-forest/10 py-3 text-sm leading-6 text-forest/75">
              <a href={source.href} target="_blank" rel="noopener noreferrer nofollow" class="font-semibold text-leaf underline">{source.label}</a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm leading-6 text-forest/75">
          Last reviewed {reviewedLabel} by <a href="/authors/kunal-siyag/" class="font-semibold text-leaf underline">Kunal Siyag</a>. See the <a href="/accuracy-policy/" class="font-semibold text-leaf underline">accuracy policy</a> for how facts are checked and corrected.
        </p>
      </div>
    </section>

    <section class="px-4 pb-16 pt-6 md:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold text-leaf">Related</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight text-forest">More on reading and checking UPI QR codes</h2>
        <ul class="mt-4">
          {related.map((item) => (
            <li class="border-t border-forest/10">
              <a href={item.href} class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between">
                <span class="text-[15px] font-semibold text-forest hover:text-leaf">{item.name}</span>
                <span class="text-sm text-forest/70">{item.note}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
