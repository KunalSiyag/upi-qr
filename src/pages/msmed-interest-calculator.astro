---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MsmedInterestCalculator } from "../components/MsmedInterestCalculator";

const title = "MSMED Delayed Payment Interest Calculator - 15% p.a. | Pro UPI QR";
const description = "Calculate interest on late B2B payments under Section 16 of the MSMED Act — 15% per year for micro & small suppliers. Days overdue, claim amount, and a PDF statement.";

const faqs = [
  {
    question: "What is the MSMED Act interest on delayed payments?",
    answer: "Under Section 16 of the Micro, Small and Medium Enterprises Development Act, 2006, buyers who delay payment beyond agreed terms (capped at 45 days) must pay compound interest at three times the RBI bank rate — currently 15% per year with monthly rests — to registered micro and small suppliers."
  },
  {
    question: "Who can claim this interest?",
    answer: "Suppliers registered as Udyam/MSME selling goods or services to any buyer, including large corporates and government departments. Registration is free on the Udyam portal; you must be registered to file before an MSE Facilitation Council."
  },
  {
    question: "How is the interest calculated and enforced?",
    answer: "Interest runs from the day after the due date until actual payment. The primary remedy is filing a reference before the MSE Facilitation Council in your state (via the SAMADHAAN portal), which has the power to award the interest with monthly compounding. This calculator's statement organises your numbers for that process."
  },
  {
    question: "My buyer's terms say 60 days. Can they?",
    answer: "For MSME suppliers, payment periods exceeding 45 days are legally disregarded — interest runs from the 45th day regardless of longer contract terms. The tool flags this whenever credit days exceed 45."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "MSMED Delayed Payment Interest Calculator by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/msmed-interest-calculator/",
      description,
      featureList: [
        "Section 16 MSMED interest at 15% p.a.",
        "Simple and monthly-compounding modes",
        "45-day statutory term cap warning",
        "Days-overdue auto calculation",
        "Claim statement PDF export"
      ],
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to calculate MSMED late-payment interest",
      step: [
        { "@type": "HowToStep", name: "Enter bill amount and bill date" },
        { "@type": "HowToStep", name: "Set agreed credit days (45-day statutory cap)" },
        { "@type": "HowToStep", name: "Leave payment date blank if still unpaid" },
        { "@type": "HowToStep", name: "Download the interest statement for MSE FC filing" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">MSMED Interest Calculator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">B2B money tools</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">MSMED delayed payment interest calculator</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Big buyers paying your invoices 90+ days late? The law says they owe you 15% annual interest. Compute the exact claimable amount, download a supporting statement, and stop financing corporates for free.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#msmed-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Calculate my claim</a>
            <a href="/payment-reminder-generator/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Reminder messages first →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="msmed-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <MsmedInterestCalculator client:load />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">MSMED interest questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
        <p class="mt-6 text-xs leading-6 font-medium text-forest/55">Disclaimer: Indicative computation based on published MSMED provisions and common Council awards. Statutory rates and category rules change — verify with the SAMADHAAN portal or legal counsel before filing.</p>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10">
        <h2 class="text-2xl font-black tracking-tight md:text-3xl">Prevention beats 15% compensation.</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/72">Invoices with scan-and-pay QRs get settled dramatically faster than net-90 promises.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/invoice-generator/" class="rounded-full bg-sun px-5 py-2.5 text-sm font-black text-forest hover:bg-white transition">Invoice with payment QR →</a>
          <a href="/tools/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Browse all tools</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
