---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DEFAULT_AUTHOR, personSchema } from "../../data/authors";

const author = DEFAULT_AUTHOR;
const title = "Kunal Siyag, Founder of Pro UPI QR | Pro UPI QR";
const description =
  "Kunal Siyag founded Pro UPI QR, writes the UPI merchant guides, and checks bank limits, MDR, and refund TAT against NPCI and RBI sources.";
const pageUrl = `https://www.proupiqr.in${author.path}`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${pageUrl}#page`,
      name: title,
      description,
      url: pageUrl,
      inLanguage: "en-IN",
      mainEntity: personSchema(author),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "Authors", item: "https://www.proupiqr.in/authors/" },
        { "@type": "ListItem", position: 3, name: author.name, item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="mx-auto max-w-4xl px-4 py-12 md:px-6 lg:px-8">
    <article class="rounded-[2rem] border border-white/70 bg-white/85 p-6 shadow-md md:p-10">
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
        <a href="/" class="hover:text-leaf transition-colors">Home</a>
        <span>/</span>
        <a href="/authors/" class="hover:text-leaf transition-colors">Authors</a>
        <span>/</span>
        <span class="text-forest font-bold" aria-current="page">{author.name}</span>
      </nav>

      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-forest text-2xl font-black text-white">
          {author.initials}
        </div>
        <div>
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-leaf">
            {author.jobTitle}
          </p>
          <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-forest md:text-5xl">{author.name}</h1>
          <p class="mt-3 text-base leading-7 text-forest/75">{author.shortBio}</p>
        </div>
      </div>

      <div class="mt-8 space-y-5 text-sm leading-relaxed text-forest/80">
        {author.longBio.map((para) => (
          <p>{para}</p>
        ))}
      </div>

      <section class="mt-10">
        <h2 class="text-xl font-bold text-forest">How the work is checked</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-forest/80">
          <li>Bank limits, MDR, and refund windows are compared with NPCI/RBI or the bank’s own page, then dated.</li>
          <li>Calculator outputs are checked in integer paise against known values (see the <a href="/accuracy-policy/" class="font-semibold text-leaf underline">accuracy policy</a>).</li>
          <li>Compatible UPI prints are not described as official PhonePe or GPay merchant kits.</li>
          <li>Material mistakes are listed on the <a href="/corrections/" class="font-semibold text-leaf underline">corrections log</a>.</li>
        </ul>
      </section>

      <section class="mt-10">
        <h2 class="text-xl font-bold text-forest">Elsewhere</h2>
        <ul class="mt-3 space-y-2 text-sm font-semibold text-leaf">
          <li><a href="https://github.com/KunalSiyag" class="underline" rel="noopener noreferrer">GitHub — KunalSiyag</a></li>
          <li><a href="https://x.com/proupiqr" class="underline" rel="noopener noreferrer">X — @proupiqr</a></li>
          <li><a href={`mailto:${author.email}`}>{author.email}</a></li>
        </ul>
      </section>

      <p class="mt-10 text-sm">
        <a href="/editorial-policy/" class="font-semibold text-leaf underline">Editorial policy</a>
        ·
        <a href="/about/" class="font-semibold text-leaf underline">About the site</a>
      </p>
    </article>
  </main>
</BaseLayout>
