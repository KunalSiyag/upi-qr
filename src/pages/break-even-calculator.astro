---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BreakEvenCalculator } from "../components/BreakEvenCalculator";

const title = "Break-Even Calculator - Units to Survive & Profit Target | Pro UPI QR";
const description = "Find exactly how many units your shop or service must sell monthly to cover costs, plus units needed for any profit target and your margin of safety. Free, browser-only.";

const faqs = [
  {
    question: "How is the break-even point calculated?",
    answer: "Break-even units = fixed monthly costs ÷ contribution per unit, where contribution = selling price − variable cost per unit. For example, ₹50,000 fixed costs with ₹80 contribution needs 625 unit sales before any profit exists."
  },
  {
    question: "What counts as fixed vs variable cost?",
    answer: "Fixed costs stay the same regardless of sales — rent, salaries, EMIs, insurance. Variable costs scale directly with each unit sold — materials, packaging, delivery commission. If unsure, ask: 'Would this cost exist even if I sold zero units this month?'"
  },
  {
    question: "What is margin of safety?",
    answer: "It shows how far current sales can fall before you hit break-even. Selling 1,000 units against a 625-unit break-even gives a 37.5% margin of safety — comfortable. At 650 units it's just 3.8% — one slow month hurts."
  },
  {
    question: "Can I use this for services instead of products?",
    answer: "Yes — define a 'unit' as one client engagement, order, or billable hour. Fixed costs are your monthly overheads; variable costs are anything you spend per delivery (travel, materials, subcontractor fees)."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Break-Even Calculator by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/break-even-calculator/",
      description,
      featureList: [
        "Break-even units and revenue calculation",
        "Contribution margin analysis",
        "Target-profit unit requirement",
        "Margin of safety at current volumes",
        "Analysis PDF/PNG export"
      ],
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to calculate break-even point",
      step: [
        { "@type": "HowToStep", "name": "Add total fixed monthly costs" },
        { "@type": "HowToStep", "name": "Enter selling price and variable cost per unit" },
        { "@type": "HowToStep", "name": "Read the exact survival-point unit count" },
        { "@type": "HowToStep", "name": "Optionally add current sales for margin of safety" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">Break-Even Calculator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Money tools</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Break-even calculator — know your survival number</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Before you sign rent agreements or quote prices, know exactly how many units per month keep the lights on — and how many deliver real profit.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#breakeven-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Calculate my break-even</a>
            <a href="/tools/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">More money tools →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="breakeven-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <BreakEvenCalculator client:visible />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Break-even questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-center text-white md:p-10">
        <h2 class="text-2xl font-black tracking-tight md:text-3xl">Every unit past break-even deserves zero payment fees.</h2>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/margin-calculator/" class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition">Margin Calculator</a>
          <a href="/" class="rounded-full bg-sun px-5 py-2.5 text-sm font-black text-forest hover:bg-white transition">Free UPI QR →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
