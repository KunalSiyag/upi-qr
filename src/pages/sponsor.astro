---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BUSINESS } from "../data/business";
import { LOCALIZED_TOOLS } from "../data/localizedTools";
import { PLACEMENTS, SPONSOR_EXCLUSIONS, SPONSOR_REACH } from "../data/sponsors";

const title = "Sponsor Pro UPI QR — Reach Indian Shops and Freelancers";
const description =
  "Sponsor the homepage of Pro UPI QR, the free UPI QR and invoice toolkit for Indian shops and freelancers. One labelled sponsor at a time, no tracking scripts.";
const pageUrl = "https://www.proupiqr.in/sponsor/";
const number = (n: number) => new Intl.NumberFormat("en-IN").format(n);
const mailto = `mailto:${BUSINESS.emails.support}?subject=${encodeURIComponent("Sponsorship enquiry")}`;
const link = "font-semibold text-leaf underline underline-offset-4";

const reach = [
  { value: number(SPONSOR_REACH.weeklyImpressions), label: "times our pages showed in Google search in one week" },
  { value: number(SPONSOR_REACH.weeklyClicks), label: "visits from Google search in the same week" },
  { value: SPONSOR_REACH.clicksChange, label: "more search visits than the week before" },
  { value: String(LOCALIZED_TOOLS.length), label: "free tools in English, Hindi, Tamil, Telugu and Marathi" },
];

const offer = [
  "Your name, one line in your words and an optional logo, in a card labelled \"Sponsored\".",
  "One sponsor per placement at a time, booked by the week or the month.",
  "A plain link with rel=\"sponsored\" and utm_source=proupiqr, so your own analytics count every visit.",
  "We read the copy and the landing page before it goes live. Claims must be true and checkable.",
];

const never = [
  "No ad network, script, pixel or cookie from the sponsor loads on our pages.",
  "We share no visitor data with sponsors. There is nothing to share: the tools run in the visitor's browser.",
  "No pop-ups, no interstitials, nothing inside a QR code, invoice, receipt or PDF a visitor downloads.",
];

const faqs = [
  {
    question: "Where does the sponsor appear?",
    answer: `${PLACEMENTS["home-hero"].where} It is a single card with a "Sponsored" label, and the tools themselves stay free and unchanged.`,
  },
  {
    question: "How do I measure results?",
    answer: "Every sponsor link carries utm_source=proupiqr, utm_medium=sponsor and utm_campaign=home-hero. Your own analytics show the visits and what they did next. We don't run tracking of our own on the card.",
  },
  {
    question: "What does a placement cost?",
    answer: `Rates depend on the dates and the length of the booking. Email ${BUSINESS.emails.support} with your brand, link and preferred weeks and we'll reply within ${BUSINESS.replyWithin}.`,
  },
  {
    question: "Which brands don't you accept?",
    answer: `Our visitors are taking payments, so we keep the spot safe for them. We don't accept: ${SPONSOR_EXCLUSIONS.join("; ").toLowerCase()}.`,
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#page`,
      name: title,
      description,
      url: pageUrl,
      inLanguage: "en-IN",
      isPartOf: { "@id": "https://www.proupiqr.in/#website" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "Sponsor", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="px-4 pb-10 pt-12 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-muted">
          <a href="/" class="transition-colors hover:text-leaf">Home</a>
          <span>/</span>
          <span class="text-ink" aria-current="page">Sponsor</span>
        </nav>
        <p class="text-sm font-semibold text-leaf">Sponsor Pro UPI QR</p>
        <h1 class="mt-3 max-w-4xl text-4xl font-semibold leading-tight tracking-tight text-ink md:text-6xl">Put your brand in front of India's UPI merchants.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-charcoal">
          Shop owners, tutors, clinics and freelancers come to Pro UPI QR to make their payment QR, send invoices and receipts, and track who owes them. One sponsor at a time gets the card beside our homepage headline.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={mailto} class="rounded-[10px] bg-forest px-6 py-3 text-sm font-semibold text-white transition hover:bg-graphite">Email us to book</a>
          <a href="/" class="rounded-[10px] bg-white px-6 py-3 text-sm font-semibold text-ink ring-1 ring-hairline transition hover:bg-fog">See the homepage</a>
        </div>
      </div>
    </section>

    <section class="px-4 pb-10 md:px-6 lg:px-8" aria-labelledby="reach">
      <div class="mx-auto max-w-5xl">
        <h2 id="reach" class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">Reach</h2>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {reach.map((item) => (
            <div class="flex flex-col rounded-[12px] bg-white p-5 shadow-card">
              <dt class="text-sm leading-6 text-charcoal">{item.label}</dt>
              <dd class="order-first text-3xl font-semibold tracking-tight text-ink">{item.value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-3 text-sm text-muted">Search figures: {SPONSOR_REACH.source}, {SPONSOR_REACH.period}. Visitors who come back directly or from WhatsApp aren't counted here.</p>
      </div>
    </section>

    <section class="px-4 pb-10 md:px-6 lg:px-8">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-ink">What you get</h2>
          <p class="mt-3 text-base leading-7 text-charcoal"><strong class="font-semibold text-ink">{PLACEMENTS["home-hero"].name}.</strong> {PLACEMENTS["home-hero"].where}</p>
          <ul class="mt-4 divide-y divide-hairline border-y border-hairline text-base leading-7 text-charcoal">
            {offer.map((item) => <li class="py-3">{item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-ink">What we never do</h2>
          <ul class="mt-4 divide-y divide-hairline border-y border-hairline text-base leading-7 text-charcoal">
            {never.map((item) => <li class="py-3">{item}</li>)}
          </ul>
          <h3 class="mt-8 text-lg font-semibold text-ink">Brands we don't accept</h3>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-base leading-7 text-charcoal">
            {SPONSOR_EXCLUSIONS.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="px-4 pb-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl rounded-[14px] bg-forest p-6 text-white md:p-10">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Book the spot</h2>
        <p class="mt-3 max-w-3xl text-base leading-7 text-white/80">
          Email <a href={mailto} class="font-semibold text-white underline underline-offset-4">{BUSINESS.emails.support}</a> with your brand, the link, one line of copy and the weeks you want. We reply within {BUSINESS.replyWithin} with dates and the rate.
        </p>
      </div>
    </section>

    <section class="px-4 pb-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">Questions</h2>
        <div class="mt-6 grid gap-3">
          {faqs.map((faq) => (
            <details class="rounded-[10px] bg-fog px-5 py-4">
              <summary class="cursor-pointer list-none text-base font-semibold text-ink">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-charcoal">{faq.answer}</p>
            </details>
          ))}
        </div>
        <p class="mt-8 text-sm text-muted">Read how we run the site on the <a href="/about/" class={link}>about page</a> and in the <a href="/privacy/" class={link}>privacy policy</a>.</p>
      </div>
    </section>
  </main>
</BaseLayout>
