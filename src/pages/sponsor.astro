---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SponsorBooking } from "../components/SponsorBooking";
import { BUSINESS } from "../data/business";
import { LOCALIZED_TOOLS } from "../data/localizedTools";
import { SPONSOR_EXCLUSIONS, SPONSOR_REACH, SPONSOR_TIERS } from "../data/sponsors";

const title = "Sponsor Pro UPI QR — Reach Indian Shops and Freelancers";
const description =
  "Sponsor the homepage of Pro UPI QR, the free UPI QR and invoice toolkit for Indian shops and freelancers: a featured card or a logo tile, labelled, no tracking.";
const pageUrl = "https://www.proupiqr.in/sponsor/";
const number = (n: number) => new Intl.NumberFormat("en-IN").format(n);
const mailto = `mailto:${BUSINESS.emails.support}?subject=${encodeURIComponent("Sponsorship enquiry")}`;
const link = "font-semibold text-leaf underline underline-offset-4";
const { featured, tile } = SPONSOR_TIERS;

const reach = [
  { value: number(SPONSOR_REACH.weeklyImpressions), label: "times our pages showed in Google search in one week" },
  { value: number(SPONSOR_REACH.weeklyClicks), label: "visits from Google search in the same week" },
  { value: SPONSOR_REACH.clicksChange, label: "more search visits than the week before" },
  { value: String(LOCALIZED_TOOLS.length), label: "free tools in English, Hindi, Tamil, Telugu and Marathi" },
];

const tiers = [
  {
    name: featured.name,
    price: `${featured.label} a month`,
    spots: "One sponsor at a time",
    where: featured.where,
    points: ["Renews monthly; cancel whenever you like.", "Yours for as long as you renew: nobody can book it from under you.", "When it's taken, the next sponsor can book once it ends."],
  },
  {
    name: tile.name,
    price: `${tile.label} a month`,
    spots: `${tile.spots} tiles`,
    where: tile.where,
    points: ["Renews monthly; cancel whenever you like.", "Live as soon as we've approved it.", "Your price stays the same for as long as you renew."],
  },
];

const never = [
  "No ad network, script, pixel or cookie from the sponsor loads on our pages.",
  "We share no visitor data with sponsors. There is nothing to share: the tools run in the visitor's browser.",
  "No pop-ups, no interstitials, nothing inside a QR code, invoice, receipt or PDF a visitor downloads.",
];

const faqs = [
  {
    question: "Where does the sponsor appear?",
    answer: `${featured.name}: ${featured.where} ${tile.name}: ${tile.where} Both are labelled, and the tools themselves stay free and unchanged.`,
  },
  {
    question: "How does booking work?",
    answer: "Choose a placement, add your brand name, link and logo (and one line for the featured card), and pay on Dodo Payments' checkout. We review every first booking within a day. Once approved it goes live straight away and stays up for as long as you renew.",
  },
  {
    question: "What if you don't approve my booking?",
    answer: "You get a full refund. We decline anything on our exclusion list, misleading claims, and landing pages that ask for payment details or PINs.",
  },
  {
    question: "What if another brand offers more for the featured card?",
    answer: "Prices are fixed and published here, and a paid booking is never moved or cancelled for someone else. The featured card stays with its sponsor for as long as they renew; if prices change, they change for new bookings only.",
  },
  {
    question: "How do I measure results?",
    answer: "Every sponsor link carries utm_source=proupiqr and utm_medium=sponsor, with utm_campaign=home-featured or home-tile. Your own analytics show the visits and what they did next. We don't run tracking of our own on the placements.",
  },
  {
    question: "Which brands don't you accept?",
    answer: `Our visitors are taking payments, so we keep these spots safe for them. We don't accept: ${SPONSOR_EXCLUSIONS.join("; ").toLowerCase()}.`,
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#page`,
      name: title,
      description,
      url: pageUrl,
      inLanguage: "en-IN",
      isPartOf: { "@id": "https://www.proupiqr.in/#website" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.proupiqr.in/" },
        { "@type": "ListItem", position: 2, name: "Sponsor", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="px-4 pb-10 pt-12 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-muted">
          <a href="/" class="transition-colors hover:text-leaf">Home</a>
          <span>/</span>
          <span class="text-ink" aria-current="page">Sponsor</span>
        </nav>
        <p class="text-sm font-semibold text-leaf">Sponsor Pro UPI QR</p>
        <h1 class="mt-3 max-w-4xl text-4xl font-semibold leading-tight tracking-tight text-ink md:text-6xl">Put your brand in front of India's UPI merchants.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-charcoal">
          Shop owners, tutors, clinics and freelancers come to Pro UPI QR to make their payment QR, send invoices and receipts, and track who owes them. Book the featured card beside our homepage headline or a logo tile under the QR generator, online, in a few minutes.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#book" class="rounded-[10px] bg-forest px-6 py-3 text-sm font-semibold text-white transition hover:bg-graphite">Book a placement</a>
          <a href="/" class="rounded-[10px] bg-white px-6 py-3 text-sm font-semibold text-ink ring-1 ring-hairline transition hover:bg-fog">See the homepage</a>
        </div>
      </div>
    </section>

    <section class="px-4 pb-10 md:px-6 lg:px-8" aria-labelledby="reach">
      <div class="mx-auto max-w-5xl">
        <h2 id="reach" class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">Reach</h2>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {reach.map((item) => (
            <div class="flex flex-col rounded-[12px] bg-white p-5 shadow-card">
              <dt class="text-sm leading-6 text-charcoal">{item.label}</dt>
              <dd class="order-first text-3xl font-semibold tracking-tight text-ink">{item.value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-3 text-sm text-muted">Search figures: {SPONSOR_REACH.source}, {SPONSOR_REACH.period}. Visitors who come back directly or from WhatsApp aren't counted here.</p>
      </div>
    </section>

    <section class="px-4 pb-10 md:px-6 lg:px-8" aria-labelledby="placements">
      <div class="mx-auto max-w-5xl">
        <h2 id="placements" class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">Two placements</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {tiers.map((t) => (
            <div class="rounded-[12px] bg-white p-6 shadow-card">
              <h3 class="text-lg font-semibold text-ink">{t.name}</h3>
              <p class="mt-1 text-2xl font-semibold tracking-tight text-ink">{t.price}</p>
              <p class="text-sm text-muted">{t.spots} · GST included</p>
              <p class="mt-4 text-base leading-7 text-charcoal">{t.where}</p>
              <ul class="mt-4 divide-y divide-hairline border-y border-hairline text-sm leading-6 text-charcoal">
                {t.points.map((p) => <li class="py-2">{p}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="book" class="scroll-mt-20 px-4 pb-10 md:px-6 lg:px-8" aria-labelledby="book-title">
      <div class="mx-auto max-w-5xl">
        <h2 id="book-title" class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">Book a placement</h2>
        <p class="mt-2 max-w-3xl text-base leading-7 text-charcoal">Paid on Dodo Payments, who issue the GST invoice. Questions first? Email <a href={mailto} class={link}>{BUSINESS.emails.support}</a>.</p>
        <div class="mt-6">
          <SponsorBooking client:visible email={BUSINESS.emails.support} />
        </div>
      </div>
    </section>

    <section class="px-4 pb-10 md:px-6 lg:px-8">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-ink">What we never do</h2>
          <ul class="mt-4 divide-y divide-hairline border-y border-hairline text-base leading-7 text-charcoal">
            {never.map((item) => <li class="py-3">{item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-ink">Brands we don't accept</h2>
          <ul class="mt-4 list-disc space-y-1 pl-5 text-base leading-7 text-charcoal">
            {SPONSOR_EXCLUSIONS.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="px-4 pb-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">Questions</h2>
        <div class="mt-6 grid gap-3">
          {faqs.map((faq) => (
            <details class="rounded-[10px] bg-fog px-5 py-4">
              <summary class="cursor-pointer list-none text-base font-semibold text-ink">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-charcoal">{faq.answer}</p>
            </details>
          ))}
        </div>
        <p class="mt-8 text-sm text-muted">Read how we run the site on the <a href="/about/" class={link}>about page</a> and in the <a href="/privacy/" class={link}>privacy policy</a>.</p>
      </div>
    </section>
  </main>
</BaseLayout>
