---
import BaseLayout from "../layouts/BaseLayout.astro";
import { QuotationGenerator } from "../components/QuotationGenerator";

const title = "Free Quotation Generator with GST & UPI Advance QR | Pro UPI QR";
const description = "Create professional quotation and estimate PDFs with items, tax, validity date, terms, and an optional UPI advance QR. Free, browser-only, no signup.";

const faqs = [
  {
    question: "What is the difference between a quotation and an invoice?",
    answer: "A quotation (or estimate) states proposed prices before work is agreed — it is not a tax document. An invoice demands payment for delivered goods or services. Use this tool to win the deal, then convert to a formal invoice from our invoice generator once confirmed."
  },
  {
    question: "How long should a quotation stay valid?",
    answer: "Fifteen to thirty days is common for services; material-heavy quotes often use seven days because input costs move. The default here is fifteen days, and the validity date prints prominently on the PDF so clients know when prices expire."
  },
  {
    question: "Can customers pay an advance directly from the quotation?",
    answer: "Yes. Add your UPI ID and a scan-and-pay QR appears on the quote so clients can lock the booking with a token advance instantly — no gateway fees, no card machines."
  },
  {
    question: "Does it calculate GST automatically?",
    answer: "Yes. Enter your tax percentage — 18% GST, VAT, or any rate — plus optional discounts, and totals update live. For intra-state Indian supplies you can note CGST/SGST split in the terms field."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Quotation Generator by Pro UPI QR",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/quotation-generator/",
      "description": description,
      "featureList": [
        "Quotation and estimate PDF generator",
        "Line items with live tax and discount totals",
        "Validity date printing",
        "Optional UPI advance payment QR",
        "WhatsApp image sharing"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      "name": "How to create a price quotation",
      "description": "Generate a professional estimate PDF with terms in your browser.",
      "step": [
        { "@type": "HowToStep", "name": "Add your business, customer, and quote number" },
        { "@type": "HowToStep", "name": "List line items with quantity and rate" },
        { "@type": "HowToStep", "name": "Set tax, discount, and validity date" },
        { "@type": "HowToStep", "name": "Share via WhatsApp or download the PDF" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main>
    <section class="relative overflow-hidden px-4 pb-12 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">Quotation Generator</span>
        </nav>
        <div class="max-w-4xl">
          <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">Merchant toolkit</p>
          <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">Free quotation generator with advance-payment QR</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">Send clean estimates with line items, tax, discounts, validity dates, and your terms — plus an optional UPI QR so clients confirm with a token advance in one scan.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#quotation-tool" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">Create quotation</a>
            <a href="/invoice-generator/" class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">Convert to invoice later →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="quotation-tool" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <QuotationGenerator client:load />
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-white/75 bg-forest p-6 text-white md:p-10">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-sun">After they say yes</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">Quote → invoice → payment → receipt.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {[
            ["UPI Invoice Generator", "Turn accepted quotes into GST-ready invoice PDFs with payment QR.", "/invoice-generator/"],
            ["Payment Receipt Generator", "Acknowledge advances and settlements with PAID-stamped receipts.", "/receipt-generator/"],
            ["Payment Reminder Generator", "Politely chase dues with ready-made WhatsApp and SMS messages.", "/payment-reminder-generator/"]
          ].map(([heading, copy, href]) => (
            <article class="flex flex-col rounded-[1.5rem] border border-white/10 bg-white/8 p-5">
              <h3 class="text-xl font-black">{heading}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-white/72">{copy}</p>
              <a href={href} class="mt-4 inline-block text-sm font-black text-sun hover:text-white">Open tool →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-14 md:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">FAQ</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">Quotation questions</h2>
        <div class="mt-8 grid gap-4">
          {faqs.map((faq) => (
            <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
              <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
