---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GstCalculator } from "../components/GstCalculator";
import AffiliateProducts from "../components/AffiliateProducts.astro";
import InternalLinkHub from "../components/InternalLinkHub.astro";

const title = "GST Calculator India 2026 — Find Rate, Add or Remove";
const description = "Look up GST 2.0 rates by product — soap, freelance, gold, restaurant — then add or remove tax and split CGST/SGST or IGST. Optional UPI QR for the payable total.";

const faqs = [
  {
    question: "What are the GST rates in India in 2026?",
    answer: "GST 2.0 (56th GST Council, generally from 22 September 2025) uses 0%, 5%, 18% and 40%, plus special 3% for gold/silver jewellery and 0.25% for rough precious stones. The old 12% and 28% slabs are gone for most goods. Confirm the HSN on gst.gov.in before you file — this tool is a billing aid, not the GST portal."
  },
  {
    question: "I do not remember the rate. How do I find it?",
    answer: "Search the product or service in the calculator (soap, freelance, restaurant, gold, cement…). It fills a common GST 2.0 rate and HSN hint. Apparel and footwear still flip at ₹2,500 a piece. Always match the HSN on the official rate finder if the item is unusual."
  },
  {
    question: "CGST + SGST or IGST?",
    answer: "Same-state (intra-state) supplies split GST equally into CGST and SGST. Inter-state supplies charge IGST at the full slab. The payable total is the same; only the columns on the invoice change."
  },
  {
    question: "Can a composition dealer use this?",
    answer: "Turn on the composition toggle. Composition dealers issue a bill of supply and cannot charge GST. Use the bill of supply generator for the document; this calculator will zero the tax so the QR matches what you actually collect."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "GST Calculator India 2026 by Pro UPI QR",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      url: "https://www.proupiqr.in/gst-calculator/",
      description,
      featureList: [
        "GST 2.0 product and service rate lookup",
        "Add GST or extract GST from MRP",
        "CGST + SGST vs IGST split",
        "Multi-item bills in integer paise",
        "Optional UPI QR for the payable total"
      ],
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    },
    {
      "@type": "HowTo",
      name: "How to calculate GST on an Indian invoice",
      step: [
        { "@type": "HowToStep", name: "Search the product or pick a GST 2.0 slab" },
        { "@type": "HowToStep", name: "Enter the amount exclusive or inclusive of tax" },
        { "@type": "HowToStep", name: "Choose intra-state (CGST+SGST) or inter-state (IGST)" },
        { "@type": "HowToStep", name: "Copy the breakdown or generate a UPI QR for the total" }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-8">
      <div class="rounded-[2.5rem] border border-white/75 bg-white/86 p-6 sm:p-8 md:p-10 shadow-[0_18px_48px_rgba(17,59,44,0.08)] space-y-4">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">GST Calculator</span>
        </nav>
        <div class="inline-flex items-center gap-2 rounded-full bg-mint px-3.5 py-1 text-xs font-bold text-leaf border border-leaf/10">
          GST 2.0 · 0% / 5% / 18% / 40%
        </div>
        <h1 class="text-3xl font-black tracking-tight text-forest sm:text-5xl">GST calculator that finds the rate for you</h1>
        <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-forest/75">
          Nobody remembers whether soap is 5% or 18%. Search the item, add or peel GST off an MRP, and split CGST/SGST or IGST. Then send a UPI QR for the exact payable total.
        </p>
      </div>

      <div class="rounded-[2.5rem] border border-white/75 bg-white/86 p-6 sm:p-8 md:p-10 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
        <GstCalculator client:visible />
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-3xl bg-mint/40 p-6 border border-leaf/10 space-y-2">
          <h2 class="text-base font-black text-forest">GST 2.0 slabs</h2>
          <p class="text-xs text-forest/75 leading-relaxed">
            0% essentials, 5% merit goods, 18% standard (most services and electronics), 40% sin/luxury. Gold stays 3%. Old 12% and 28% remain only for leftover invoices.
          </p>
        </div>
        <div class="rounded-3xl bg-cream/60 p-6 border border-forest/10 space-y-2">
          <h2 class="text-base font-black text-forest">Add vs remove GST</h2>
          <p class="text-xs text-forest/75 leading-relaxed">
            Exclusive: tax = amount × rate. Inclusive: base = total ÷ (1 + rate). Both round to paise so the invoice columns add back to the rupee.
          </p>
        </div>
        <div class="rounded-3xl bg-[#f2e5cd]/60 p-6 border border-forest/10 space-y-2">
          <h2 class="text-base font-black text-forest">Not a GST return</h2>
          <p class="text-xs text-forest/75 leading-relaxed">
            File on the GST portal. Need a document? Use the <a class="font-bold text-leaf underline" href="/invoice-generator/">tax invoice</a> or <a class="font-bold text-leaf underline" href="/bill-of-supply-generator/">bill of supply</a> generator.
          </p>
        </div>
      </div>

      <section class="space-y-4">
        <h2 class="text-2xl font-black text-forest">GST calculator questions</h2>
        {faqs.map((faq) => (
          <details class="section-card rounded-[1.5rem] border border-white/75 bg-white/86 p-5">
            <summary class="cursor-pointer list-none text-lg font-black text-forest">{faq.question}</summary>
            <p class="mt-3 max-w-3xl text-base leading-7 text-forest/72">{faq.answer}</p>
          </details>
        ))}
      </section>

      <AffiliateProducts />
      <InternalLinkHub currentPath="/gst-calculator/" />
    </div>
  </main>
</BaseLayout>
