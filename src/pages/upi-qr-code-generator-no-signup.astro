---
import BaseLayout from "../layouts/BaseLayout.astro";
import { UniversalQrForm } from "../components/UniversalQrForm";
import InternalLinkHub from "../components/InternalLinkHub.astro";
import EmbedWidgetModal from "../components/EmbedWidgetModal.astro";

const title = "UPI QR Code Generator No Signup | 100% Free & Private";
const description =
  "Create instant UPI payment QR posters without creating an account or logging in. 100% private, client-side rendering for PhonePe, GPay, Paytm & SBI.";

const faqs = [
  {
    question: "Do I need to sign up or enter my email address to create a QR code?",
    answer:
      "No! You can generate unlimited payment QR code posters instantly without signing up, registering, or revealing personal data."
  },
  {
    question: "Is my UPI ID or payment data stored on your servers?",
    answer:
      "Zero server tracking. All QR codes are calculated 100% locally inside your web browser using HTML5 Canvas & WebAssembly APIs."
  },
  {
    question: "Which payment apps are supported by the generated QR code?",
    answer:
      "All NPCI compliant payment apps in India are supported, including PhonePe, Google Pay (GPay), Paytm, BHIM UPI, WhatsApp Pay, and all Indian mobile banking apps."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://www.proupiqr.in/upi-qr-code-generator-no-signup/#webapp",
      "name": "Instant UPI QR Code Generator No Signup",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "url": "https://www.proupiqr.in/upi-qr-code-generator-no-signup/",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.proupiqr.in/upi-qr-code-generator-no-signup/#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": " " + faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="py-8">
    <section class="px-5 pb-6 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-mint border border-leaf/20 text-xs font-black text-forest uppercase tracking-wider mb-3">
        <svg class="h-3.5 w-3.5 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span>No Account Required • 100% Private Client-Side Rendering</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-forest">
        Instant UPI QR Code Generator (No Signup)
      </h1>
      <p class="mt-3 text-base text-forest/75 leading-relaxed">
        Generate custom payment posters and counter standees instantly. Enter your UPI VPA handle and download print-ready vector files <strong>without login, email collection, or monthly fees</strong>.
      </p>
    </section>

    <!-- Interactive Generator -->
    <section class="px-4 pb-12">
      <UniversalQrForm client:load />
    </section>

    <div class="max-w-4xl mx-auto px-5">
      <EmbedWidgetModal generatorTitle="No-Signup UPI QR Generator" />
    </div>

    <!-- FAQs -->
    <section class="max-w-4xl mx-auto px-5 py-12">
      <h2 class="text-2xl font-black text-forest text-center mb-6">Frequently Asked Questions</h2>
      <div class="grid gap-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm">
            <h3 class="text-base font-black text-forest">{faq.question}</h3>
            <p class="mt-2 text-sm text-forest/75 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <InternalLinkHub />
  </main>
</BaseLayout>
