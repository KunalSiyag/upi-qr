---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogListing from "../../components/BlogListing.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const title = "UPI QR Guides for Shops, NGOs & Creators";
const description =
  "Practical UPI QR guides for Indian shops, freelancers, restaurants and NGOs: print standees, fix scan issues, compare apps, and collect payments.";
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-4 py-16 md:px-6 lg:px-8">
    <BlogListing posts={posts} />
  </main>
</BaseLayout>