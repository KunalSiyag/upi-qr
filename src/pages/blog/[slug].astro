---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import InternalLinkHub from "../../components/InternalLinkHub.astro";
import { getGeneratorCtaForTags } from "../../data/internalLinks";
import { hubForPath, relatedArticlesFromCollection } from "../../data/topicHubs";
import {
  formatEnIn,
  nextReviewDate,
  personSchema,
  resolveAuthor,
} from "../../data/authors";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import { DEFAULT_OG_IMAGE, resolveSiteImage } from "../../data/siteImages";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
import { render } from "astro:content";
const { Content } = await render(post);

const rawTitle = post.data.title.trim();
const title = rawTitle.includes("Pro UPI QR") 
  ? rawTitle 
  : (rawTitle.length > 52 ? rawTitle : `${rawTitle} | Pro UPI QR`);
const description = post.data.description;

const postSlug = post.id.replace(/\.mdx?$/, "");
const generatorCta = getGeneratorCtaForTags(post.data.tags);

const posts = await getCollection("blog");
const relatedPosts = relatedArticlesFromCollection(posts, {
  excludeSlug: postSlug,
  tags: post.data.tags,
  hubArticleSlugs: hubForPath(`/blog/${postSlug}/`)?.articleSlugs ?? [],
  limit: 3,
});

const catalogImage = resolveSiteImage(post.data.image);
const postImagePath = post.data.image ?? DEFAULT_OG_IMAGE.src;
const postImageUrl = postImagePath.startsWith("http")
  ? postImagePath
  : new URL(postImagePath, Astro.site).toString();
const postImageObject = {
  "@type": "ImageObject",
  url: postImageUrl,
  width: catalogImage?.width ?? 1200,
  height: catalogImage?.height ?? 630,
  caption: catalogImage?.caption ?? post.data.title,
  encodingFormat: catalogImage?.mime ?? "image/jpeg",
};

const faqs: { question: string; answer: string }[] = [];
if (post.body) {
  const regex = /###\s+Q\d*\.\s*(.+?)\r?\n+([^#][\s\S]*?)(?=\r?\n### |\r?\n## |\s*$)/g;
  let match;
  while ((match = regex.exec(post.body)) !== null) {
    const question = match[1].trim();
    const answer = match[2].trim();
    faqs.push({ question, answer });
  }
}

const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const author = resolveAuthor(post.data.author);
const reviewer = post.data.reviewer ? resolveAuthor(post.data.reviewer) : null;
const reviewedOn = post.data.reviewedOn;
const nextReview =
  reviewedOn && post.data.reviewIntervalDays
    ? nextReviewDate(reviewedOn, post.data.reviewIntervalDays)
    : null;

const blogPosting: Record<string, unknown> = {
  "@type": "BlogPosting",
  "@id": postUrl + "#blogposting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  image: postImageObject,
  author: personSchema(author),
  publisher: { "@id": "https://www.proupiqr.in/#organization" },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
};

if (reviewer && reviewer.slug !== author.slug) {
  blogPosting.reviewedBy = personSchema(reviewer);
}
if (post.data.sourceUrls?.length) {
  blogPosting.citation = post.data.sourceUrls.map((source) => source.url);
}

const graph: any[] = [
  {
    "@type": "BreadcrumbList",
    "@id": postUrl + "#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.proupiqr.in/" },
      { "@type": "ListItem", "position": 2, "name": "Blog Guides", "item": "https://www.proupiqr.in/blog/" },
      { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postUrl }
    ]
  },
  blogPosting,
];

if (faqs.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "@id": postUrl + "#faq",
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") // Strip markdown links for schema text
      }
    }))
  });
}

const schema = {
  "@context": "https://schema.org",
  "@graph": graph
};

// Hindi translation (if it exists) → hreflang cluster for bilingual indexing.
import { getCollection as getBlogCollections } from "astro:content";
const hasHindiTranslation = (await getBlogCollections("blogHi")).some(
  (p) => p.id.replace(/\.mdx?$/, "") === postSlug
);
const alternates = [
  { lang: "en", url: postUrl },
  ...(hasHindiTranslation
    ? [{ lang: "hi", url: new URL(`/hi/blog/${postSlug}/`, Astro.site).toString() }]
    : []),
  { lang: "x-default", url: postUrl }
];
---

<BaseLayout title={title} description={description} schema={schema} image={post.data.image} alternates={alternates}>
  <main class="mx-auto max-w-4xl px-4 py-16 md:px-6 lg:px-8">
    <article class="rounded-[2.5rem] border border-white/75 bg-white/86 p-6 shadow-[0_18px_48px_rgba(17,59,44,0.08)] md:p-12">
      
      {/* Breadcrumb nav + Back link */}
      <div class="mb-8 flex items-center gap-2 text-xs font-semibold text-forest/50">
        <a href="/" class="hover:text-leaf transition-colors">Home</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-leaf transition-colors">Blog Guides</a>
        <span>/</span>
        <span class="text-forest/70 truncate max-w-[200px]">{post.data.title}</span>
      </div>

      {/* Frontmatter Metadata */}
      <header class="border-b border-forest/10 pb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold text-forest/50">
          <span>
            By{" "}
            <a href={author.path} class="text-leaf hover:underline">
              {author.name}
            </a>
          </span>
          <span>&bull;</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatEnIn(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <>
              <span>&bull;</span>
              <time datetime={post.data.updatedDate.toISOString()}>
                Updated {formatEnIn(post.data.updatedDate)}
              </time>
            </>
          )}
          {reviewedOn && (
            <>
              <span>&bull;</span>
              <time datetime={reviewedOn.toISOString()}>
                Reviewed {formatEnIn(reviewedOn)}
              </time>
            </>
          )}
          {nextReview && (
            <>
              <span>&bull;</span>
              <span>Next review by {formatEnIn(nextReview)}</span>
            </>
          )}
        </div>

        <h1 class="mt-4 text-3xl font-black leading-tight text-forest md:text-5xl">
          {post.data.title}
        </h1>
        
        <p class="mt-4 text-base font-medium text-forest/72 leading-relaxed">
          {post.data.description}
        </p>

        {post.data.image && (
          <ResponsiveImage src={post.data.image} loading="eager" />
        )}

        <div class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full bg-mint px-3 py-0.5 text-xs font-bold text-forest">
              #{tag}
            </span>
          ))}
        </div>
      </header>

      {/* Rendered Markdown Body Content */}
      <div class="blog-content mt-8">
        <Content />
      </div>

      {(post.data.sourceUrls?.length || post.data.testedApplications?.length) && (
        <aside class="mt-10 rounded-2xl border border-forest/10 bg-[#fffdf6] p-5 text-sm text-forest/80">
          <h2 class="text-base font-black text-forest">Sources and testing</h2>
          {post.data.testedApplications?.length ? (
            <p class="mt-2">
              Tested in: {post.data.testedApplications.join(", ")}. App menus still change — confirm inside the app before you print a batch.
            </p>
          ) : null}
          {post.data.sourceUrls?.length ? (
            <ul class="mt-3 list-disc space-y-1 pl-5">
              {post.data.sourceUrls.map((source) => (
                <li>
                  <a href={source.url} class="font-semibold text-leaf hover:underline" rel="noopener noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : null}
          <p class="mt-3 text-xs text-forest/55">
            <a href="/accuracy-policy/" class="font-semibold text-leaf hover:underline">Accuracy policy</a>
            {" · "}
            <a href="/corrections/" class="font-semibold text-leaf hover:underline">Corrections log</a>
          </p>
        </aside>
      )}

      {/* Author Bio (E-E-A-T) */}
      <div class="mt-12 rounded-2xl bg-mint/30 p-6 border border-leaf/10 flex flex-col md:flex-row items-center md:items-start gap-4">
        <div class="h-14 w-14 shrink-0 rounded-full bg-forest text-white flex items-center justify-center text-xl font-black shadow-sm">
          {author.initials}
        </div>
        <div class="text-center md:text-left">
          <h3 class="text-lg font-black text-forest">
            <a href={author.path} class="hover:text-leaf">{author.name}</a>
          </h3>
          <p class="text-xs font-bold uppercase tracking-wider text-leaf">{author.jobTitle}, Pro UPI QR</p>
          <p class="mt-1 text-sm text-forest/80 leading-relaxed">{author.shortBio}</p>
          <div class="mt-3 flex flex-wrap items-center justify-center md:justify-start gap-4 text-sm font-bold text-leaf">
            <a href={author.path} class="hover:underline hover:text-forest">Author profile</a>
            <a href="/editorial-policy/" class="hover:underline hover:text-forest">Editorial policy</a>
            <a href="/about/" class="hover:underline hover:text-forest">About</a>
          </div>
        </div>
      </div>

      {/* Related Articles */}
      {relatedPosts.length > 0 && (
        <div class="mt-12 border-t border-forest/10 pt-10">
          <h3 class="text-2xl font-black text-forest mb-6">Related Articles</h3>
          <div class="grid gap-6 md:grid-cols-3">
            {relatedPosts.map((rPost) => ({
                  href: `/blog/${rPost.id.replace(/\.mdx?$/, "")}/`,
                  title: rPost.data.title,
                  description: rPost.data.description,
                  date: rPost.data.pubDate,
                })
            ).map((item) => (
              <a
                href={item.href}
                class="group flex flex-col justify-between rounded-2xl border border-forest/5 bg-[#fffdf6] p-5 transition-all duration-300 hover:scale-[1.02] hover:border-leaf/20 hover:shadow-md"
              >
                <div>
                  {item.date && (
                    <span class="text-[10px] font-bold text-forest/40">
                      {item.date.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </span>
                  )}
                  <h4 class={`text-base font-black text-forest group-hover:text-leaf transition-colors line-clamp-2 ${item.date ? "mt-2" : ""}`}>
                    {item.title}
                  </h4>
                  <p class="mt-2 text-xs text-forest/70 line-clamp-3 leading-relaxed">
                    {item.description}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-forest/5 flex items-center justify-between text-[11px] font-bold text-leaf">
                  <span>Read Guide</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <InternalLinkHub variant="both" currentGuide={postSlug} guideLimit={4} />

      {/* Footer CTA */}
      <footer class="mt-12 border-t border-forest/10 pt-8 text-center">
        <h3 class="text-xl font-black text-forest">{generatorCta.headline}</h3>
        <p class="mt-2 text-sm text-forest/70">{generatorCta.description}</p>
        <a
          href={generatorCta.href}
          class="mt-5 inline-block rounded-full bg-forest px-8 py-3 text-sm font-bold text-white transition hover:bg-leaf"
        >
          {generatorCta.label}
        </a>
      </footer>

    </article>
  </main>
</BaseLayout>

<style is:global>
  /* Localized Prose Styling for Rendered Markdown */
  .blog-content {
    color: #16211f;
    font-size: 1rem;
    line-height: 1.8;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  @media (min-width: 768px) {
    .blog-content {
      font-size: 1.0625rem;
    }
  }

  .blog-content p {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .blog-content strong {
    font-weight: 700;
    color: #113b2c;
  }

  .blog-content h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #113b2c;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  @media (min-width: 768px) {
    .blog-content h2 {
      font-size: 1.75rem;
    }
  }

  .blog-content h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #113b2c;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .blog-content ul, .blog-content ol {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .blog-content ul {
    list-style-type: disc;
  }

  .blog-content ol {
    list-style-type: decimal;
  }

  .blog-content li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .blog-content a {
    color: #287a57;
    text-decoration: underline;
    font-weight: 600;
  }
  .blog-content a:hover {
    color: #113b2c;
  }

  .blog-content hr {
    border: 0;
    border-top: 1px solid rgba(17, 59, 44, 0.1);
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  /* Table styling */
  .blog-content table {
    width: 100%;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .blog-content th, .blog-content td {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(17, 59, 44, 0.1);
    text-align: left;
  }

  .blog-content th {
    background-color: #dff6e7;
    color: #113b2c;
    font-weight: 800;
  }

  .blog-content td {
    background-color: #fffaf1;
  }

  /* Blockquote block styling */
  .blog-content blockquote {
    border-left: 4px solid #287a57;
    padding-left: 1.25rem;
    font-style: italic;
    color: rgba(22, 33, 31, 0.85);
    margin: 1.5rem 0;
    background-color: rgba(223, 246, 231, 0.35);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    border-radius: 0 0.75rem 0.75rem 0;
  }

  .blog-content blockquote p {
    margin: 0;
  }

  /* Responsive, styled markdown images */
  .blog-content img {
    max-width: 100%;
    height: auto;
    border-radius: 1.25rem;
    border: 1px solid rgba(17, 59, 44, 0.08);
    box-shadow: 0 10px 32px rgba(17, 59, 44, 0.06);
    margin: 2.25rem auto;
    display: block;
  }

  .blog-content figure {
    margin: 2.25rem 0;
  }

  .blog-content figure img {
    margin: 0 auto 0.75rem;
  }

  .blog-content figcaption {
    text-align: center;
    font-size: 0.85rem;
    color: rgba(17, 59, 44, 0.65);
    line-height: 1.5;
    margin: 0 auto 0.25rem;
    max-width: 40rem;
  }
</style>
