import { routeExistsInLang } from "../data/validRoutes";

interface Props {
  isHindi?: boolean;
}

const { isHindi = false } = Astro.props;

function getPath(slug: string): string {
  if (slug.startsWith("/") || slug.startsWith("http")) {
    return slug;
  }

  const cleanSlug = slug.replace(/^\/|\/$/g, "");
  if (isHindi && routeExistsInLang(cleanSlug, "hi")) {
    return `/hi/${cleanSlug}/`;
  }
  return `/${cleanSlug}/`;
}

