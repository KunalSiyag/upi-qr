        </svg>
        {content.title}
      </h2>
      <p class="mt-2 text-xs leading-relaxed text-forest/70 max-w-2xl">
        {content.subtitle}
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {/* Device & Mobile Column */}
