---
import { featuredProducts } from "../data/products";

const products = featuredProducts();
---

<section class="mt-16 border-t border-forest/10 pt-16">
  <div class="max-w-3xl">
    <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">Physical Display</p>
    <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-4xl">
      Print &amp; Frame Your QR Code
    </h2>
    <p class="mt-3 text-base leading-7 text-forest/72">
      Acrylic standees, table tents, waterproof stickers, and thermal printers sit next to a printed UPI QR. Each card links to a buying guide with sizes and a generator. Hardware is optional — generators stay free.
    </p>
    <p class="mt-2 text-xs font-semibold text-forest/55">
      Amazon Associate links — Pro UPI QR may earn from qualifying purchases. Prices change on Amazon. These links do not affect QR generation or calculator math. See the <a href="/editorial-policy/" class="text-leaf hover:underline">editorial policy</a>.
    </p>
  </div>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {products.map((product) => (
      <article class="flex flex-col justify-between rounded-[2rem] border border-white/75 bg-white/86 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
        <div>
          <a href={`/products/${product.slug}/`} class="block rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf">
            <div class="relative flex h-48 w-full items-center justify-center overflow-hidden rounded-2xl border border-forest/5 bg-cream p-4">
              <picture>
                <source type="image/avif" srcset={product.imgSrc.replace(".png", "-480.avif")} />
                <source type="image/webp" srcset={product.imgSrc.replace(".png", "-480.webp")} />
                <img
                  src={product.imgSrc}
                  alt={product.imgAlt}
                  width="320"
                  height="192"
                  loading="lazy"
                  decoding="async"
                  class="max-h-full max-w-full object-contain"
                />
              </picture>
              <span class="absolute right-3 top-3 rounded-full bg-mint px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-forest">
                {product.tag}
              </span>
            </div>
            <h3 class="mt-5 text-lg font-black text-forest hover:text-leaf">{product.name}</h3>
          </a>
          <p class="mt-2.5 text-sm leading-relaxed text-forest/72">{product.bestFor}</p>
        </div>
        <div class="mt-6 flex items-center justify-between border-t border-forest/5 pt-4">
          <span class="text-sm font-bold text-forest">{product.priceEst}</span>
          <a
            href={product.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
            class="rounded-full bg-forest px-4 py-2 text-xs font-black text-white shadow-sm transition-colors hover:bg-leaf focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf"
          >
            Check Price →
          </a>
        </div>
      </article>
    ))}
  </div>
  <p class="mt-8 text-center">
    <a
      href="/products/"
      class="inline-flex rounded-full border border-forest/15 bg-white px-5 py-2.5 text-sm font-black text-forest transition hover:border-leaf hover:text-leaf focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf"
    >
      Browse all 12 hardware guides →
    </a>
  </p>
</section>
