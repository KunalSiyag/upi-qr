---
import { getCollection } from "astro:content";
import {
  generators,
  generatorPath,
  guidePath,
  type GeneratorSlug,
} from "../data/internalLinks";
import {
  getRelatedTools,
  hubForPath,
  isTopicHubPath,
  relatedArticlesFromCollection,
  contextualArticleQuery,
  pickFeaturedPosts,
  normalizePath,
} from "../data/topicHubs";
import { chromeFor } from "../data/localeChrome";
import { localeHref, type SiteLang } from "../lib/locale";

interface Props {
  variant?: "generators" | "guides" | "both";
  currentGenerator?: GeneratorSlug;
  currentGuide?: string;
  isHindi?: boolean;
  lang?: SiteLang;
  currentPath?: string;
  guideLimit?: number;
}

const {
  variant = "both",
  currentGenerator,
  currentGuide,
  isHindi = false,
  lang: langProp,
  currentPath,
  guideLimit = 4,
} = Astro.props;
const lang: SiteLang = langProp ?? (isHindi ? "hi" : "en");
const chrome = chromeFor(lang);

const path = normalizePath(currentPath ?? Astro.url.pathname);
const onHubPage = isTopicHubPath(path);
const hub = hubForPath(path);
const posts = await getCollection("blog");

const showTools = !onHubPage && variant !== "guides";
const showGuides = !onHubPage && variant !== "generators";
const isBlogPost = path.startsWith("/blog/");

const relatedTools = showTools
  ? getRelatedTools(currentGenerator ? `/${currentGenerator}/` : path, 4)
  : [];

const articleQuery = contextualArticleQuery(path);
if (currentGuide) articleQuery.excludeSlug = currentGuide;
if (isBlogPost) {
  const currentPost = posts.find((post) => post.id.replace(/\.mdx?$/, "") === (currentGuide ?? articleQuery.excludeSlug));
  if (currentPost) articleQuery.tags = currentPost.data.tags;
}

const relatedGuides = showGuides
  ? isBlogPost
    ? []
    : variant === "guides"
      ? pickFeaturedPosts(posts, guideLimit)
      : relatedArticlesFromCollection(posts, { ...articleQuery, limit: guideLimit })
  : [];

const labels = {
  toolsTitle: chrome.relatedTools,
  toolsSubtitle: chrome.relatedToolsHint,
  guidesTitle: chrome.relatedGuides,
  guidesSubtitle: chrome.relatedGuidesHint,
  readGuide: chrome.readGuide,
  openTool: chrome.openTool,
  browseHub: hub ? (lang === "hi" ? `सभी ${hub.hiName} देखें` : chrome.browseTopics) : chrome.browseTopics,
};

const hubHref = localeHref(lang, hub?.path?.replace(/^\/|\/$/g, "") || "tools");

function toolHref(href: string): string {
  if (lang === "en") return href;
  if (href === "/") return localeHref(lang, "");
  const slug = href.replace(/^\/|\/$/g, "") as GeneratorSlug;
  if (generators.some((generator) => generator.slug === slug)) {
    return generatorPath(slug, lang);
  }
  return localeHref(lang, slug);
}
---

{(relatedTools.length > 0 || relatedGuides.length > 0) && (
  <section class="mt-12 border-t border-forest/10 pt-10 space-y-10">
    {relatedTools.length > 0 && (
      <div>
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">{labels.toolsTitle}</p>
        <p class="mt-2 text-sm text-forest/70">{labels.toolsSubtitle}</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {relatedTools.map((tool) => (
            <a
              href={toolHref(tool.href)}
              class="group flex flex-col justify-between rounded-2xl border border-forest/8 bg-[#fffdf6] p-5 transition-all duration-300 hover:border-leaf/25 hover:shadow-md"
            >
              <div>
                <h3 class="text-base font-black text-forest group-hover:text-leaf transition-colors">
                  {tool.name}
                </h3>
                <p class="mt-2 text-xs leading-relaxed text-forest/70 line-clamp-3">{tool.description}</p>
              </div>
              <span class="mt-4 text-[11px] font-bold text-leaf group-hover:translate-x-1 transition-transform inline-block">
                {labels.openTool} &rarr;
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    {relatedGuides.length > 0 && (
      <div>
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">{labels.guidesTitle}</p>
        <p class="mt-2 text-sm text-forest/70">{labels.guidesSubtitle}</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {relatedGuides.map((guide) => (
            <a
              href={guidePath(guide.id.replace(/\.mdx?$/, ""))}
              class="group flex flex-col justify-between rounded-2xl border border-forest/8 bg-white p-5 transition-all duration-300 hover:border-leaf/25 hover:shadow-md"
            >
              <div>
                <h3 class="text-base font-black text-forest group-hover:text-leaf transition-colors line-clamp-2">
                  {guide.data.title}
                </h3>
                <p class="mt-2 text-xs leading-relaxed text-forest/70 line-clamp-2">
                  {guide.data.description}
                </p>
              </div>
              <span class="mt-4 text-[11px] font-bold text-leaf group-hover:translate-x-1 transition-transform inline-block">
                {labels.readGuide} &rarr;
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <a href={hubHref} class="inline-block text-sm font-bold text-leaf hover:underline">
      {labels.browseHub} &rarr;
    </a>
  </section>
)}
