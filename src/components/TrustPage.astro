---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  h1: string;
  eyebrow: string;
  lastUpdated: string;
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, h1, eyebrow, lastUpdated, schema } = Astro.props;
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="mx-auto max-w-4xl px-4 py-12 md:px-6 lg:px-8">
    <div class="rounded-[2rem] border border-white/70 bg-white/85 p-6 shadow-md md:p-10">
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
        <a href="/" class="hover:text-leaf transition-colors">Home</a>
        <span>/</span>
        <slot name="crumb" />
      </nav>
      <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">
        {eyebrow}
      </p>
      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-forest md:text-5xl">{h1}</h1>
      <p class="mt-2 text-xs text-forest/50">Last updated: {lastUpdated}</p>
      <div class="mt-8 space-y-6 text-sm leading-relaxed text-forest/80 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-forest [&_h3]:mt-6 [&_h3]:text-base [&_h3]:font-black [&_h3]:text-forest [&_a]:font-semibold [&_a]:text-leaf [&_a]:underline [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5 [&_strong]:text-forest">
        <slot />
      </div>
    </div>
  </main>
</BaseLayout>
