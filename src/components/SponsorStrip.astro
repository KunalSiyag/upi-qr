---
/**
 * The "Supported by" strip of logo tiles under the homepage generator. The HTML holds one "your logo here" tile;
 * sponsorSpots.ts adds the running sponsors from /api/v1/sponsors/ and drops that tile once all are taken.
 */
import type { SiteLang } from "../lib/locale";
import { SPONSOR_COPY } from "../data/sponsorCopy";

interface Props {
  lang: SiteLang;
  class?: string;
}

const { lang, class: className = "" } = Astro.props;
const copy = SPONSOR_COPY[lang];
---

{copy && (
  <div class={className} data-sponsor-strip>
    <div class="flex items-baseline justify-between gap-4">
      <p class="text-sm font-semibold text-leaf">{copy.supported}</p>
      <a href="/sponsor/#book" class="text-xs font-medium text-muted transition-colors hover:text-ink">{copy.advertise} →</a>
    </div>
    <ul class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-8" data-sponsor-tiles>
      <li data-sponsor-open>
        <a href="/sponsor/#book" class="flex h-full min-h-[84px] flex-col items-center justify-center gap-1 rounded-[10px] border border-dashed border-pebble px-2 py-3 text-center transition-colors hover:border-ink/40">
          <span class="text-xs font-semibold text-ink">{copy.yourLogo}</span>
          <span class="text-[11px] text-muted">{copy.tilePrice}</span>
        </a>
      </li>
    </ul>
  </div>
)}

<script>
  import "../scripts/sponsorSpots";
</script>
