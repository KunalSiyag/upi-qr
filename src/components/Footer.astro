---
import { generatorPath } from "../data/internalLinks";
import { NAV_HUBS } from "../data/topicHubs";
import { chromeFor } from "../data/localeChrome";
import { detectLangFromPath, localeHref, localeHome } from "../lib/locale";

const currentYear = new Date().getFullYear();
const lang = detectLangFromPath(Astro.url.pathname);
const chrome = chromeFor(lang);
const home = localeHome(lang);

const flagshipTools = [
  { href: home, label: chrome.upiQrGenerator },
  { href: localeHref(lang, "universal-qr-generator"), label: "Universal QR" },
  { href: localeHref(lang, "invoice-generator"), label: "Invoice PDF" },
  { href: localeHref(lang, "upi-error-codes"), label: "UPI errors" },
  { href: localeHref(lang, "upi-limits"), label: "Bank UPI limits" },
  { href: localeHref(lang, "tools"), label: chrome.allTools },
];

const flagshipGenerators = [
  { slug: "phonepe-qr-generator" as const, label: "PhonePe" },
  { slug: "google-pay-qr-generator" as const, label: "Google Pay" },
  { slug: "paytm-qr-generator" as const, label: "Paytm" },
  { slug: "bhim-qr-generator" as const, label: "BHIM" },
  { slug: "sbi-qr-generator" as const, label: "SBI" },
];
---

<footer class="border-t border-forest/10 bg-cream/40 px-4 py-10 md:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-3">
        <a href={home} class="text-xl font-black tracking-tight text-forest">Pro UPI QR</a>
        <p class="text-xs leading-relaxed text-forest/70">{chrome.brandBlurb}</p>
      </div>

      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-forest/90">{chrome.topics}</h4>
        <ul class="space-y-2 text-xs font-medium text-forest/75">
          {NAV_HUBS.map((hub) => (
            <li>
              <a href={localeHref(lang, hub.path.replace(/^\/|\/$/g, ""))} class="hover:text-leaf hover:underline">
                {lang === "hi" ? hub.hiName : hub.shortName}
              </a>
            </li>
          ))}
          <li><a href={localeHref(lang, "print-templates")} class="hover:text-leaf hover:underline">{chrome.printTemplates}</a></li>
          <li><a href="/products/" class="hover:text-leaf hover:underline">Standees & printers</a></li>
          <li><a href={localeHref(lang, "blog")} class="hover:text-leaf hover:underline">{chrome.blog}</a></li>
        </ul>
      </div>

      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-forest/90">{chrome.toolsCol}</h4>
        <ul class="space-y-2 text-xs font-medium text-forest/75">
          {flagshipTools.map((tool) => (
            <li><a href={tool.href} class="hover:text-leaf hover:underline">{tool.label}</a></li>
          ))}
          {flagshipGenerators.map((gen) => (
            <li>
              <a href={generatorPath(gen.slug, lang)} class="hover:text-leaf hover:underline">
                {gen.label} QR
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-forest/90">{chrome.legalCol}</h4>
        <ul class="space-y-2 text-xs font-medium text-forest/75">
          <li><a href="/about/" class="hover:text-leaf hover:underline">{chrome.about}</a></li>
          <li><a href="/authors/kunal-siyag/" class="hover:text-leaf hover:underline">{chrome.author}</a></li>
          <li><a href="/editorial-policy/" class="hover:text-leaf hover:underline">{chrome.editorial}</a></li>
          <li><a href="/accuracy-policy/" class="hover:text-leaf hover:underline">{chrome.accuracy}</a></li>
          <li><a href="/corrections/" class="hover:text-leaf hover:underline">{chrome.corrections}</a></li>
          <li><a href={localeHref(lang, "privacy")} class="hover:text-leaf hover:underline">{chrome.privacy}</a></li>
          <li><a href={localeHref(lang, "terms")} class="hover:text-leaf hover:underline">{chrome.terms}</a></li>
          <li><a href={localeHref(lang, "disclaimer")} class="hover:text-leaf hover:underline">{chrome.disclaimer}</a></li>
          <li><a href="mailto:support@proupiqr.in" class="hover:text-leaf hover:underline">support@proupiqr.in</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-forest/5 pt-5 text-[10px] leading-relaxed text-forest/60 space-y-2">
      <p>
        <strong>NPCI:</strong> {chrome.npciDisclaimer}
      </p>
      <p>
        <strong>Brands:</strong> {chrome.brands}
      </p>
    </div>

    <div class="mt-5 flex flex-col items-center justify-between gap-3 border-t border-forest/5 pt-5 text-center text-xs text-forest/65 md:flex-row">
      <p>&copy; {currentYear} Pro UPI QR. {chrome.madeFor}</p>
      <p class="text-[10px] text-forest/50">{chrome.paymentsFollow}</p>
    </div>
  </div>
</footer>
