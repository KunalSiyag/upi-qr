---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
  TOPIC_HUB_BY_ID,
  articlesForHub,
  type TopicHubId,
} from "../data/topicHubs";
import { ogImageForPath } from "../data/siteImages";

interface Props {
  hubId: TopicHubId;
}

const { hubId } = Astro.props;
const hub = TOPIC_HUB_BY_ID[hubId];
const posts = await getCollection("blog");
const articles = articlesForHub(hub, posts);
const relatedHubs = hub.relatedHubIds.map((id) => TOPIC_HUB_BY_ID[id]);

const site = "https://www.proupiqr.in";
const pageUrl = `${site}${hub.path}`;
const inventory = [
  ...hub.groups.flatMap((group) => group.tools),
  ...articles.map((post) => ({
    href: `/blog/${post.id.replace(/\.mdx?$/, "")}/`,
    name: post.data.title,
  })),
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#page`,
      name: hub.title,
      description: hub.description,
      url: pageUrl,
      inLanguage: "en-IN",
      isPartOf: { "@id": `${site}/#website` },
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: inventory.length,
        itemListElement: inventory.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          url: item.href.startsWith("http") ? item.href : `${site}${item.href}`,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "All Tools", item: `${site}/tools/` },
        { "@type": "ListItem", position: 3, name: hub.shortName, item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: hub.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout title={hub.title} description={hub.description} schema={schema} image={ogImageForPath(hub.path).src}>
  <main>
    <section class="relative overflow-hidden px-4 pb-10 pt-12 md:px-6 lg:px-8">
      <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
      <div class="relative mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
          <a href="/" class="hover:text-leaf transition-colors">Home</a>
          <span>/</span>
          <a href="/tools/" class="hover:text-leaf transition-colors">All Tools</a>
          <span>/</span>
          <span class="text-forest font-bold" aria-current="page">{hub.shortName}</span>
        </nav>
        <p class="inline-flex text-sm font-semibold text-leaf">
          {hub.eyebrow}
        </p>
        <h1 class="mt-5 max-w-4xl text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">
          {hub.h1}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">{hub.intro}</p>
      </div>
    </section>

    {hub.groups.map((group) => (
      <section class="px-4 py-8 md:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <h2 class="text-2xl font-black tracking-tight text-forest md:text-3xl">{group.heading}</h2>
          <ul class="mt-5 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
            {group.tools.map((tool) => (
              <li class="border-t border-forest/10">
                <a href={tool.href} class="group flex items-start justify-between gap-4 py-3.5">
                  <div class="min-w-0">
                    <h3 class="text-base font-bold text-obsidian group-hover:text-leaf">{tool.name}</h3>
                    <p class="mt-0.5 text-sm leading-6">{tool.description}</p>
                  </div>
                  <span class="mt-0.5 shrink-0 text-forest/40 group-hover:text-leaf" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    {articles.length > 0 && (
      <section class="px-4 py-8 md:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <h2 class="text-2xl font-black tracking-tight text-forest md:text-3xl">Guides in this topic</h2>
          <p class="mt-1 text-sm font-semibold text-forest/65">From the article collection, not a hand-picked subset.</p>
          <ul class="mt-5 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
            {articles.map((post) => (
              <li class="border-t border-forest/10">
                <a href={`/blog/${post.id.replace(/\.mdx?$/, "")}/`} class="group block py-4">
                  <h3 class="line-clamp-2 text-base font-bold text-obsidian group-hover:text-leaf">{post.data.title}</h3>
                  <p class="mt-1 line-clamp-3 text-sm leading-6">{post.data.description}</p>
                  <span class="mt-1.5 inline-block text-sm font-semibold text-forest underline underline-offset-4">Read guide →</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="px-4 py-8 md:px-6 lg:px-8" id="faq">
      <div class="mx-auto max-w-7xl">
        <h2 class="text-2xl font-black tracking-tight text-forest md:text-3xl">Frequently asked questions</h2>
        <div class="mt-5 grid gap-x-10 md:grid-cols-2">
          {hub.faqs.map((faq) => (
            <div class="border-t border-forest/10 py-4">
              <h3 class="text-base font-bold text-obsidian">{faq.question}</h3>
              <p class="mt-1.5 text-sm leading-6">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-8 md:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="text-2xl font-black tracking-tight text-forest md:text-3xl">Related topics</h2>
        <ul class="mt-5 grid gap-x-10 sm:grid-cols-3">
          {relatedHubs.map((related) => (
            <li class="border-t border-forest/10">
              <a href={related.path} class="group block py-4">
                <h3 class="text-base font-bold text-obsidian group-hover:text-leaf">{related.shortName}</h3>
                <p class="mt-1 text-sm leading-6">{related.blurb}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
