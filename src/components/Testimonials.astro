---
import StarRating from "./StarRating.astro";
import { TESTIMONIALS, aggregateFromTestimonials, formatRatingLabel } from "../data/reviews";

interface Props {
  heading?: string;
}

const { heading = "What merchants say" } = Astro.props;
const agg = aggregateFromTestimonials();
const dateFmt = new Intl.DateTimeFormat("en-IN", { day: "numeric", month: "short", year: "numeric" });
---

{TESTIMONIALS.length > 0 && (
  <section id="testimonials" class="scroll-mt-28 px-4 py-12 md:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8 max-w-3xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">Reviews</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-5xl">{heading}</h2>
        {agg && (
          <p class="mt-4 flex flex-wrap items-center gap-2 text-base text-forest/72">
            <StarRating value={agg.ratingValue} label={formatRatingLabel(agg)} />
            <span class="tabular-nums font-semibold text-forest">{formatRatingLabel(agg)}</span>
          </p>
        )}
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {TESTIMONIALS.map((item) => (
          <article class="flex flex-col rounded-[1.75rem] border border-white/75 bg-white/86 p-6 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
            <StarRating value={item.rating} size="sm" />
            <blockquote class="mt-4 flex-1 text-base leading-7 text-forest/80">
              <p>“{item.quote}”</p>
            </blockquote>
            <footer class="mt-5 text-sm">
              <p class="font-black text-forest">{item.name}</p>
              <p class="text-forest/60">
                {item.role}
                {item.city ? ` · ${item.city}` : ""}
              </p>
              <p class="mt-1 text-xs text-forest/50">
                <time datetime={item.date}>{dateFmt.format(new Date(`${item.date}T00:00:00+05:30`))}</time>
                {item.sourceUrl ? (
                  <>
                    {" · "}
                    <a href={item.sourceUrl} rel="noopener noreferrer" class="font-semibold text-leaf underline hover:text-forest">
                      Source
                    </a>
                  </>
                ) : (
                  " · Verified email"
                )}
              </p>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
