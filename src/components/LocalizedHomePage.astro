---
import { GeneratorForm } from "./GeneratorForm";
import AffiliateProducts from "./AffiliateProducts.astro";
import { HOME_COPY } from "../data/homeCopy";
import { localeHref, type SiteLang } from "../lib/locale";

interface Props { lang: Exclude<SiteLang, "en" | "hi">; }
const { lang } = Astro.props;
const copy = HOME_COPY[lang];

const presets = [
  { href: localeHref(lang, "phonepe-qr-generator"), label: "PhonePe QR", color: "#5f259f" },
  { href: localeHref(lang, "google-pay-qr-generator"), label: "Google Pay QR", color: "#4285f4" },
  { href: localeHref(lang, "paytm-qr-generator"), label: "Paytm QR", color: "#00baf2" },
  { href: localeHref(lang, "upi-error-codes"), label: "NPCI", color: "#113b2c" },
  { href: localeHref(lang, "tools"), label: "Tools", color: "#287a57" },
];
---

<main>
  <section class="relative overflow-hidden px-4 pb-16 pt-12 md:px-6 lg:px-8">
    <div class="grid-glow absolute inset-x-0 top-0 h-[24rem] pointer-events-none"></div>
    <div class="relative mx-auto max-w-5xl text-center">
      <span class="inline-block rounded-full bg-leaf/10 px-4 py-1.5 text-xs font-black uppercase tracking-wider text-forest">
        {copy.eyebrow}
      </span>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-forest md:text-5xl">{copy.h1}</h1>
      <p class="mt-4 text-sm text-forest/75 md:text-base max-w-2xl mx-auto">{copy.intro}</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="#generator" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-white transition hover:bg-leaf">{copy.ctaGenerate}</a>
        <a href={localeHref(lang, "tools")} class="rounded-full border border-forest/10 px-6 py-3 text-sm font-bold text-forest transition hover:bg-white">{copy.ctaTemplates}</a>
      </div>
      <p class="mt-8 text-xs font-bold text-forest/70 uppercase tracking-wider">{copy.presetsLabel}</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2.5">
        {presets.map((preset) => (
          <a
            href={preset.href}
            class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs font-bold transition hover:text-white"
            style={`border-color:${preset.color}40;color:${preset.color}`}
          >
            {preset.label}
          </a>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        {copy.useCases.map((item) => (
          <span class="inline-flex items-center gap-2 rounded-full border border-white/80 bg-white/70 px-4 py-2 text-xs font-bold text-forest">
            <span class="w-1.5 h-1.5 rounded-full bg-leaf"></span>
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section id="generator" class="scroll-mt-28 px-4 py-10 md:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8 max-w-3xl">
        <p class="text-sm font-black uppercase tracking-[0.2em] text-leaf">{copy.generatorEyebrow}</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-forest md:text-4xl">{copy.generatorH2}</h2>
        <p class="mt-4 text-base leading-7 text-forest/72">{copy.generatorIntro}</p>
        <p class="mt-3 text-xs font-semibold text-leaf">{copy.privacy}</p>
      </div>
      <GeneratorForm client:visible lang={lang} />
    </div>
  </section>

  <section class="px-4 py-10 md:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-5 md:grid-cols-3">
      {copy.features.map((feature) => (
        <article class="rounded-[1.75rem] border border-white/75 bg-white/86 p-6">
          <h3 class="text-xl font-black text-forest">{feature.title}</h3>
          <p class="mt-3 text-base leading-7 text-forest/72">{feature.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="px-4 py-10 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-black text-forest">{copy.faqHeading}</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {copy.faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-white p-5 shadow-sm space-y-2">
            <h3 class="text-sm font-black text-forest">{faq.question}</h3>
            <p class="text-xs text-forest/75 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="px-4 pb-12 md:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <AffiliateProducts />
    </div>
  </div>
</main>
