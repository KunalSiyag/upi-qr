---
import { GeneratorForm } from "./GeneratorForm";
import AffiliateProducts from "./AffiliateProducts.astro";
import SponsorSlot from "./SponsorSlot.astro";
import { HOME_COPY } from "../data/homeCopy";
import { localeHref, type SiteLang } from "../lib/locale";

interface Props { lang: Exclude<SiteLang, "en" | "hi">; }
const { lang } = Astro.props;
const copy = HOME_COPY[lang];

const stickerCopy: Record<typeof lang, { phonepe: string; gpay: string }> = {
  ta: { phonepe: "PhonePe ஸ்டிக்கர்", gpay: "GPay ஸ்டிக்கர்" },
  te: { phonepe: "PhonePe స్టిక్కర్", gpay: "GPay స్టిక్కర్" },
  mr: { phonepe: "PhonePe स्टिकर", gpay: "GPay स्टिकर" },
  es: { phonepe: "Sticker PhonePe", gpay: "Sticker GPay" },
  pt: { phonepe: "Adesivo PhonePe", gpay: "Adesivo GPay" },
  fr: { phonepe: "Sticker PhonePe", gpay: "Sticker GPay" },
  de: { phonepe: "PhonePe-Sticker", gpay: "GPay-Sticker" },
  id: { phonepe: "Stiker PhonePe", gpay: "Stiker GPay" },
  ar: { phonepe: "ملصق PhonePe", gpay: "ملصق GPay" },
  it: { phonepe: "Sticker PhonePe", gpay: "Sticker GPay" },
  ja: { phonepe: "PhonePeステッカー", gpay: "GPayステッカー" },
  zh: { phonepe: "PhonePe 贴纸", gpay: "GPay 贴纸" },
};
const stickers = stickerCopy[lang];
const presets = [
  { href: localeHref(lang, "phonepe-qr-generator"), label: "PhonePe QR", img: "/phonepe.png" },
  { href: `${localeHref(lang, "qr-sticker-generator")}?app=phonepe#tool`, label: stickers.phonepe, img: "/phonepe.png" },
  { href: localeHref(lang, "google-pay-qr-generator"), label: "Google Pay QR", img: "/googlepay.png" },
  { href: `${localeHref(lang, "qr-sticker-generator")}?app=gpay#tool`, label: stickers.gpay, img: "/googlepay.png" },
  { href: localeHref(lang, "paytm-qr-generator"), label: "Paytm QR", img: "/paytm.ico" },
  { href: localeHref(lang, "upi-error-codes"), label: "NPCI", img: "" },
  { href: localeHref(lang, "tools"), label: "Tools", img: "" },
];
const check = "M5 12l5 5L20 7";
const link = "font-semibold text-forest underline underline-offset-4 hover:text-leaf";
---

<main>
  <section class="px-4 pb-14 pt-8 md:px-6 md:pt-14 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-x-12">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold text-leaf">{copy.eyebrow}</p>
          <h1 class="mt-2 text-4xl font-black leading-[1.05] tracking-[-0.02em] text-obsidian md:text-6xl">{copy.h1}</h1>
          <p class="mt-4 max-w-2xl text-lg leading-8">{copy.intro}</p>
          <ul class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-[15px] font-medium">
            <li class="flex items-center gap-2"><svg class="h-[18px] w-[18px] text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={check} /></svg>Free, no signup</li>
            <li><a href="/reviews/" class={link}>Reviews</a> · Product Hunt</li>
            <li><a href={localeHref(lang, "tools")} class={link}>{copy.ctaTemplates}</a></li>
          </ul>
        </div>

        <SponsorSlot placement="home-hero" lang={lang} class="order-3 mt-8 lg:order-none lg:mt-1" />

        <div id="generator" class="mt-8 scroll-mt-20 lg:col-span-2">
          <GeneratorForm client:load lang={lang} />
        </div>
      </div>

      <div class="mt-12 grid gap-10 border-t border-forest/10 pt-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <p class="text-sm font-semibold text-leaf">{copy.generatorEyebrow}</p>
          <h2 class="mt-2 text-2xl font-black tracking-tight text-obsidian sm:text-3xl">{copy.generatorH2}</h2>
          <p class="mt-3 text-base leading-7">{copy.generatorIntro}</p>
          <p class="mt-4 flex items-start gap-2 text-[15px] leading-6">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-leaf" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            <span>{copy.privacy}</span>
          </p>
          <p class="mt-6 text-sm leading-6 text-muted">{copy.useCases.join(" · ")}</p>
        </div>
        <div>
          <p class="text-sm font-bold text-muted">{copy.presetsLabel}</p>
          <ul class="mt-2 grid grid-cols-2 gap-x-6">
            {presets.map((preset) => (
              <li>
                <a href={preset.href} class="flex min-h-12 items-center gap-3 border-b border-forest/10 py-2.5 text-[15px] font-semibold text-forest hover:text-leaf">
                  {preset.img ? (
                    <img src={preset.img} alt="" width="24" height="24" loading="lazy" class="h-6 w-6 rounded-full bg-white object-contain ring-1 ring-forest/10" />
                  ) : (
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-mint" aria-hidden="true"><span class="h-2 w-2 rounded-full bg-leaf"></span></span>
                  )}
                  {preset.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 md:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 border-t border-forest/10 pt-12 md:grid-cols-3">
      {copy.features.map((feature) => (
        <div>
          <h3 class="text-xl font-bold text-obsidian">{feature.title}</h3>
          <p class="mt-2 text-base leading-7">{feature.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="px-4 pb-16 md:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-3xl font-black tracking-tight text-obsidian md:text-4xl">{copy.faqHeading}</h2>
      <div class="mt-6 grid gap-x-10 md:grid-cols-2">
        {copy.faqs.map((faq) => (
          <div class="border-t border-forest/10 py-4">
            <h3 class="text-base font-bold text-obsidian">{faq.question}</h3>
            <p class="mt-1.5 text-sm leading-6">{faq.answer}</p>
          </div>
        ))}
      </div>
      <div class="mt-12"><AffiliateProducts /></div>
    </div>
  </section>
</main>
