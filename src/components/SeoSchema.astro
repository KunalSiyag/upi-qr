---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface StepItem {
  name: string;
  text: string;
  url?: string;
  image?: string;
}

interface Props {
  type?: "WebApplication" | "SoftwareApplication" | "FAQPage" | "HowTo" | "Combined";
  name?: string;
  description?: string;
  applicationCategory?: string;
  operatingSystem?: string;
  url?: string;
  faqs?: FAQItem[];
  howToName?: string;
  howToDescription?: string;
  steps?: StepItem[];
}

const {
  type = "Combined",
  name = "Pro UPI QR Generator",
  description = "Free online UPI QR code generator for Indian bank accounts, shops, and merchants.",
  applicationCategory = "FinancialApplication",
  operatingSystem = "All (Web Browser, Android, iOS)",
  url = Astro.url.href,
  faqs = [],
  howToName = "How to Generate a UPI QR Code",
  howToDescription = "Step-by-step guide to generating a instant UPI QR code for direct bank transfers.",
  steps = [
    { name: "Enter UPI ID", text: "Enter your valid VPA/UPI ID (e.g. name@upi or phone@paytm)." },
    { name: "Specify Amount & Payee Name", text: "Optionally enter the recipient name and fixed payment amount in INR." },
    { name: "Download or Print QR Code", text: "Click to download high-resolution SVG/PNG image or print standard payment poster standee." }
  ]
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://www.proupiqr.in";

// 1. WebApplication Schema
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": name,
  "description": description,
  "url": url,
  "applicationCategory": applicationCategory,
  "operatingSystem": operatingSystem,
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  },
  "author": {
    "@type": "Organization",
    "name": "Pro UPI QR",
    "url": siteUrl
  }
};

// 2. FAQ Schema
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

// 3. HowTo Schema
const howToSchema = steps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": howToName,
  "description": howToDescription,
  "totalTime": "PT1M",
  "step": steps.map((step, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": step.name,
    "text": step.text,
    ...(step.url && { "url": step.url }),
    ...(step.image && { "image": step.image })
  }))
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

{howToSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
)}
