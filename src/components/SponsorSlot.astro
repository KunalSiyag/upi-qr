---
/**
 * The featured sponsor card (src/lib/sponsors/). The HTML is the house card linking to /sponsor/; sponsorSpots.ts
 * swaps in the running sponsor from /api/v1/sponsors/ (our own API: no sponsor script, pixel or cookie). en/hi/ta/
 * te/mr homepages only. The wrapper is a div, not an aside: WaitlistCard is the page's <aside> (waitlist-e2e).
 */
import type { SiteLang } from "../lib/locale";
import { SPONSOR_COPY } from "../data/sponsorCopy";

interface Props {
  lang: SiteLang;
  class?: string;
}

const { lang, class: className = "" } = Astro.props;
const copy = SPONSOR_COPY[lang];
const card = "flex min-h-[176px] flex-col rounded-[12px] bg-white p-4 shadow-card transition hover:shadow-pop focus-visible:outline focus-visible:outline-2 focus-visible:outline-leaf";
---

{copy && (
  <div class={className} data-sponsor-featured data-sponsor="house" data-label={copy.sponsored}>
    <a href="/sponsor/" class={card} data-sponsor-link>
      <span class="text-xs font-medium text-muted" data-sponsor-label>{copy.house}</span>
      <span class="mt-2 flex items-center gap-3">
        <img hidden alt="" width="40" height="40" decoding="async" class="h-10 w-10 shrink-0 rounded-[10px] object-contain ring-1 ring-hairline" data-sponsor-logo />
        <span class="block text-base font-semibold text-ink" data-sponsor-name>{copy.title}</span>
      </span>
      <span class="mt-1 block text-sm leading-6 text-charcoal" data-sponsor-line>{copy.body}</span>
      <span class="mt-auto block pt-3 text-sm font-semibold text-leaf" data-sponsor-cta>{copy.cta} →</span>
    </a>
  </div>
)}

<script>
  import "../scripts/sponsorSpots";
</script>
