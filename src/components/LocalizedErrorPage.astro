---
import { UpiErrorCodeResolver } from "./UpiErrorCodeResolver";
import AffiliateProducts from "./AffiliateProducts.astro";
import InternalLinkHub from "./InternalLinkHub.astro";
import ResponsiveImage from "./ResponsiveImage.astro";
import { ERROR_CODE_REVIEWED_ON, ERROR_CODE_SOURCES, UPI_ERROR_CODES } from "../data/upiErrorCodes";
import { ERROR_PAGE } from "../data/errorI18n";
import { siteImage } from "../data/siteImages";
import { localeHome, type SiteLang } from "../lib/locale";

interface Props { lang: Exclude<SiteLang, "en">; }
const { lang } = Astro.props;
const copy = ERROR_PAGE[lang];
const localeTag = `${lang}-IN`;
const reviewedLabel = new Date(`${ERROR_CODE_REVIEWED_ON}T00:00:00+05:30`).toLocaleDateString(localeTag, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<main class="px-4 py-8 md:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl space-y-8">
    <header class="rounded-[2.5rem] border border-white/75 bg-white/86 p-6 sm:p-8 md:p-10 shadow-[0_18px_48px_rgba(17,59,44,0.08)] space-y-4">
      <a href={localeHome(lang)} class="text-xs font-bold text-leaf hover:underline">&larr; {copy.back}</a>
      <div class="inline-flex items-center gap-2 rounded-full bg-mint px-3.5 py-1 text-xs font-bold text-leaf border border-leaf/10">
        {copy.eyebrow}
      </div>
      <h1 class="text-3xl font-black tracking-tight text-forest text-pretty sm:text-5xl">{copy.h1}</h1>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-forest/80">{copy.intro}</p>
      <p class="text-xs font-semibold text-forest/55">
        {copy.reviewed} {reviewedLabel} · {UPI_ERROR_CODES.length} · Consumer VPAs
      </p>
      <ResponsiveImage src={siteImage("upi-payment-failed-phone").src} loading="eager" />
    </header>

    <section class="rounded-[2.5rem] border border-white/75 bg-white/86 p-6 sm:p-8 md:p-10 shadow-[0_18px_48px_rgba(17,59,44,0.08)]">
      <h2 id="resolver" class="scroll-mt-28 mb-5 text-2xl font-black text-forest">{copy.resolverHeading}</h2>
      <UpiErrorCodeResolver client:visible lang={lang} />
    </section>

    <section class="rounded-[2rem] border border-forest/10 bg-cream/70 p-6 md:p-8 space-y-5">
      <h2 id="debit-decision-tree" class="scroll-mt-28 text-2xl font-black text-forest">{copy.debitHeading}</h2>
      <p class="text-sm leading-relaxed text-forest/75">{copy.debitIntro}</p>
      <ol class="grid gap-4 md:grid-cols-3 text-sm">
        {copy.debitSteps.map((step) => (
          <li class="rounded-2xl bg-white/90 border border-forest/10 p-5 space-y-2">
            <span class="text-xs font-black uppercase tracking-wider text-leaf">{step.kicker}</span>
            <p class="font-bold text-forest">{step.title}</p>
            <p class="text-forest/75 leading-relaxed">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="rounded-[2rem] border border-white/75 bg-white/86 p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)] space-y-5">
      <h2 id="bank-vs-npci-vs-app" class="scroll-mt-28 text-2xl font-black text-forest">{copy.originHeading}</h2>
      <p class="text-sm leading-relaxed text-forest/75">{copy.originIntro}</p>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left text-sm border-collapse">
          <thead>
            <tr class="bg-mint text-forest">
              {copy.originHeaders.map((header) => (
                <th class="border border-forest/10 px-3 py-2 font-black">{header}</th>
              ))}
            </tr>
          </thead>
          <tbody class="text-forest/80">
            {copy.originRows.map((row) => (
              <tr>
                <td class="border border-forest/10 px-3 py-2 font-semibold">{row.origin}</td>
                <td class="border border-forest/10 px-3 py-2" translate="no">{row.codes}</td>
                <td class="border border-forest/10 px-3 py-2">{row.fix}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="rounded-[2rem] border border-forest/10 bg-cream/70 p-6 md:p-8 space-y-5">
      <h2 id="refund-timelines" class="scroll-mt-28 text-2xl font-black text-forest">{copy.tatHeading}</h2>
      <p class="text-sm leading-relaxed text-forest/75">{copy.tatIntro}</p>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[32rem] text-left text-sm border-collapse">
          <thead>
            <tr class="bg-mint text-forest">
              {copy.tatHeaders.map((header) => (
                <th class="border border-forest/10 px-3 py-2 font-black">{header}</th>
              ))}
            </tr>
          </thead>
          <tbody class="text-forest/80">
            {copy.tatRows.map((row) => (
              <tr>
                {row.map((cell, index) => (
                  <td class:list={["border border-forest/10 px-3 py-2", index === 1 && "font-semibold"]}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-forest/60 leading-relaxed">
        {copy.tatFoot}{" "}
        <a class="font-bold text-leaf underline" href="https://www.rbi.org.in/Scripts/NotificationUser.aspx?Id=11693&Mode=0">
          RBI DPSS.CO.PD No.629/02.01.014/2019-20
        </a>
      </p>
    </section>

    <section class="rounded-[2rem] border border-white/75 bg-white/86 p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)] space-y-5">
      <h2 id="utr-and-escalation" class="scroll-mt-28 text-2xl font-black text-forest">{copy.utrHeading}</h2>
      <p class="text-sm leading-relaxed text-forest/75">{copy.utrIntro}</p>
      <ol class="space-y-3 text-sm text-forest/80 list-decimal pl-5">
        {copy.utrSteps.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="rounded-[2rem] bg-mint/30 border border-leaf/10 p-6 md:p-8 space-y-3">
      <h2 id="sources" class="scroll-mt-28 text-xl font-black text-forest">{copy.sourcesHeading}</h2>
      <p class="text-sm leading-relaxed text-forest/75">{copy.sourcesIntro}</p>
      <ul class="text-sm space-y-1">
        {ERROR_CODE_SOURCES.map((source) => (
          <li><a class="font-bold text-leaf underline" href={source.href}>{source.label}</a></li>
        ))}
      </ul>
      <p class="text-xs text-forest/55">{copy.sourcesFoot}</p>
    </section>

    <section class="rounded-[2rem] border border-white/75 bg-white/86 p-6 md:p-8 shadow-[0_18px_48px_rgba(17,59,44,0.08)] space-y-4">
      <h2 id="faq" class="scroll-mt-28 text-2xl font-black text-forest">{copy.faqHeading}</h2>
      <dl class="space-y-4">
        {copy.faqs.map((faq) => (
          <div class="rounded-2xl border border-forest/10 bg-[#fffdf6] p-5">
            <dt class="font-black text-forest">{faq.question}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-forest/75">{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <AffiliateProducts />
    <InternalLinkHub lang={lang} />
  </div>
</main>
