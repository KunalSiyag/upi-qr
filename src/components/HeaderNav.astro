            </div>
          </a>
          <a href={p("upi-qr-generators")} class="block rounded-xl p-2 text-center text-[11px] font-black uppercase tracking-wider text-leaf hover:bg-mint/60">
            {isHindi ? "सभी UPI QR जनरेटर →" : "All UPI QR generators →"}
          </a>
        </div>
      </div>
    </div>

    <!-- Billing documents -->
    <div class="relative group px-2 py-1">
      <button type="button" class="flex items-center gap-1 hover:text-leaf transition-colors focus-visible:ring-2 focus-visible:ring-leaf rounded-md focus:outline-none">
