---
import { routeExistsInLang } from "../data/validRoutes";
import { chromeFor } from "../data/localeChrome";
import { localeHref, type SiteLang } from "../lib/locale";

interface Props {
  isHindi?: boolean;
  langLink?: string;
  langLabel?: string;
  currentPath?: string;
}

const { isHindi = false, currentPath = "/" } = Astro.props;

const cleanPath = currentPath.replace(/^\/(hi|ta|te|mr)(\/|$)/, "/");
const currentSlug = cleanPath.replace(/^\/|\/$/g, "");

const languages = [
  { code: "en", label: "English", path: routeExistsInLang(currentSlug, "en") ? (currentSlug ? `/${currentSlug}/` : "/") : "/" },
  { code: "hi", label: "हिन्दी", path: routeExistsInLang(currentSlug, "hi") ? (currentSlug ? `/hi/${currentSlug}/` : "/hi/") : "/hi/" },
  { code: "ta", label: "தமிழ்", path: routeExistsInLang(currentSlug, "ta") ? (currentSlug ? `/ta/${currentSlug}/` : "/ta/") : "/ta/" },
  { code: "te", label: "తెలుగు", path: routeExistsInLang(currentSlug, "te") ? (currentSlug ? `/te/${currentSlug}/` : "/te/") : "/te/" },
  { code: "mr", label: "मराठी", path: routeExistsInLang(currentSlug, "mr") ? (currentSlug ? `/mr/${currentSlug}/` : "/mr/") : "/mr/" }
];

const localeMatch = currentPath.match(/^\/(hi|ta|te|mr)(?:\/|$)/);
const currentLang = localeMatch?.[1] ?? "en";
const siteLang: SiteLang = (currentLang === "hi" || currentLang === "ta" || currentLang === "te" || currentLang === "mr") ? currentLang : "en";
const chrome = chromeFor(siteLang);
const p = (slug: string) => localeHref(siteLang, slug);
const activeLang = languages.find((language) => language.code === currentLang) ?? languages[0];
const localeHome = currentLang === "en" ? "/" : `/${currentLang}/`;
