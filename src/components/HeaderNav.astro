  </nav>

  <div class="flex items-center gap-2 sm:gap-3">
    <!-- Language Dropdown Selector -->
    <div class="relative group">
      <button type="button" class="flex min-h-11 items-center gap-1.5 rounded-full bg-forest/5 border border-forest/10 px-3 py-1 text-xs font-bold text-forest hover:bg-forest hover:text-white transition-all duration-200 shrink-0 focus:outline-none">
        <svg class="h-3.5 w-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        <span>{activeLang.label}</span>
        <svg class="h-3 w-3 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="absolute right-0 top-full hidden group-hover:block group-focus-within:block pt-2 z-50 w-36">
        <div class="rounded-2xl border border-forest/10 bg-white/95 p-1.5 shadow-2xl backdrop-blur-xl space-y-0.5 text-xs font-bold">
          {languages.map((lang) => (
            <a
              href={lang.path}
              class={`flex items-center justify-between rounded-xl px-3 py-2 transition-colors ${
                activeLang.code === lang.code ? "bg-forest text-white" : "hover:bg-mint text-forest"
              }`}
            >
              <span>{lang.label}</span>
              <span class="text-[10px] uppercase opacity-60">{lang.code}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button type="button" id="mobile-menu-btn" aria-label={chrome.openMenu} aria-controls="mobile-menu" aria-expanded="false" class="xl:hidden flex h-11 w-11 items-center justify-center rounded-full bg-forest/5 text-forest hover:bg-forest/10 focus:outline-none">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

</header>

<!-- Mobile Dropdown Menu (opens below the navbar) -->
  <nav id="mobile-menu" aria-label="Mobile navigation" hidden class="xl:hidden pointer-events-auto absolute inset-x-0 top-[calc(100%+0.5rem)] z-40 max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain rounded-3xl border border-forest/10 bg-white shadow-2xl">
    <div class="space-y-3 p-4" style="padding-bottom:calc(1rem + env(safe-area-inset-bottom))">
    <div>
      <div class="text-[10px] font-bold uppercase tracking-wider text-forest/50 px-2 mb-1">{chrome.qrGenerators}</div>
      <div class="grid grid-cols-2 gap-1 text-xs">
        <a href={localeHome} class="p-2.5 rounded-lg hover:bg-mint text-forest font-semibold">UPI QR</a>
        <a href={p("universal-qr-generator")} class="p-2.5 rounded-lg hover:bg-mint text-forest font-semibold">Universal QR</a>
        <a href={p("qr-sticker-generator")} class="p-2.5 rounded-lg hover:bg-mint text-forest font-semibold">QR Stickers</a>
        <a href={p("upi-qr-decoder")} class="p-2.5 rounded-lg hover:bg-mint text-forest font-semibold">QR Decoder</a>
