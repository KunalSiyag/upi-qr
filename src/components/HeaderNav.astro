          </a>
          <a href={p("receipt-generator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">Payment receipt</div>
            <div class="text-[10px] text-forest/60">PAID stamp, UTR, and UPI QR</div>
          </a>
          <a href={p("rent-receipt-generator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
