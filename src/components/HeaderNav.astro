---
import { routeExistsInLang } from "../data/validRoutes";
import { chromeFor } from "../data/localeChrome";
import { localeHref, NON_EN_LANG_PATH, NON_EN_LANG_STRIP, isSiteLang, type SiteLang } from "../lib/locale";

interface Props {
  isHindi?: boolean;
  langLink?: string;
  langLabel?: string;
  currentPath?: string;
}

const { isHindi = false, currentPath = "/" } = Astro.props;

const cleanPath = currentPath.replace(NON_EN_LANG_STRIP, "/");
const currentSlug = cleanPath.replace(/^\/|\/$/g, "");

const languages = [
  { code: "en", label: "English", path: routeExistsInLang(currentSlug, "en") ? (currentSlug ? `/${currentSlug}/` : "/") : "/" },
  { code: "hi", label: "हिन्दी", path: routeExistsInLang(currentSlug, "hi") ? (currentSlug ? `/hi/${currentSlug}/` : "/hi/") : "/hi/" },
  { code: "ta", label: "தமிழ்", path: routeExistsInLang(currentSlug, "ta") ? (currentSlug ? `/ta/${currentSlug}/` : "/ta/") : "/ta/" },
  { code: "te", label: "తెలుగు", path: routeExistsInLang(currentSlug, "te") ? (currentSlug ? `/te/${currentSlug}/` : "/te/") : "/te/" },
  { code: "mr", label: "मराठी", path: routeExistsInLang(currentSlug, "mr") ? (currentSlug ? `/mr/${currentSlug}/` : "/mr/") : "/mr/" },
  { code: "es", label: "Español", path: routeExistsInLang(currentSlug, "es") ? (currentSlug ? `/es/${currentSlug}/` : "/es/") : "/es/" },
  { code: "pt", label: "Português", path: routeExistsInLang(currentSlug, "pt") ? (currentSlug ? `/pt/${currentSlug}/` : "/pt/") : "/pt/" },
  { code: "fr", label: "Français", path: routeExistsInLang(currentSlug, "fr") ? (currentSlug ? `/fr/${currentSlug}/` : "/fr/") : "/fr/" },
  { code: "de", label: "Deutsch", path: routeExistsInLang(currentSlug, "de") ? (currentSlug ? `/de/${currentSlug}/` : "/de/") : "/de/" },
  { code: "id", label: "Bahasa Indonesia", path: routeExistsInLang(currentSlug, "id") ? (currentSlug ? `/id/${currentSlug}/` : "/id/") : "/id/" },
  { code: "ar", label: "العربية", path: routeExistsInLang(currentSlug, "ar") ? (currentSlug ? `/ar/${currentSlug}/` : "/ar/") : "/ar/" },
  { code: "it", label: "Italiano", path: routeExistsInLang(currentSlug, "it") ? (currentSlug ? `/it/${currentSlug}/` : "/it/") : "/it/" },
  { code: "ja", label: "日本語", path: routeExistsInLang(currentSlug, "ja") ? (currentSlug ? `/ja/${currentSlug}/` : "/ja/") : "/ja/" },
  { code: "zh", label: "中文", path: routeExistsInLang(currentSlug, "zh") ? (currentSlug ? `/zh/${currentSlug}/` : "/zh/") : "/zh/" },
];

const localeMatch = currentPath.match(NON_EN_LANG_PATH);
const currentLang = localeMatch?.[1] ?? "en";
const siteLang: SiteLang = isSiteLang(currentLang) ? currentLang : "en";
const chrome = chromeFor(siteLang);
const p = (slug: string) => localeHref(siteLang, slug);
const activeLang = languages.find((language) => language.code === currentLang) ?? languages[0];
const localeHome = currentLang === "en" ? "/" : `/${currentLang}/`;
const hi = (en: string, hindi: string) => (isHindi ? hindi : en);
const loginHref = "/sign-in/?redirect_url=" + encodeURIComponent("/app/");

/**
 * The Tools menu: the pages people search for (Search Console), grouped by the job.
 * Every other tool is one click away on its hub ("All …") or on /tools/.
 */
const toolGroups = [
  {
    title: chrome.qrGenerators,
    links: [
      { href: localeHome, label: chrome.upiQrGenerator },
      { href: p("universal-qr-generator"), label: "Universal QR" },
      { href: p("phonepe-qr-generator"), label: "PhonePe QR" },
      { href: p("google-pay-qr-generator"), label: "Google Pay QR" },
      { href: p("paytm-qr-generator"), label: "Paytm QR" },
      { href: p("bhim-qr-generator"), label: "NPCI / BHIM QR" },
      { href: p("sbi-qr-generator"), label: "SBI QR" },
      { href: p("qr-sticker-generator"), label: hi("QR stickers", "QR स्टीकर") },
      { href: p("upi-qr-decoder"), label: hi("UPI QR decoder", "UPI QR डिकोडर") },
    ],
    more: { href: p("upi-qr-generators"), label: hi("All QR generators", "सभी QR जनरेटर") },
  },
  {
    title: chrome.billing,
    links: [
      { href: p("invoice-generator"), label: hi("Invoice PDF", "इनवॉइस PDF") },
      { href: p("receipt-generator"), label: hi("Payment receipt", "भुगतान रसीद") },
      { href: p("paid-stamp-generator"), label: hi("Paid stamp", "PAID स्टैम्प") },
      { href: p("quotation-generator"), label: hi("Quotation", "कोटेशन") },
      { href: p("upi-link-generator"), label: hi("Payment link", "पेमेंट लिंक") },
      { href: p("payment-tracker"), label: hi("Payment tracker", "पेमेंट ट्रैकर") },
    ],
    more: { href: p("merchant-documents"), label: hi("All documents", "सभी दस्तावेज़") },
  },
  {
    title: chrome.calculators,
    links: [
      { href: p("upi-calculator"), label: hi("UPI fee calculator", "UPI शुल्क कैलकुलेटर") },
      { href: p("gst-calculator"), label: hi("GST calculator", "GST कैलकुलेटर") },
      { href: p("upi-mdr-calculator"), label: "UPI MDR (Oct 2026)" },
      { href: p("upi-limits"), label: hi("Bank UPI limits", "बैंक UPI लिमिट") },
      { href: p("upi-error-codes"), label: hi("UPI error codes", "UPI एरर कोड") },
      { href: p("emi-calculator"), label: hi("EMI calculator", "EMI कैलकुलेटर") },
    ],
    more: { href: p("business-calculators"), label: hi("All calculators", "सभी कैलकुलेटर") },
  },
];
---

<header class="flex h-16 items-center justify-between gap-4">
  <a href={localeHome} class="flex shrink-0 items-center gap-2.5 text-lg font-black tracking-tight text-obsidian">
    <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8 rounded-[9px]" />
    <span>Pro UPI QR</span>
  </a>

  <nav aria-label="Main" class="hidden items-center gap-7 text-[15px] font-semibold text-forest lg:flex">
    <div class="group relative">
      <button type="button" aria-haspopup="true" class="flex min-h-11 items-center gap-1 rounded-full hover:text-leaf focus:outline-none focus-visible:ring-2 focus-visible:ring-leaf">
        <span>{chrome.toolsCol}</span>
        <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </button>
      <div class="absolute left-0 top-full z-50 hidden w-[min(46rem,calc(100vw-4rem))] pt-2 group-focus-within:block group-hover:block">
        <div class="rounded-[14px] border border-forest/10 bg-white p-6 shadow-[0_6px_20px_rgba(0,0,0,0.08)]">
          <div class="grid grid-cols-3 gap-6">
            {toolGroups.map((group) => (
              <div>
                <p class="px-2 text-xs font-bold text-muted">{group.title}</p>
                <ul class="mt-2 space-y-0.5">
                  {group.links.map((link) => (
                    <li><a href={link.href} class="block rounded-[10px] px-2 py-1.5 text-sm font-semibold text-forest hover:bg-mint">{link.label}</a></li>
                  ))}
                </ul>
                <a href={group.more.href} class="mt-2 inline-block px-2 text-sm font-semibold text-forest underline underline-offset-4 hover:text-leaf">{group.more.label}</a>
              </div>
            ))}
          </div>
          <div class="mt-5 flex items-center justify-between border-t border-forest/10 pt-4 text-sm font-semibold">
            <span class="text-muted">{hi("Free, no signup. Made in your browser.", "मुफ्त, बिना साइनअप। आपके ब्राउज़र में बनता है।")}</span>
            <a href={p("tools")} class="text-forest underline underline-offset-4 hover:text-leaf">{chrome.allTools} &rarr;</a>
          </div>
        </div>
      </div>
    </div>
    <a href={p("payment-tracker")} class="hover:text-leaf">{hi("Payment tracker", "पेमेंट ट्रैकर")}</a>
    <a href="/pricing/" class="hover:text-leaf">{hi("Pricing", "प्राइसिंग")}</a>
    <a href={p("blog")} class="hover:text-leaf">{chrome.guides}</a>
  </nav>

  <div class="flex items-center gap-1 sm:gap-2">
    <div class="group relative">
      <button type="button" aria-haspopup="true" aria-label={`Language: ${activeLang.label}`} class="flex min-h-11 items-center gap-1 rounded-[10px] px-2.5 text-sm font-semibold text-muted hover:text-forest focus:outline-none focus-visible:ring-2 focus-visible:ring-leaf">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
        <span class="uppercase">{activeLang.code}</span>
      </button>
      <div class="absolute right-0 top-full z-50 hidden w-44 pt-2 group-focus-within:block group-hover:block">
        <div class="space-y-0.5 rounded-[12px] border border-forest/10 bg-white p-1.5 text-sm font-semibold shadow-[0_6px_20px_rgba(0,0,0,0.08)]">
          {languages.map((lang) => (
            <a href={lang.path} class={`flex items-center justify-between rounded-[10px] px-3 py-2 ${activeLang.code === lang.code ? "bg-forest text-white" : "text-forest hover:bg-mint"}`}>
              <span>{lang.label}</span>
              <span class="text-[11px] uppercase opacity-60">{lang.code}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
    <a href={loginHref} data-login-link class="hidden min-h-11 shrink-0 items-center px-2 text-[15px] font-semibold text-forest hover:text-leaf md:inline-flex">{hi("Log in", "लॉग इन")}</a>
    <a href="/app/" class="hidden h-11 shrink-0 items-center rounded-[10px] border border-forest px-5 text-[15px] font-semibold text-forest transition-colors hover:bg-forest hover:text-white sm:inline-flex">{hi("Track payments", "पेमेंट ट्रैक करें")}</a>
    <button type="button" id="mobile-menu-btn" aria-label={chrome.openMenu} aria-controls="mobile-menu" aria-expanded="false" class="flex h-11 w-11 items-center justify-center rounded-full bg-fog text-forest hover:bg-mint lg:hidden">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>
</header>

<nav id="mobile-menu" aria-label={chrome.openMenu} hidden class="absolute inset-x-0 top-full z-40 max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-b border-forest/10 bg-white shadow-[0_6px_20px_rgba(0,0,0,0.08)] lg:hidden">
  <div class="mx-auto max-w-7xl space-y-5 px-4 py-4 md:px-6" style="padding-bottom:calc(1rem + env(safe-area-inset-bottom))">
    <a href="/app/" class="flex h-12 items-center justify-between rounded-[10px] bg-forest px-5 text-base font-bold text-white">
      <span>{hi("Track payments — free", "पेमेंट ट्रैक करें — मुफ्त")}</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
    {toolGroups.map((group) => (
      <div>
        <p class="text-xs font-bold text-muted">{group.title}</p>
        <ul class="mt-1 grid grid-cols-2 gap-x-3">
          {group.links.map((link) => (
            <li><a href={link.href} class="block py-2.5 text-[15px] font-semibold text-forest">{link.label}</a></li>
          ))}
        </ul>
        <a href={group.more.href} class="inline-block py-1 text-sm font-semibold text-forest underline underline-offset-4">{group.more.label}</a>
      </div>
    ))}
    <div class="flex flex-wrap gap-x-5 gap-y-1 border-t border-forest/10 pt-3 text-[15px] font-semibold text-forest">
      <a href={p("tools")} class="py-2">{chrome.allTools}</a>
      <a href="/pricing/" class="py-2">{hi("Pricing", "प्राइसिंग")}</a>
      <a href={p("blog")} class="py-2">{chrome.guides}</a>
      <a href={p("about")} class="py-2">{chrome.about}</a>
      <a href={loginHref} data-login-link class="py-2">{hi("Log in", "लॉग इन")}</a>
    </div>
  </div>
</nav>

<script is:inline define:vars={{ accountLabel: hi("My account", "मेरा खाता") }}>
  // The header is static and Clerk loads only on account pages, so read Clerk's
  // __client_uat cookie (sign-in time, "0" when signed out) to swap "Log in".
  if (/(?:^|; )__client_uat=[1-9]/.test(document.cookie)) {
    for (const link of document.querySelectorAll("[data-login-link]")) {
      link.textContent = accountLabel;
      link.href = "/app/?tab=settings";
    }
  }
</script>
<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  function setMobileMenu(open) {
    if (!btn || !menu) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  }

  btn?.addEventListener('click', () => setMobileMenu(menu?.hidden ?? false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMobileMenu(false);
  });
</script>
