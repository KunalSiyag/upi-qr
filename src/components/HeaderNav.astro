---
import { routeExistsInLang } from "../data/validRoutes";
import { chromeFor } from "../data/localeChrome";
import { localeHref, type SiteLang } from "../lib/locale";

interface Props {
  isHindi?: boolean;
  langLink?: string;
  langLabel?: string;
  currentPath?: string;
}

const { isHindi = false, currentPath = "/" } = Astro.props;

const cleanPath = currentPath.replace(/^\/(hi|ta|te|mr|es|pt|fr|de|id)(\/|$)/, "/");
const currentSlug = cleanPath.replace(/^\/|\/$/g, "");

const languages = [
  { code: "en", label: "English", path: routeExistsInLang(currentSlug, "en") ? (currentSlug ? `/${currentSlug}/` : "/") : "/" },
  { code: "hi", label: "हिन्दी", path: routeExistsInLang(currentSlug, "hi") ? (currentSlug ? `/hi/${currentSlug}/` : "/hi/") : "/hi/" },
  { code: "ta", label: "தமிழ்", path: routeExistsInLang(currentSlug, "ta") ? (currentSlug ? `/ta/${currentSlug}/` : "/ta/") : "/ta/" },
  { code: "te", label: "తెలుగు", path: routeExistsInLang(currentSlug, "te") ? (currentSlug ? `/te/${currentSlug}/` : "/te/") : "/te/" },
  { code: "mr", label: "मराठी", path: routeExistsInLang(currentSlug, "mr") ? (currentSlug ? `/mr/${currentSlug}/` : "/mr/") : "/mr/" },
  { code: "es", label: "Español", path: routeExistsInLang(currentSlug, "es") ? (currentSlug ? `/es/${currentSlug}/` : "/es/") : "/es/" },
  { code: "pt", label: "Português", path: routeExistsInLang(currentSlug, "pt") ? (currentSlug ? `/pt/${currentSlug}/` : "/pt/") : "/pt/" },
  { code: "fr", label: "Français", path: routeExistsInLang(currentSlug, "fr") ? (currentSlug ? `/fr/${currentSlug}/` : "/fr/") : "/fr/" },
  { code: "de", label: "Deutsch", path: routeExistsInLang(currentSlug, "de") ? (currentSlug ? `/de/${currentSlug}/` : "/de/") : "/de/" },
  { code: "id", label: "Bahasa Indonesia", path: routeExistsInLang(currentSlug, "id") ? (currentSlug ? `/id/${currentSlug}/` : "/id/") : "/id/" },
];

const localeMatch = currentPath.match(/^\/(hi|ta|te|mr|es|pt|fr|de|id)(?:\/|$)/);
const currentLang = localeMatch?.[1] ?? "en";
const siteLang: SiteLang = (currentLang === "hi" || currentLang === "ta" || currentLang === "te" || currentLang === "mr" || currentLang === "es" || currentLang === "pt" || currentLang === "fr" || currentLang === "de" || currentLang === "id") ? currentLang : "en";
const chrome = chromeFor(siteLang);
const p = (slug: string) => localeHref(siteLang, slug);
const activeLang = languages.find((language) => language.code === currentLang) ?? languages[0];
const localeHome = currentLang === "en" ? "/" : `/${currentLang}/`;
---

<div class="relative">
<header class="flex items-center justify-between gap-4 rounded-full border border-white/80 bg-white/85 px-4 py-3 backdrop-blur-md shadow-[0_8px_30px_rgb(0,0,0,0.06)] pointer-events-auto transition-all">
  <a href={localeHome} class="flex items-center gap-2.5 text-sm sm:text-lg font-black tracking-tight text-forest shrink-0 hover:opacity-90">
    <img src="/favicon.svg" alt="Pro UPI QR Logo" width="32" height="32" class="h-8 w-8 rounded-xl shadow-sm" />
    <span>Pro UPI QR</span>
  </a>

  <!-- Desktop Navigation -->
  <nav class="hidden xl:flex items-center gap-1 text-xs md:text-sm font-semibold text-forest/80">
    <!-- QR Generators Dropdown -->
    <div class="relative group px-2 py-1">
      <button type="button" class="flex items-center gap-1 hover:text-leaf transition-colors focus-visible:ring-2 focus-visible:ring-leaf rounded-md focus:outline-none">
        <span>{chrome.qrGenerators}</span>
        <svg class="h-3.5 w-3.5 opacity-70 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block pt-2 z-50 w-64">
        <div class="rounded-2xl border border-forest/10 bg-white/95 p-2 shadow-2xl backdrop-blur-xl space-y-1">
          <a href={localeHome} class="flex items-start gap-2.5 rounded-xl p-2 hover:bg-mint/60 transition-colors">
            <div class="p-1.5 rounded-lg bg-mint text-leaf">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold text-forest">{chrome.upiQrGenerator}</div>
              <div class="text-[10px] text-forest/60">{chrome.upiQrGeneratorHint}</div>
            </div>
          </a>
          <a href={p("universal-qr-generator")} class="flex items-start gap-2.5 rounded-xl p-2 hover:bg-mint/60 transition-colors">
            <div class="p-1.5 rounded-lg bg-mint text-leaf">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold text-forest">Universal QR Generator</div>
