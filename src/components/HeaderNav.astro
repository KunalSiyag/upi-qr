            <div class="text-[10px] text-forest/60">HRA format with revenue stamp box</div>
          </a>
          <a href={p("quotation-generator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">Quotation</div>
