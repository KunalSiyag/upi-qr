            <div class="text-[10px] text-forest/60">{isHindi ? "एम्बेड और API" : "Embed widget and payment API"}</div>
          </a>
          <a href={p("about")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">{chrome.about}</div>
          </a>
          <a href="/reviews/" class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">{chrome.reviews}</div>
          </a>
