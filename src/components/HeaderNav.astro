          </a>
          <a href={p("merchant-documents")} class="block rounded-xl p-2 text-center text-[11px] font-black uppercase tracking-wider text-leaf hover:bg-mint/60">
            {isHindi ? "सभी दस्तावेज़ →" : "All billing documents →"}
          </a>
        </div>
      </div>
    </div>

    <!-- Calculators -->
    <div class="relative group px-2 py-1">
      <button type="button" class="flex items-center gap-1 hover:text-leaf transition-colors focus-visible:ring-2 focus-visible:ring-leaf rounded-md focus:outline-none">
        <span>{chrome.calculators}</span>
        <svg class="h-3.5 w-3.5 opacity-70 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block pt-2 z-50 w-72">
        <div class="rounded-2xl border border-forest/10 bg-white/95 p-2 shadow-2xl backdrop-blur-xl space-y-0.5">
          <a href={p("gst-calculator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">GST calculator</div>
            <div class="text-[10px] text-forest/60">Find the rate, then split tax</div>
          </a>
          <a href={p("upi-mdr-calculator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">UPI MDR (Oct 2026)</div>
            <div class="text-[10px] text-forest/60">0.4% above ₹2,000 — not a tax</div>
          </a>
          <a href={p("emi-calculator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">EMI calculator</div>
            <div class="text-[10px] text-forest/60">Loan EMI and amortization PDF</div>
          </a>
          <a href={p("sip-calculator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">SIP calculator</div>
            <div class="text-[10px] text-forest/60">Growth table and inflation view</div>
          </a>
          <a href={p("split-bill-calculator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">Split bill</div>
            <div class="text-[10px] text-forest/60">Fair shares with UPI pay links</div>
          </a>
          <a href={p("cash-denomination-calculator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">Night-close till</div>
            <div class="text-[10px] text-forest/60">Cash + UPI + card + bank bag</div>
          </a>
          <a href={p("upi-calculator")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">UPI fee calculator</div>
            <div class="text-[10px] text-forest/60">MDR and settlement math</div>
          </a>
          <a href={p("upi-limits")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">Bank UPI limits</div>
            <div class="text-[10px] text-forest/60">Daily caps for 30+ banks</div>
          </a>
          <a href={p("upi-error-codes")} class="block rounded-xl px-3 py-2 hover:bg-mint/60">
            <div class="text-xs font-bold text-forest">NPCI error resolver</div>
            <div class="text-[10px] text-forest/60">Paste Z9 / M16 / returned error</div>
          </a>
          <a href={p("business-calculators")} class="block rounded-xl p-2 text-center text-[11px] font-black uppercase tracking-wider text-leaf hover:bg-mint/60">
            {isHindi ? "सभी कैलकुलेटर →" : "All calculators →"}
