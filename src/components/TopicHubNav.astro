---
import { NAV_HUBS } from "../data/topicHubs";
import { chromeFor } from "../data/localeChrome";
import { detectLangFromPath, localeHref } from "../lib/locale";

interface Props {
  isHindi?: boolean;
}

const lang = detectLangFromPath(Astro.url.pathname);
const chrome = chromeFor(lang);
const title = chrome.topics;
---

<nav class="no-print border-t border-forest/10 px-4 py-6 md:px-6 lg:px-8" aria-label={title}>
  <div class="mx-auto flex max-w-7xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-xs font-black uppercase tracking-[0.18em] text-leaf">{title}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-2 text-xs font-semibold text-forest/80">
      {NAV_HUBS.map((hub) => (
        <li>
          <a href={localeHref(lang, hub.path.replace(/^\/|\/$/g, ""))} class="hover:text-leaf hover:underline">
            {lang === "hi" ? hub.hiName : hub.shortName}
          </a>
        </li>
      ))}
      <li><a href={localeHref(lang, "print-templates")} class="hover:text-leaf hover:underline">{chrome.printTemplates}</a></li>
      <li><a href={localeHref(lang, "blog")} class="hover:text-leaf hover:underline">{chrome.blog}</a></li>
      <li><a href={localeHref(lang, "tools")} class="hover:text-leaf hover:underline">{chrome.allTools}</a></li>
    </ul>
  </div>
</nav>
