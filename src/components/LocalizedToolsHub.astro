---
import { LOCALIZED_TOOLS, getLocalizedToolCopy } from "../data/localizedTools";
import { chromeFor } from "../data/localeChrome";
import { localeHref, localeHome, type SiteLang } from "../lib/locale";

interface Props { lang: Exclude<SiteLang, "en">; }
const { lang } = Astro.props;
const chrome = chromeFor(lang);

const featured = [
  { href: localeHome(lang), name: chrome.upiQrGenerator, desc: chrome.upiQrGeneratorHint },
  { href: localeHref(lang, "phonepe-qr-generator"), name: "PhonePe QR", desc: "PhonePe" },
  { href: localeHref(lang, "google-pay-qr-generator"), name: "Google Pay QR", desc: "GPay" },
  { href: localeHref(lang, "upi-error-codes"), name: lang === "hi" ? "UPI एरर कोड" : lang === "ta" ? "UPI பிழைக் குறியீடுகள்" : lang === "te" ? "UPI ఎర్రర్ కోడ్‌లు" : "UPI त्रुटी कोड", desc: "NPCI" },
  { href: localeHref(lang, "universal-qr-generator"), name: "Universal QR", desc: "URL, Wi-Fi, vCard" },
];

const more = LOCALIZED_TOOLS.map((tool) => {
  const copy = getLocalizedToolCopy(tool, lang);
  return { href: localeHref(lang, tool.slug), name: copy.name, desc: copy.intro };
});
---

<main>
  <section class="relative overflow-hidden px-4 pb-10 pt-12 md:px-6 lg:px-8">
    <div class="grid-glow absolute inset-x-0 top-0 h-[24rem]"></div>
    <div class="relative mx-auto max-w-7xl">
      <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-forest/60">
        <a href={localeHome(lang)} class="hover:text-leaf transition-colors">{chrome.upiQrGenerator}</a>
        <span>/</span>
        <span class="text-forest font-bold" aria-current="page">{chrome.allTools}</span>
      </nav>
      <p class="inline-flex rounded-full border border-leaf/15 bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.26em] text-leaf">{chrome.allTools}</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-black leading-tight tracking-tight text-forest md:text-6xl">{chrome.toolsHubH1}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-forest/75 md:text-xl">{chrome.toolsHubIntro}</p>
    </div>
  </section>

  <section class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-2xl font-black tracking-tight text-forest md:text-3xl">{chrome.toolsHubFeatured}</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((tool) => (
          <a href={tool.href} class="group flex flex-col rounded-[1.5rem] border border-white/75 bg-white/88 p-5 shadow-[0_10px_30px_rgba(17,59,44,0.06)] transition hover:border-leaf/40 hover:-translate-y-0.5">
            <h3 class="text-base font-black text-forest group-hover:text-leaf transition-colors">{tool.name}</h3>
            <p class="mt-2 flex-1 text-xs leading-6 text-forest/70">{tool.desc}</p>
            <span class="mt-3 text-[11px] font-black uppercase tracking-wider text-leaf">{chrome.openTool} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-8 md:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-2xl font-black tracking-tight text-forest md:text-3xl">{chrome.toolsHubMore}</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {more.map((tool) => (
          <a href={tool.href} class="group flex flex-col rounded-[1.5rem] border border-white/75 bg-white/88 p-5 shadow-[0_10px_30px_rgba(17,59,44,0.06)] transition hover:border-leaf/40 hover:-translate-y-0.5">
            <h3 class="text-base font-black text-forest group-hover:text-leaf transition-colors">{tool.name}</h3>
            <p class="mt-2 flex-1 text-xs leading-6 text-forest/70 line-clamp-3">{tool.desc}</p>
            <span class="mt-3 text-[11px] font-black uppercase tracking-wider text-leaf">{chrome.openTool} →</span>
          </a>
        ))}
      </div>
      <p class="mt-8 text-sm text-forest/70">
        <a href="/tools/" class="font-bold text-leaf hover:underline">{chrome.toolsHubEnglish} →</a>
      </p>
    </div>
  </section>
</main>
