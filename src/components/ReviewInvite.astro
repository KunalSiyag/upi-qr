---
import { PRODUCT_HUNT_REVIEWS_URL } from "../data/reviews";
---

<section class="px-4 py-12 md:px-6 lg:px-8">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 rounded-[2rem] border border-white/75 bg-forest px-6 py-8 text-white md:flex-row md:items-end md:justify-between md:px-8 md:py-10">
    <div class="max-w-2xl">
      <p class="text-sm font-black uppercase tracking-[0.2em] text-sun">Ratings help shops trust a QR</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">Used the generator? Leave a public rating.</h2>
      <p class="mt-4 text-base leading-7 text-white/76">
        Product Hunt is the public rating today. If you printed a standee or invoice QR, a short review there helps the next shop trust the tool.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href={`${PRODUCT_HUNT_REVIEWS_URL}?utm_source=proupiqr&utm_medium=site&utm_campaign=review-invite`}
        rel="noopener noreferrer"
        class="rounded-full bg-sun px-5 py-3 text-sm font-bold text-forest transition hover:bg-[#f2ad37] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun"
      >
        Review on Product Hunt
      </a>
      <a
        href="/reviews/#write"
        class="rounded-full border border-white/20 px-5 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-forest focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun"
      >
        Send a shop quote
      </a>
    </div>
  </div>
</section>
