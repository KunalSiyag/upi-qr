---
import { GeneratorForm } from "./GeneratorForm";
import { DigitalVisitingCard } from "./DigitalVisitingCard";
import { DynamicQrGenerator } from "./DynamicQrGenerator";
import { StickerSheetGenerator } from "./StickerSheetGenerator";
import { GstCalculator } from "./GstCalculator";
import { WhatsappOrderGenerator } from "./WhatsappOrderGenerator";
import { BulkQrGenerator } from "./BulkQrGenerator";
import { InvoiceGenerator } from "./InvoiceGenerator";
import { UpiCalculator } from "./UpiCalculator";
import { OfferPosterGenerator } from "./OfferPosterGenerator";
import { MenuQrGenerator } from "./MenuQrGenerator";
import { MarginCalculator } from "./MarginCalculator";
import { UpiLimitsChecker } from "./UpiLimitsChecker";
import { UpiQrDecoder } from "./UpiQrDecoder";
import { UpiLinkGenerator } from "./UpiLinkGenerator";
import { SurveyQrGenerator } from "./SurveyQrGenerator";
import InternalLinkHub from "./InternalLinkHub.astro";
import type { LocalizedTool, SupportedToolLanguage } from "../data/localizedTools";
import { getLocalizedToolCopy } from "../data/localizedTools";

interface Props { lang: SupportedToolLanguage; tool: LocalizedTool; }
const { lang, tool } = Astro.props;
const locale = getLocalizedToolCopy(tool, lang);
const chrome = {
  hi: { home: "मुख्य पृष्ठ पर वापस जाएं", label: "मुफ्त व्यापारी टूल", howTo: "कैसे उपयोग करें", faq: "अक्सर पूछे जाने वाले प्रश्न", privacy: "कोई साइनअप नहीं", instant: "तुरंत परिणाम", local: "ब्राउज़र में निजी प्रोसेसिंग" },
  ta: { home: "முதன்மை பக்கத்திற்குத் திரும்பு", label: "இலவச வணிகக் கருவி", howTo: "எப்படி பயன்படுத்துவது", faq: "அடிக்கடி கேட்கப்படும் கேள்விகள்", privacy: "பதிவு தேவையில்லை", instant: "உடனடி முடிவுகள்", local: "உலாவியில் தனிப்பட்ட செயலாக்கம்" },
  te: { home: "ప్రధాన పేజీకి తిరిగి వెళ్లండి", label: "ఉచిత వ్యాపార సాధనం", howTo: "ఎలా ఉపయోగించాలి", faq: "తరచుగా అడిగే ప్రశ్నలు", privacy: "సైన్అప్ అవసరం లేదు", instant: "తక్షణ ఫలితాలు", local: "బ్రౌజర్‌లో ప్రైవేట్ ప్రాసెసింగ్" },
  mr: { home: "मुख्य पृष्ठावर परत जा", label: "मोफत व्यावसायिक साधन", howTo: "कसे वापरावे", faq: "नेहमी विचारले जाणारे प्रश्न", privacy: "साइनअप नाही", instant: "त्वरित निकाल", local: "ब्राउझरमध्ये खाजगी प्रक्रिया" },
}[lang];
const path = `/${lang}/${tool.slug}/`;
---

<main class="px-3 py-8 sm:px-4 md:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-8">
      <section class="rounded-[2rem] border border-white/75 bg-white/86 p-5 shadow-[0_18px_48px_rgba(17,59,44,0.08)] sm:p-8 md:p-10">
        <a href={`/${lang}/`} class="text-xs font-bold text-leaf hover:underline">&larr; {chrome.home}</a>
        <p class="mt-5 inline-flex rounded-full border border-leaf/15 bg-mint px-3 py-1.5 text-xs font-black text-leaf">{chrome.label}</p>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-forest sm:text-5xl">{locale.name}</h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-forest/75 sm:text-base">{locale.intro}</p>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold text-forest/75"><span class="rounded-full bg-mint px-3 py-2">{chrome.privacy}</span><span class="rounded-full bg-mint px-3 py-2">{chrome.instant}</span><span class="rounded-full bg-mint px-3 py-2">{chrome.local}</span></div>
      </section>
      <section id="tool" class="rounded-[2rem] border border-white/75 bg-white/86 p-4 shadow-[0_18px_48px_rgba(17,59,44,0.08)] sm:p-8 md:p-10">
        {tool.component === "digitalCard" && <DigitalVisitingCard client:load />}
        {tool.component === "dynamicQr" && <DynamicQrGenerator client:load />}
        {tool.component === "stickers" && <StickerSheetGenerator client:load />}
        {tool.component === "gst" && <GstCalculator client:load />}
        {tool.component === "whatsapp" && <WhatsappOrderGenerator client:load />}
        {tool.component === "bulk" && <BulkQrGenerator client:load />}
        {tool.component === "invoice" && <InvoiceGenerator client:load />}
        {tool.component === "upiCalculator" && <UpiCalculator client:load />}
        {tool.component === "offerPoster" && <OfferPosterGenerator client:load />}
        {tool.component === "menuQr" && <MenuQrGenerator client:load />}
        {tool.component === "margin" && <MarginCalculator client:load />}
        {tool.component === "limits" && <UpiLimitsChecker client:load />}
        {tool.component === "decoder" && <UpiQrDecoder client:load />}
        {tool.component === "upiLink" && <UpiLinkGenerator client:load />}
        {tool.component === "survey" && <SurveyQrGenerator client:load />}
        {tool.component === "default" && <GeneratorForm client:load lang={lang === "hi" ? "hi" : "en"} />}
      </section>
      {locale.steps.length > 0 && (
        <section class="rounded-[2rem] border border-white/75 bg-white/86 p-5 sm:p-8">
          <h2 class="text-xl font-black text-forest">{chrome.howTo}</h2>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-forest/80">
            {locale.steps.map((step) => <li>{step}</li>)}
          </ol>
        </section>
      )}
      {locale.faqs.length > 0 && (
        <section class="rounded-[2rem] border border-white/75 bg-white/86 p-5 sm:p-8">
          <h2 class="text-xl font-black text-forest">{chrome.faq}</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {locale.faqs.map((faq) => (
              <div class="rounded-2xl border border-forest/10 bg-[#fffdf6] p-4">
                <h3 class="text-sm font-black text-forest">{faq.question}</h3>
                <p class="mt-2 text-xs leading-relaxed text-forest/75">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}
      <InternalLinkHub currentPath={path} isHindi={lang === "hi"} />
    </div>
  </main>
