---
import { GeneratorForm } from "./GeneratorForm";
import { DigitalVisitingCard } from "./DigitalVisitingCard";
import { DynamicQrGenerator } from "./DynamicQrGenerator";
import { StickerSheetGenerator } from "./StickerSheetGenerator";
import { GstCalculator } from "./GstCalculator";
import { WhatsappOrderGenerator } from "./WhatsappOrderGenerator";
import { BulkQrGenerator } from "./BulkQrGenerator";
import { InvoiceGenerator } from "./InvoiceGenerator";
import { ReceiptGenerator } from "./ReceiptGenerator";
import { PaidStampGenerator } from "./PaidStampGenerator";
import { RentReceiptGenerator } from "./RentReceiptGenerator";
import { PaymentReminderGenerator } from "./PaymentReminderGenerator";
import { QuotationGenerator } from "./QuotationGenerator";
import { SplitBillCalculator } from "./SplitBillCalculator";
import { CashDenominationCalculator } from "./CashDenominationCalculator";
import { CreditNoteGenerator } from "./CreditNoteGenerator";
import { EmiCalculator } from "./EmiCalculator";
import { GratuityCalculator } from "./GratuityCalculator";
import { SipCalculator } from "./SipCalculator";
import { SalarySlipGenerator } from "./SalarySlipGenerator";
import { MsmedInterestCalculator } from "./MsmedInterestCalculator";
import { ProformaInvoiceGenerator } from "./ProformaInvoiceGenerator";
import { BreakEvenCalculator } from "./BreakEvenCalculator";
import { TredsCalculator } from "./TredsCalculator";
import { UpiCalculator } from "./UpiCalculator";
import { OfferPosterGenerator } from "./OfferPosterGenerator";
import { MenuQrGenerator } from "./MenuQrGenerator";
import { MarginCalculator } from "./MarginCalculator";
import { UpiLimitsChecker } from "./UpiLimitsChecker";
import { UpiQrDecoder } from "./UpiQrDecoder";
import { UpiLinkGenerator } from "./UpiLinkGenerator";
import { SurveyQrGenerator } from "./SurveyQrGenerator";
import { MerchantReconciliation } from "./MerchantReconciliation";
import { MsmeReceivables } from "./MsmeReceivables";
import InternalLinkHub from "./InternalLinkHub.astro";
import type { LocalizedTool, SupportedToolLanguage } from "../data/localizedTools";
import { getLocalizedToolCopy } from "../data/localizedTools";

interface Props { lang: SupportedToolLanguage; tool: LocalizedTool; }
const { lang, tool } = Astro.props;
const locale = getLocalizedToolCopy(tool, lang);
const chrome = {
  hi: { home: "मुख्य पृष्ठ पर वापस जाएं", label: "मुफ्त व्यापारी टूल", howTo: "कैसे उपयोग करें", faq: "अक्सर पूछे जाने वाले प्रश्न", privacy: "कोई साइनअप नहीं", instant: "तुरंत परिणाम", local: "ब्राउज़र में निजी प्रोसेसिंग" },
  ta: { home: "முதன்மை பக்கத்திற்குத் திரும்பு", label: "இலவச வணிகக் கருவி", howTo: "எப்படி பயன்படுத்துவது", faq: "அடிக்கடி கேட்கப்படும் கேள்விகள்", privacy: "பதிவு தேவையில்லை", instant: "உடனடி முடிவுகள்", local: "உலாவியில் தனிப்பட்ட செயலாக்கம்" },
  te: { home: "ప్రధాన పేజీకి తిరిగి వెళ్లండి", label: "ఉచిత వ్యాపార సాధనం", howTo: "ఎలా ఉపయోగించాలి", faq: "తరచుగా అడిగే ప్రశ్నలు", privacy: "సైన్అప్ అవసరం లేదు", instant: "తక్షణ ఫలితాలు", local: "బ్రౌజర్‌లో ప్రైవేట్ ప్రాసెసింగ్" },
  mr: { home: "मुख्य पृष्ठावर परत जा", label: "मोफत व्यावसायिक साधन", howTo: "कसे वापरावे", faq: "नेहमी विचारले जाणारे प्रश्न", privacy: "साइनअप नाही", instant: "त्वरित निकाल", local: "ब्राउझरमध्ये खाजगी प्रक्रिया" },
  es: { home: "Volver a la página principal", label: "Herramienta gratuita para negocios", howTo: "Cómo utilizar", faq: "Preguntas frecuentes", privacy: "Sin registro", instant: "Resultados inmediatos", local: "Procesamiento local y privado" },
  pt: { home: "Voltar para o início", label: "Ferramenta empresarial gratuita", howTo: "Como usar", faq: "Perguntas frequentes", privacy: "Sem cadastro", instant: "Resultados instantâneos", local: "Processamento privado no navegador" },
  fr: { home: "Retour à l'accueil", label: "Outil professionnel gratuit", howTo: "Mode d'emploi", faq: "Foire aux questions", privacy: "Sans inscription", instant: "Résultats instantanés", local: "Traitement local et privé" },
  de: { home: "Zur Startseite zurückkehren", label: "Kostenloses Business-Tool", howTo: "Anleitung", faq: "Häufige Fragen", privacy: "Ohne Registrierung", instant: "Sofortige Ergebnisse", local: "Lokale & private Verarbeitung" },
  id: { home: "Kembali ke beranda utama", label: "Alat bisnis & UMKM gratis", howTo: "Cara penggunaan", faq: "Pertanyaan umum", privacy: "Tanpa registrasi", instant: "Hasil instan", local: "Pemrosesan privat di browser" },
}[lang];
const cloudBadges = {
  hi: ["साइन इन आवश्यक", "सुरक्षित क्लाउड रीडायरेक्ट", "केवल कुल स्कैन आंकड़े"],
  ta: ["உள்நுழைவு தேவை", "பாதுகாப்பான கிளவுட் திருப்பி", "மொத்த ஸ்கேன் எண்ணிக்கை மட்டும்"],
  te: ["సైన్ ఇన్ అవసరం", "రక్షిత క్లౌడ్ రీడైరెక్ట్", "మొత్తం స్కాన్ లెక్కలు మాత్రమే"],
  mr: ["साइन इन आवश्यक", "सुरक्षित क्लाउड रीडायरेक्ट", "फक्त एकूण स्कॅन मोजणी"],
  es: ["Inicio de sesión requerido", "Redirección en la nube segura", "Estadísticas anónimas de escaneos"],
  pt: ["Login necessário", "Redirecionamento em nuvem seguro", "Apenas contagem de acessos"],
  fr: ["Connexion requise", "Redirection cloud sécurisée", "Statistiques de scan uniquement"],
  de: ["Anmeldung erforderlich", "Sichere Cloud-Weiterleitung", "Nur Scan-Zähler"],
  id: ["Perlu masuk akun", "Pengalihan cloud aman", "Hanya statistik total scan"],
}[lang];
const badges = tool.component === "dynamicQr"
  ? cloudBadges
  : [chrome.privacy, chrome.instant, chrome.local];
const path = `/${lang}/${tool.slug}/`;
---

<main class="px-3 py-8 sm:px-4 md:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-8">
      <section class="rounded-[2rem] border border-white/75 bg-white/86 p-5 shadow-[0_18px_48px_rgba(17,59,44,0.08)] sm:p-8 md:p-10">
        <a href={`/${lang}/`} class="text-xs font-bold text-leaf hover:underline">&larr; {chrome.home}</a>
        <p class="mt-5 inline-flex rounded-full border border-leaf/15 bg-mint px-3 py-1.5 text-xs font-black text-leaf">{chrome.label}</p>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-forest sm:text-5xl">{locale.name}</h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-forest/75 sm:text-base">{locale.intro}</p>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold text-forest/75">{badges.map((badge) => <span class="rounded-full bg-mint px-3 py-2">{badge}</span>)}</div>
      </section>
      <section id="tool" class="rounded-[2rem] border border-white/75 bg-white/86 p-4 shadow-[0_18px_48px_rgba(17,59,44,0.08)] sm:p-8 md:p-10">
        {tool.component === "digitalCard" && <DigitalVisitingCard client:visible />}
        {tool.component === "dynamicQr" && <DynamicQrGenerator client:visible />}
        {tool.component === "stickers" && <StickerSheetGenerator client:visible />}
        {tool.component === "gst" && <GstCalculator client:visible />}
        {tool.component === "whatsapp" && <WhatsappOrderGenerator client:visible />}
        {tool.component === "bulk" && <BulkQrGenerator client:visible />}
        {tool.component === "invoice" && <InvoiceGenerator client:visible />}
        {tool.component === "receipt" && <ReceiptGenerator client:visible />}
        {tool.component === "paidStamp" && <PaidStampGenerator client:visible />}
        {tool.component === "rentReceipt" && <RentReceiptGenerator client:visible />}
        {tool.component === "paymentReminder" && <PaymentReminderGenerator client:visible />}
        {tool.component === "quotation" && <QuotationGenerator client:visible />}
        {tool.component === "splitBill" && <SplitBillCalculator client:visible />}
        {tool.component === "cashDenomination" && <CashDenominationCalculator client:visible />}
        {tool.component === "creditNote" && <CreditNoteGenerator client:visible />}
        {tool.component === "emiCalculator" && <EmiCalculator client:visible />}
        {tool.component === "gratuity" && <GratuityCalculator client:visible />}
        {tool.component === "sipCalculator" && <SipCalculator client:visible />}
        {tool.component === "salarySlip" && <SalarySlipGenerator client:visible />}
        {tool.component === "msmed" && <MsmedInterestCalculator client:visible />}
        {tool.component === "proforma" && <ProformaInvoiceGenerator client:visible />}
        {tool.component === "breakEven" && <BreakEvenCalculator client:visible />}
        {tool.component === "treds" && <TredsCalculator client:visible />}
        {tool.component === "upiCalculator" && <UpiCalculator client:visible />}
        {tool.component === "offerPoster" && <OfferPosterGenerator client:visible />}
        {tool.component === "menuQr" && <MenuQrGenerator client:visible />}
        {tool.component === "margin" && <MarginCalculator client:visible />}
        {tool.component === "limits" && <UpiLimitsChecker client:visible />}
        {tool.component === "decoder" && <UpiQrDecoder client:visible />}
        {tool.component === "upiLink" && <UpiLinkGenerator client:visible />}
        {tool.component === "survey" && <SurveyQrGenerator client:visible />}
        {tool.component === "merchantRecon" && <MerchantReconciliation client:visible />}
        {tool.component === "msmeReceivables" && <MsmeReceivables client:visible />}
        {tool.component === "default" && <GeneratorForm client:visible lang={lang} />}
      </section>
      {locale.steps.length > 0 && (
        <section class="rounded-[2rem] border border-white/75 bg-white/86 p-5 sm:p-8">
          <h2 class="text-xl font-black text-forest">{chrome.howTo}</h2>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-forest/80">
            {locale.steps.map((step) => <li>{step}</li>)}
          </ol>
        </section>
      )}
      {locale.faqs.length > 0 && (
        <section class="rounded-[2rem] border border-white/75 bg-white/86 p-5 sm:p-8">
          <h2 class="text-xl font-black text-forest">{chrome.faq}</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {locale.faqs.map((faq) => (
              <div class="rounded-2xl border border-forest/10 bg-[#fffdf6] p-4">
                <h3 class="text-sm font-black text-forest">{faq.question}</h3>
                <p class="mt-2 text-xs leading-relaxed text-forest/75">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}
      <InternalLinkHub currentPath={path} lang={lang} />
    </div>
  </main>
